+            break;
+
+        case 2:
+            Audio_PlayActorSound2(&this->actor, NA_SE_EN_GANON_CHARGE_MASIC - SFX_FLAG);
+            this->unk_278.x = this->unk_2EC[0].x;
+            this->unk_278.y = this->unk_2EC[0].y + 50.0f + 30.0f;
