+            Math_ApproachF(&this->unk_28C, 0.25f, 0.1f, 0.006f);
+
+            if ((this->timers[0] > 20) && (this->timers[0] < 60)) {
+                Math_ApproachF(&this->unk_290, 255.0f, 1.0f, 15.0f);
+            }
+
+            if (this->timers[0] == 0) {
