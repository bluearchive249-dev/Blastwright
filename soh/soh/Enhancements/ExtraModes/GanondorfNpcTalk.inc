{ 0x7091, { "\x05\x41Ganondorf:\x05\x40\x01""You take the blame for Hyrule's\x01""ruin, princess.", "\x05\x41Ganondorf:\x05\x40\x01""Your doing? No, princess. Mine.\x01""Do not steal my glory." } },
{ 0x7092, { "\x05\x41Ganondorf:\x05\x40\x01""You warn that the road between\x01""times will close.", "\x05\x41Ganondorf:\x05\x40\x01""Close it. I need no road. I am\x01""already where I mean to be." } },
