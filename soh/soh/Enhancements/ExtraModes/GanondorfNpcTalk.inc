// SoH: "Play as Ganondorf", his own lines in each conversation (GanondorfNpcs.cpp): a lead-in before their line, and
// his answer after it where the line ends the talk. Written for that NPC and that line, in his own voice: dry, blunt,
// sometimes amused, sometimes almost kind, answering what was actually said. Laid out in the text box when shown
// (GanondorfText.h), under his name.
// Kokiri Forest, the Lost Woods and the Deku Tree
{ 0x1001, { "\x05\x41Ganondorf:\x05\x40\x01""Easy. I'm not here for you.", "\x05\x41Ganondorf:\x05\x40\x01""Bigger, yes. You'll get used to it. Everyone does, eventually." } },
{ 0x1003, { "\x05\x41Ganondorf:\x05\x40\x01""You'll wait. Of course you will.", "\x05\x41Ganondorf:\x05\x40\x01""Nice. I'll be exactly as nice as he deserves." } },
{ 0x1006, { "\x05\x41Ganondorf:\x05\x40\x01""Go on. Ask it.", "\x05\x41Ganondorf:\x05\x40\x01""No. Nothing in this forest made me. The sand did, and it was a hard mother." } },
{ 0x1008, { "\x05\x41Ganondorf:\x05\x40\x01""Says who? The tree?", "" } },
{ 0x1009, { "\x05\x41Ganondorf:\x05\x40\x01""Let me guess. Something about the tree.", "\x05\x41Ganondorf:\x05\x40\x01""No, I'm not. And your tree's rules were never mine." } },
{ 0x100A, { "\x05\x41Ganondorf:\x05\x40\x01""Let me guess. Somebody bigger told you to.", "" } },
{ 0x100B, { "\x05\x41Ganondorf:\x05\x40\x01""You want my help. With grass.", "\x05\x41Ganondorf:\x05\x40\x01""I don't cut grass, child. ...Fine. Stand back." } },
{ 0x100F, { "\x05\x41Ganondorf:\x05\x40\x01""You look ready to burst. Out with it.", "" } },
{ 0x1010, { "\x05\x41Ganondorf:\x05\x40\x01""Word travels fast in a forest this small.", "" } },
{ 0x1011, { "\x05\x41Ganondorf:\x05\x40\x01""Saria. You knew I wouldn't stay.", "\x05\x41Ganondorf:\x05\x40\x01""Don't cry. I've had enough goodbyes for one life." } },
{ 0x1012, { "\x05\x41Ganondorf:\x05\x40\x01""Out with it. What do you want me to promise?", "\x05\x41Ganondorf:\x05\x40\x01""I don't make friends. ...But I'll remember you. That'll have to do." } },
{ 0x1013, { "\x05\x41Ganondorf:\x05\x40\x01""For me? Nobody gives me anything.", "\x05\x41Ganondorf:\x05\x40\x01""I'll keep it. Don't ask me why." } },
{ 0x1014, { "\x05\x41Ganondorf:\x05\x40\x01""There's more. There always is.", "\x05\x41Ganondorf:\x05\x40\x01""I'll come back. You may not like it when I do." } },
{ 0x1019, { "\x05\x41Ganondorf:\x05\x40\x01""Advice? From you? Go on, I could use a laugh.", "\x05\x41Ganondorf:\x05\x40\x01""Kind of you. I learned in the desert. Out there you only fail once." } },
{ 0x101B, { "\x05\x41Ganondorf:\x05\x40\x01""Hm.", "\x05\x41Ganondorf:\x05\x40\x01""That obvious, is it? Let them whisper. It means they're paying attention." } },
{ 0x101D, { "\x05\x41Ganondorf:\x05\x40\x01""Bad luck.", "\x05\x41Ganondorf:\x05\x40\x01""It happens. The trick is to happen back." } },
{ 0x101E, { "\x05\x41Ganondorf:\x05\x40\x01""You like it, then.", "\x05\x41Ganondorf:\x05\x40\x01""Wear it. Nobody will mess with you. Nobody was going to anyway." } },
{ 0x101F, { "\x05\x41Ganondorf:\x05\x40\x01""Rupees again.", "" } },
{ 0x1020, { "\x05\x41Ganondorf:\x05\x40\x01""Your friends? There's a surprise.", "\x05\x41Ganondorf:\x05\x40\x01""Enjoy it. Masks are cheaper than faces." } },
{ 0x1021, { "\x05\x41Ganondorf:\x05\x40\x01""Shame, is it?", "\x05\x41Ganondorf:\x05\x40\x01""Sorry to disappoint. I'm hard to lose." } },
{ 0x1023, { "\x05\x41Ganondorf:\x05\x40\x01""She's waiting. She always is.", "\x05\x41Ganondorf:\x05\x40\x01""Then she's the only sensible one here." } },
{ 0x1024, { "\x05\x41Ganondorf:\x05\x40\x01""You know my name. Good.", "\x05\x41Ganondorf:\x05\x40\x01""Spare me the praise. I didn't do it for you." } },
{ 0x1026, { "\x05\x41Ganondorf:\x05\x40\x01""You're dying, old tree.", "\x05\x41Ganondorf:\x05\x40\x01""I did. I won't pretend otherwise." } },
{ 0x1027, { "\x05\x41Ganondorf:\x05\x40\x01""Go on. Say it to my face.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. That man is me. They trusted me because you never told them not to." } },
{ 0x1028, { "\x05\x41Ganondorf:\x05\x40\x01""The Lost Woods. Naturally.", "\x05\x41Ganondorf:\x05\x40\x01""Big shots climb too. I'll manage." } },
{ 0x1029, { "\x05\x41Ganondorf:\x05\x40\x01""Go on. I'm listening.", "\x05\x41Ganondorf:\x05\x40\x01""You know what I am, and you're still talking to me. Brave, for a tree." } },
{ 0x102B, { "\x05\x41Ganondorf:\x05\x40\x01""Something bad? Me?", "\x05\x41Ganondorf:\x05\x40\x01""Of course. But I'll see the castle first." } },
{ 0x102D, { "\x05\x41Ganondorf:\x05\x40\x01""Laugh while you can.", "\x05\x41Ganondorf:\x05\x40\x01""Heh. You'll keep." } },
{ 0x102F, { "\x05\x41Ganondorf:\x05\x40\x01""Mr. Desert Giant. That's a new one.", "" } },
{ 0x1030, { "\x05\x41Ganondorf:\x05\x40\x01""Rules. Wonderful.", "\x05\x41Ganondorf:\x05\x40\x01""Whatever I am, I'm walking past you." } },
{ 0x1031, { "\x05\x41Ganondorf:\x05\x40\x01""Someone's been talking.", "" } },
{ 0x1032, { "\x05\x41Ganondorf:\x05\x40\x01""One sword in the whole forest.", "\x05\x41Ganondorf:\x05\x40\x01""I've got hands. They'll do." } },
{ 0x1033, { "\x05\x41Ganondorf:\x05\x40\x01""You're shaking.", "" } },
{ 0x1034, { "\x05\x41Ganondorf:\x05\x40\x01""Mido. You again.", "\x05\x41Ganondorf:\x05\x40\x01""She likes me better. Live with it." } },
{ 0x103C, { "\x05\x41Ganondorf:\x05\x40\x01""Your sister's out spending, is she?", "\x05\x41Ganondorf:\x05\x40\x01""I know what Rupees are worth. More than most people here." } },
{ 0x1040, { "\x05\x41Ganondorf:\x05\x40\x01""You'll figure it out. Of course.", "\x05\x41Ganondorf:\x05\x40\x01""I usually do." } },
{ 0x1041, { "\x05\x41Ganondorf:\x05\x40\x01""No?", "\x05\x41Ganondorf:\x05\x40\x01""Then play it for me again. Slowly." } },
{ 0x1042, { "\x05\x41Ganondorf:\x05\x40\x01""Upset? I barely touched him.", "\x05\x41Ganondorf:\x05\x40\x01""Maybe a little. He'll live." } },
{ 0x1043, { "\x05\x41Ganondorf:\x05\x40\x01""Where am I going? Out.", "\x05\x41Ganondorf:\x05\x40\x01""To the castle, yes. Take it over? Let's see." } },
{ 0x1044, { "\x05\x41Ganondorf:\x05\x40\x01""You'll die, will you.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be fine. You're right about the rest." } },
{ 0x1046, { "\x05\x41Ganondorf:\x05\x40\x01""Your house. I noticed.", "\x05\x41Ganondorf:\x05\x40\x01""Too big, yes. I'll mind the ceiling." } },
{ 0x1047, { "\x05\x41Ganondorf:\x05\x40\x01""Safe. Me. Funny word for it.", "" } },
{ 0x1048, { "\x05\x41Ganondorf:\x05\x40\x01""She said so, did she.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody gets a say. Fine by me." } },
{ 0x1049, { "\x05\x41Ganondorf:\x05\x40\x01""Something happened. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""I was there. You'll have to make do with that." } },
{ 0x104A, { "\x05\x41Ganondorf:\x05\x40\x01""You've a good nose.", "\x05\x41Ganondorf:\x05\x40\x01""Sand and burning. That's what change smells like." } },
{ 0x104B, { "\x05\x41Ganondorf:\x05\x40\x01""Bye, then.", "\x05\x41Ganondorf:\x05\x40\x01""Don't worry. You won't miss me." } },
{ 0x104C, { "\x05\x41Ganondorf:\x05\x40\x01""Angry? Me?", "\x05\x41Ganondorf:\x05\x40\x01""I'll come back how I like." } },
{ 0x104E, { "\x05\x41Ganondorf:\x05\x40\x01""Scared of the monsters. And me.", "\x05\x41Ganondorf:\x05\x40\x01""Good. One of us is on your side, and it isn't them." } },
{ 0x104F, { "\x05\x41Ganondorf:\x05\x40\x01""Saria went on her own?", "" } },
{ 0x1050, { "\x05\x41Ganondorf:\x05\x40\x01""Beyond the Lost Woods. Noted.", "\x05\x41Ganondorf:\x05\x40\x01""I know the way. I've been there." } },
{ 0x1051, { "\x05\x41Ganondorf:\x05\x40\x01""You'd never forgive me.", "\x05\x41Ganondorf:\x05\x40\x01""I haven't touched her. Not yet, anyway." } },
{ 0x1052, { "\x05\x41Ganondorf:\x05\x40\x01""Eat you? You're not big enough.", "\x05\x41Ganondorf:\x05\x40\x01""Keep your Deku Shield. It wouldn't cover my hand." } },
{ 0x1053, { "\x05\x41Ganondorf:\x05\x40\x01""You looked in my eyes. Brave.", "" } },
{ 0x1054, { "\x05\x41Ganondorf:\x05\x40\x01""Hiding? Good guess.", "\x05\x41Ganondorf:\x05\x40\x01""He's smarter than he looks, then." } },
{ 0x1055, { "\x05\x41Ganondorf:\x05\x40\x01""The monsters don't worry me.", "" } },
{ 0x1056, { "\x05\x41Ganondorf:\x05\x40\x01""Bored, are you?", "\x05\x41Ganondorf:\x05\x40\x01""Stay in. It's safer, and you're right about why." } },
{ 0x1057, { "\x05\x41Ganondorf:\x05\x40\x01""Throw people? Only on bad days.", "\x05\x41Ganondorf:\x05\x40\x01""Bows are for those who can't reach." } },
{ 0x1058, { "\x05\x41Ganondorf:\x05\x40\x01""A boy named that? Maybe.", "" } },
{ 0x1059, { "\x05\x41Ganondorf:\x05\x40\x01""Maybe Mido was right.", "\x05\x41Ganondorf:\x05\x40\x01""Mido's right about once a year. This was the time." } },
{ 0x105A, { "\x05\x41Ganondorf:\x05\x40\x01""In a bad dream? Could be.", "\x05\x41Ganondorf:\x05\x40\x01""I get around." } },
{ 0x105B, { "\x05\x41Ganondorf:\x05\x40\x01""He left, did he.", "" } },
{ 0x105C, { "\x05\x41Ganondorf:\x05\x40\x01""Don't count on it.", "\x05\x41Ganondorf:\x05\x40\x01""He'll be back. He won't be the same." } },
{ 0x105D, { "\x05\x41Ganondorf:\x05\x40\x01""Strong? You'd like that.", "" } },
{ 0x105E, { "\x05\x41Ganondorf:\x05\x40\x01""You'll never get bigger.", "\x05\x41Ganondorf:\x05\x40\x01""You've got a point. Big hasn't made me kind." } },
{ 0x1060, { "\x05\x41Ganondorf:\x05\x40\x01""Can't fool you, can I.", "" } },
{ 0x1061, { "\x05\x41Ganondorf:\x05\x40\x01""Especially not me. Hm.", "\x05\x41Ganondorf:\x05\x40\x01""You'll keep your promise. I'll find another way." } },
{ 0x1062, { "\x05\x41Ganondorf:\x05\x40\x01""You're the sprout. You've grown.", "\x05\x41Ganondorf:\x05\x40\x01""The one who cursed your father is standing here. Yes. Still want to talk?" } },
{ 0x1063, { "\x05\x41Ganondorf:\x05\x40\x01""None of them knew me. No.", "\x05\x41Ganondorf:\x05\x40\x01""They stay children. I stopped being one a long time ago." } },
{ 0x1064, { "\x05\x41Ganondorf:\x05\x40\x01""Go on, tell me.", "\x05\x41Ganondorf:\x05\x40\x01""A Gerudo. The one man born to them. I've known since I was small." } },
{ 0x1066, { "\x05\x41Ganondorf:\x05\x40\x01""I've always known. You're right.", "\x05\x41Ganondorf:\x05\x40\x01""Break the curses? I'll break what I like." } },
{ 0x1067, { "\x05\x41Ganondorf:\x05\x40\x01""You know that song.", "" } },
{ 0x1068, { "\x05\x41Ganondorf:\x05\x40\x01""Him. Big and quiet.", "\x05\x41Ganondorf:\x05\x40\x01""He's gone. The man who came back is someone else." } },
{ 0x1069, { "\x05\x41Ganondorf:\x05\x40\x01""You think so?", "\x05\x41Ganondorf:\x05\x40\x01""I've died in worse places than this. I'm still here." } },
{ 0x106A, { "\x05\x41Ganondorf:\x05\x40\x01""Still my friend. After all that.", "\x05\x41Ganondorf:\x05\x40\x01""I don't understand you, Saria. I never did." } },
{ 0x106C, { "\x05\x41Ganondorf:\x05\x40\x01""Time's cruel. I know.", "\x05\x41Ganondorf:\x05\x40\x01""Memories don't change. That's what makes them hurt." } },
{ 0x106D, { "\x05\x41Ganondorf:\x05\x40\x01""Stay good? I'll try.", "\x05\x41Ganondorf:\x05\x40\x01""Don't hold your breath." } },
{ 0x106E, { "\x05\x41Ganondorf:\x05\x40\x01""Unless I've done something.", "\x05\x41Ganondorf:\x05\x40\x01""I haven't. This time." } },
{ 0x106F, { "\x05\x41Ganondorf:\x05\x40\x01""Just this once. Fine.", "" } },
{ 0x1070, { "\x05\x41Ganondorf:\x05\x40\x01""You made a promise.", "" } },
{ 0x1071, { "\x05\x41Ganondorf:\x05\x40\x01""Him. I'll pass it on.", "" } },
{ 0x1073, { "\x05\x41Ganondorf:\x05\x40\x01""Nobody wanted to play with him.", "\x05\x41Ganondorf:\x05\x40\x01""Funny. It doesn't hurt like it used to." } },
{ 0x1074, { "\x05\x41Ganondorf:\x05\x40\x01""Minus the evil part. Ha.", "\x05\x41Ganondorf:\x05\x40\x01""That part's free. You'll grow out of wanting it." } },
{ 0x1075, { "\x05\x41Ganondorf:\x05\x40\x01""He might.", "\x05\x41Ganondorf:\x05\x40\x01""And if he does, he will have changed. Everyone does." } },
{ 0x1076, { "\x05\x41Ganondorf:\x05\x40\x01""You should run. You're right.", "\x05\x41Ganondorf:\x05\x40\x01""But you won't. Kokiri never learn." } },
{ 0x1077, { "\x05\x41Ganondorf:\x05\x40\x01""Some thanks. I'll take it.", "\x05\x41Ganondorf:\x05\x40\x01""The forest's fine. I didn't come for it." } },
{ 0x1078, { "\x05\x41Ganondorf:\x05\x40\x01""Even from me.", "\x05\x41Ganondorf:\x05\x40\x01""Good. Someone should try." } },
{ 0x1079, { "\x05\x41Ganondorf:\x05\x40\x01""Strange, isn't it.", "\x05\x41Ganondorf:\x05\x40\x01""Even I get tired of storms." } },
{ 0x107A, { "\x05\x41Ganondorf:\x05\x40\x01""You're sure he'll come back.", "\x05\x41Ganondorf:\x05\x40\x01""Then wait for him. Waiting suits this place." } },
{ 0x107B, { "\x05\x41Ganondorf:\x05\x40\x01""She's busy.", "\x05\x41Ganondorf:\x05\x40\x01""Saria will come back when she's done. She always finishes things." } },
{ 0x107C, { "\x05\x41Ganondorf:\x05\x40\x01""You're sure of that.", "\x05\x41Ganondorf:\x05\x40\x01""Maybe. It's a good thing to be sure of." } },
{ 0x107D, { "\x05\x41Ganondorf:\x05\x40\x01""Hello, tree.", "\x05\x41Ganondorf:\x05\x40\x01""Yes, I'm back too. I'm not here to finish the job." } },
{ 0x107E, { "\x05\x41Ganondorf:\x05\x40\x01""You're talking about me.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. The Sacred Realm. I'm looking. I'll find it." } },
{ 0x108F, { "\x05\x41Ganondorf:\x05\x40\x01""You knew I'd come.", "\x05\x41Ganondorf:\x05\x40\x01""We can't live in the same world. You're right. I'm sorry it's you." } },
{ 0x1090, { "\x05\x41Ganondorf:\x05\x40\x01""Don't regret it. I'll manage that myself.", "\x05\x41Ganondorf:\x05\x40\x01""Watch, then. Just don't expect me to change." } },
{ 0x1091, { "\x05\x41Ganondorf:\x05\x40\x01""Courage was never my strong suit.", "\x05\x41Ganondorf:\x05\x40\x01""I'm not sure I understand either." } },
{ 0x1093, { "\x05\x41Ganondorf:\x05\x40\x01""The stone. Yes, I wanted it.", "\x05\x41Ganondorf:\x05\x40\x01""I'll go to the castle. Your princess and I have things to discuss." } },
{ 0x1094, { "\x05\x41Ganondorf:\x05\x40\x01""Different. Always.", "\x05\x41Ganondorf:\x05\x40\x01""You knew before I did, Saria." } },
{ 0x1097, { "\x05\x41Ganondorf:\x05\x40\x01""Backflips. In this armor.", "\x05\x41Ganondorf:\x05\x40\x01""I don't flip. I land." } },
{ 0x10A0, { "\x05\x41Ganondorf:\x05\x40\x01""Deku Nuts. How generous.", "" } },
{ 0x10A1, { "\x05\x41Ganondorf:\x05\x40\x01""Sticks. Of course.", "" } },
{ 0x10A2, { "\x05\x41Ganondorf:\x05\x40\x01""A Piece of Heart. For me?", "" } },
{ 0x10A4, { "\x05\x41Ganondorf:\x05\x40\x01""Run home, then.", "\x05\x41Ganondorf:\x05\x40\x01""Go on. Faster." } },
{ 0x10A5, { "\x05\x41Ganondorf:\x05\x40\x01""Even kings pay. Bold.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. I'll be back with Rupees." } },
{ 0x10A6, { "\x05\x41Ganondorf:\x05\x40\x01""Not now? Hm.", "\x05\x41Ganondorf:\x05\x40\x01""I'm not mad. Yet." } },
{ 0x10A8, { "\x05\x41Ganondorf:\x05\x40\x01""Your secret place.", "" } },
{ 0x10AA, { "\x05\x41Ganondorf:\x05\x40\x01""Ready. Gentle fingers.", "\x05\x41Ganondorf:\x05\x40\x01""Ha. Go on, I'm listening." } },
{ 0x10AB, { "\x05\x41Ganondorf:\x05\x40\x01""Boring? It's harder than it looks.", "\x05\x41Ganondorf:\x05\x40\x01""All right. Once more." } },
{ 0x10AC, { "\x05\x41Ganondorf:\x05\x40\x01""Gentle. Don't tell anyone.", "" } },
{ 0x10AD, { "\x05\x41Ganondorf:\x05\x40\x01""Anytime?", "\x05\x41Ganondorf:\x05\x40\x01""I'll remember. Might even use it." } },
{ 0x10AE, { "\x05\x41Ganondorf:\x05\x40\x01""It's safe.", "\x05\x41Ganondorf:\x05\x40\x01""Better than safe. I haven't broken it yet." } },
{ 0x10B0, { "\x05\x41Ganondorf:\x05\x40\x01""Sulking. Of course he is.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find him. He won't enjoy it." } },
{ 0x10B4, { "\x05\x41Ganondorf:\x05\x40\x01""I was never a nice guy.", "\x05\x41Ganondorf:\x05\x40\x01""Go on, then. Get away." } },
{ 0x10B5, { "\x05\x41Ganondorf:\x05\x40\x01""She did.", "\x05\x41Ganondorf:\x05\x40\x01""We talked. Don't worry about it." } },
{ 0x10B6, { "\x05\x41Ganondorf:\x05\x40\x01""That old hag. Right.", "\x05\x41Ganondorf:\x05\x40\x01""I'm going. Don't rush me." } },
{ 0x10B7, { "\x05\x41Ganondorf:\x05\x40\x01""Everybody becomes a Stalfos.", "" } },
{ 0x10B9, { "\x05\x41Ganondorf:\x05\x40\x01""A scary Stalfos.", "\x05\x41Ganondorf:\x05\x40\x01""I'd make a fine one. Don't hold your breath." } },
{ 0x10BB, { "\x05\x41Ganondorf:\x05\x40\x01""Friends, even if I'm scary.", "\x05\x41Ganondorf:\x05\x40\x01""I'll take it. Don't spread it around." } },
{ 0x10BC, { "\x05\x41Ganondorf:\x05\x40\x01""Plain? It's fine.", "\x05\x41Ganondorf:\x05\x40\x01""Mine's been called worse." } },
{ 0x10BD, { "\x05\x41Ganondorf:\x05\x40\x01""If I promise. Hm.", "\x05\x41Ganondorf:\x05\x40\x01""Can't promise that. But I'll play." } },
{ 0x10BE, { "\x05\x41Ganondorf:\x05\x40\x01""Lead, then.", "\x05\x41Ganondorf:\x05\x40\x01""Go on. I'll follow." } },
{ 0x10BF, { "\x05\x41Ganondorf:\x05\x40\x01""For a warlord. Thanks.", "\x05\x41Ganondorf:\x05\x40\x01""I've had a lot of time alone with music." } },
{ 0x10C0, { "\x05\x41Ganondorf:\x05\x40\x01""Watching me, owl?", "" } },
{ 0x10C3, { "\x05\x41Ganondorf:\x05\x40\x01""You're right. It isn't.", "\x05\x41Ganondorf:\x05\x40\x01""I follow my ears fine. Thanks for nothing." } },
{ 0x10C4, { "\x05\x41Ganondorf:\x05\x40\x01""Owl again.", "" } },
{ 0x10C7, { "\x05\x41Ganondorf:\x05\x40\x01""Memorize them. Yes, yes.", "\x05\x41Ganondorf:\x05\x40\x01""I remember every song I've ever heard." } },
{ 0x10C8, { "\x05\x41Ganondorf:\x05\x40\x01""He's not wrong.", "" } },
{ 0x10C9, { "\x05\x41Ganondorf:\x05\x40\x01""Since I arrived. Fair.", "" } },
{ 0x10CA, { "\x05\x41Ganondorf:\x05\x40\x01""Put down the fist? Make me a deal.", "" } },
{ 0x10CB, { "\x05\x41Ganondorf:\x05\x40\x01""A steal? We'll see.", "" } },
{ 0x10CC, { "\x05\x41Ganondorf:\x05\x40\x01""Bombs. Now we're talking.", "" } },
{ 0x10CD, { "\x05\x41Ganondorf:\x05\x40\x01""Arrows. Fine.", "" } },
{ 0x10CE, { "\x05\x41Ganondorf:\x05\x40\x01""Red Potion. Sure.", "" } },
{ 0x10CF, { "\x05\x41Ganondorf:\x05\x40\x01""My magic smells? Rude.", "" } },
{ 0x10D1, { "\x05\x41Ganondorf:\x05\x40\x01""Me. Yes. Get used to it.", "" } },
{ 0x10D2, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. These hands.", "" } },
{ 0x10D3, { "\x05\x41Ganondorf:\x05\x40\x01""A brute's still a brute. Hm.", "" } },
{ 0x10D4, { "\x05\x41Ganondorf:\x05\x40\x01""I won't stomp you.", "" } },
{ 0x10D5, { "\x05\x41Ganondorf:\x05\x40\x01""Deku Nuts again.", "" } },
{ 0x10D6, { "\x05\x41Ganondorf:\x05\x40\x01""I'll tell him.", "\x05\x41Ganondorf:\x05\x40\x01""Not scared of me either. I'll pass that on, Mido." } },
{ 0x10D7, { "\x05\x41Ganondorf:\x05\x40\x01""A real man. Thanks.", "" } },
{ 0x10D9, { "\x05\x41Ganondorf:\x05\x40\x01""What did I do? You know.", "\x05\x41Ganondorf:\x05\x40\x01""I won't lie to you. He's gone because of me." } },
{ 0x10DA, { "\x05\x41Ganondorf:\x05\x40\x01""Right gear. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Nothing in there would dare. You're right about that." } },
{ 0x10DC, { "\x05\x41Ganondorf:\x05\x40\x01""More Deku Sticks.", "" } },
{ 0x10DD, { "\x05\x41Ganondorf:\x05\x40\x01""More Deku Nuts.", "" } },
{ 0x10DE, { "\x05\x41Ganondorf:\x05\x40\x01""So sorry? Fine.", "\x05\x41Ganondorf:\x05\x40\x01""I'm not going to hurt you. Calm down." } },
{ 0x10DF, { "\x05\x41Ganondorf:\x05\x40\x01""Everybody, Stalfos.", "\x05\x41Ganondorf:\x05\x40\x01""Cheerful place." } },
// Lon Lon Ranch and Hyrule Field
{ 0x2001, { "\x05\x41Ganondorf:\x05\x40\x01""Epona. She's doing fine.", "\x05\x41Ganondorf:\x05\x40\x01""She trusts me. Don't ask me why either. Horses are strange that way." } },
{ 0x2002, { "\x05\x41Ganondorf:\x05\x40\x01""She was wild. So was I.", "" } },
{ 0x2009, { "\x05\x41Ganondorf:\x05\x40\x01""Funny thing to tell me.", "\x05\x41Ganondorf:\x05\x40\x01""I'll protect it. I just won't give it back." } },
{ 0x200A, { "\x05\x41Ganondorf:\x05\x40\x01""A disguise? Hardly.", "" } },
{ 0x200D, { "\x05\x41Ganondorf:\x05\x40\x01""You're awake. Barely.", "\x05\x41Ganondorf:\x05\x40\x01""Malon yelled at you. I'd have done worse." } },
{ 0x200E, { "\x05\x41Ganondorf:\x05\x40\x01""I read Hylian fine.", "\x05\x41Ganondorf:\x05\x40\x01""Relax. I'm not going to hurt you. Over a sign." } },
{ 0x200F, { "\x05\x41Ganondorf:\x05\x40\x01""Suit yourself.", "\x05\x41Ganondorf:\x05\x40\x01""Your loss." } },
{ 0x2011, { "\x05\x41Ganondorf:\x05\x40\x01""Hard work. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""You can stop laughing. It's making me nervous." } },
{ 0x2014, { "\x05\x41Ganondorf:\x05\x40\x01""Mr. Ingo. Of course.", "\x05\x41Ganondorf:\x05\x40\x01""Scram, you were going to say. Go on, finish it." } },
{ 0x2016, { "\x05\x41Ganondorf:\x05\x40\x01""A present for your kid.", "\x05\x41Ganondorf:\x05\x40\x01""Masks are cheap. Kids aren't. Buy one." } },
{ 0x2017, { "\x05\x41Ganondorf:\x05\x40\x01""He's gone.", "\x05\x41Ganondorf:\x05\x40\x01""He went quietly. That's more than most get." } },
{ 0x2018, { "\x05\x41Ganondorf:\x05\x40\x01""You know me?", "\x05\x41Ganondorf:\x05\x40\x01""Yes. You know me. Most people wish they didn't." } },
{ 0x2019, { "\x05\x41Ganondorf:\x05\x40\x01""Lost her. Again.", "\x05\x41Ganondorf:\x05\x40\x01""Chickens. Of all the things to lose." } },
{ 0x2022, { "\x05\x41Ganondorf:\x05\x40\x01""The gravekeeper. Ha.", "\x05\x41Ganondorf:\x05\x40\x01""Cute face or not, you'll be digging graves soon enough." } },
{ 0x2024, { "\x05\x41Ganondorf:\x05\x40\x01""Sure you do.", "\x05\x41Ganondorf:\x05\x40\x01""Show me, then." } },
{ 0x2026, { "\x05\x41Ganondorf:\x05\x40\x01""Just like the gravekeeper.", "\x05\x41Ganondorf:\x05\x40\x01""Here's your mask. Go dig something." } },
{ 0x2027, { "\x05\x41Ganondorf:\x05\x40\x01""He paid without a word.", "" } },
{ 0x2028, { "\x05\x41Ganondorf:\x05\x40\x01""Dig and dig.", "\x05\x41Ganondorf:\x05\x40\x01""Don't dig anything up you can't put back." } },
{ 0x2029, { "\x05\x41Ganondorf:\x05\x40\x01""You want to be a rabbit.", "\x05\x41Ganondorf:\x05\x40\x01""Rabbits run. Not the worst plan in this country." } },
{ 0x202A, { "\x05\x41Ganondorf:\x05\x40\x01""Rabbit ears. Legendary ones.", "" } },
{ 0x202C, { "\x05\x41Ganondorf:\x05\x40\x01""Then ask a better question.", "\x05\x41Ganondorf:\x05\x40\x01""You won't like the next one either." } },
{ 0x202E, { "\x05\x41Ganondorf:\x05\x40\x01""More than I can count.", "" } },
{ 0x2030, { "\x05\x41Ganondorf:\x05\x40\x01""Talon was weak. Hm.", "" } },
{ 0x2032, { "\x05\x41Ganondorf:\x05\x40\x01""My lord, is it. Better.", "\x05\x41Ganondorf:\x05\x40\x01""I'll come back. Keep the place standing." } },
{ 0x2033, { "\x05\x41Ganondorf:\x05\x40\x01""The rules. Of course.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. I'll find the money." } },
{ 0x2039, { "\x05\x41Ganondorf:\x05\x40\x01""A king doesn't carry coins.", "\x05\x41Ganondorf:\x05\x40\x01""No stakes, no race. Fair enough." } },
{ 0x203E, { "\x05\x41Ganondorf:\x05\x40\x01""Let you win. Sure I did.", "\x05\x41Ganondorf:\x05\x40\x01""You won. Enjoy it. It won't happen again." } },
{ 0x203F, { "\x05\x41Ganondorf:\x05\x40\x01""Big... sir. Nice save.", "" } },
{ 0x2040, { "\x05\x41Ganondorf:\x05\x40\x01""You think a king doesn't work?", "\x05\x41Ganondorf:\x05\x40\x01""Holding a country down is work too. Ask anyone I've done it to." } },
{ 0x2042, { "\x05\x41Ganondorf:\x05\x40\x01""Your father. The milk man.", "\x05\x41Ganondorf:\x05\x40\x01""I saw him. He was asleep by the castle wall. He's fine." } },
{ 0x2045, { "\x05\x41Ganondorf:\x05\x40\x01""Ingo again.", "" } },
{ 0x2046, { "\x05\x41Ganondorf:\x05\x40\x01""Someone like me. I'm flattered.", "\x05\x41Ganondorf:\x05\x40\x01""Careful what you ask for, Ingo. You'll get it." } },
{ 0x2049, { "\x05\x41Ganondorf:\x05\x40\x01""Sing? Me?", "\x05\x41Ganondorf:\x05\x40\x01""Your mother wrote a good song. I'll listen. That's all." } },
{ 0x204B, { "\x05\x41Ganondorf:\x05\x40\x01""He's out cold.", "\x05\x41Ganondorf:\x05\x40\x01""Leave him. He's earned it." } },
{ 0x204C, { "\x05\x41Ganondorf:\x05\x40\x01""It's me. I'm afraid so.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. I did that. I'm not going to say sorry." } },
{ 0x204D, { "\x05\x41Ganondorf:\x05\x40\x01""Happy or sad. Hm.", "\x05\x41Ganondorf:\x05\x40\x01""You're fast. That's never something to be sad about." } },
{ 0x204E, { "\x05\x41Ganondorf:\x05\x40\x01""Stop that song, he says.", "\x05\x41Ganondorf:\x05\x40\x01""Not a fan of music, then." } },
{ 0x204F, { "\x05\x41Ganondorf:\x05\x40\x01""Death Mountain. I know.", "\x05\x41Ganondorf:\x05\x40\x01""The Gorons have their stone. Not for long." } },
{ 0x2050, { "\x05\x41Ganondorf:\x05\x40\x01""I won't tell.", "\x05\x41Ganondorf:\x05\x40\x01""Your secret's safe. I've got bigger ones." } },
{ 0x2051, { "\x05\x41Ganondorf:\x05\x40\x01""Ingo changed.", "" } },
{ 0x2052, { "\x05\x41Ganondorf:\x05\x40\x01""She's mine now. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be good to her. Better than I am to people." } },
{ 0x2053, { "\x05\x41Ganondorf:\x05\x40\x01""A one-eyed statue. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""It looked away. Smart stone." } },
{ 0x2054, { "\x05\x41Ganondorf:\x05\x40\x01""A talking stone.", "\x05\x41Ganondorf:\x05\x40\x01""Go on, stone. What did you hear?" } },
{ 0x2055, { "\x05\x41Ganondorf:\x05\x40\x01""A new leaf.", "\x05\x41Ganondorf:\x05\x40\x01""Good luck with that. I mean it." } },
{ 0x2056, { "\x05\x41Ganondorf:\x05\x40\x01""Tempted. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""He wanted more than he had. I just told him he could have it." } },
{ 0x2057, { "\x05\x41Ganondorf:\x05\x40\x01""Not easy being a working man.", "\x05\x41Ganondorf:\x05\x40\x01""Go back to sleep, Talon." } },
{ 0x2059, { "\x05\x41Ganondorf:\x05\x40\x01""I might.", "\x05\x41Ganondorf:\x05\x40\x01""I rarely do. But maybe." } },
{ 0x205D, { "\x05\x41Ganondorf:\x05\x40\x01""Normal price. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""I'll pay. Kings pay. Sometimes." } },
{ 0x205F, { "\x05\x41Ganondorf:\x05\x40\x01""Honored. You don't look it.", "\x05\x41Ganondorf:\x05\x40\x01""I won't take it away. Do your job." } },
{ 0x2060, { "\x05\x41Ganondorf:\x05\x40\x01""You'll be watching me.", "\x05\x41Ganondorf:\x05\x40\x01""Watch, then. I'll make it worth your while." } },
{ 0x2061, { "\x05\x41Ganondorf:\x05\x40\x01""With these hands, yes.", "\x05\x41Ganondorf:\x05\x40\x01""You'd be surprised what these hands can do." } },
{ 0x2062, { "\x05\x41Ganondorf:\x05\x40\x01""Kakariko. Your village.", "\x05\x41Ganondorf:\x05\x40\x01""I'll talk to them. Whether they want to or not." } },
{ 0x2063, { "\x05\x41Ganondorf:\x05\x40\x01""A royal song. For me.", "\x05\x41Ganondorf:\x05\x40\x01""Fitting. It's not proof of loyalty, Impa. It's just a song." } },
{ 0x2064, { "\x05\x41Ganondorf:\x05\x40\x01""You again, owl.", "" } },
{ 0x2065, { "\x05\x41Ganondorf:\x05\x40\x01""Treat her well.", "" } },
{ 0x2067, { "\x05\x41Ganondorf:\x05\x40\x01""I'm sure you will.", "\x05\x41Ganondorf:\x05\x40\x01""Watch closely, owl. You might learn something." } },
{ 0x206B, { "\x05\x41Ganondorf:\x05\x40\x01""Too smart. Probably.", "\x05\x41Ganondorf:\x05\x40\x01""Thanks. I'll take my chances." } },
{ 0x206E, { "\x05\x41Ganondorf:\x05\x40\x01""Choose wisely. I always do.", "\x05\x41Ganondorf:\x05\x40\x01""For me, anyway." } },
{ 0x2070, { "\x05\x41Ganondorf:\x05\x40\x01""Angry. Me?", "\x05\x41Ganondorf:\x05\x40\x01""No promises." } },
{ 0x2072, { "\x05\x41Ganondorf:\x05\x40\x01""I always am.", "\x05\x41Ganondorf:\x05\x40\x01""Going." } },
{ 0x208A, { "\x05\x41Ganondorf:\x05\x40\x01""No bottle. Hm.", "\x05\x41Ganondorf:\x05\x40\x01""Hold it. I'll be back for it." } },
{ 0x208E, { "\x05\x41Ganondorf:\x05\x40\x01""An angle. Noted.", "\x05\x41Ganondorf:\x05\x40\x01""I'll try again. She knows what she's doing even if I don't." } },
// Death Mountain, Goron City and the Fire Temple
{ 0x3002, { "\x05\x41Ganondorf:\x05\x40\x01""You made this?", "\x05\x41Ganondorf:\x05\x40\x01""Good work. Even I can see that." } },
{ 0x3003, { "\x05\x41Ganondorf:\x05\x40\x01""A souvenir. For me.", "\x05\x41Ganondorf:\x05\x40\x01""Not on Gorons. I'll try to remember." } },
{ 0x3004, { "\x05\x41Ganondorf:\x05\x40\x01""Surprised?", "\x05\x41Ganondorf:\x05\x40\x01""We're not sworn brothers. I know. Keep your debt; I'll collect later." } },
{ 0x3007, { "\x05\x41Ganondorf:\x05\x40\x01""Hot, is it.", "\x05\x41Ganondorf:\x05\x40\x01""You're going to hurt yourself, Darunia." } },
{ 0x3008, { "\x05\x41Ganondorf:\x05\x40\x01""A Goron. I'd noticed.", "" } },
{ 0x3009, { "\x05\x41Ganondorf:\x05\x40\x01""Right into me. Ambitious.", "\x05\x41Ganondorf:\x05\x40\x01""Roll all you like. I'll still be standing at the bottom." } },
{ 0x300B, { "\x05\x41Ganondorf:\x05\x40\x01""Bomb Flowers. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Raw material for bombs. You don't say." } },
{ 0x300D, { "\x05\x41Ganondorf:\x05\x40\x01""The cavern. Mine, yes.", "\x05\x41Ganondorf:\x05\x40\x01""It's dim in there. Good. I like it that way." } },
{ 0x300E, { "\x05\x41Ganondorf:\x05\x40\x01""Visitors. Rare up here.", "" } },
{ 0x3011, { "\x05\x41Ganondorf:\x05\x40\x01""Desert dog. Cute.", "\x05\x41Ganondorf:\x05\x40\x01""Roll it off, then. I'll wait." } },
{ 0x3013, { "\x05\x41Ganondorf:\x05\x40\x01""Mixed feelings. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""Roll on. It's the most honest thing you do." } },
{ 0x3014, { "\x05\x41Ganondorf:\x05\x40\x01""Starving. I know why.", "" } },
{ 0x3015, { "\x05\x41Ganondorf:\x05\x40\x01""Your sirloin rocks.", "\x05\x41Ganondorf:\x05\x40\x01""Not today. Ask nicely and maybe tomorrow." } },
{ 0x3016, { "\x05\x41Ganondorf:\x05\x40\x01""Fall? Me?", "" } },
{ 0x3017, { "\x05\x41Ganondorf:\x05\x40\x01""Not for me. Clearly.", "\x05\x41Ganondorf:\x05\x40\x01""He'll open the door. Everyone does, eventually." } },
{ 0x3018, { "\x05\x41Ganondorf:\x05\x40\x01""Food. I gathered.", "" } },
{ 0x3019, { "\x05\x41Ganondorf:\x05\x40\x01""Before I came. Yes.", "" } },
{ 0x301A, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. Me.", "" } },
{ 0x301B, { "\x05\x41Ganondorf:\x05\x40\x01""Least of all me.", "\x05\x41Ganondorf:\x05\x40\x01""And yet here I am. Funny, isn't it." } },
{ 0x301C, { "\x05\x41Ganondorf:\x05\x40\x01""Darunia. Big boss.", "\x05\x41Ganondorf:\x05\x40\x01""You're easier to like than I expected. Don't tell anyone I said that." } },
{ 0x301D, { "\x05\x41Ganondorf:\x05\x40\x01""My mess. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""Clean it up, then talk. Fair enough." } },
{ 0x301E, { "\x05\x41Ganondorf:\x05\x40\x01""Just the tune.", "\x05\x41Ganondorf:\x05\x40\x01""Fine by me. I'm not much of a dancer." } },
{ 0x301F, { "\x05\x41Ganondorf:\x05\x40\x01""Even when I play it.", "\x05\x41Ganondorf:\x05\x40\x01""It's a good song. Doesn't matter whose hands." } },
{ 0x3020, { "\x05\x41Ganondorf:\x05\x40\x01""Not desert music.", "\x05\x41Ganondorf:\x05\x40\x01""Green and natural. I'll see what I can find." } },
{ 0x3021, { "\x05\x41Ganondorf:\x05\x40\x01""Funny. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""I opened it. You're welcome." } },
{ 0x3023, { "\x05\x41Ganondorf:\x05\x40\x01""Suppose all you like.", "\x05\x41Ganondorf:\x05\x40\x01""Eat, then. I'll want something for it later." } },
{ 0x3024, { "\x05\x41Ganondorf:\x05\x40\x01""He took it away. Good to know.", "" } },
{ 0x3025, { "\x05\x41Ganondorf:\x05\x40\x01""Fire. From his room.", "\x05\x41Ganondorf:\x05\x40\x01""I'll bring it. Don't burn yourself." } },
{ 0x3026, { "\x05\x41Ganondorf:\x05\x40\x01""At me. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""You'd miss." } },
{ 0x3027, { "\x05\x41Ganondorf:\x05\x40\x01""Me. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Call me what you like. They're dead either way." } },
{ 0x3029, { "\x05\x41Ganondorf:\x05\x40\x01""Your loss.", "\x05\x41Ganondorf:\x05\x40\x01""Name him what you like. He'll hear about me anyway." } },
{ 0x302A, { "\x05\x41Ganondorf:\x05\x40\x01""Thrilled. I bet.", "\x05\x41Ganondorf:\x05\x40\x01""I'll go anyway. They'll get over it." } },
{ 0x302C, { "\x05\x41Ganondorf:\x05\x40\x01""Lively. I'll light them.", "\x05\x41Ganondorf:\x05\x40\x01""It's grim enough in the dark." } },
{ 0x302E, { "\x05\x41Ganondorf:\x05\x40\x01""Out of Bombs. I heard.", "" } },
{ 0x302F, { "\x05\x41Ganondorf:\x05\x40\x01""Furious. Yes.", "" } },
{ 0x3030, { "\x05\x41Ganondorf:\x05\x40\x01""THE Ganondorf. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody's getting you. Calm down." } },
{ 0x3031, { "\x05\x41Ganondorf:\x05\x40\x01""Hero of the Gorons. Tremble, should I?", "\x05\x41Ganondorf:\x05\x40\x01""You've got your father's nerve. I'll give you that." } },
{ 0x3032, { "\x05\x41Ganondorf:\x05\x40\x01""Named after me. Hm.", "" } },
{ 0x3035, { "\x05\x41Ganondorf:\x05\x40\x01""A dragon. Volvagia.", "" } },
{ 0x3036, { "\x05\x41Ganondorf:\x05\x40\x01""My followers. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""I'll get them out. Don't ask why." } },
{ 0x3037, { "\x05\x41Ganondorf:\x05\x40\x01""You're asking me. Brave.", "" } },
{ 0x3038, { "\x05\x41Ganondorf:\x05\x40\x01""The statue. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""Move it. Right." } },
{ 0x3039, { "\x05\x41Ganondorf:\x05\x40\x01""Bigger, yes.", "\x05\x41Ganondorf:\x05\x40\x01""Not now. Agreed. Later, then." } },
{ 0x303A, { "\x05\x41Ganondorf:\x05\x40\x01""Before you change your mind.", "\x05\x41Ganondorf:\x05\x40\x01""I won't tell anyone if you don't." } },
{ 0x303B, { "\x05\x41Ganondorf:\x05\x40\x01""Hold on, Darunia.", "\x05\x41Ganondorf:\x05\x40\x01""I'm not leaving you here. Not yet." } },
{ 0x303C, { "\x05\x41Ganondorf:\x05\x40\x01""I did. It's dead.", "\x05\x41Ganondorf:\x05\x40\x01""It hurts you to say it. I can tell. It means more that way." } },
{ 0x303E, { "\x05\x41Ganondorf:\x05\x40\x01""Friendship.", "\x05\x41Ganondorf:\x05\x40\x01""Even my heart. Hm. Don't hold your breath." } },
{ 0x303F, { "\x05\x41Ganondorf:\x05\x40\x01""We'll see which.", "\x05\x41Ganondorf:\x05\x40\x01""Either way, Darunia." } },
{ 0x3041, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. Together.", "" } },
{ 0x3042, { "\x05\x41Ganondorf:\x05\x40\x01""Good like your dad. Smart kid.", "\x05\x41Ganondorf:\x05\x40\x01""Your dad's a good man. Better than me. Listen to him." } },
{ 0x3043, { "\x05\x41Ganondorf:\x05\x40\x01""Hard to say. I know.", "\x05\x41Ganondorf:\x05\x40\x01""It gets easier. Or so I'm told." } },
{ 0x3044, { "\x05\x41Ganondorf:\x05\x40\x01""I won't. Probably.", "" } },
{ 0x3045, { "\x05\x41Ganondorf:\x05\x40\x01""Destiny. Ha.", "\x05\x41Ganondorf:\x05\x40\x01""Funny's one word for it, Darunia." } },
{ 0x3046, { "\x05\x41Ganondorf:\x05\x40\x01""Your trust. Heavy thing.", "\x05\x41Ganondorf:\x05\x40\x01""I'll try not to waste it. No promises." } },
{ 0x3047, { "\x05\x41Ganondorf:\x05\x40\x01""Even me. Good business sense.", "" } },
{ 0x3048, { "\x05\x41Ganondorf:\x05\x40\x01""An incredible story.", "\x05\x41Ganondorf:\x05\x40\x01""The Dodongos, the boulder. Funny how it all happened. Isn't it." } },
{ 0x3049, { "\x05\x41Ganondorf:\x05\x40\x01""Tight fit indeed.", "\x05\x41Ganondorf:\x05\x40\x01""Breathe in. I'm not moving." } },
{ 0x304A, { "\x05\x41Ganondorf:\x05\x40\x01""A while. Fine.", "" } },
{ 0x304B, { "\x05\x41Ganondorf:\x05\x40\x01""Five or six years.", "\x05\x41Ganondorf:\x05\x40\x01""I'll try. Can't promise anything about the conquering." } },
{ 0x304C, { "\x05\x41Ganondorf:\x05\x40\x01""A weapon. Show me.", "" } },
{ 0x304D, { "\x05\x41Ganondorf:\x05\x40\x01""It's light. I like it.", "\x05\x41Ganondorf:\x05\x40\x01""Sharp. Light. I'll keep it." } },
{ 0x304E, { "\x05\x41Ganondorf:\x05\x40\x01""Durability problems. Of course.", "" } },
{ 0x3050, { "\x05\x41Ganondorf:\x05\x40\x01""I will.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be back." } },
{ 0x3051, { "\x05\x41Ganondorf:\x05\x40\x01""I'm not going to eat you.", "\x05\x41Ganondorf:\x05\x40\x01""Stomach ache. I'll take your word for it." } },
{ 0x3052, { "\x05\x41Ganondorf:\x05\x40\x01""Desperate, yes.", "\x05\x41Ganondorf:\x05\x40\x01""I'll help him. Don't make it awkward." } },
{ 0x3053, { "\x05\x41Ganondorf:\x05\x40\x01""Your brother's store.", "\x05\x41Ganondorf:\x05\x40\x01""Hylian craftsmanship. Interesting. Show me." } },
{ 0x3054, { "\x05\x41Ganondorf:\x05\x40\x01""Itchy eyes. Bad luck.", "" } },
{ 0x3056, { "\x05\x41Ganondorf:\x05\x40\x01""You're not finished.", "\x05\x41Ganondorf:\x05\x40\x01""I'll get you some drops. Sit still." } },
{ 0x3058, { "\x05\x41Ganondorf:\x05\x40\x01""Politely. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""I'll say hello. Politely is a stretch." } },
{ 0x305A, { "\x05\x41Ganondorf:\x05\x40\x01""Working great. Good.", "" } },
{ 0x305C, { "\x05\x41Ganondorf:\x05\x40\x01""Even a king can wait.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. A few days." } },
{ 0x305D, { "\x05\x41Ganondorf:\x05\x40\x01""Impatient. Like all tyrants.", "\x05\x41Ganondorf:\x05\x40\x01""I've waited longer for less." } },
{ 0x305E, { "\x05\x41Ganondorf:\x05\x40\x01""Your finest. I can see that.", "\x05\x41Ganondorf:\x05\x40\x01""I'll use it wisely. For me, anyway." } },
{ 0x3062, { "\x05\x41Ganondorf:\x05\x40\x01""The summit. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Clouds reflect the mountain's moods. Fitting." } },
{ 0x3063, { "\x05\x41Ganondorf:\x05\x40\x01""You won't call me a hero. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""Wise owl. Keep it that way." } },
{ 0x3064, { "\x05\x41Ganondorf:\x05\x40\x01""She won't want to see me.", "\x05\x41Ganondorf:\x05\x40\x01""She'll see me anyway." } },
{ 0x3065, { "\x05\x41Ganondorf:\x05\x40\x01""A big shield. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""I'm my own shield." } },
{ 0x3067, { "\x05\x41Ganondorf:\x05\x40\x01""One lick. No.", "\x05\x41Ganondorf:\x05\x40\x01""Worst, am I? You haven't seen me trying." } },
{ 0x3068, { "\x05\x41Ganondorf:\x05\x40\x01""On monsters. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""I'll see her. Whatever she thinks of me." } },
{ 0x3069, { "\x05\x41Ganondorf:\x05\x40\x01""Even if I caged you. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""Doors that fall. Noted. Thanks." } },
{ 0x306A, { "\x05\x41Ganondorf:\x05\x40\x01""Roll forward. Noted.", "\x05\x41Ganondorf:\x05\x40\x01""Fire doesn't bother me much." } },
{ 0x306B, { "\x05\x41Ganondorf:\x05\x40\x01""Dancing creatures.", "\x05\x41Ganondorf:\x05\x40\x01""I'll manage without arrows." } },
{ 0x306C, { "\x05\x41Ganondorf:\x05\x40\x01""Cut the switches.", "\x05\x41Ganondorf:\x05\x40\x01""Or blow them up. My kind of answer." } },
{ 0x306D, { "\x05\x41Ganondorf:\x05\x40\x01""Play the Ocarina. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""The Ocarina. I'll try it." } },
{ 0x306E, { "\x05\x41Ganondorf:\x05\x40\x01""The pillar in the ceiling.", "\x05\x41Ganondorf:\x05\x40\x01""I'll handle it." } },
{ 0x306F, { "\x05\x41Ganondorf:\x05\x40\x01""A door in the statue.", "\x05\x41Ganondorf:\x05\x40\x01""Hidden in the statue. Clever." } },
{ 0x3070, { "\x05\x41Ganondorf:\x05\x40\x01""Different sound. Thanks.", "\x05\x41Ganondorf:\x05\x40\x01""I'll knock on every wall in the place." } },
