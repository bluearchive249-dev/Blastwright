{ 0x402D, { "\x05\x41Ganondorf:\x05\x40\x01""We don't understand either.", "\x05\x41Ganondorf:\x05\x40\x01""Neither do I." } },
{ 0x402E, { "\x05\x41Ganondorf:\x05\x40\x01""Funny timing. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""I'm a funny man." } },
{ 0x402F, { "\x05\x41Ganondorf:\x05\x40\x01""A real king. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""He's got a princess and a fish. I'll give him that." } },
{ 0x4030, { "\x05\x41Ganondorf:\x05\x40\x01""Run fast. Got it.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be fast. Even in armor." } },
{ 0x4031, { "\x05\x41Ganondorf:\x05\x40\x01""Bigger and stronger. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""The Zoras serve the Royal Family. Not for long." } },
{ 0x4032, { "\x05\x41Ganondorf:\x05\x40\x01""Something I didn't steal.", "\x05\x41Ganondorf:\x05\x40\x01""That'll take some looking." } },
{ 0x4033, { "\x05\x41Ganondorf:\x05\x40\x01""Probably not to me. Ha.", "\x05\x41Ganondorf:\x05\x40\x01""We'll see." } },
{ 0x4036, { "\x05\x41Ganondorf:\x05\x40\x01""We meet again.", "\x05\x41Ganondorf:\x05\x40\x01""Hello, owl. Or whoever you are." } },
{ 0x4037, { "\x05\x41Ganondorf:\x05\x40\x01""Shut off the source. Right.", "\x05\x41Ganondorf:\x05\x40\x01""I'll go in. I know the way." } },
{ 0x4038, { "\x05\x41Ganondorf:\x05\x40\x01""Noble ambition or tyranny.", "\x05\x41Ganondorf:\x05\x40\x01""Hard to tell the two apart from the inside. Trust me." } },
