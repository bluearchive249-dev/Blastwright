{ 0x4049, { "\x05\x41Ganondorf:\x05\x40\x01""Can't hide anything. Hm.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. I'm looking for her. Don't ask me why." } },
{ 0x404A, { "\x05\x41Ganondorf:\x05\x40\x01""Respectfully. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""Justice and peace. I'll let you keep praying." } },
{ 0x404B, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. A Gerudo. In here.", "\x05\x41Ganondorf:\x05\x40\x01""Your father asked. Don't thank me yet." } },
{ 0x404F, { "\x05\x41Ganondorf:\x05\x40\x01""Big lug. Right.", "\x05\x41Ganondorf:\x05\x40\x01""Up you go. Hold still." } },
{ 0x4051, { "\x05\x41Ganondorf:\x05\x40\x01""Your mother's stone.", "\x05\x41Ganondorf:\x05\x40\x01""It's yours. Hold on to it this time." } },
{ 0x4052, { "\x05\x41Ganondorf:\x05\x40\x01""Carry you. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Hold on. Don't kick." } },
