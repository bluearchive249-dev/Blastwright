{ 0x402A, { "\x05\x41Ganondorf:\x05\x40\x01""Too expensive. Hm.", "\x05\x41Ganondorf:\x05\x40\x01""Catch one, then. I did." } },
{ 0x402B, { "\x05\x41Ganondorf:\x05\x40\x01""Don't let it go to my head.", "\x05\x41Ganondorf:\x05\x40\x01""Too late. It's a big head." } },
