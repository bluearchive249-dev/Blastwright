{ 0x400A, { "\x05\x41Ganondorf:\x05\x40\x01""Never me. Noted.", "\x05\x41Ganondorf:\x05\x40\x01""You'll serve someone else soon enough." } },
{ 0x400B, { "\x05\x41Ganondorf:\x05\x40\x01""The Royal Chamber. Right.", "\x05\x41Ganondorf:\x05\x40\x01""I know the way." } },
{ 0x400D, { "\x05\x41Ganondorf:\x05\x40\x01""Happy. Even me.", "\x05\x41Ganondorf:\x05\x40\x01""I'll try a fish. Couldn't hurt." } },
{ 0x400E, { "\x05\x41Ganondorf:\x05\x40\x01""Not good? Hm.", "\x05\x41Ganondorf:\x05\x40\x01""I'll see him. Once was enough last time." } },
{ 0x400F, { "\x05\x41Ganondorf:\x05\x40\x01""Lake Hylia. You searched hard.", "\x05\x41Ganondorf:\x05\x40\x01""She'll turn up. Princesses usually do." } },
{ 0x4010, { "\x05\x41Ganondorf:\x05\x40\x01""And if I've harmed her...", "\x05\x41Ganondorf:\x05\x40\x01""I haven't. Keep your threats for someone who'll care." } },
