{ 0x4095, { "\x05\x41Ganondorf:\x05\x40\x01""Nerves, he says.", "" } },
{ 0x4096, { "\x05\x41Ganondorf:\x05\x40\x01""Cloudy water.", "" } },
{ 0x409D, { "\x05\x41Ganondorf:\x05\x40\x01""Walk quietly. I'll try.", "" } },
