// SoH: "Play as Ganondorf", his own lines in each conversation (GanondorfNpcs.cpp): a lead-in before their line, and
// his answer after it where the line ends the talk. Written for that NPC and that line, in the voice of a king:
// measured, proud, his threats spoken as decrees. Generated from plain lines, wrapped to the box under his name.
// Kokiri Forest, the Lost Woods and the Deku Tree
{ 0x1001, { "\x05\x41Ganondorf:\x05\x40\x01""So this is the one the forest\x01""sings of. Lift your eyes, girl.\x01""A king has crossed your\x04\x05\x41Ganondorf:\x05\x40\x01""threshold.", "\x05\x41Ganondorf:\x05\x40\x01""Greater in stature and in\x01""purpose both. Mark the\x01""difference well, for all Hyrule\x04\x05\x41Ganondorf:\x05\x40\x01""shall learn it." } },
{ 0x1003, { "\x05\x41Ganondorf:\x05\x40\x01""Faithful still. I have known\x01""captains with less constancy\x01""than you, child of the wood.", "\x05\x41Ganondorf:\x05\x40\x01""I shall show your guardian the\x01""courtesy one sovereign owes\x01""another at the end of his\x04\x05\x41Ganondorf:\x05\x40\x01""reign." } },
{ 0x1006, { "\x05\x41Ganondorf:\x05\x40\x01""Ask your question, small one. A\x01""king does not begrudge an\x01""answer to the curious.", "\x05\x41Ganondorf:\x05\x40\x01""No tree gave me breath. The\x01""desert bore me, and the desert\x01""gives nothing it does not mean\x04\x05\x41Ganondorf:\x05\x40\x01""to take back." } },
{ 0x1008, { "\x05\x41Ganondorf:\x05\x40\x01""You would bar the road to me. I\x01""have seen gates of iron attempt\x01""the same.", "" } },
{ 0x1009, { "\x05\x41Ganondorf:\x05\x40\x01""There is terror in you of what\x01""lies past the trees. Speak of\x01""it.", "\x05\x41Ganondorf:\x05\x40\x01""Death waits beyond the wood for\x01""your kind. For mine it waited\x01""within the sand, and I did not\x04\x05\x41Ganondorf:\x05\x40\x01""kneel to it." } },
{ 0x100A, { "\x05\x41Ganondorf:\x05\x40\x01""Toil sits heavily on one so\x01""small. Who lays such burdens on\x01""you?", "" } },
{ 0x100B, { "\x05\x41Ganondorf:\x05\x40\x01""You come to me as a petitioner.\x01""Name your suit.", "\x05\x41Ganondorf:\x05\x40\x01""I have reaped kingdoms, child.\x01""I do not reap grass. Yet I\x01""shall forget the asking." } },
{ 0x100F, { "\x05\x41Ganondorf:\x05\x40\x01""Tidings shine in your face.\x01""Deliver them.", "" } },
{ 0x1010, { "\x05\x41Ganondorf:\x05\x40\x01""The leaves carry word swiftly.\x01""What have they told you of me?", "" } },
{ 0x1011, { "\x05\x41Ganondorf:\x05\x40\x01""She keeps her vigil upon the\x01""bridge, as if a parting could\x01""be forbidden.", "\x05\x41Ganondorf:\x05\x40\x01""I depart a wood to claim a\x01""world. Do not weep at so fair\x01""an exchange." } },
{ 0x1012, { "\x05\x41Ganondorf:\x05\x40\x01""Speak, girl. There is something\x01""you would have me swear.", "\x05\x41Ganondorf:\x05\x40\x01""Friendship is a coin I have\x01""never minted. Yet keep yours.\x01""It may buy you mercy when the\x04\x05\x41Ganondorf:\x05\x40\x01""hour comes." } },
{ 0x1013, { "\x05\x41Ganondorf:\x05\x40\x01""You offer tribute. The first\x01""freely given me in all this\x01""green country.", "\x05\x41Ganondorf:\x05\x40\x01""A small thing, to hold the keys\x01""of doors that armies could not\x01""force. I accept it." } },
{ 0x1014, { "\x05\x41Ganondorf:\x05\x40\x01""There is more upon your heart.\x01""Unburden it; the hour is mine\x01""to spend.", "\x05\x41Ganondorf:\x05\x40\x01""I shall return, as kings\x01""return: with banners. Pray the\x01""forest learns to love their\x04\x05\x41Ganondorf:\x05\x40\x01""shadow." } },
{ 0x1019, { "\x05\x41Ganondorf:\x05\x40\x01""You would counsel me in arms.\x01""Proceed; I am not too proud to\x01""be amused.", "\x05\x41Ganondorf:\x05\x40\x01""I was schooled in war by the\x01""waste itself, where the pupils\x01""who fail are buried by the\x04\x05\x41Ganondorf:\x05\x40\x01""wind." } },
{ 0x101B, { "\x05\x41Ganondorf:\x05\x40\x01""Your gaze lingers upon the\x01""mask, and upon what it fails to\x01""hide.", "\x05\x41Ganondorf:\x05\x40\x01""Let them whisper. A name spoken\x01""low in fear is nearer to a\x01""prayer than they know." } },
{ 0x101D, { "\x05\x41Ganondorf:\x05\x40\x01""Fortune has turned her face\x01""from you, little one.", "\x05\x41Ganondorf:\x05\x40\x01""So she turns from all who wait\x01""upon her. I learned long ago to\x01""take her by the throat." } },
{ 0x101E, { "\x05\x41Ganondorf:\x05\x40\x01""You wear your prize as a victor\x01""wears his laurel.", "\x05\x41Ganondorf:\x05\x40\x01""Then you have grasped in a\x01""morning what your elders never\x01""shall: to be feared is to be\x04\x05\x41Ganondorf:\x05\x40\x01""safe." } },
{ 0x101F, { "\x05\x41Ganondorf:\x05\x40\x01""I see reproof gathering in you.\x01""Weigh it before you spend it.", "" } },
{ 0x1020, { "\x05\x41Ganondorf:\x05\x40\x01""Your fellows covet what is\x01""mine. That is the beginning of\x01""ambition.", "\x05\x41Ganondorf:\x05\x40\x01""Let them come and beg it of me.\x01""I would see which among them\x01""has the stomach." } },
{ 0x1021, { "\x05\x41Ganondorf:\x05\x40\x01""You had thought me gone, and\x01""built some small hope upon it.", "\x05\x41Ganondorf:\x05\x40\x01""I depart when my purpose is\x01""served, and not one hour\x01""before. Grieve at your leisure." } },
{ 0x1023, { "\x05\x41Ganondorf:\x05\x40\x01""You bear a message. Kings are\x01""accustomed to messengers; say\x01""on.", "\x05\x41Ganondorf:\x05\x40\x01""One who does not fear me. I\x01""shall see with my own eyes\x01""whether that is courage, or\x04\x05\x41Ganondorf:\x05\x40\x01""only innocence." } },
{ 0x1024, { "\x05\x41Ganondorf:\x05\x40\x01""You have yet breath to bestow\x01""on me, ancient one. Spend it\x01""with care.", "\x05\x41Ganondorf:\x05\x40\x01""Keep your blessing. I came for\x01""the stone, and I do not leave a\x01""throne room empty-handed." } },
{ 0x1026, { "\x05\x41Ganondorf:\x05\x40\x01""There is a weariness in your\x01""boughs that was not there when\x01""first I came.", "\x05\x41Ganondorf:\x05\x40\x01""It is so. I laid the curse with\x01""my own hand, and I do not\x01""disown my works." } },
{ 0x1027, { "\x05\x41Ganondorf:\x05\x40\x01""Tell your tale, guardian. I\x01""would hear how the dying\x01""remember me.", "\x05\x41Ganondorf:\x05\x40\x01""A wicked man of the desert. So\x01""the conquered ever name the one\x01""who would not stay conquered." } },
{ 0x1028, { "\x05\x41Ganondorf:\x05\x40\x01""You know where she keeps her\x01""court. Disclose it.", "\x05\x41Ganondorf:\x05\x40\x01""Then I shall climb, and the\x01""wood that swallows wanderers\x01""will learn it has swallowed a\x04\x05\x41Ganondorf:\x05\x40\x01""king." } },
{ 0x1029, { "\x05\x41Ganondorf:\x05\x40\x01""A dying sovereign gives his\x01""last decree. I attend it.", "\x05\x41Ganondorf:\x05\x40\x01""You charge me to guard the\x01""Triforce from myself. The\x01""goddesses made that same jest\x04\x05\x41Ganondorf:\x05\x40\x01""when they hid it from my\x01""people." } },
{ 0x102B, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite presumes to counsel\x01""me. Say on, small light.", "\x05\x41Ganondorf:\x05\x40\x01""Evil is the name the\x01""comfortable give to hunger. I\x01""go to the castle to end a\x04\x05\x41Ganondorf:\x05\x40\x01""famine of a thousand years." } },
{ 0x102D, { "\x05\x41Ganondorf:\x05\x40\x01""You are merry at my expense.\x01""Few have afforded the luxury.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh, then. I keep a ledger of\x01""such things, and I am patient\x01""in the collecting." } },
{ 0x102F, { "\x05\x41Ganondorf:\x05\x40\x01""You stand athwart my road, boy,\x01""and you raise your voice. Have\x01""a care.", "" } },
{ 0x1030, { "\x05\x41Ganondorf:\x05\x40\x01""You recite your little statutes\x01""to me as though they bound me.", "\x05\x41Ganondorf:\x05\x40\x01""Law is but the breath of him\x01""who sits the throne. In time\x01""you will be reciting mine." } },
{ 0x1031, { "\x05\x41Ganondorf:\x05\x40\x01""What has your small chieftain\x01""dared, that you tremble to tell\x01""it?", "" } },
{ 0x1032, { "\x05\x41Ganondorf:\x05\x40\x01""Counsel, from a child,\x01""concerning arms.", "\x05\x41Ganondorf:\x05\x40\x01""The blade I bear was forged for\x01""the breaking of dynasties. Keep\x01""your trinkets for your games." } },
{ 0x1033, { "\x05\x41Ganondorf:\x05\x40\x01""Still you hold the pass, Mido.\x01""I have razed forts with weaker\x01""hearts in them.", "" } },
{ 0x1034, { "\x05\x41Ganondorf:\x05\x40\x01""Declaim, small lord. I have\x01""endured the speeches of kings;\x01""I can endure yours.", "\x05\x41Ganondorf:\x05\x40\x01""I am friend to no one, boy. I\x01""am the end toward which this\x01""age is bent, and she, too, will\x04\x05\x41Ganondorf:\x05\x40\x01""learn it." } },
{ 0x103C, { "\x05\x41Ganondorf:\x05\x40\x01""Some secret presses to be told.\x01""Out with it; I am a patient\x01""confessor.", "\x05\x41Ganondorf:\x05\x40\x01""Count your green coins, child.\x01""I have come for a treasure that\x01""cannot be counted." } },
{ 0x1040, { "\x05\x41Ganondorf:\x05\x40\x01""You were instructing me, small\x01""one. Continue.", "\x05\x41Ganondorf:\x05\x40\x01""I do not play at things. I\x01""learn them, and then they are\x01""mine." } },
{ 0x1041, { "\x05\x41Ganondorf:\x05\x40\x01""The measure displeases you.", "\x05\x41Ganondorf:\x05\x40\x01""Then I shall play it until the\x01""wood itself forgets how it once\x01""went." } },
{ 0x1042, { "\x05\x41Ganondorf:\x05\x40\x01""You come as herald for another.\x01""Deliver your charge.", "\x05\x41Ganondorf:\x05\x40\x01""I did nothing to him but stand\x01""in his sight. For some, that\x01""suffices." } },
{ 0x1043, { "\x05\x41Ganondorf:\x05\x40\x01""Why do you stare so, as at a\x01""storm upon the horizon?", "\x05\x41Ganondorf:\x05\x40\x01""You have guessed in jest what\x01""princes failed to guess in\x01""council. Yes, child. I go to\x04\x05\x41Ganondorf:\x05\x40\x01""take it." } },
{ 0x1044, { "\x05\x41Ganondorf:\x05\x40\x01""Dread rides you harder than is\x01""your custom.", "\x05\x41Ganondorf:\x05\x40\x01""Then abide, and be eternal and\x01""small. The wide world is\x01""promised elsewhere." } },
{ 0x1046, { "\x05\x41Ganondorf:\x05\x40\x01""A low door and a loud master. I\x01""have stooped to enter worse\x01""halls.", "\x05\x41Ganondorf:\x05\x40\x01""Wherever I stand, I hold court.\x01""Be content that this court is\x01""brief." } },
{ 0x1047, { "\x05\x41Ganondorf:\x05\x40\x01""The girl again, and gladness in\x01""her, as though I were one to be\x01""glad of.", "" } },
{ 0x1048, { "\x05\x41Ganondorf:\x05\x40\x01""You have a proclamation, little\x01""one. Proclaim it.", "\x05\x41Ganondorf:\x05\x40\x01""She has chosen her ally as the\x01""lamb chooses the mountain's\x01""shade, not knowing what dwells\x04\x05\x41Ganondorf:\x05\x40\x01""upon the mountain." } },
{ 0x1049, { "\x05\x41Ganondorf:\x05\x40\x01""Trouble is written upon your\x01""brow. Read it to me.", "\x05\x41Ganondorf:\x05\x40\x01""All that grows must fall. I but\x01""appointed the season." } },
{ 0x104A, { "\x05\x41Ganondorf:\x05\x40\x01""You taste it too. The very air\x01""has changed its allegiance.", "\x05\x41Ganondorf:\x05\x40\x01""Sand and burning. It is the\x01""breath of my homeland, come at\x01""last to visit yours." } },
{ 0x104B, { "\x05\x41Ganondorf:\x05\x40\x01""You watch my going as the\x01""watchman watches a fire burn\x01""low.", "\x05\x41Ganondorf:\x05\x40\x01""Take your ease. But know that\x01""such fires as I do not go out;\x01""they travel." } },
{ 0x104C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of my return as one\x01""speaks of winter.", "\x05\x41Ganondorf:\x05\x40\x01""Whether I come in wrath or in\x01""triumph, child, will be for\x01""Hyrule to decide, not you." } },
{ 0x104E, { "\x05\x41Ganondorf:\x05\x40\x01""You look behind you oft, as the\x01""hunted do.", "\x05\x41Ganondorf:\x05\x40\x01""When a guardian falls, the\x01""wolves grow bold. I knew it\x01""would be so. I counted upon it." } },
{ 0x104F, { "\x05\x41Ganondorf:\x05\x40\x01""The wind has turned, child, and\x01""you have felt it turn.", "" } },
{ 0x1050, { "\x05\x41Ganondorf:\x05\x40\x01""You know where the temple\x01""stands. Speak it plainly.", "\x05\x41Ganondorf:\x05\x40\x01""Beyond the wood that devours\x01""the lost. A fit place; I have\x01""set a shadow of myself to keep\x04\x05\x41Ganondorf:\x05\x40\x01""it." } },
{ 0x1051, { "\x05\x41Ganondorf:\x05\x40\x01""There is accusation in your\x01""eyes. Give it a tongue, if you\x01""dare.", "\x05\x41Ganondorf:\x05\x40\x01""I have never sued for pardon,\x01""child, of gods or of men. I\x01""shall not begin with you." } },
{ 0x1052, { "\x05\x41Ganondorf:\x05\x40\x01""Be still, little merchant. I\x01""have not come for you.", "\x05\x41Ganondorf:\x05\x40\x01""I bear no shield, child. A\x01""shield is the confession of a\x01""man who expects to be struck." } },
{ 0x1053, { "\x05\x41Ganondorf:\x05\x40\x01""You seek one who is gone. I\x01""know that look; I have caused\x01""it often.", "" } },
{ 0x1054, { "\x05\x41Ganondorf:\x05\x40\x01""You search for your chieftain\x01""in the hour of need.", "\x05\x41Ganondorf:\x05\x40\x01""He has hidden. It is the first\x01""act of his I can call wise." } },
{ 0x1055, { "\x05\x41Ganondorf:\x05\x40\x01""You marked my coming. I am\x01""accustomed to being watched.", "" } },
{ 0x1056, { "\x05\x41Ganondorf:\x05\x40\x01""You keep to your walls. So did\x01""the lords of many a city that\x01""is now a name.", "\x05\x41Ganondorf:\x05\x40\x01""No door has yet been made that\x01""is proof against tedium, child.\x01""Nor against me." } },
{ 0x1057, { "\x05\x41Ganondorf:\x05\x40\x01""You would speak to me of bows\x01""and of arrows.", "\x05\x41Ganondorf:\x05\x40\x01""My people are born to the bow.\x01""But I have no need to strike\x01""from afar what I may break in\x04\x05\x41Ganondorf:\x05\x40\x01""my hand." } },
{ 0x1058, { "\x05\x41Ganondorf:\x05\x40\x01""You put one question to every\x01""stranger. Put it, then, to me.", "" } },
{ 0x1059, { "\x05\x41Ganondorf:\x05\x40\x01""Doubt gnaws you. It is the\x01""first honest counsellor you\x01""have had.", "\x05\x41Ganondorf:\x05\x40\x01""Your chieftain spoke truer than\x01""he knew. Let it console him; he\x01""will not be right again." } },
{ 0x105A, { "\x05\x41Ganondorf:\x05\x40\x01""You have seen my face before,\x01""you think.", "\x05\x41Ganondorf:\x05\x40\x01""In dreams. Yes. I have walked\x01""there before my feet ever\x01""touched your soil." } },
{ 0x105B, { "\x05\x41Ganondorf:\x05\x40\x01""Another who mourns the boy that\x01""went away.", "" } },
{ 0x105C, { "\x05\x41Ganondorf:\x05\x40\x01""Still you keep watch for him.", "\x05\x41Ganondorf:\x05\x40\x01""Should he come again, pray he\x01""has grown to be as I am.\x01""Nothing less will serve him\x04\x05\x41Ganondorf:\x05\x40\x01""against me." } },
{ 0x105D, { "\x05\x41Ganondorf:\x05\x40\x01""You look upon me as upon a\x01""mountain. It is well; I mean to\x01""be seen so.", "" } },
{ 0x105E, { "\x05\x41Ganondorf:\x05\x40\x01""Never to age. They have told\x01""you it is a gift.", "\x05\x41Ganondorf:\x05\x40\x01""To be a child for ever is to be\x01""for ever ruled. I would sooner\x01""burn in one day than endure so\x04\x05\x41Ganondorf:\x05\x40\x01""through all the ages." } },
{ 0x1060, { "\x05\x41Ganondorf:\x05\x40\x01""You claim to see what I am.\x01""Look longer, boy.", "" } },
{ 0x1061, { "\x05\x41Ganondorf:\x05\x40\x01""Yet you keep her road. Devotion\x01""I can honour, even in a foe so\x01""small.", "\x05\x41Ganondorf:\x05\x40\x01""Me least of all. At last this\x01""forest has spoken one true\x01""word." } },
{ 0x1062, { "\x05\x41Ganondorf:\x05\x40\x01""So this seedling is the heir.\x01""Great houses do dwindle.", "\x05\x41Ganondorf:\x05\x40\x01""Grow swiftly, little root. Your\x01""father stood ten thousand\x01""years, and fell to me between\x04\x05\x41Ganondorf:\x05\x40\x01""one dawn and the next." } },
{ 0x1063, { "\x05\x41Ganondorf:\x05\x40\x01""You speak as one who knows me,\x01""sapling.", "\x05\x41Ganondorf:\x05\x40\x01""They do not grow, and I do not\x01""forget. Each of us bears his\x01""own curse." } },
{ 0x1064, { "\x05\x41Ganondorf:\x05\x40\x01""A revelation, and offered so\x01""solemnly.", "\x05\x41Ganondorf:\x05\x40\x01""No child of the wood, I. That\x01""truth was plain the hour I\x01""first cast a shadow here." } },
{ 0x1066, { "\x05\x41Ganondorf:\x05\x40\x01""You prate of destiny, who have\x01""had but a season of life.", "\x05\x41Ganondorf:\x05\x40\x01""I know mine. It is not given; I\x01""am seizing it, and its road\x01""lies across your roots." } },
{ 0x1067, { "\x05\x41Ganondorf:\x05\x40\x01""That air is known to you. I\x01""read it in your face.", "" } },
{ 0x1068, { "\x05\x41Ganondorf:\x05\x40\x01""Your eyes go past me, to some\x01""other you remember.", "\x05\x41Ganondorf:\x05\x40\x01""Whoever he was, his silence was\x01""the wiser part. He should have\x01""kept it." } },
{ 0x1069, { "\x05\x41Ganondorf:\x05\x40\x01""My own shade lifts its hand\x01""against the hand that shaped\x01""it.", "\x05\x41Ganondorf:\x05\x40\x01""I wrought you from my shadow,\x01""phantom, and to shadow I return\x01""you. No creature of mine shall\x04\x05\x41Ganondorf:\x05\x40\x01""name itself my master." } },
{ 0x106A, { "\x05\x41Ganondorf:\x05\x40\x01""The girl wakes, and is a girl\x01""no longer.", "\x05\x41Ganondorf:\x05\x40\x01""A Sage. You will find it a cold\x01""throne, and a long watch, and\x01""no thanks at the end of it." } },
{ 0x106C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of time as of a river\x01""that carries all alike.", "\x05\x41Ganondorf:\x05\x40\x01""It is cruel; it kneels to no\x01""crown. Yet I have made treaty\x01""with harder things than time." } },
{ 0x106D, { "\x05\x41Ganondorf:\x05\x40\x01""Already you grow faint, as\x01""stars do at morning.", "\x05\x41Ganondorf:\x05\x40\x01""Goodness is the virtue of those\x01""who cannot rule. I shall be\x01""king, and let the chronicles\x04\x05\x41Ganondorf:\x05\x40\x01""choose the word." } },
{ 0x106E, { "\x05\x41Ganondorf:\x05\x40\x01""Still you attend her coming.", "\x05\x41Ganondorf:\x05\x40\x01""Hold fast to that suspicion,\x01""boy. It is the nearest you have\x01""come to wisdom." } },
{ 0x106F, { "\x05\x41Ganondorf:\x05\x40\x01""You have reached your verdict\x01""upon me.", "" } },
{ 0x1070, { "\x05\x41Ganondorf:\x05\x40\x01""Your countenance is fallen,\x01""small lord.", "" } },
{ 0x1071, { "\x05\x41Ganondorf:\x05\x40\x01""You would make me your\x01""messenger. Me.", "" } },
{ 0x1073, { "\x05\x41Ganondorf:\x05\x40\x01""Again you search my face for\x01""another's.", "\x05\x41Ganondorf:\x05\x40\x01""One whom none would play with.\x01""Then he had the better part;\x01""solitude is the school of\x04\x05\x41Ganondorf:\x05\x40\x01""kings." } },
{ 0x1074, { "\x05\x41Ganondorf:\x05\x40\x01""You would be as I am. Consider\x01""what you ask.", "\x05\x41Ganondorf:\x05\x40\x01""There is no taking the strength\x01""and leaving the rest, child.\x01""They are one metal." } },
{ 0x1075, { "\x05\x41Ganondorf:\x05\x40\x01""Still at your post, small\x01""sentinel.", "\x05\x41Ganondorf:\x05\x40\x01""He will return. They ever do.\x01""And I am ever waiting." } },
{ 0x1076, { "\x05\x41Ganondorf:\x05\x40\x01""Some old knowledge of me stirs\x01""in you.", "\x05\x41Ganondorf:\x05\x40\x01""Heed the second instinct,\x01""child. It is the truer." } },
{ 0x1077, { "\x05\x41Ganondorf:\x05\x40\x01""The wood wears a gentler face,\x01""I see.", "\x05\x41Ganondorf:\x05\x40\x01""Take joy of your peace. It is\x01""to such peace as this that I am\x01""sent as an ending." } },
{ 0x1078, { "\x05\x41Ganondorf:\x05\x40\x01""Bold words, and a little army\x01""to speak them.", "\x05\x41Ganondorf:\x05\x40\x01""Then stand to your defence. I\x01""should think the less of a\x01""realm that did not." } },
{ 0x1079, { "\x05\x41Ganondorf:\x05\x40\x01""A fair wind, you say.", "\x05\x41Ganondorf:\x05\x40\x01""Winds are fair or foul as I\x01""ordain. This one I have merely\x01""not yet turned." } },
{ 0x107A, { "\x05\x41Ganondorf:\x05\x40\x01""You scent hope upon the air.", "\x05\x41Ganondorf:\x05\x40\x01""Hope is the last thing I take\x01""from a land. I am in no haste;\x01""it sweetens the taking." } },
{ 0x107B, { "\x05\x41Ganondorf:\x05\x40\x01""Sighs, in one who cannot grow\x01""old.", "\x05\x41Ganondorf:\x05\x40\x01""She keeps a temple now, and\x01""temples keep their own. Wonder\x01""as you will." } },
{ 0x107C, { "\x05\x41Ganondorf:\x05\x40\x01""Such faith, and bestowed upon a\x01""boy.", "\x05\x41Ganondorf:\x05\x40\x01""Let him come. I shall keep a\x01""welcome for him, and it will be\x01""warm." } },
{ 0x107D, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite returns to a throne\x01""without a king, and brings the\x01""usurper with her.", "\x05\x41Ganondorf:\x05\x40\x01""The man who slew you. I have\x01""borne heavier titles, and worn\x01""them lightly." } },
{ 0x107E, { "\x05\x41Ganondorf:\x05\x40\x01""The ancient one speaks of me\x01""yet.", "\x05\x41Ganondorf:\x05\x40\x01""Without ceasing. It is so. What\x01""I have begun, no hand in this\x01""world shall see left undone." } },
{ 0x108F, { "\x05\x41Ganondorf:\x05\x40\x01""You say you looked for my\x01""coming, Sage.", "\x05\x41Ganondorf:\x05\x40\x01""None knows me, girl. That is\x01""the secret of my ascent: men\x01""see the desert, and never the\x04\x05\x41Ganondorf:\x05\x40\x01""storm it sends." } },
{ 0x1090, { "\x05\x41Ganondorf:\x05\x40\x01""You would keep watch on me from\x01""your sanctuary.", "\x05\x41Ganondorf:\x05\x40\x01""Watch, then. I have never\x01""wanted for witnesses, nor\x01""shrunk from them." } },
{ 0x1091, { "\x05\x41Ganondorf:\x05\x40\x01""You sit in judgment still, in\x01""your last hour.", "\x05\x41Ganondorf:\x05\x40\x01""Strength was the whole of my\x01""embassy. You yourself are the\x01""proof that it sufficed." } },
{ 0x1093, { "\x05\x41Ganondorf:\x05\x40\x01""You send me to the castle. I\x01""was bound there before your\x01""first leaf fell.", "\x05\x41Ganondorf:\x05\x40\x01""The Princess of Destiny. Yes.\x01""Her destiny and mine have an\x01""appointment, and I am never\x04\x05\x41Ganondorf:\x05\x40\x01""late." } },
{ 0x1094, { "\x05\x41Ganondorf:\x05\x40\x01""You knew this wood could not\x01""hold me.", "\x05\x41Ganondorf:\x05\x40\x01""Different. It is the gentlest\x01""word this country has ever\x01""spared me. I shall remember who\x04\x05\x41Ganondorf:\x05\x40\x01""spoke it." } },
{ 0x1097, { "\x05\x41Ganondorf:\x05\x40\x01""You vault and tumble like a\x01""court fool before a king.", "\x05\x41Ganondorf:\x05\x40\x01""I do not caper, child. When I\x01""leave the ground, cities look\x01""up." } },
{ 0x10A0, { "\x05\x41Ganondorf:\x05\x40\x01""A shrub that parleys. This\x01""forest does not lack for\x01""wonders.", "" } },
{ 0x10A1, { "\x05\x41Ganondorf:\x05\x40\x01""You yield with admirable speed.\x01""It is the beginning of\x01""statecraft.", "" } },
{ 0x10A2, { "\x05\x41Ganondorf:\x05\x40\x01""Another small merchant sues for\x01""terms.", "" } },
{ 0x10A4, { "\x05\x41Ganondorf:\x05\x40\x01""You quake, little thicket.", "\x05\x41Ganondorf:\x05\x40\x01""Flee. It is the oldest wisdom\x01""of small things, and I do not\x01""despise it." } },
{ 0x10A5, { "\x05\x41Ganondorf:\x05\x40\x01""You deny me, and for want of\x01""coin.", "\x05\x41Ganondorf:\x05\x40\x01""Kings pay in clemency, shrub.\x01""See that you do not exhaust my\x01""treasury." } },
{ 0x10A6, { "\x05\x41Ganondorf:\x05\x40\x01""You withhold your wares from\x01""me.", "\x05\x41Ganondorf:\x05\x40\x01""I am not wroth. I am patient;\x01""and of the two, my patience is\x01""the more to be feared." } },
{ 0x10A8, { "\x05\x41Ganondorf:\x05\x40\x01""So this is her court. A stump\x01""for a throne, and silence for a\x01""guard.", "" } },
{ 0x10AA, { "\x05\x41Ganondorf:\x05\x40\x01""You would be my tutor in music.\x01""Begin.", "\x05\x41Ganondorf:\x05\x40\x01""These hands have unseated\x01""kings. Let us learn whether\x01""they may yet be taught\x04\x05\x41Ganondorf:\x05\x40\x01""gentleness." } },
{ 0x10AB, { "\x05\x41Ganondorf:\x05\x40\x01""You grow impatient with a king.", "\x05\x41Ganondorf:\x05\x40\x01""You hasten one whom the\x01""centuries themselves have\x01""waited upon, child." } },
{ 0x10AC, { "\x05\x41Ganondorf:\x05\x40\x01""You are well pleased. I have\x01""done something to earn it, it\x01""seems.", "" } },
{ 0x10AD, { "\x05\x41Ganondorf:\x05\x40\x01""A song that bears your voice\x01""across the leagues.", "\x05\x41Ganondorf:\x05\x40\x01""Then the forest shall have no\x01""secret from me, wherever I hold\x01""my court. I thank you for the\x04\x05\x41Ganondorf:\x05\x40\x01""gift." } },
{ 0x10AE, { "\x05\x41Ganondorf:\x05\x40\x01""You ask after your gift, as a\x01""mother after a child sent\x01""abroad.", "\x05\x41Ganondorf:\x05\x40\x01""It is kept. I break nothing\x01""that has yet a use to me." } },
{ 0x10B0, { "\x05\x41Ganondorf:\x05\x40\x01""You know the hole wherein your\x01""chieftain sulks.", "\x05\x41Ganondorf:\x05\x40\x01""Skulking beneath a roof while\x01""his people wonder. So perish\x01""all petty thrones." } },
{ 0x10B4, { "\x05\x41Ganondorf:\x05\x40\x01""Understanding dawns in you at\x01""last.", "\x05\x41Ganondorf:\x05\x40\x01""No, child. I am not kind. I am\x01""necessary; it is a colder\x01""thing, and it endures." } },
{ 0x10B5, { "\x05\x41Ganondorf:\x05\x40\x01""You carry her word to me.", "\x05\x41Ganondorf:\x05\x40\x01""If she seeks me, let her find\x01""me. Many have, and wished the\x01""search had failed." } },
{ 0x10B6, { "\x05\x41Ganondorf:\x05\x40\x01""You set me errands, as if I\x01""were your page.", "\x05\x41Ganondorf:\x05\x40\x01""A crone's errand. Two such\x01""raised me. I know the breed,\x01""and I do not keep them waiting." } },
{ 0x10B7, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of those the wood has\x01""taken.", "" } },
{ 0x10B9, { "\x05\x41Ganondorf:\x05\x40\x01""My fate amuses you, masked one.", "\x05\x41Ganondorf:\x05\x40\x01""No. When I am bone I shall rule\x01""yet, and the worms will hold\x01""their office by my leave." } },
{ 0x10BB, { "\x05\x41Ganondorf:\x05\x40\x01""The air pleases you, little\x01""mask.", "\x05\x41Ganondorf:\x05\x40\x01""A king has subjects, not\x01""friends. Yet I receive your\x01""tribute." } },
{ 0x10BC, { "\x05\x41Ganondorf:\x05\x40\x01""You ask a king's opinion of\x01""your face.", "\x05\x41Ganondorf:\x05\x40\x01""Mine was graven by wind and by\x01""war. Be thankful that yours has\x01""known neither." } },
{ 0x10BD, { "\x05\x41Ganondorf:\x05\x40\x01""You love your games, imp.", "\x05\x41Ganondorf:\x05\x40\x01""I swear to nothing. Hence no\x01""man living can say that\x01""Ganondorf has broken faith." } },
{ 0x10BE, { "\x05\x41Ganondorf:\x05\x40\x01""The masked children would have\x01""music of me.", "\x05\x41Ganondorf:\x05\x40\x01""Lead on. I shall follow, as the\x01""tide follows, until it is time\x01""to cover all." } },
{ 0x10BF, { "\x05\x41Ganondorf:\x05\x40\x01""You were listening. All of you.", "\x05\x41Ganondorf:\x05\x40\x01""Let it be told in the wood that\x01""the conqueror keeps time as\x01""truly as he keeps his word." } },
{ 0x10C0, { "\x05\x41Ganondorf:\x05\x40\x01""The old watcher. Wherever I\x01""turn, there are your eyes.", "" } },
{ 0x10C3, { "\x05\x41Ganondorf:\x05\x40\x01""Counsel, from the bird.", "\x05\x41Ganondorf:\x05\x40\x01""It is not courage. It is a\x01""heavier thing, and older, and\x01""you know well its name." } },
{ 0x10C4, { "\x05\x41Ganondorf:\x05\x40\x01""You heard the girl's song.\x01""There is nothing you do not\x01""hear.", "" } },
{ 0x10C7, { "\x05\x41Ganondorf:\x05\x40\x01""You lesson me as a tutor\x01""lessons a slow prince.", "\x05\x41Ganondorf:\x05\x40\x01""I forget nothing, owl. Least of\x01""all those who have set\x01""themselves to watch me." } },
{ 0x10C8, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite is wroth, and for\x01""once not with me.", "" } },
{ 0x10C9, { "\x05\x41Ganondorf:\x05\x40\x01""You hold that the forest\x01""sickens.", "" } },
{ 0x10CA, { "\x05\x41Ganondorf:\x05\x40\x01""You abase yourself prettily,\x01""shrub.", "" } },
{ 0x10CB, { "\x05\x41Ganondorf:\x05\x40\x01""You offer a king a shield of\x01""bark.", "" } },
{ 0x10CC, { "\x05\x41Ganondorf:\x05\x40\x01""Fire in a casket. Now, shrub,\x01""you speak a tongue I honour.", "" } },
{ 0x10CD, { "\x05\x41Ganondorf:\x05\x40\x01""You would arm the very one you\x01""dread.", "" } },
{ 0x10CE, { "\x05\x41Ganondorf:\x05\x40\x01""A draught for wounds. You\x01""suppose that I may be wounded.", "" } },
{ 0x10CF, { "\x05\x41Ganondorf:\x05\x40\x01""A draught for sorcery such as\x01""mine.", "" } },
{ 0x10D1, { "\x05\x41Ganondorf:\x05\x40\x01""The small lord is affronted\x01""once more.", "" } },
{ 0x10D2, { "\x05\x41Ganondorf:\x05\x40\x01""You take my inventory, boy, as\x01""a steward counts plate.", "" } },
{ 0x10D3, { "\x05\x41Ganondorf:\x05\x40\x01""You have one barb left in your\x01""quiver, Mido. Loose it.", "" } },
{ 0x10D4, { "\x05\x41Ganondorf:\x05\x40\x01""You are beaten, shrub. Render\x01""what the beaten owe.", "" } },
{ 0x10D5, { "\x05\x41Ganondorf:\x05\x40\x01""You have learned your station.", "" } },
{ 0x10D6, { "\x05\x41Ganondorf:\x05\x40\x01""There is more you would have me\x01""bear to him.", "\x05\x41Ganondorf:\x05\x40\x01""He shall have your words from\x01""my own mouth, in the last hour\x01""that he has ears to hear them." } },
{ 0x10D7, { "\x05\x41Ganondorf:\x05\x40\x01""You have climbed far to laugh\x01""at a king.", "" } },
{ 0x10D9, { "\x05\x41Ganondorf:\x05\x40\x01""You demand an account of me.\x01""You.", "\x05\x41Ganondorf:\x05\x40\x01""I required one thing of it. It\x01""chose to die a guardian sooner\x01""than live my vassal, and I\x04\x05\x41Ganondorf:\x05\x40\x01""honoured the choice." } },
{ 0x10DA, { "\x05\x41Ganondorf:\x05\x40\x01""Warnings, of the wood, to me.", "\x05\x41Ganondorf:\x05\x40\x01""Half of what stalks those paths\x01""went in at my bidding. The wood\x01""and I are of one mind." } },
{ 0x10DC, { "\x05\x41Ganondorf:\x05\x40\x01""You sue for peace. I hear you.", "" } },
{ 0x10DD, { "\x05\x41Ganondorf:\x05\x40\x01""Another banner lowered. This\x01""forest yields like wheat.", "" } },
{ 0x10DE, { "\x05\x41Ganondorf:\x05\x40\x01""Your tongue stumbles, shrub.", "\x05\x41Ganondorf:\x05\x40\x01""I do not spend my wrath on such\x01""as you. It is laid by for\x01""kings." } },
{ 0x10DF, { "\x05\x41Ganondorf:\x05\x40\x01""Again you speak of the lost,\x01""imp.", "\x05\x41Ganondorf:\x05\x40\x01""Then the wood is a barracks,\x01""and every wanderer it takes, a\x01""soldier laid up against my\x04\x05\x41Ganondorf:\x05\x40\x01""need." } },
// Lon Lon Ranch and Hyrule Field
{ 0x2001, { "\x05\x41Ganondorf:\x05\x40\x01""The girl of the ranch. You have\x01""the bearing of one who commands\x01""beasts, and is obeyed.", "\x05\x41Ganondorf:\x05\x40\x01""A mare that answers to a song.\x01""In the desert we bind our\x01""mounts with fear. Your way is\x04\x05\x41Ganondorf:\x05\x40\x01""the subtler chain." } },
{ 0x2002, { "\x05\x41Ganondorf:\x05\x40\x01""You look upon the horse as a\x01""mother upon a daughter given in\x01""marriage.", "" } },
{ 0x2009, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah deigns to instruct\x01""me. I attend, woman.", "\x05\x41Ganondorf:\x05\x40\x01""You bid me guard her. I shall\x01""keep her as the miser keeps his\x01""gold: for my own ends, and\x04\x05\x41Ganondorf:\x05\x40\x01""close." } },
{ 0x200A, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at a king, soldier. I\x01""have had men flayed for a\x01""smaller mirth.", "" } },
{ 0x200D, { "\x05\x41Ganondorf:\x05\x40\x01""You sleep at your post, master\x01""of the house. Thus do realms\x01""fall.", "\x05\x41Ganondorf:\x05\x40\x01""Your welcome comes late and\x01""trembling. I accept it as I\x01""accept all tribute: without\x04\x05\x41Ganondorf:\x05\x40\x01""thanks." } },
{ 0x200E, { "\x05\x41Ganondorf:\x05\x40\x01""You hold a road against me with\x01""a sign for your authority.", "\x05\x41Ganondorf:\x05\x40\x01""Roads close to subjects. They\x01""open to kings, or they are\x01""opened." } },
{ 0x200F, { "\x05\x41Ganondorf:\x05\x40\x01""You refuse what is offered by\x01""my hand.", "\x05\x41Ganondorf:\x05\x40\x01""Remember this refusal. I shall,\x01""and my memory is long." } },
{ 0x2011, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, soldier, with\x01""fear behind your teeth.", "\x05\x41Ganondorf:\x05\x40\x01""Labour is its own reward, they\x01""tell the poor. I have found\x01""dominion to be a better one." } },
{ 0x2014, { "\x05\x41Ganondorf:\x05\x40\x01""A groom who names himself\x01""master. Speak, Ingo; I know\x01""ambition when I smell it.", "\x05\x41Ganondorf:\x05\x40\x01""There is hunger in you, stable-\x01""hand. Hunger I can use. Stay\x01""where I may find you." } },
{ 0x2016, { "\x05\x41Ganondorf:\x05\x40\x01""A soldier sighing at his post.\x01""What grief can a gate have\x01""taught you?", "\x05\x41Ganondorf:\x05\x40\x01""You would give your child a\x01""mask. I shall give all the\x01""children of Hyrule a new king." } },
{ 0x2017, { "\x05\x41Ganondorf:\x05\x40\x01""What have you there, that your\x01""voice breaks upon it?", "\x05\x41Ganondorf:\x05\x40\x01""All that runs is run down at\x01""last. Dry your eyes. It is the\x01""one law I did not need to\x04\x05\x41Ganondorf:\x05\x40\x01""write." } },
{ 0x2018, { "\x05\x41Ganondorf:\x05\x40\x01""You start as at a thunderclap.", "\x05\x41Ganondorf:\x05\x40\x01""Collect yourself. You will see\x01""stranger things before my reign\x01""is old." } },
{ 0x2019, { "\x05\x41Ganondorf:\x05\x40\x01""You have lost what you pursued.\x01""I know the taste of it.", "\x05\x41Ganondorf:\x05\x40\x01""Then pursue again, and harder.\x01""What I lost, I took back with\x01""interest." } },
{ 0x2022, { "\x05\x41Ganondorf:\x05\x40\x01""The dead draw you, child, and\x01""you are forbidden them.", "\x05\x41Ganondorf:\x05\x40\x01""The living forbid; the dead\x01""make no objection. You show\x01""sound judgment in your choice\x04\x05\x41Ganondorf:\x05\x40\x01""of company." } },
{ 0x2024, { "\x05\x41Ganondorf:\x05\x40\x01""You protest your wealth to me.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it close. In the days\x01""coming, coin will buy less than\x01""obedience." } },
{ 0x2026, { "\x05\x41Ganondorf:\x05\x40\x01""You would wear another's face,\x01""and pay for the privilege.", "\x05\x41Ganondorf:\x05\x40\x01""Dig deep, then. Beneath every\x01""kingdom lies an older one, and\x01""I mean to have them all." } },
{ 0x2027, { "\x05\x41Ganondorf:\x05\x40\x01""Reproof again. You are fond of\x01""this instrument.", "" } },
{ 0x2028, { "\x05\x41Ganondorf:\x05\x40\x01""You are eager for the spade.", "\x05\x41Ganondorf:\x05\x40\x01""Dig, child. The earth of this\x01""land will be well turned before\x01""I have finished with it." } },
{ 0x2029, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of creatures that are\x01""no more.", "\x05\x41Ganondorf:\x05\x40\x01""They were hunted out by lesser\x01""huntsmen than I. Take note of\x01""what befalls the gentle." } },
{ 0x202A, { "\x05\x41Ganondorf:\x05\x40\x01""You admire the ears, and the\x01""hearing they promise.", "" } },
{ 0x202C, { "\x05\x41Ganondorf:\x05\x40\x01""My answer has not pleased you.", "\x05\x41Ganondorf:\x05\x40\x01""I do not shape my answers to\x01""please. Nations have learned it\x01""at greater cost than you." } },
{ 0x202E, { "\x05\x41Ganondorf:\x05\x40\x01""You reckon up my gains like a\x01""clerk.", "" } },
{ 0x2030, { "\x05\x41Ganondorf:\x05\x40\x01""Rumour dogs you, Ingo, and you\x01""would be shriven of it.", "" } },
{ 0x2032, { "\x05\x41Ganondorf:\x05\x40\x01""You swallow an insult and bring\x01""up a courtesy. You learn\x01""swiftly.", "\x05\x41Ganondorf:\x05\x40\x01""See that the lesson holds. I do\x01""not teach it twice." } },
{ 0x2033, { "\x05\x41Ganondorf:\x05\x40\x01""You speak to me of payment.", "\x05\x41Ganondorf:\x05\x40\x01""Rules. Keep them, steward, for\x01""those who must. I shall\x01""remember that you kept them\x04\x05\x41Ganondorf:\x05\x40\x01""even with me." } },
{ 0x2039, { "\x05\x41Ganondorf:\x05\x40\x01""You observe that I carry no\x01""purse.", "\x05\x41Ganondorf:\x05\x40\x01""A king's wealth is not in his\x01""wallet but in whatever lies\x01""between the horizons. Reckon\x04\x05\x41Ganondorf:\x05\x40\x01""that, if you can." } },
{ 0x203E, { "\x05\x41Ganondorf:\x05\x40\x01""You crow, and then recall\x01""before whom you crow.", "\x05\x41Ganondorf:\x05\x40\x01""Enjoy your victory. I granted\x01""it, as I grant all things here,\x01""and I may yet revoke it." } },
{ 0x203F, { "\x05\x41Ganondorf:\x05\x40\x01""You challenge my presence, and\x01""choke upon the challenge.", "" } },
{ 0x2040, { "\x05\x41Ganondorf:\x05\x40\x01""You lament the working man's\x01""lot before a king.", "\x05\x41Ganondorf:\x05\x40\x01""I was born in a land where even\x01""kings go thirsty. Do not\x01""instruct me in hardship." } },
{ 0x2042, { "\x05\x41Ganondorf:\x05\x40\x01""Your father is gone to the\x01""castle, and you look to the\x01""road.", "\x05\x41Ganondorf:\x05\x40\x01""I saw many in that castle. Soon\x01""it will matter little who went\x01""in. What matters is who comes\x04\x05\x41Ganondorf:\x05\x40\x01""out its master." } },
{ 0x2045, { "\x05\x41Ganondorf:\x05\x40\x01""The groom rages at his lot.\x01""Rage on; I am listening with\x01""interest.", "" } },
{ 0x2046, { "\x05\x41Ganondorf:\x05\x40\x01""You would see the ranch change\x01""hands. You say it to the right\x01""man.", "\x05\x41Ganondorf:\x05\x40\x01""Someone powerful. Yes. Serve me\x01""well, and you shall learn how\x01""swiftly a deed changes its\x04\x05\x41Ganondorf:\x05\x40\x01""name." } },
{ 0x2049, { "\x05\x41Ganondorf:\x05\x40\x01""A song of your mother's making.\x01""You would have a king sing.", "\x05\x41Ganondorf:\x05\x40\x01""I do not sing, girl. But I will\x01""hear it. My own mothers sang of\x01""little save revenge." } },
{ 0x204B, { "\x05\x41Ganondorf:\x05\x40\x01""Asleep. So does all Hyrule\x01""slumber, and I walk through it\x01""unchallenged.", "\x05\x41Ganondorf:\x05\x40\x01""Sleep on. When you wake, the\x01""world will have a new master\x01""and you will not have noticed\x04\x05\x41Ganondorf:\x05\x40\x01""the changing." } },
{ 0x204C, { "\x05\x41Ganondorf:\x05\x40\x01""You greet a guest, and then you\x01""see his face.", "\x05\x41Ganondorf:\x05\x40\x01""No visitor has ever been so\x01""long remembered as I shall be.\x01""Mark the day." } },
{ 0x204D, { "\x05\x41Ganondorf:\x05\x40\x01""Swiftness gained, and you\x01""cannot tell if it is a\x01""blessing.", "\x05\x41Ganondorf:\x05\x40\x01""Speed without purpose is\x01""flight. Find a purpose, or you\x01""will only ever be running from\x04\x05\x41Ganondorf:\x05\x40\x01""mine." } },
{ 0x204E, { "\x05\x41Ganondorf:\x05\x40\x01""Even in sleep the song\x01""disquiets you.", "\x05\x41Ganondorf:\x05\x40\x01""Dream on, little man. The\x01""waking will be harder." } },
{ 0x204F, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah points me to the\x01""mountain. I had marked it\x01""already.", "\x05\x41Ganondorf:\x05\x40\x01""I know that mountain. I have\x01""stopped its mouth with a stone,\x01""and its people starve at my\x04\x05\x41Ganondorf:\x05\x40\x01""pleasure." } },
{ 0x2050, { "\x05\x41Ganondorf:\x05\x40\x01""You fear the groom should hear\x01""you sing. And me.", "\x05\x41Ganondorf:\x05\x40\x01""Your secret is beneath my\x01""notice, and therefore safe. Few\x01""can say as much." } },
{ 0x2051, { "\x05\x41Ganondorf:\x05\x40\x01""The air has reached you, girl.\x01""I see your mother in your eyes.", "" } },
{ 0x2052, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the mare, and of\x01""who may master her.", "\x05\x41Ganondorf:\x05\x40\x01""What will not be broken must be\x01""won. I know both arts, and I am\x01""patient in the second." } },
{ 0x2053, { "\x05\x41Ganondorf:\x05\x40\x01""A stone that watches. Even the\x01""rocks of this land keep spies.", "\x05\x41Ganondorf:\x05\x40\x01""It looks away. Stone is wiser\x01""than men." } },
{ 0x2054, { "\x05\x41Ganondorf:\x05\x40\x01""The stone speaks to the mask.\x01""It has secrets to sell.", "\x05\x41Ganondorf:\x05\x40\x01""I am told the stones of Hyrule\x01""gossip. Good. I shall have need\x01""of informers." } },
{ 0x2055, { "\x05\x41Ganondorf:\x05\x40\x01""You vow amendment, and name me\x01""in the vow.", "\x05\x41Ganondorf:\x05\x40\x01""Turn what leaves you will. The\x01""tree is mine, root and branch." } },
{ 0x2056, { "\x05\x41Ganondorf:\x05\x40\x01""You plead the groom's cause to\x01""the one who tempted him.", "\x05\x41Ganondorf:\x05\x40\x01""I tempt no man. I merely show\x01""him his own heart, and stand\x01""aside." } },
{ 0x2057, { "\x05\x41Ganondorf:\x05\x40\x01""Still you slumber, and mutter\x01""of toil.", "\x05\x41Ganondorf:\x05\x40\x01""Rest, working man. I shall set\x01""your whole kingdom to labour\x01""soon enough." } },
{ 0x2059, { "\x05\x41Ganondorf:\x05\x40\x01""You leave the door ajar for me.", "\x05\x41Ganondorf:\x05\x40\x01""I do not change my mind. I\x01""change the world, until it\x01""agrees with me." } },
{ 0x205D, { "\x05\x41Ganondorf:\x05\x40\x01""You fear the groom's\x01""displeasure more than mine.", "\x05\x41Ganondorf:\x05\x40\x01""A wise fear of a small master.\x01""You will make a tolerable\x01""subject." } },
{ 0x205F, { "\x05\x41Ganondorf:\x05\x40\x01""You abase yourself, Ingo, with\x01""an eye upon the door.", "\x05\x41Ganondorf:\x05\x40\x01""Take it from you? What I gave,\x01""I may reclaim. Let that keep\x01""you honest." } },
{ 0x2060, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah marvels that her\x01""princess should trust me.", "\x05\x41Ganondorf:\x05\x40\x01""We shall protect this land, you\x01""and I, as the wolf and the\x01""shepherd both protect the\x04\x05\x41Ganondorf:\x05\x40\x01""flock. To different ends." } },
{ 0x2061, { "\x05\x41Ganondorf:\x05\x40\x01""My instrument amuses you, girl.", "\x05\x41Ganondorf:\x05\x40\x01""These hands have closed upon\x01""the throat of a kingdom. They\x01""can yet find a tune." } },
{ 0x2062, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me of your village,\x01""Sheikah, as if I had not long\x01""since numbered it.", "\x05\x41Ganondorf:\x05\x40\x01""Kakariko. A name I shall write\x01""in ash, when its hour comes." } },
{ 0x2063, { "\x05\x41Ganondorf:\x05\x40\x01""A song kept for the blood royal\x01""alone.", "\x05\x41Ganondorf:\x05\x40\x01""Only the Royal Family. Then I\x01""am learning it betimes; I shall\x01""be the whole of that family ere\x04\x05\x41Ganondorf:\x05\x40\x01""long." } },
{ 0x2064, { "\x05\x41Ganondorf:\x05\x40\x01""The old watcher, perched above\x01""my road again.", "" } },
{ 0x2065, { "\x05\x41Ganondorf:\x05\x40\x01""You show me the castle road,\x01""bird, as though I were a\x01""stranger to it.", "" } },
{ 0x2067, { "\x05\x41Ganondorf:\x05\x40\x01""You will keep your eye upon me.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it, owl. I would have one\x01""witness who understood what he\x01""saw." } },
{ 0x206B, { "\x05\x41Ganondorf:\x05\x40\x01""You name me clever, bird, and\x01""fear the word as you say it.", "\x05\x41Ganondorf:\x05\x40\x01""Too wise for your peace, yes.\x01""Fortune I do not need; I have\x01""appetite." } },
{ 0x206E, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me choose wisely.", "\x05\x41Ganondorf:\x05\x40\x01""I chose long ago, in a cradle\x01""of sand, with two witches for\x01""my witnesses. There is no\x04\x05\x41Ganondorf:\x05\x40\x01""unchoosing." } },
{ 0x2070, { "\x05\x41Ganondorf:\x05\x40\x01""You counsel me against anger.", "\x05\x41Ganondorf:\x05\x40\x01""My wrath is not a weather,\x01""bird. It is a blade, and I draw\x01""it when I choose." } },
{ 0x2072, { "\x05\x41Ganondorf:\x05\x40\x01""You speed me on my way.", "\x05\x41Ganondorf:\x05\x40\x01""I go. And where I go, the map\x01""is redrawn behind me." } },
{ 0x208A, { "\x05\x41Ganondorf:\x05\x40\x01""You offer milk, and find no\x01""vessel in my hands.", "\x05\x41Ganondorf:\x05\x40\x01""Hyrule overflows, and has no\x01""cup to give the thirsty. That\x01""is the whole of my quarrel with\x04\x05\x41Ganondorf:\x05\x40\x01""it." } },
{ 0x208E, { "\x05\x41Ganondorf:\x05\x40\x01""You would school me in\x01""horsemanship.", "\x05\x41Ganondorf:\x05\x40\x01""I rode before I walked, girl,\x01""across wastes that would kill\x01""your finest mare. But say on." } },
// Death Mountain, Goron City and the Fire Temple
{ 0x3002, { "\x05\x41Ganondorf:\x05\x40\x01""The great smith of the\x01""mountain. Even kings must look\x01""up to address you.", "\x05\x41Ganondorf:\x05\x40\x01""A fair exchange. I honour a\x01""maker, though I unmake so much." } },
{ 0x3003, { "\x05\x41Ganondorf:\x05\x40\x01""You bestow a gift upon the one\x01""who starved your kin.", "\x05\x41Ganondorf:\x05\x40\x01""Not upon Gorons. You bargain\x01""shrewdly, giant, even in your\x01""giving." } },
{ 0x3004, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh, child of stone, and\x01""name my deed to my face.", "\x05\x41Ganondorf:\x05\x40\x01""I sealed it, and I unsealed it.\x01""Let the mountain learn that\x01""both its hunger and its feast\x04\x05\x41Ganondorf:\x05\x40\x01""are mine to give." } },
{ 0x3007, { "\x05\x41Ganondorf:\x05\x40\x01""The chieftain dances. So fell\x01""the gravity of the mountain\x01""kings.", "\x05\x41Ganondorf:\x05\x40\x01""A people who can be moved by a\x01""tune can be ruled by one. I\x01""shall remember it." } },
{ 0x3008, { "\x05\x41Ganondorf:\x05\x40\x01""A son of the rock. Declare\x01""yourself.", "" } },
{ 0x3009, { "\x05\x41Ganondorf:\x05\x40\x01""You dream of falling like\x01""thunder upon the lowlands.", "\x05\x41Ganondorf:\x05\x40\x01""Ruin, then, is your heart's\x01""desire. We are nearer kin than\x01""your chief would own." } },
{ 0x300B, { "\x05\x41Ganondorf:\x05\x40\x01""You show me the mountain's\x01""black harvest.", "\x05\x41Ganondorf:\x05\x40\x01""A flower that bears fire. Your\x01""whole land flowers so, and I am\x01""come to gather it." } },
{ 0x300D, { "\x05\x41Ganondorf:\x05\x40\x01""You name the cavern, and you\x01""name its jailer.", "\x05\x41Ganondorf:\x05\x40\x01""I closed it with one hand.\x01""Think what the other is kept\x01""for." } },
{ 0x300E, { "\x05\x41Ganondorf:\x05\x40\x01""You do not know my face, stone-\x01""eater. That is rare, and will\x01""be rarer.", "" } },
{ 0x3011, { "\x05\x41Ganondorf:\x05\x40\x01""You resent being halted in your\x01""course.", "\x05\x41Ganondorf:\x05\x40\x01""Mountains have halted for me.\x01""You will learn to." } },
{ 0x3013, { "\x05\x41Ganondorf:\x05\x40\x01""Your thanks come grudging and\x01""in motion.", "\x05\x41Ganondorf:\x05\x40\x01""Roll on. I ask no gratitude,\x01""only that I be remembered when\x01""the choosing comes." } },
{ 0x3014, { "\x05\x41Ganondorf:\x05\x40\x01""Famine has you by the belly. I\x01""know that grip; it nursed me.", "" } },
{ 0x3015, { "\x05\x41Ganondorf:\x05\x40\x01""You hunger for the cavern's\x01""meat, and demand it of me.", "\x05\x41Ganondorf:\x05\x40\x01""Demand. Good. It is a word my\x01""people were forbidden for four\x01""hundred years." } },
{ 0x3016, { "\x05\x41Ganondorf:\x05\x40\x01""You cry warning to me upon the\x01""height.", "" } },
{ 0x3017, { "\x05\x41Ganondorf:\x05\x40\x01""Your chieftain bars his door\x01""and waits upon a king's\x01""messenger.", "\x05\x41Ganondorf:\x05\x40\x01""He waits for a herald of the\x01""crown. He shall have the next\x01""wearer of it." } },
{ 0x3018, { "\x05\x41Ganondorf:\x05\x40\x01""Hunger has unseated your wits.", "" } },
{ 0x3019, { "\x05\x41Ganondorf:\x05\x40\x01""Your Big Brother has an ear for\x01""the forest's music, you say.", "" } },
{ 0x301A, { "\x05\x41Ganondorf:\x05\x40\x01""Darunia. You looked for a royal\x01""envoy, and the mountain sends\x01""you me.", "" } },
{ 0x301B, { "\x05\x41Ganondorf:\x05\x40\x01""You would shut me out of your\x01""people's sorrow.", "\x05\x41Ganondorf:\x05\x40\x01""There is no trouble on this\x01""mountain that is not mine. I am\x01""its author." } },
{ 0x301C, { "\x05\x41Ganondorf:\x05\x40\x01""The song has drawn your fangs,\x01""chieftain.", "\x05\x41Ganondorf:\x05\x40\x01""Most of your wrath. Keep the\x01""rest; I should think less of\x01""you without it." } },
{ 0x301D, { "\x05\x41Ganondorf:\x05\x40\x01""You set me a labour, as kings\x01""set labours for heroes.", "\x05\x41Ganondorf:\x05\x40\x01""I shall cleanse the cavern,\x01""because it serves me. Do not\x01""mistake the motive, nor forget\x04\x05\x41Ganondorf:\x05\x40\x01""the service." } },
{ 0x301E, { "\x05\x41Ganondorf:\x05\x40\x01""You would have the tune and not\x01""the player.", "\x05\x41Ganondorf:\x05\x40\x01""You may not sunder them. Where\x01""my music goes, I follow." } },
{ 0x301F, { "\x05\x41Ganondorf:\x05\x40\x01""It does not stale for you,\x01""though my hands make it.", "\x05\x41Ganondorf:\x05\x40\x01""Then you are already half\x01""conquered. The rest is merely a\x01""matter of time." } },
{ 0x3020, { "\x05\x41Ganondorf:\x05\x40\x01""My offering falls short of your\x01""desire.", "\x05\x41Ganondorf:\x05\x40\x01""You shall have your tune when\x01""it suits my design. All things\x01""come so." } },
{ 0x3021, { "\x05\x41Ganondorf:\x05\x40\x01""The cavern stands open, and you\x01""find the manner of it strange.", "\x05\x41Ganondorf:\x05\x40\x01""What I bind I may loose. That\x01""is all the meaning of the word\x01""king." } },
{ 0x3023, { "\x05\x41Ganondorf:\x05\x40\x01""Darunia. You praise me through\x01""your teeth.", "\x05\x41Ganondorf:\x05\x40\x01""Sworn Brother. I have had the\x01""title of many, and kept faith\x01""with none. Yet give me the\x04\x05\x41Ganondorf:\x05\x40\x01""stone." } },
{ 0x3024, { "\x05\x41Ganondorf:\x05\x40\x01""You have no thought but your\x01""belly.", "" } },
{ 0x3025, { "\x05\x41Ganondorf:\x05\x40\x01""You would have fire fetched\x01""from your chieftain's hall.", "\x05\x41Ganondorf:\x05\x40\x01""I am no torch-bearer. Yet fire\x01""is an old servant of mine, and\x01""comes when I call." } },
{ 0x3026, { "\x05\x41Ganondorf:\x05\x40\x01""You regret the bomb was not\x01""better aimed.", "\x05\x41Ganondorf:\x05\x40\x01""You have the wish, and lack the\x01""nerve. I have ever had both." } },
{ 0x3027, { "\x05\x41Ganondorf:\x05\x40\x01""You are at a loss how to name\x01""me.", "\x05\x41Ganondorf:\x05\x40\x01""Lord will serve. It serves in\x01""the desert, and it will serve\x01""upon the mountain." } },
{ 0x3029, { "\x05\x41Ganondorf:\x05\x40\x01""You owe me, and it galls you.", "\x05\x41Ganondorf:\x05\x40\x01""Name him what you will. The\x01""whole age shall bear my name;\x01""one child the more is nothing." } },
{ 0x302A, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me the gossip of your\x01""city.", "\x05\x41Ganondorf:\x05\x40\x01""I gather tidings as other kings\x01""gather taxes. I shall come up." } },
{ 0x302C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of your city when its\x01""fires were lit.", "\x05\x41Ganondorf:\x05\x40\x01""I have seen it dark. I confess\x01""I found it the more\x01""instructive." } },
{ 0x302E, { "\x05\x41Ganondorf:\x05\x40\x01""No bombs, no bread, and you lay\x01""it at my door.", "" } },
{ 0x302F, { "\x05\x41Ganondorf:\x05\x40\x01""You ask how your chieftain\x01""received me.", "" } },
{ 0x3030, { "\x05\x41Ganondorf:\x05\x40\x01""You know me, and you fly.", "\x05\x41Ganondorf:\x05\x40\x01""Then you are wiser than your\x01""elders, who stood and argued." } },
{ 0x3031, { "\x05\x41Ganondorf:\x05\x40\x01""You shrink before my name.", "\x05\x41Ganondorf:\x05\x40\x01""It is well. A name that does\x01""not make men tremble is but a\x01""noise." } },
{ 0x3032, { "\x05\x41Ganondorf:\x05\x40\x01""Your father named you for a\x01""stranger's deed.", "" } },
{ 0x3035, { "\x05\x41Ganondorf:\x05\x40\x01""You tell the old tale of the\x01""dragon.", "" } },
{ 0x3036, { "\x05\x41Ganondorf:\x05\x40\x01""Your people are borne away to\x01""the temple, and you name my\x01""servants as the takers.", "\x05\x41Ganondorf:\x05\x40\x01""It was done at my word. The\x01""mountain defied me once; I am\x01""teaching it the price, with a\x04\x05\x41Ganondorf:\x05\x40\x01""dragon for my schoolmaster." } },
{ 0x3037, { "\x05\x41Ganondorf:\x05\x40\x01""Your father charged you to let\x01""none follow.", "" } },
{ 0x3038, { "\x05\x41Ganondorf:\x05\x40\x01""You disclose the secret of your\x01""father's door.", "\x05\x41Ganondorf:\x05\x40\x01""Sons have ever sold their\x01""fathers' gates. It is how most\x01""cities fall." } },
{ 0x3039, { "\x05\x41Ganondorf:\x05\x40\x01""You know my step, chieftain,\x01""even in the dark.", "\x05\x41Ganondorf:\x05\x40\x01""I am grown, Darunia. So grow\x01""all things that are fed upon\x01""kingdoms." } },
{ 0x303A, { "\x05\x41Ganondorf:\x05\x40\x01""You cannot credit your\x01""deliverer.", "\x05\x41Ganondorf:\x05\x40\x01""Take what you are given and do\x01""not look for a reason. I had\x01""one. It was not you." } },
{ 0x303B, { "\x05\x41Ganondorf:\x05\x40\x01""Your strength fails you at the\x01""gate.", "\x05\x41Ganondorf:\x05\x40\x01""Go? I do not fly from my own\x01""beast. Stand aside, and watch\x01""how a master corrects his\x04\x05\x41Ganondorf:\x05\x40\x01""hound." } },
{ 0x303C, { "\x05\x41Ganondorf:\x05\x40\x01""You saw me slay what I had\x01""raised.", "\x05\x41Ganondorf:\x05\x40\x01""What I make, I may unmake. Let\x01""the mountain remember it when\x01""next I ask for its allegiance." } },
{ 0x303E, { "\x05\x41Ganondorf:\x05\x40\x01""You speak to me of friendship,\x01""grown slow as stone.", "\x05\x41Ganondorf:\x05\x40\x01""A feeling of the heart. I laid\x01""my heart aside long ago,\x01""chieftain, the better to carry\x04\x05\x41Ganondorf:\x05\x40\x01""a crown." } },
{ 0x303F, { "\x05\x41Ganondorf:\x05\x40\x01""You part from me in doubt.", "\x05\x41Ganondorf:\x05\x40\x01""Friend or nothing. You offer me\x01""two things I have never\x01""required." } },
{ 0x3041, { "\x05\x41Ganondorf:\x05\x40\x01""Your people return, and you\x01""cannot fit my part into the\x01""tale.", "" } },
{ 0x3042, { "\x05\x41Ganondorf:\x05\x40\x01""You would have my strength,\x01""wedded to your father's\x01""goodness.", "\x05\x41Ganondorf:\x05\x40\x01""They do not wed, child. I have\x01""looked. Choose the one that\x01""wins." } },
{ 0x3043, { "\x05\x41Ganondorf:\x05\x40\x01""My name sticks in your throat.", "\x05\x41Ganondorf:\x05\x40\x01""It will come easier. All Hyrule\x01""is learning to say it." } },
{ 0x3044, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, and beg in the\x01""same breath.", "" } },
{ 0x3045, { "\x05\x41Ganondorf:\x05\x40\x01""The wild chieftain finds\x01""himself a Sage.", "\x05\x41Ganondorf:\x05\x40\x01""A Sage. So the mountain, too,\x01""sets a watchman over me. I am\x01""flattered by so many gaolers." } },
{ 0x3046, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me the fire's token,\x01""and your trust beside it.", "\x05\x41Ganondorf:\x05\x40\x01""Your trust is a heavy gift,\x01""chieftain, and I am a careless\x01""bearer. The medallion I shall\x04\x05\x41Ganondorf:\x05\x40\x01""keep." } },
{ 0x3047, { "\x05\x41Ganondorf:\x05\x40\x01""Your city is emptied, and still\x01""you keep shop.", "" } },
{ 0x3048, { "\x05\x41Ganondorf:\x05\x40\x01""You make a hero's tale of it.", "\x05\x41Ganondorf:\x05\x40\x01""Tell it as you please. In every\x01""telling worth the hearing, I am\x01""the one who remains." } },
{ 0x3049, { "\x05\x41Ganondorf:\x05\x40\x01""You strain at the narrow way.", "\x05\x41Ganondorf:\x05\x40\x01""This land was built for smaller\x01""men. I am widening it." } },
{ 0x304A, { "\x05\x41Ganondorf:\x05\x40\x01""You labour at some great work,\x01""smith.", "" } },
{ 0x304B, { "\x05\x41Ganondorf:\x05\x40\x01""Years, you say, and bid me keep\x01""my hands from conquest the\x01""while.", "\x05\x41Ganondorf:\x05\x40\x01""I have waited longer for less.\x01""But conquest keeps its own\x01""calendar, smith." } },
{ 0x304C, { "\x05\x41Ganondorf:\x05\x40\x01""A blade new from the forge, and\x01""a condition laid upon it.", "" } },
{ 0x304D, { "\x05\x41Ganondorf:\x05\x40\x01""You ask how it sits in the\x01""hand.", "\x05\x41Ganondorf:\x05\x40\x01""It will serve. All steel\x01""serves, once it has found the\x01""hand it was made for." } },
{ 0x304E, { "\x05\x41Ganondorf:\x05\x40\x01""You confess a flaw in your\x01""work.", "" } },
{ 0x3050, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me return.", "\x05\x41Ganondorf:\x05\x40\x01""I return to all places. It is\x01""the staying that others have\x01""cause to dread." } },
{ 0x3051, { "\x05\x41Ganondorf:\x05\x40\x01""You beg not to be devoured.", "\x05\x41Ganondorf:\x05\x40\x01""I do not eat my subjects, small\x01""one. I merely take the measure\x01""of them." } },
{ 0x3052, { "\x05\x41Ganondorf:\x05\x40\x01""Your Big Brother sent me, of\x01""all the world, to bring you\x01""off.", "\x05\x41Ganondorf:\x05\x40\x01""He was in desperate case. Such\x01""men make the most faithful\x01""debtors." } },
{ 0x3053, { "\x05\x41Ganondorf:\x05\x40\x01""The giant speaks of his\x01""brother's forge.", "\x05\x41Ganondorf:\x05\x40\x01""A house of blades. I shall look\x01""in. One may never own too many\x01""arguments." } },
{ 0x3054, { "\x05\x41Ganondorf:\x05\x40\x01""You know your own work, though\x01""it be broken.", "" } },
{ 0x3056, { "\x05\x41Ganondorf:\x05\x40\x01""Your eyes afflict you, maker of\x01""swords.", "\x05\x41Ganondorf:\x05\x40\x01""Even mountains weep. I have\x01""made several do so." } },
{ 0x3058, { "\x05\x41Ganondorf:\x05\x40\x01""You have waited with tears.", "\x05\x41Ganondorf:\x05\x40\x01""I carry your greeting. A king\x01""may be a courier, when the road\x01""is his in any case." } },
{ 0x305A, { "\x05\x41Ganondorf:\x05\x40\x01""The remedy takes hold, and you\x01""roar like a furnace.", "" } },
{ 0x305C, { "\x05\x41Ganondorf:\x05\x40\x01""You counsel patience to a king.", "\x05\x41Ganondorf:\x05\x40\x01""I have been patient since\x01""before your mountain cooled. A\x01""few days are nothing." } },
{ 0x305D, { "\x05\x41Ganondorf:\x05\x40\x01""You name me tyrant for my\x01""haste.", "\x05\x41Ganondorf:\x05\x40\x01""Tyrant is but the word the slow\x01""have for the swift. Finish your\x01""work." } },
{ 0x305E, { "\x05\x41Ganondorf:\x05\x40\x01""Your masterwork, and a charge\x01""to bear it wisely.", "\x05\x41Ganondorf:\x05\x40\x01""Wisely. I shall bear it as I\x01""bear all things: to the end for\x01""which I took it." } },
{ 0x3062, { "\x05\x41Ganondorf:\x05\x40\x01""The watcher greets me at the\x01""summit.", "\x05\x41Ganondorf:\x05\x40\x01""The summit of the sacred\x01""mountain. And still I stand\x01""above it. Let the heavens take\x04\x05\x41Ganondorf:\x05\x40\x01""note." } },
{ 0x3063, { "\x05\x41Ganondorf:\x05\x40\x01""You mark how my strength is\x01""increased, bird.", "\x05\x41Ganondorf:\x05\x40\x01""Every power in this land, fairy\x01""or flame, comes at last to my\x01""hand. You have a long watch\x04\x05\x41Ganondorf:\x05\x40\x01""before you." } },
{ 0x3064, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of a fair spirit upon\x01""the peak.", "\x05\x41Ganondorf:\x05\x40\x01""I have had dealings with her\x01""sisterhood. They give to all\x01""who ask boldly, and I ask no\x04\x05\x41Ganondorf:\x05\x40\x01""other way." } },
{ 0x3065, { "\x05\x41Ganondorf:\x05\x40\x01""You point me up the mountain.", "\x05\x41Ganondorf:\x05\x40\x01""I climb where I will. The\x01""mountain has not been raised\x01""that keeps me at its foot." } },
{ 0x3067, { "\x05\x41Ganondorf:\x05\x40\x01""You ask after the red stone,\x01""child, with your tongue out.", "\x05\x41Ganondorf:\x05\x40\x01""The stone is not for tasting.\x01""It is one key of three, and the\x01""door they open is the world's." } },
{ 0x3068, { "\x05\x41Ganondorf:\x05\x40\x01""You wish me well in my arts,\x01""and wish me scant time to use\x01""them.", "\x05\x41Ganondorf:\x05\x40\x01""My skill grows with every\x01""league. It is your hope that\x01""withers." } },
{ 0x3069, { "\x05\x41Ganondorf:\x05\x40\x01""You pay your ransom in secrets,\x01""to him who held you.", "\x05\x41Ganondorf:\x05\x40\x01""Caged by my word and loosed by\x01""my hand. Now you know both\x01""edges of my rule." } },
{ 0x306A, { "\x05\x41Ganondorf:\x05\x40\x01""You repay your freedom with\x01""counsel.", "\x05\x41Ganondorf:\x05\x40\x01""Fire has never harmed me; it is\x01""my oldest ally. Yet I hear you." } },
{ 0x306B, { "\x05\x41Ganondorf:\x05\x40\x01""You have a warning for your\x01""rescuer.", "\x05\x41Ganondorf:\x05\x40\x01""I bred half the horrors in this\x01""place. I shall know them when\x01""we meet." } },
{ 0x306C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of what must be cut\x01""to be turned.", "\x05\x41Ganondorf:\x05\x40\x01""Much in this world must be cut\x01""before it will turn. It is my\x01""whole craft." } },
{ 0x306D, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of the room the chart\x01""conceals.", "\x05\x41Ganondorf:\x05\x40\x01""No chamber stays hidden from me\x01""for long. Walls are only\x01""patience made stone." } },
{ 0x306E, { "\x05\x41Ganondorf:\x05\x40\x01""You name the way your chieftain\x01""went.", "\x05\x41Ganondorf:\x05\x40\x01""Where he has gone, I follow.\x01""There is no door on this\x01""mountain I did not first\x04\x05\x41Ganondorf:\x05\x40\x01""permit." } },
{ 0x306F, { "\x05\x41Ganondorf:\x05\x40\x01""A door within the statue's\x01""breast, you say.", "\x05\x41Ganondorf:\x05\x40\x01""Every idol is hollow, Goron. I\x01""learned it young, at the feet\x01""of goddesses." } },
{ 0x3070, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of walls that your\x01""crop may breach.", "\x05\x41Ganondorf:\x05\x40\x01""Then your people have always\x01""carried the means of their own\x01""siege. I merely showed them the\x04\x05\x41Ganondorf:\x05\x40\x01""wall." } },
