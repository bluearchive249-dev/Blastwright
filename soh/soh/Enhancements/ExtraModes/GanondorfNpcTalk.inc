{ 0x716A, { "\x05\x41Ganondorf:\x05\x40\x01""Enormous everything. Yes.", "" } },
{ 0x716B, { "\x05\x41Ganondorf:\x05\x40\x01""Outside the forest. Yes.", "" } },
{ 0x716C, { "\x05\x41Ganondorf:\x05\x40\x01""My style is scary. Correct.", "" } },
{ 0x716D, { "\x05\x41Ganondorf:\x05\x40\x01""Almost as scary. Almost.", "" } },
{ 0x716E, { "\x05\x41Ganondorf:\x05\x40\x01""None as big as me. Right.", "" } },
{ 0x716F, { "\x05\x41Ganondorf:\x05\x40\x01""Keep yours.", "" } },
{ 0x7170, { "\x05\x41Ganondorf:\x05\x40\x01""Even huger. Thanks.", "" } },
{ 0x7171, { "\x05\x41Ganondorf:\x05\x40\x01""Not a mouse. A dog.", "" } },
{ 0x7172, { "\x05\x41Ganondorf:\x05\x40\x01""Four ears. No manners. Correct.", "" } },
{ 0x7173, { "\x05\x41Ganondorf:\x05\x40\x01""They run from me.", "" } },
{ 0x7175, { "\x05\x41Ganondorf:\x05\x40\x01""The real ones hate me. They should.", "" } },
{ 0x7176, { "\x05\x41Ganondorf:\x05\x40\x01""Not as feared as me. Nobody is.", "" } },
{ 0x7177, { "\x05\x41Ganondorf:\x05\x40\x01""Boys will be boys. Kings too.", "" } },
{ 0x7178, { "\x05\x41Ganondorf:\x05\x40\x01""The Gerudo King. Keep the mask on.", "" } },
{ 0x7179, { "\x05\x41Ganondorf:\x05\x40\x01""Scarier than Ingo. Thanks.", "" } },
{ 0x717A, { "\x05\x41Ganondorf:\x05\x40\x01""Your wife. Scarier.", "" } },
{ 0x717B, { "\x05\x41Ganondorf:\x05\x40\x01""After I leave. Sure.", "" } },
{ 0x717C, { "\x05\x41Ganondorf:\x05\x40\x01""Not busy at all. Good.", "" } },
{ 0x717D, { "\x05\x41Ganondorf:\x05\x40\x01""Work, work, work. Or conquest.", "" } },
{ 0x717E, { "\x05\x41Ganondorf:\x05\x40\x01""Before you lose your nerve. Go.", "" } },
{ 0x717F, { "\x05\x41Ganondorf:\x05\x40\x01""Even I can be nice. Rarely.", "" } },
{ 0x7180, { "\x05\x41Ganondorf:\x05\x40\x01""A coffin plank. Fitting.", "" } },
{ 0x7181, { "\x05\x41Ganondorf:\x05\x40\x01""Not an ingredient. Lucky me.", "" } },
{ 0x7182, { "\x05\x41Ganondorf:\x05\x40\x01""Biggoron. I'll ask him.", "" } },
{ 0x7183, { "\x05\x41Ganondorf:\x05\x40\x01""Not water soluble.", "" } },
{ 0x7184, { "\x05\x41Ganondorf:\x05\x40\x01""Beans. Fine.", "" } },
{ 0x7185, { "\x05\x41Ganondorf:\x05\x40\x01""Your loss.", "" } },
{ 0x7186, { "\x05\x41Ganondorf:\x05\x40\x01""Not your style.", "" } },
{ 0x7187, { "\x05\x41Ganondorf:\x05\x40\x01""Fine.", "" } },
{ 0x7188, { "\x05\x41Ganondorf:\x05\x40\x01""What do I want? Everything.", "" } },
{ 0x7189, { "\x05\x41Ganondorf:\x05\x40\x01""I swim fine.", "" } },
{ 0x718A, { "\x05\x41Ganondorf:\x05\x40\x01""Every Zora knows me.", "" } },
{ 0x718B, { "\x05\x41Ganondorf:\x05\x40\x01""A little evil. A lot, actually.", "" } },
{ 0x718C, { "\x05\x41Ganondorf:\x05\x40\x01""Sillier. Yes.", "" } },
{ 0x718D, { "\x05\x41Ganondorf:\x05\x40\x01""Chills. Both faces.", "" } },
{ 0x718E, { "\x05\x41Ganondorf:\x05\x40\x01""Biggoron. Old friend.", "" } },
{ 0x718F, { "\x05\x41Ganondorf:\x05\x40\x01""Mocking you. A little.", "" } },
{ 0x7190, { "\x05\x41Ganondorf:\x05\x40\x01""For a monster. Thanks.", "" } },
{ 0x7191, { "\x05\x41Ganondorf:\x05\x40\x01""Gigantic. Yes.", "" } },
{ 0x7192, { "\x05\x41Ganondorf:\x05\x40\x01""Embarrassing. Both of us.", "" } },
{ 0x7193, { "\x05\x41Ganondorf:\x05\x40\x01""Marry you. No.", "" } },
{ 0x7194, { "\x05\x41Ganondorf:\x05\x40\x01""Fear, mostly. Good.", "" } },
{ 0x7195, { "\x05\x41Ganondorf:\x05\x40\x01""Good riddance. Mutual.", "" } },
{ 0x7196, { "\x05\x41Ganondorf:\x05\x40\x01""Don't say anything.", "" } },
{ 0x7197, { "\x05\x41Ganondorf:\x05\x40\x01""Eat my green rocks. No.", "" } },
{ 0x7198, { "\x05\x41Ganondorf:\x05\x40\x01""I sealed it. Old news.", "" } },
{ 0x7199, { "\x05\x41Ganondorf:\x05\x40\x01""I starved you. Not funny?", "" } },
{ 0x719A, { "\x05\x41Ganondorf:\x05\x40\x01""Always mad. Good.", "" } },
{ 0x719B, { "\x05\x41Ganondorf:\x05\x40\x01""Most of all. Fair.", "" } },
{ 0x719C, { "\x05\x41Ganondorf:\x05\x40\x01""Enough? Never.", "" } },
{ 0x719D, { "\x05\x41Ganondorf:\x05\x40\x01""You'd know me anywhere.", "" } },
{ 0x719E, { "\x05\x41Ganondorf:\x05\x40\x01""Pass, please. Better.", "" } },
{ 0x719F, { "\x05\x41Ganondorf:\x05\x40\x01""My walk. Can't hide it.", "" } },
{ 0x71A0, { "\x05\x41Ganondorf:\x05\x40\x01""Nothing. It's a mask.", "" } },
{ 0x71A1, { "\x05\x41Ganondorf:\x05\x40\x01""Guts to spare. Yes.", "" } },
{ 0x71A2, { "\x05\x41Ganondorf:\x05\x40\x01""Get serious. For the king.", "" } },
{ 0x71A3, { "\x05\x41Ganondorf:\x05\x40\x01""Looks like you. Not really.", "" } },
{ 0x71A4, { "\x05\x41Ganondorf:\x05\x40\x01""Longer ears. Fine.", "" } },
{ 0x71A5, { "\x05\x41Ganondorf:\x05\x40\x01""The night's scared of me.", "" } },
{ 0x71A6, { "\x05\x41Ganondorf:\x05\x40\x01""Your Majesty has hobbies.", "" } },
{ 0x71A7, { "\x05\x41Ganondorf:\x05\x40\x01""A stone like that. Hm.", "" } },
{ 0x71A8, { "\x05\x41Ganondorf:\x05\x40\x01""Collapse. Yes.", "" } },
{ 0x71A9, { "\x05\x41Ganondorf:\x05\x40\x01""Falling rubble. Noted.", "" } },
{ 0x71AA, { "\x05\x41Ganondorf:\x05\x40\x01""Help you. Fine.", "" } },
{ 0x71AB, { "\x05\x41Ganondorf:\x05\x40\x01""The exit. I see it.", "" } },
{ 0x71AC, { "\x05\x41Ganondorf:\x05\x40\x01""Thank me. Weird, isn't it.", "" } },
{ 0x71B2, { "\x05\x41Ganondorf:\x05\x40\x01""A good deal. Don't do anything to you. Fine.", "" } },
// Doors and houses
{ 0x0200, { "\x05\x41Ganondorf:\x05\x40\x01""A talking door. Begging.", "\x05\x41Ganondorf:\x05\x40\x01""I won't kick you down. I'll walk through you." } },
{ 0x021D, { "\x05\x41Ganondorf:\x05\x40\x01""Leave him be. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Playing in a graveyard. He'll fit right in eventually." } },
{ 0x021E, { "\x05\x41Ganondorf:\x05\x40\x01""Come back some time. Or never.", "\x05\x41Ganondorf:\x05\x40\x01""Let him sleep. The world'll still be there when he wakes. Worse." } },
{ 0x0227, { "\x05\x41Ganondorf:\x05\x40\x01""Me. Of course. By the back door.", "\x05\x41Ganondorf:\x05\x40\x01""Juicy gossip. That's how every kingdom falls." } },
{ 0x0229, { "\x05\x41Ganondorf:\x05\x40\x01""Locked. Cute.", "\x05\x41Ganondorf:\x05\x40\x01""Come back when it's light. I'll come back when I like." } },
