{ 0x4002, { "\x05\x41Ganondorf:\x05\x40\x01""Peaceful. Not for me, owl.", "" } },
{ 0x4003, { "\x05\x41Ganondorf:\x05\x40\x01""The map. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""A beautiful lake. I'll try not to ruin it. Today." } },
