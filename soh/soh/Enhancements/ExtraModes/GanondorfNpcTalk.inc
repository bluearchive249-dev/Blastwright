{ 0x403E, { "\x05\x41Ganondorf:\x05\x40\x01""Ruto. You've grown.", "\x05\x41Ganondorf:\x05\x40\x01""Fiancee. You did say it. I'll try to forget." } },
{ 0x403F, { "\x05\x41Ganondorf:\x05\x40\x01""I see it.", "\x05\x41Ganondorf:\x05\x40\x01""Thanks. Really." } },
