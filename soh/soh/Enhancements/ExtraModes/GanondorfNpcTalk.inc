{ 0x406B, { "\x05\x41Ganondorf:\x05\x40\x01""Not for sale? Hm.", "\x05\x41Ganondorf:\x05\x40\x01""Keep your beans." } },
{ 0x406C, { "\x05\x41Ganondorf:\x05\x40\x01""Soft soil. Noted.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find it." } },
{ 0x4074, { "\x05\x41Ganondorf:\x05\x40\x01""Watching me. Good.", "\x05\x41Ganondorf:\x05\x40\x01""I'll leave. Thanks for the gift." } },
