// SoH: "Play as Ganondorf", his own lines in each conversation (GanondorfNpcs.cpp): a lead-in before their line, and
// his answer after it where the line ends the talk. Written for that NPC and that line, in his own voice: cynical, cruel
// and rude, his threats meant, answering what was actually said (a rare crack of warmth for Saria). Laid out when shown
// (GanondorfText.h), under his name.
// Kokiri Forest, the Lost Woods and the Deku Tree
{ 0x1001, { "\x05\x41Ganondorf:\x05\x40\x01""Relax. If I wanted you, you'd know.", "\x05\x41Ganondorf:\x05\x40\x01""And you're smaller than you'll ever know. Enjoy your forest. It won't last." } },
{ 0x1003, { "\x05\x41Ganondorf:\x05\x40\x01""Wait here. You're good at that.", "\x05\x41Ganondorf:\x05\x40\x01""Nice to a tree. Sure. As nice as he was to you, keeping you here forever." } },
{ 0x1006, { "\x05\x41Ganondorf:\x05\x40\x01""Ask. You'll hate the answer.", "\x05\x41Ganondorf:\x05\x40\x01""Your tree made you small and scared. Nobody made me. That's the difference." } },
{ 0x1008, { "\x05\x41Ganondorf:\x05\x40\x01""Your tree's rules. Your problem.", "" } },
{ 0x1009, { "\x05\x41Ganondorf:\x05\x40\x01""And you believe him. Of course you do.", "\x05\x41Ganondorf:\x05\x40\x01""No. Kokiri die if they leave. I'm the reason they won't want to." } },
{ 0x100A, { "\x05\x41Ganondorf:\x05\x40\x01""Welcome to how the world works, kid.", "" } },
{ 0x100B, { "\x05\x41Ganondorf:\x05\x40\x01""Cut it yourself.", "\x05\x41Ganondorf:\x05\x40\x01""Then ask why Mido gets the credit. First lesson in how the world works. Free of charge." } },
{ 0x100F, { "\x05\x41Ganondorf:\x05\x40\x01""Spit it out before you burst.", "" } },
{ 0x1010, { "\x05\x41Ganondorf:\x05\x40\x01""Summoned. By a dying tree. Lucky me.", "" } },
{ 0x1011, { "\x05\x41Ganondorf:\x05\x40\x01""Look at that. Tears. How useful.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone leaves, Saria. The smart ones don't look back." } },
{ 0x1012, { "\x05\x41Ganondorf:\x05\x40\x01""Out with it. Everyone wants something.", "\x05\x41Ganondorf:\x05\x40\x01""Friends forever. People say that right up until it costs them something." } },
{ 0x1013, { "\x05\x41Ganondorf:\x05\x40\x01""A gift. So I'll owe you.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. I'll owe you. Don't expect me to pay. ...But I'll keep it." } },
{ 0x1014, { "\x05\x41Ganondorf:\x05\x40\x01""There's always a catch.", "\x05\x41Ganondorf:\x05\x40\x01""I'll come back. You won't like what I bring." } },
{ 0x1019, { "\x05\x41Ganondorf:\x05\x40\x01""Advice from a child. Riveting.", "\x05\x41Ganondorf:\x05\x40\x01""Training is for people who lose. I've never had the time." } },
{ 0x101B, { "\x05\x41Ganondorf:\x05\x40\x01""Whispers. Good. Let them.", "\x05\x41Ganondorf:\x05\x40\x01""Fear travels faster than any messenger. Saves me the postage." } },
{ 0x101D, { "\x05\x41Ganondorf:\x05\x40\x01""Bad luck. Get used to it.", "\x05\x41Ganondorf:\x05\x40\x01""The world doesn't care about you. Better you learn it from me." } },
{ 0x101E, { "\x05\x41Ganondorf:\x05\x40\x01""A mask makes you tough. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Wear it. When the real monsters come, see how much it helps." } },
{ 0x101F, { "\x05\x41Ganondorf:\x05\x40\x01""Rupees. Always Rupees.", "" } },
{ 0x1020, { "\x05\x41Ganondorf:\x05\x40\x01""Your buddies want it. Then they'll want yours.", "\x05\x41Ganondorf:\x05\x40\x01""That's friendship. Wanting what the other one has." } },
{ 0x1021, { "\x05\x41Ganondorf:\x05\x40\x01""Shame. Yes. I'm full of disappointments.", "\x05\x41Ganondorf:\x05\x40\x01""You'd miss me. Admit it. Nobody else here talks to you like you're real." } },
{ 0x1023, { "\x05\x41Ganondorf:\x05\x40\x01""The usual spot. Pathetic. Sweet, but pathetic.", "\x05\x41Ganondorf:\x05\x40\x01""The only one not scared of me. Someone has to be the fool." } },
{ 0x1024, { "\x05\x41Ganondorf:\x05\x40\x01""Spare me. You knew it would end like this.", "\x05\x41Ganondorf:\x05\x40\x01""You had a hundred years to grow a spine. You grew bark." } },
{ 0x1026, { "\x05\x41Ganondorf:\x05\x40\x01""Short? You've been dying for a century.", "\x05\x41Ganondorf:\x05\x40\x01""I just saved you the boredom of the rest." } },
{ 0x1027, { "\x05\x41Ganondorf:\x05\x40\x01""Say it. You've had the speech ready for ages.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. Me. And you sat there teaching children to hide. You'd have died anyway. I just saved time." } },
{ 0x1028, { "\x05\x41Ganondorf:\x05\x40\x01""The Lost Woods. Where children go to vanish.", "\x05\x41Ganondorf:\x05\x40\x01""Big shots climb. Small ones stay in the village and wonder why nothing happens to them." } },
{ 0x1029, { "\x05\x41Ganondorf:\x05\x40\x01""You'd tell any other child. Not me.", "\x05\x41Ganondorf:\x05\x40\x01""Smart tree. Too late, but smart." } },
{ 0x102B, { "\x05\x41Ganondorf:\x05\x40\x01""Something bad. Me? Always.", "\x05\x41Ganondorf:\x05\x40\x01""Bad is just good with better results." } },
{ 0x102D, { "\x05\x41Ganondorf:\x05\x40\x01""Laugh. It's cheaper than crying.", "\x05\x41Ganondorf:\x05\x40\x01""You'll keep. Your kind always does, until it doesn't." } },
{ 0x102F, { "\x05\x41Ganondorf:\x05\x40\x01""Mr. Desert Giant. Creative.", "" } },
{ 0x1030, { "\x05\x41Ganondorf:\x05\x40\x01""Rules. The comfort of small minds.", "\x05\x41Ganondorf:\x05\x40\x01""Whatever I am, I'm walking past you. Try stopping me." } },
{ 0x1031, { "\x05\x41Ganondorf:\x05\x40\x01""Braver than you, at least.", "" } },
{ 0x1032, { "\x05\x41Ganondorf:\x05\x40\x01""One sword. For a forest full of children.", "\x05\x41Ganondorf:\x05\x40\x01""Your tree planned that well. Hide the weapon from the ones who'd need it." } },
{ 0x1033, { "\x05\x41Ganondorf:\x05\x40\x01""You're shaking, kid.", "" } },
{ 0x1034, { "\x05\x41Ganondorf:\x05\x40\x01""Mido. Still yelling.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody asked you. Nobody ever will. Get used to it. It's the only thing you'll be good at." } },
{ 0x103C, { "\x05\x41Ganondorf:\x05\x40\x01""Spending Rupees. That's how it starts.", "\x05\x41Ganondorf:\x05\x40\x01""Green is one, blue is five, red is twenty. And people are worth whatever someone pays." } },
{ 0x1040, { "\x05\x41Ganondorf:\x05\x40\x01""Figure it out. Everyone has to, alone.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody's coming to explain the world to you." } },
{ 0x1041, { "\x05\x41Ganondorf:\x05\x40\x01""Not quite. Like most things here.", "\x05\x41Ganondorf:\x05\x40\x01""Close only counts in stories." } },
{ 0x1042, { "\x05\x41Ganondorf:\x05\x40\x01""Upset. Mido. Breaking news.", "\x05\x41Ganondorf:\x05\x40\x01""I did. He'll thank me when he's older. He won't." } },
{ 0x1043, { "\x05\x41Ganondorf:\x05\x40\x01""The castle. And I'll take it, yes.", "\x05\x41Ganondorf:\x05\x40\x01""Someone will. Better me than the fools sitting in it." } },
{ 0x1044, { "\x05\x41Ganondorf:\x05\x40\x01""You'll die, will you. Conveniently.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be fine. The rest of you were never going anywhere anyway." } },
{ 0x1046, { "\x05\x41Ganondorf:\x05\x40\x01""Your house. It's a box with a door.", "\x05\x41Ganondorf:\x05\x40\x01""Too big for it. Too big for this whole forest." } },
{ 0x1047, { "\x05\x41Ganondorf:\x05\x40\x01""Safe. Funny word.", "" } },
{ 0x1048, { "\x05\x41Ganondorf:\x05\x40\x01""Forever. That word again.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody gets a say. That's the only true thing you've said." } },
{ 0x1049, { "\x05\x41Ganondorf:\x05\x40\x01""Something happened. Something always does.", "\x05\x41Ganondorf:\x05\x40\x01""I was there. You'll figure out the rest when you're older. You won't get older." } },
{ 0x104A, { "\x05\x41Ganondorf:\x05\x40\x01""You've got a nose. Pity about the brain.", "\x05\x41Ganondorf:\x05\x40\x01""That's sand and burning. Get used to the smell." } },
{ 0x104B, { "\x05\x41Ganondorf:\x05\x40\x01""Good. You meant it the first time.", "\x05\x41Ganondorf:\x05\x40\x01""Bye, kid. Don't wave. It's embarrassing." } },
{ 0x104C, { "\x05\x41Ganondorf:\x05\x40\x01""Angry is my resting state.", "\x05\x41Ganondorf:\x05\x40\x01""I'll come back however I like." } },
{ 0x104E, { "\x05\x41Ganondorf:\x05\x40\x01""Scared of everything. Sensible.", "\x05\x41Ganondorf:\x05\x40\x01""The monsters want to eat you. I just don't care. Pick your favourite." } },
{ 0x104F, { "\x05\x41Ganondorf:\x05\x40\x01""Saria ran off to play hero.", "" } },
{ 0x1050, { "\x05\x41Ganondorf:\x05\x40\x01""The far side of the woods. Got it.", "\x05\x41Ganondorf:\x05\x40\x01""Heroes always go to the far side. Nobody builds temples next door." } },
{ 0x1051, { "\x05\x41Ganondorf:\x05\x40\x01""Forgive me. Like that's ever mattered.", "\x05\x41Ganondorf:\x05\x40\x01""I haven't touched her. Your forgiveness is safe, and worthless." } },
{ 0x1052, { "\x05\x41Ganondorf:\x05\x40\x01""Eat you? You'd taste of leaves.", "\x05\x41Ganondorf:\x05\x40\x01""Deku Shields. Wood against the world. Adorable." } },
{ 0x1053, { "\x05\x41Ganondorf:\x05\x40\x01""My eyes know a lot. Most of it's ugly.", "" } },
{ 0x1054, { "\x05\x41Ganondorf:\x05\x40\x01""Hiding from me. The only smart thing he's done.", "\x05\x41Ganondorf:\x05\x40\x01""Mido's a coward with good instincts. Rare combination." } },
{ 0x1055, { "\x05\x41Ganondorf:\x05\x40\x01""Monsters don't worry me. I worry them.", "" } },
{ 0x1056, { "\x05\x41Ganondorf:\x05\x40\x01""Bored and scared. Childhood in a nutshell.", "\x05\x41Ganondorf:\x05\x40\x01""Stay in your box. The world out here eats people like you." } },
{ 0x1057, { "\x05\x41Ganondorf:\x05\x40\x01""Throw people? When they're asking for it.", "\x05\x41Ganondorf:\x05\x40\x01""A bow's a coward's weapon. Hit from far away, never see their face." } },
{ 0x1058, { "\x05\x41Ganondorf:\x05\x40\x01""That boy. Sure. Everybody's looking for someone.", "" } },
{ 0x1059, { "\x05\x41Ganondorf:\x05\x40\x01""Mido was right. Don't tell him.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone's right sometimes. Even idiots. Especially idiots." } },
{ 0x105A, { "\x05\x41Ganondorf:\x05\x40\x01""In a bad dream. I visit a lot of those.", "\x05\x41Ganondorf:\x05\x40\x01""You'll see me again. Close your eyes tonight." } },
{ 0x105B, { "\x05\x41Ganondorf:\x05\x40\x01""He left. People do.", "" } },
{ 0x105C, { "\x05\x41Ganondorf:\x05\x40\x01""He won't come back the same. Nobody does.", "\x05\x41Ganondorf:\x05\x40\x01""And he'll look like whatever the world makes him. Like me." } },
{ 0x105D, { "\x05\x41Ganondorf:\x05\x40\x01""Big and strong. You'd only waste it.", "" } },
{ 0x105E, { "\x05\x41Ganondorf:\x05\x40\x01""Never bigger. Lucky you.", "\x05\x41Ganondorf:\x05\x40\x01""Big just means more people come at you. Stay small. Stay alive." } },
{ 0x1060, { "\x05\x41Ganondorf:\x05\x40\x01""Fool you? I don't need to.", "" } },
{ 0x1061, { "\x05\x41Ganondorf:\x05\x40\x01""Especially not me. Cute.", "\x05\x41Ganondorf:\x05\x40\x01""Promises to Saria. Children make them like they'll hold." } },
{ 0x1062, { "\x05\x41Ganondorf:\x05\x40\x01""The sprout. Your father's sapling.", "\x05\x41Ganondorf:\x05\x40\x01""Yes, I'm the one who killed him. Grow faster. You'll need the head start." } },
{ 0x1063, { "\x05\x41Ganondorf:\x05\x40\x01""None of them knew me. Of course not.", "\x05\x41Ganondorf:\x05\x40\x01""They never grow up. Never learn. Never change. That's not peace, it's a cage." } },
{ 0x1064, { "\x05\x41Ganondorf:\x05\x40\x01""A Gerudo. I know what I am.", "\x05\x41Ganondorf:\x05\x40\x01""The one man born to them in a hundred years. Destined to rule. The goddesses rigged it, not me." } },
{ 0x1066, { "\x05\x41Ganondorf:\x05\x40\x01""Destiny. Lazy word for someone else's plan.", "\x05\x41Ganondorf:\x05\x40\x01""Break the curses. I'll break what I like and call it destiny afterward." } },
{ 0x1067, { "\x05\x41Ganondorf:\x05\x40\x01""Saria's song. Small world.", "" } },
{ 0x1068, { "\x05\x41Ganondorf:\x05\x40\x01""Him. Gone. He grew up.", "\x05\x41Ganondorf:\x05\x40\x01""The boy you remember died. I wear his face better." } },
{ 0x1069, { "\x05\x41Ganondorf:\x05\x40\x01""Even the King of Evil. Big words.", "\x05\x41Ganondorf:\x05\x40\x01""Dreams and reality. I've survived both. You won't survive me." } },
{ 0x106A, { "\x05\x41Ganondorf:\x05\x40\x01""Still my friend. Even now. Idiot.", "\x05\x41Ganondorf:\x05\x40\x01""...I never understood you, Saria. It's the one thing I don't hate about this place." } },
{ 0x106C, { "\x05\x41Ganondorf:\x05\x40\x01""Time's cruel. Finally, someone honest.", "\x05\x41Ganondorf:\x05\x40\x01""Memories don't change. That's why they hurt. That's why I don't keep many." } },
{ 0x106D, { "\x05\x41Ganondorf:\x05\x40\x01""Stay good. Too late for that.", "\x05\x41Ganondorf:\x05\x40\x01""Goodbye, Saria. Don't wait up." } },
{ 0x106E, { "\x05\x41Ganondorf:\x05\x40\x01""Unless I've done something. Maybe I have.", "\x05\x41Ganondorf:\x05\x40\x01""She'll come back. Or she won't. Either way you'll wait. That's what you do." } },
{ 0x106F, { "\x05\x41Ganondorf:\x05\x40\x01""Trust me. That's your mistake, not mine.", "" } },
{ 0x1070, { "\x05\x41Ganondorf:\x05\x40\x01""Promises. They break.", "" } },
{ 0x1071, { "\x05\x41Ganondorf:\x05\x40\x01""Him. Sure. I'll pass it on. Probably.", "" } },
{ 0x1073, { "\x05\x41Ganondorf:\x05\x40\x01""Nobody wanted to play with him. Good.", "\x05\x41Ganondorf:\x05\x40\x01""It taught him early. Nobody's coming. Take what you want." } },
{ 0x1074, { "\x05\x41Ganondorf:\x05\x40\x01""Minus the evil. That's the useful part.", "\x05\x41Ganondorf:\x05\x40\x01""You'll grow out of being good. Everyone does." } },
{ 0x1075, { "\x05\x41Ganondorf:\x05\x40\x01""He might. Who cares.", "\x05\x41Ganondorf:\x05\x40\x01""If he does, he'll have learned what I learned. The world bites." } },
{ 0x1076, { "\x05\x41Ganondorf:\x05\x40\x01""You should run. You won't.", "\x05\x41Ganondorf:\x05\x40\x01""Kokiri never learn. That's why the forest needs a guard." } },
{ 0x1077, { "\x05\x41Ganondorf:\x05\x40\x01""Some thanks. Don't strain yourself.", "\x05\x41Ganondorf:\x05\x40\x01""Back to normal. Normal is just the calm before the next thing." } },
{ 0x1078, { "\x05\x41Ganondorf:\x05\x40\x01""Even from me. Good luck.", "\x05\x41Ganondorf:\x05\x40\x01""Work together. Then turn on each other. That's how it always goes." } },
{ 0x1079, { "\x05\x41Ganondorf:\x05\x40\x01""A fair wind. Enjoy it. Winds change.", "\x05\x41Ganondorf:\x05\x40\x01""Strange things happen when I'm around. Mostly to other people." } },
{ 0x107A, { "\x05\x41Ganondorf:\x05\x40\x01""He'll come back. Keep telling yourself.", "\x05\x41Ganondorf:\x05\x40\x01""Hope is what people do instead of acting." } },
{ 0x107B, { "\x05\x41Ganondorf:\x05\x40\x01""She's busy being a Sage. Chained to a temple.", "\x05\x41Ganondorf:\x05\x40\x01""Saria finishes things. It's going to get her killed one day." } },
{ 0x107C, { "\x05\x41Ganondorf:\x05\x40\x01""You're sure. Children always are.", "" } },
{ 0x107D, { "\x05\x41Ganondorf:\x05\x40\x01""Back, tree? So am I.", "\x05\x41Ganondorf:\x05\x40\x01""I didn't come to finish the job. I came to watch you grow up knowing who did it." } },
{ 0x107E, { "\x05\x41Ganondorf:\x05\x40\x01""My search. My business.", "\x05\x41Ganondorf:\x05\x40\x01""The Sacred Realm. I'll find it. Your father couldn't stop me and neither will you." } },
{ 0x108F, { "\x05\x41Ganondorf:\x05\x40\x01""Destiny again. Everyone's favourite excuse.", "\x05\x41Ganondorf:\x05\x40\x01""We can't live in the same world. Fine. I'll take this one." } },
{ 0x1090, { "\x05\x41Ganondorf:\x05\x40\x01""Watch over me. You'll get tired.", "\x05\x41Ganondorf:\x05\x40\x01""Keep your medallion warm. I'll have use for it." } },
{ 0x1091, { "\x05\x41Ganondorf:\x05\x40\x01""Courage. Overrated. Strength works.", "\x05\x41Ganondorf:\x05\x40\x01""You don't understand it. Nobody does. That's why it works." } },
{ 0x1093, { "\x05\x41Ganondorf:\x05\x40\x01""The stone. Mine. Finally.", "\x05\x41Ganondorf:\x05\x40\x01""The Princess of Destiny. Another child with a title. I'll handle her." } },
{ 0x1094, { "\x05\x41Ganondorf:\x05\x40\x01""Different. Thank the goddesses.", "\x05\x41Ganondorf:\x05\x40\x01""You stay. I go. That's the difference between us." } },
{ 0x1097, { "\x05\x41Ganondorf:\x05\x40\x01""Backflips. Spare me.", "\x05\x41Ganondorf:\x05\x40\x01""I don't flip. I don't run. I walk, and things get out of my way." } },
{ 0x10A0, { "\x05\x41Ganondorf:\x05\x40\x01""Surrender's the only smart thing you've done.", "" } },
{ 0x10A1, { "\x05\x41Ganondorf:\x05\x40\x01""Deku Sticks. Cheap, like your loyalty.", "" } },
{ 0x10A2, { "\x05\x41Ganondorf:\x05\x40\x01""A Piece of Heart. Keep it, I've no use for one.", "" } },
{ 0x10A4, { "\x05\x41Ganondorf:\x05\x40\x01""Run, then. Further.", "\x05\x41Ganondorf:\x05\x40\x01""That's the spirit. Cowardice keeps you alive." } },
{ 0x10A5, { "\x05\x41Ganondorf:\x05\x40\x01""Even kings pay. For now.", "\x05\x41Ganondorf:\x05\x40\x01""When I'm king of all this, you'll pay me." } },
{ 0x10A6, { "\x05\x41Ganondorf:\x05\x40\x01""Mad? I don't waste anger on shrubs.", "\x05\x41Ganondorf:\x05\x40\x01""Come back again. I'll remember you. That's not good news." } },
{ 0x10A8, { "\x05\x41Ganondorf:\x05\x40\x01""Your secret place. Not anymore.", "" } },
{ 0x10AA, { "\x05\x41Ganondorf:\x05\x40\x01""Ready. Gentle fingers. Ugh.", "\x05\x41Ganondorf:\x05\x40\x01""Play, then. Before I change my mind." } },
{ 0x10AB, { "\x05\x41Ganondorf:\x05\x40\x01""Boring. Music is boring.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. Once more. Don't tell anyone." } },
{ 0x10AC, { "\x05\x41Ganondorf:\x05\x40\x01""Gentle. Don't spread that around.", "" } },
{ 0x10AD, { "\x05\x41Ganondorf:\x05\x40\x01""Anytime. Like a leash.", "\x05\x41Ganondorf:\x05\x40\x01""I'll call if I need you. Don't hold your breath." } },
{ 0x10AE, { "\x05\x41Ganondorf:\x05\x40\x01""It's fine. Stop asking.", "\x05\x41Ganondorf:\x05\x40\x01""Better than fine. I haven't sold it. Yet." } },
{ 0x10B0, { "\x05\x41Ganondorf:\x05\x40\x01""Sulking. Of course.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find him. He'll wish I hadn't." } },
{ 0x10B4, { "\x05\x41Ganondorf:\x05\x40\x01""Nice guy? Never claimed it.", "\x05\x41Ganondorf:\x05\x40\x01""Get away from me, then. Everyone does eventually." } },
{ 0x10B5, { "\x05\x41Ganondorf:\x05\x40\x01""She did. It went badly.", "\x05\x41Ganondorf:\x05\x40\x01""Saria wants to see everyone. It's a weakness." } },
{ 0x10B6, { "\x05\x41Ganondorf:\x05\x40\x01""The old hag. Charming.", "\x05\x41Ganondorf:\x05\x40\x01""Deliver this, fetch that. The whole world runs on errands." } },
{ 0x10B7, { "\x05\x41Ganondorf:\x05\x40\x01""Everybody, Stalfos. Fair enough.", "" } },
{ 0x10B9, { "\x05\x41Ganondorf:\x05\x40\x01""A scary Stalfos. I'd be terrifying.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody's turning me into anything." } },
{ 0x10BB, { "\x05\x41Ganondorf:\x05\x40\x01""Friends, because I know a song.", "\x05\x41Ganondorf:\x05\x40\x01""That's how cheap friendship is here. Fine. I'll take the gift." } },
{ 0x10BC, { "\x05\x41Ganondorf:\x05\x40\x01""Plain. Yes. Forgettable.", "\x05\x41Ganondorf:\x05\x40\x01""Mine's unforgettable. You're welcome." } },
{ 0x10BD, { "\x05\x41Ganondorf:\x05\x40\x01""Promise not to conquer you? No.", "\x05\x41Ganondorf:\x05\x40\x01""I'll play. Conquering's later." } },
{ 0x10BE, { "\x05\x41Ganondorf:\x05\x40\x01""Lead. I'll pretend to follow.", "" } },
{ 0x10BF, { "\x05\x41Ganondorf:\x05\x40\x01""For a warlord. Patronizing little stump.", "\x05\x41Ganondorf:\x05\x40\x01""Keep your gift. No, give it here. Free things are free things." } },
{ 0x10C0, { "\x05\x41Ganondorf:\x05\x40\x01""Watch me. You and everyone.", "" } },
{ 0x10C3, { "\x05\x41Ganondorf:\x05\x40\x01""Courage doesn't drive me. Owl's right.", "\x05\x41Ganondorf:\x05\x40\x01""Follow my ears. Spare me the riddles, bird." } },
{ 0x10C4, { "\x05\x41Ganondorf:\x05\x40\x01""Owl. Again. Lovely.", "" } },
{ 0x10C7, { "\x05\x41Ganondorf:\x05\x40\x01""Memorize them. Thank you, Captain Obvious.", "\x05\x41Ganondorf:\x05\x40\x01""I forget nothing. Ask the people who've crossed me." } },
{ 0x10C8, { "\x05\x41Ganondorf:\x05\x40\x01""He's not wrong. Mido rarely is about me.", "" } },
{ 0x10C9, { "\x05\x41Ganondorf:\x05\x40\x01""Since I arrived. Funny, that.", "" } },
{ 0x10CA, { "\x05\x41Ganondorf:\x05\x40\x01""Put down the fist? Make it worth my while.", "" } },
{ 0x10CB, { "\x05\x41Ganondorf:\x05\x40\x01""A steal. You'd know.", "" } },
{ 0x10CC, { "\x05\x41Ganondorf:\x05\x40\x01""Bombs. Finally, something useful.", "" } },
{ 0x10CD, { "\x05\x41Ganondorf:\x05\x40\x01""Arrows. Fine. For throwing at people.", "" } },
{ 0x10CE, { "\x05\x41Ganondorf:\x05\x40\x01""Red Potion. Overpriced, like everything here.", "" } },
{ 0x10CF, { "\x05\x41Ganondorf:\x05\x40\x01""My magic smells. Yours is non-existent.", "" } },
{ 0x10D1, { "\x05\x41Ganondorf:\x05\x40\x01""Me. Yes. Weep.", "" } },
{ 0x10D2, { "\x05\x41Ganondorf:\x05\x40\x01""These hands. Get used to them.", "" } },
{ 0x10D3, { "\x05\x41Ganondorf:\x05\x40\x01""A brute's still a brute. And still winning.", "" } },
{ 0x10D4, { "\x05\x41Ganondorf:\x05\x40\x01""I won't stomp you. Not worth the mud.", "" } },
{ 0x10D5, { "\x05\x41Ganondorf:\x05\x40\x01""Deku Nuts. Again. Riveting.", "" } },
{ 0x10D6, { "\x05\x41Ganondorf:\x05\x40\x01""I'll tell him. Or I won't.", "\x05\x41Ganondorf:\x05\x40\x01""Not scared of me. Sure, Mido. Keep telling yourself." } },
{ 0x10D7, { "\x05\x41Ganondorf:\x05\x40\x01""A real man. Finally, someone with eyes.", "" } },
{ 0x10D9, { "\x05\x41Ganondorf:\x05\x40\x01""What did I do? What I wanted.", "\x05\x41Ganondorf:\x05\x40\x01""He was old, slow and in my way. Get over it." } },
{ 0x10DA, { "\x05\x41Ganondorf:\x05\x40\x01""Right gear. Nothing in there would dare.", "\x05\x41Ganondorf:\x05\x40\x01""Except the woods themselves. They eat children. Watch your step." } },
{ 0x10DC, { "\x05\x41Ganondorf:\x05\x40\x01""More sticks. Thrilling.", "" } },
{ 0x10DD, { "\x05\x41Ganondorf:\x05\x40\x01""More nuts. Even more thrilling.", "" } },
{ 0x10DE, { "\x05\x41Ganondorf:\x05\x40\x01""So sorry. You will be.", "\x05\x41Ganondorf:\x05\x40\x01""Calm down. I don't hurt things this small. Not on purpose." } },
{ 0x10DF, { "\x05\x41Ganondorf:\x05\x40\x01""Everybody, Stalfos.", "\x05\x41Ganondorf:\x05\x40\x01""The forest's honest, at least. It eats everyone the same." } },
// Lon Lon Ranch and Hyrule Field
{ 0x2001, { "\x05\x41Ganondorf:\x05\x40\x01""The horse. Yes. She knows a winner.", "\x05\x41Ganondorf:\x05\x40\x01""She trusts me. Horses only care who feeds them. People are the same." } },
{ 0x2002, { "\x05\x41Ganondorf:\x05\x40\x01""Wild like me. She learned to obey. So will you.", "" } },
{ 0x2009, { "\x05\x41Ganondorf:\x05\x40\x01""Telling me. That's how you lose a kingdom.", "\x05\x41Ganondorf:\x05\x40\x01""Protect the Triforce. I'll protect it right into my own hand." } },
{ 0x200A, { "\x05\x41Ganondorf:\x05\x40\x01""A disguise? Do I look like I need one?", "" } },
{ 0x200D, { "\x05\x41Ganondorf:\x05\x40\x01""Awake. Barely. As usual.", "\x05\x41Ganondorf:\x05\x40\x01""Malon yelled at you. Your daughter's the only one on this ranch with a spine." } },
{ 0x200E, { "\x05\x41Ganondorf:\x05\x40\x01""I read Hylian. I just ignore it.", "\x05\x41Ganondorf:\x05\x40\x01""Signs are for people who ask permission." } },
{ 0x200F, { "\x05\x41Ganondorf:\x05\x40\x01""Your loss. Most things are.", "\x05\x41Ganondorf:\x05\x40\x01""Then don't. Nobody's forcing you. Yet." } },
{ 0x2011, { "\x05\x41Ganondorf:\x05\x40\x01""Hard work. You've never done any.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh louder. It makes the fear harder to hear." } },
{ 0x2014, { "\x05\x41Ganondorf:\x05\x40\x01""Mr. Ingo. Mister. Cute.", "\x05\x41Ganondorf:\x05\x40\x01""Scram, you were about to say. You almost had a backbone for a second." } },
{ 0x2016, { "\x05\x41Ganondorf:\x05\x40\x01""A present for your kid. Guilt, is it?", "\x05\x41Ganondorf:\x05\x40\x01""Buy the mask. Kids forgive anything for a toy." } },
{ 0x2017, { "\x05\x41Ganondorf:\x05\x40\x01""He's dead. It happens.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone stops breathing eventually. He just got there first." } },
{ 0x2018, { "\x05\x41Ganondorf:\x05\x40\x01""You know my name. Good.", "\x05\x41Ganondorf:\x05\x40\x01""Say it again. Louder. Get used to it." } },
{ 0x2019, { "\x05\x41Ganondorf:\x05\x40\x01""Lost her. You lose everything, don't you.", "\x05\x41Ganondorf:\x05\x40\x01""A cucco. You can't even keep a chicken." } },
{ 0x2022, { "\x05\x41Ganondorf:\x05\x40\x01""Pretending to be the gravekeeper. Aim higher.", "\x05\x41Ganondorf:\x05\x40\x01""Your face is the scariest thing in that graveyard. Use it." } },
{ 0x2024, { "\x05\x41Ganondorf:\x05\x40\x01""Sure you do. Show me.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone claims they have money. Until it's time to pay." } },
{ 0x2026, { "\x05\x41Ganondorf:\x05\x40\x01""Just like him. Dig, then.", "\x05\x41Ganondorf:\x05\x40\x01""Graves are the one business that never runs dry." } },
{ 0x2027, { "\x05\x41Ganondorf:\x05\x40\x01""He paid without a word. Smart kid.", "" } },
{ 0x2028, { "\x05\x41Ganondorf:\x05\x40\x01""Dig and dig. That's life.", "\x05\x41Ganondorf:\x05\x40\x01""You'll dig until you're the one in the hole. Same as everyone." } },
{ 0x2029, { "\x05\x41Ganondorf:\x05\x40\x01""A rabbit. Something easy to hunt.", "\x05\x41Ganondorf:\x05\x40\x01""Rabbits run. Wise of them. You won't." } },
{ 0x202A, { "\x05\x41Ganondorf:\x05\x40\x01""Legendary rabbit ears. Sure.", "" } },
{ 0x202C, { "\x05\x41Ganondorf:\x05\x40\x01""Then ask a better question.", "\x05\x41Ganondorf:\x05\x40\x01""Wanting the right answer doesn't make it come." } },
{ 0x202E, { "\x05\x41Ganondorf:\x05\x40\x01""More than I can count. People pay anything to make me leave.", "" } },
{ 0x2030, { "\x05\x41Ganondorf:\x05\x40\x01""Talon was weak. Correct.", "" } },
{ 0x2032, { "\x05\x41Ganondorf:\x05\x40\x01""My lord. Faster next time.", "\x05\x41Ganondorf:\x05\x40\x01""I'll come back. Have the place in better shape." } },
{ 0x2033, { "\x05\x41Ganondorf:\x05\x40\x01""The rules. You hide behind them well.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. I'll pay. And remember who paid." } },
{ 0x2039, { "\x05\x41Ganondorf:\x05\x40\x01""A king doesn't carry coins. A king takes them.", "\x05\x41Ganondorf:\x05\x40\x01""No stakes, no race. You learned that from me." } },
{ 0x203E, { "\x05\x41Ganondorf:\x05\x40\x01""Let me win. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""You won. Savor it. It's the last time." } },
{ 0x203F, { "\x05\x41Ganondorf:\x05\x40\x01""Big... sir. Good recovery.", "" } },
{ 0x2040, { "\x05\x41Ganondorf:\x05\x40\x01""A working man. Spare me.", "\x05\x41Ganondorf:\x05\x40\x01""Kings work. We just don't complain about it in front of the help." } },
{ 0x2042, { "\x05\x41Ganondorf:\x05\x40\x01""Your father. Asleep by the castle wall.", "\x05\x41Ganondorf:\x05\x40\x01""He's fine. Lazy, but fine. Like this whole country." } },
{ 0x2045, { "\x05\x41Ganondorf:\x05\x40\x01""Ingo complaining. Shocking.", "" } },
{ 0x2046, { "\x05\x41Ganondorf:\x05\x40\x01""Someone like me. You'd sell your soul for a promotion.", "\x05\x41Ganondorf:\x05\x40\x01""Good. That's why you're useful." } },
{ 0x2049, { "\x05\x41Ganondorf:\x05\x40\x01""Sing? With you? No.", "\x05\x41Ganondorf:\x05\x40\x01""Your mother wrote a good song. Shame it's all she left you." } },
{ 0x204B, { "\x05\x41Ganondorf:\x05\x40\x01""Asleep. Shocking.", "\x05\x41Ganondorf:\x05\x40\x01""Let him snore. It's the only thing he's good at." } },
{ 0x204C, { "\x05\x41Ganondorf:\x05\x40\x01""Since I came. Yes. All my doing.", "\x05\x41Ganondorf:\x05\x40\x01""The people left. The town's ruined. And the sun still comes up. Life goes on, mostly." } },
{ 0x204D, { "\x05\x41Ganondorf:\x05\x40\x01""Faster than anyone. Now what?", "\x05\x41Ganondorf:\x05\x40\x01""Happy or sad. Same thing, really. Both end." } },
{ 0x204E, { "\x05\x41Ganondorf:\x05\x40\x01""Stop that song. No.", "\x05\x41Ganondorf:\x05\x40\x01""Mumble all you like, Talon. You'll wake up to the same world." } },
{ 0x204F, { "\x05\x41Ganondorf:\x05\x40\x01""Death Mountain. Yes. I know.", "\x05\x41Ganondorf:\x05\x40\x01""The Gorons can keep their stone for now. I'm not in a hurry." } },
{ 0x2050, { "\x05\x41Ganondorf:\x05\x40\x01""Your secret's safe. Mine are worse.", "\x05\x41Ganondorf:\x05\x40\x01""Ingo won't hear it from me. He'd only cry about it." } },
{ 0x2051, { "\x05\x41Ganondorf:\x05\x40\x01""Ingo changed. People do, when you offer them enough.", "" } },
{ 0x2052, { "\x05\x41Ganondorf:\x05\x40\x01""Mine now. She chose well.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be good to her. Horses don't lie. People do." } },
{ 0x2053, { "\x05\x41Ganondorf:\x05\x40\x01""One-eyed stone. Judgy thing.", "\x05\x41Ganondorf:\x05\x40\x01""It looked away. Smart stone. Smarter than most people." } },
{ 0x2054, { "\x05\x41Ganondorf:\x05\x40\x01""A talking stone. Of course.", "\x05\x41Ganondorf:\x05\x40\x01""Go on, rock. Gossip." } },
{ 0x2055, { "\x05\x41Ganondorf:\x05\x40\x01""A new leaf. Good luck.", "\x05\x41Ganondorf:\x05\x40\x01""Never serve me again. Sure. Until I ask." } },
{ 0x2056, { "\x05\x41Ganondorf:\x05\x40\x01""Tempted. He wanted more. Everyone does.", "\x05\x41Ganondorf:\x05\x40\x01""Not a bad person. Just a weak one. There's a difference. Barely." } },
{ 0x2057, { "\x05\x41Ganondorf:\x05\x40\x01""Not easy being a working man. Or a lazy one.", "\x05\x41Ganondorf:\x05\x40\x01""Go back to sleep. The world will still be awful when you wake." } },
{ 0x2059, { "\x05\x41Ganondorf:\x05\x40\x01""I won't.", "" } },
{ 0x205D, { "\x05\x41Ganondorf:\x05\x40\x01""Normal price. For me. Bold.", "\x05\x41Ganondorf:\x05\x40\x01""Ingo will get mad. Ingo is always mad. It's his only talent." } },
{ 0x205F, { "\x05\x41Ganondorf:\x05\x40\x01""Honored. Your knees are shaking.", "\x05\x41Ganondorf:\x05\x40\x01""Do your job and I won't take it away. That's the deal." } },
{ 0x2060, { "\x05\x41Ganondorf:\x05\x40\x01""Watching me. Everyone is.", "\x05\x41Ganondorf:\x05\x40\x01""Watch, then. Learn something." } },
{ 0x2061, { "\x05\x41Ganondorf:\x05\x40\x01""With these hands. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""They crush things. They also play music. Life's full of surprises." } },
{ 0x2062, { "\x05\x41Ganondorf:\x05\x40\x01""Your village. Kakariko. Lovely.", "\x05\x41Ganondorf:\x05\x40\x01""Talk to the villagers. They'll tell me everything. They always do." } },
{ 0x2063, { "\x05\x41Ganondorf:\x05\x40\x01""A royal song. For me. Hilarious.", "\x05\x41Ganondorf:\x05\x40\x01""Proof of a connection to the Royal Family. Nothing proves that like owning it." } },
{ 0x2064, { "\x05\x41Ganondorf:\x05\x40\x01""Owl. Watching me again.", "" } },
{ 0x2065, { "\x05\x41Ganondorf:\x05\x40\x01""Treat her well. Sure.", "" } },
{ 0x2067, { "\x05\x41Ganondorf:\x05\x40\x01""Keep an eye on me. Bring both.", "\x05\x41Ganondorf:\x05\x40\x01""You'll be watching me a long time." } },
{ 0x206B, { "\x05\x41Ganondorf:\x05\x40\x01""Too smart. Thanks.", "\x05\x41Ganondorf:\x05\x40\x01""Luck is for people without plans." } },
{ 0x206E, { "\x05\x41Ganondorf:\x05\x40\x01""My quest. Alone. As always.", "\x05\x41Ganondorf:\x05\x40\x01""Choose wisely. I always do. It just never matches what you'd choose." } },
{ 0x2070, { "\x05\x41Ganondorf:\x05\x40\x01""Discouraged. Angry. Pick one.", "\x05\x41Ganondorf:\x05\x40\x01""Angry gets things done." } },
{ 0x2072, { "\x05\x41Ganondorf:\x05\x40\x01""Careful. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Go, he says. I was going anyway." } },
{ 0x208A, { "\x05\x41Ganondorf:\x05\x40\x01""No bottle. Story of my life.", "\x05\x41Ganondorf:\x05\x40\x01""Keep the milk. I'll take the cow later." } },
{ 0x208E, { "\x05\x41Ganondorf:\x05\x40\x01""An angle. Noted.", "\x05\x41Ganondorf:\x05\x40\x01""I'll try again. She does the work. I take the credit. That's the system." } },
// Death Mountain, Goron City and the Fire Temple
{ 0x3002, { "\x05\x41Ganondorf:\x05\x40\x01""You made this. Good.", "\x05\x41Ganondorf:\x05\x40\x01""Fine work. Shame you'll never sell it to anyone who matters." } },
{ 0x3003, { "\x05\x41Ganondorf:\x05\x40\x01""A souvenir. For me. Touching.", "\x05\x41Ganondorf:\x05\x40\x01""Not on Gorons. No promises." } },
{ 0x3004, { "\x05\x41Ganondorf:\x05\x40\x01""Surprised? I clean up when it suits me.", "\x05\x41Ganondorf:\x05\x40\x01""Not sworn brothers. Good. Brothers betray you. Debtors pay." } },
{ 0x3007, { "\x05\x41Ganondorf:\x05\x40\x01""Dance, Darunia. It suits you.", "\x05\x41Ganondorf:\x05\x40\x01""Hot beat. Cold heart. You'll learn." } },
{ 0x3008, { "\x05\x41Ganondorf:\x05\x40\x01""A Goron. Yes. Big rock.", "" } },
{ 0x3009, { "\x05\x41Ganondorf:\x05\x40\x01""Roll into me. Try.", "\x05\x41Ganondorf:\x05\x40\x01""Then you'd be a real man. A flat one." } },
{ 0x300B, { "\x05\x41Ganondorf:\x05\x40\x01""Bomb Flowers. I know what they are.", "\x05\x41Ganondorf:\x05\x40\x01""Raw material for bombs. You're sitting on a weapon and eating gravel. Brilliant." } },
{ 0x300D, { "\x05\x41Ganondorf:\x05\x40\x01""My cavern. Yes. Admire it.", "\x05\x41Ganondorf:\x05\x40\x01""Dim inside. Good. Bad things grow best in the dark." } },
{ 0x300E, { "\x05\x41Ganondorf:\x05\x40\x01""Visitors. Especially my kind.", "" } },
{ 0x3011, { "\x05\x41Ganondorf:\x05\x40\x01""Desert dog. Original.", "\x05\x41Ganondorf:\x05\x40\x01""Roll off your anger. It's not going anywhere. Neither am I." } },
{ 0x3013, { "\x05\x41Ganondorf:\x05\x40\x01""Mixed feelings. You'll get used to them.", "\x05\x41Ganondorf:\x05\x40\x01""Roll on. It's all you know how to do." } },
{ 0x3014, { "\x05\x41Ganondorf:\x05\x40\x01""Starving. I know. I did that.", "" } },
{ 0x3015, { "\x05\x41Ganondorf:\x05\x40\x01""Your sirloin rocks. Ask nicely.", "\x05\x41Ganondorf:\x05\x40\x01""Beg. You'd be surprised what begging gets you. Nothing, usually." } },
{ 0x3016, { "\x05\x41Ganondorf:\x05\x40\x01""Fall? You'd watch.", "" } },
{ 0x3017, { "\x05\x41Ganondorf:\x05\x40\x01""Waiting for the Royal messenger. Not me.", "\x05\x41Ganondorf:\x05\x40\x01""Your brother's waiting for rescue from people who forgot him. Typical." } },
{ 0x3018, { "\x05\x41Ganondorf:\x05\x40\x01""Food. That's all you think about.", "" } },
{ 0x3019, { "\x05\x41Ganondorf:\x05\x40\x01""The good old days. Before me. Funny how that works.", "" } },
{ 0x301A, { "\x05\x41Ganondorf:\x05\x40\x01""Me. Surprise.", "" } },
{ 0x301B, { "\x05\x41Ganondorf:\x05\x40\x01""A Goron problem. That I made.", "\x05\x41Ganondorf:\x05\x40\x01""Strangers help nobody. I'm the only one who showed up." } },
{ 0x301C, { "\x05\x41Ganondorf:\x05\x40\x01""Darunia. Big boss. Bigger temper.", "\x05\x41Ganondorf:\x05\x40\x01""One song and your anger melts. Your whole people sold for a tune." } },
{ 0x301D, { "\x05\x41Ganondorf:\x05\x40\x01""Undo my mess. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Then we'll talk. You'll talk. I'll take the stone." } },
{ 0x301E, { "\x05\x41Ganondorf:\x05\x40\x01""Just the tune. Not me. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""The tune's the only thing anyone ever liked about me." } },
{ 0x301F, { "\x05\x41Ganondorf:\x05\x40\x01""Even when I play it. Music doesn't care who plays.", "\x05\x41Ganondorf:\x05\x40\x01""That's the only honest thing in this mountain." } },
{ 0x3020, { "\x05\x41Ganondorf:\x05\x40\x01""Not desert music. Too bad.", "\x05\x41Ganondorf:\x05\x40\x01""Green and natural. You want what you don't have. Everyone does." } },
{ 0x3021, { "\x05\x41Ganondorf:\x05\x40\x01""Funny. I sealed it. I opened it.", "\x05\x41Ganondorf:\x05\x40\x01""Gratitude's awkward when the hero and the villain are the same man." } },
{ 0x3023, { "\x05\x41Ganondorf:\x05\x40\x01""Well done. You suppose. Generous.", "\x05\x41Ganondorf:\x05\x40\x01""Eat until you burst. Then remember who fed you." } },
{ 0x3024, { "\x05\x41Ganondorf:\x05\x40\x01""He took it away. Good to know.", "" } },
{ 0x3025, { "\x05\x41Ganondorf:\x05\x40\x01""Fire from his room. Errands for a king.", "\x05\x41Ganondorf:\x05\x40\x01""I'll bring it. Don't get used to it." } },
{ 0x3026, { "\x05\x41Ganondorf:\x05\x40\x01""Throw it at me. You'd miss.", "\x05\x41Ganondorf:\x05\x40\x01""Hindsight's a coward's courage." } },
{ 0x3027, { "\x05\x41Ganondorf:\x05\x40\x01""Me. Yes. Call me what you like.", "\x05\x41Ganondorf:\x05\x40\x01""I made the mess, I cleaned the mess. That's more than your chief did." } },
{ 0x3029, { "\x05\x41Ganondorf:\x05\x40\x01""Don't name your kid after me. Too late.", "\x05\x41Ganondorf:\x05\x40\x01""He'll grow up hearing it anyway. Names travel." } },
{ 0x302A, { "\x05\x41Ganondorf:\x05\x40\x01""Thrilled to see me. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""They'll be thrilled. Thrilled like rabbits." } },
{ 0x302C, { "\x05\x41Ganondorf:\x05\x40\x01""Lively. With torches. Wild.", "\x05\x41Ganondorf:\x05\x40\x01""Light all you want. The mountain's still a tomb." } },
{ 0x302E, { "\x05\x41Ganondorf:\x05\x40\x01""Out of Bombs. And hungry. And whining.", "" } },
{ 0x302F, { "\x05\x41Ganondorf:\x05\x40\x01""Furious. Yes. As expected.", "" } },
{ 0x3030, { "\x05\x41Ganondorf:\x05\x40\x01""THE Ganondorf. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody's getting you, kid. You're not worth the effort." } },
{ 0x3031, { "\x05\x41Ganondorf:\x05\x40\x01""Hero of the Gorons. Named after me. Hilarious.", "\x05\x41Ganondorf:\x05\x40\x01""Tremble? You're shaking enough for both of us." } },
{ 0x3032, { "\x05\x41Ganondorf:\x05\x40\x01""Your name's mine. Your dad has a sense of humour.", "" } },
{ 0x3035, { "\x05\x41Ganondorf:\x05\x40\x01""Volvagia. A dragon that ate Gorons.", "" } },
{ 0x3036, { "\x05\x41Ganondorf:\x05\x40\x01""My followers took them. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""To feed the dragon. Your father should've seen it coming." } },
{ 0x3037, { "\x05\x41Ganondorf:\x05\x40\x01""You're asking me. Desperate.", "" } },
{ 0x3038, { "\x05\x41Ganondorf:\x05\x40\x01""Move the statue. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""It's always a statue." } },
{ 0x3039, { "\x05\x41Ganondorf:\x05\x40\x01""Bigger, yes. You noticed.", "\x05\x41Ganondorf:\x05\x40\x01""Not the time. It never is, with you." } },
{ 0x303A, { "\x05\x41Ganondorf:\x05\x40\x01""Before you change your mind. Smart.", "\x05\x41Ganondorf:\x05\x40\x01""Don't thank me. I needed you alive. It's not the same." } },
{ 0x303B, { "\x05\x41Ganondorf:\x05\x40\x01""Hold it, Darunia.", "\x05\x41Ganondorf:\x05\x40\x01""Get out, he says. As if you could stop me staying." } },
{ 0x303C, { "\x05\x41Ganondorf:\x05\x40\x01""My own dragon. Yes. It was boring anyway.", "\x05\x41Ganondorf:\x05\x40\x01""It hurts to thank me. Good. Gratitude should hurt." } },
{ 0x303E, { "\x05\x41Ganondorf:\x05\x40\x01""True friendship. Grows over time. Like mould.", "\x05\x41Ganondorf:\x05\x40\x01""Even my heart. Don't hold your breath." } },
{ 0x303F, { "\x05\x41Ganondorf:\x05\x40\x01""As a friend. Or not at all. Not at all, then.", "" } },
{ 0x3041, { "\x05\x41Ganondorf:\x05\x40\x01""Together. Yes. Don't make it weird.", "" } },
{ 0x3042, { "\x05\x41Ganondorf:\x05\x40\x01""Strong like me. Good like your dad.", "\x05\x41Ganondorf:\x05\x40\x01""Pick one. You can't have both." } },
{ 0x3043, { "\x05\x41Ganondorf:\x05\x40\x01""Hard to say. I know.", "\x05\x41Ganondorf:\x05\x40\x01""Practise. You'll be saying it a lot." } },
{ 0x3044, { "\x05\x41Ganondorf:\x05\x40\x01""Capture you again? Don't tempt me.", "" } },
{ 0x3045, { "\x05\x41Ganondorf:\x05\x40\x01""Sage of Fire. You. Hilarious.", "\x05\x41Ganondorf:\x05\x40\x01""Destiny. Nothing like a word to make people swallow their fate." } },
{ 0x3046, { "\x05\x41Ganondorf:\x05\x40\x01""Your trust. A heavy, useless thing.", "\x05\x41Ganondorf:\x05\x40\x01""I won't waste it. I'll spend it." } },
{ 0x3047, { "\x05\x41Ganondorf:\x05\x40\x01""Even for me. Business is business.", "" } },
{ 0x3048, { "\x05\x41Ganondorf:\x05\x40\x01""An incredible story. Funny how it all happened.", "\x05\x41Ganondorf:\x05\x40\x01""The Dodongos. The boulder. Almost like someone planned it." } },
{ 0x3049, { "\x05\x41Ganondorf:\x05\x40\x01""Tight fit. Breathe in.", "" } },
{ 0x304A, { "\x05\x41Ganondorf:\x05\x40\x01""Something cool. Take your time.", "" } },
{ 0x304B, { "\x05\x41Ganondorf:\x05\x40\x01""Five or six years. I'll be busy.", "\x05\x41Ganondorf:\x05\x40\x01""Try not to conquer anything. I'll try not to laugh." } },
{ 0x304C, { "\x05\x41Ganondorf:\x05\x40\x01""A weapon. Now we're talking.", "" } },
{ 0x304D, { "\x05\x41Ganondorf:\x05\x40\x01""Light. Sharp. Good.", "\x05\x41Ganondorf:\x05\x40\x01""It'll do. For now." } },
{ 0x304E, { "\x05\x41Ganondorf:\x05\x40\x01""Durability issues. Like your people.", "" } },
{ 0x3050, { "\x05\x41Ganondorf:\x05\x40\x01""I will.", "\x05\x41Ganondorf:\x05\x40\x01""You'll be here. You've nowhere else to go." } },
{ 0x3051, { "\x05\x41Ganondorf:\x05\x40\x01""Eat you? You're not that appetizing.", "\x05\x41Ganondorf:\x05\x40\x01""A stomach ache. Fine. I'll pass." } },
{ 0x3052, { "\x05\x41Ganondorf:\x05\x40\x01""Desperate times. Big Brother sent me.", "\x05\x41Ganondorf:\x05\x40\x01""You owe me. Remember that, when it matters." } },
{ 0x3053, { "\x05\x41Ganondorf:\x05\x40\x01""Your brother's store. Competition. How dull.", "\x05\x41Ganondorf:\x05\x40\x01""Hylian craftsmanship. Good. Let's see if it breaks." } },
{ 0x3054, { "\x05\x41Ganondorf:\x05\x40\x01""Itchy eyes. Tragic.", "" } },
{ 0x3056, { "\x05\x41Ganondorf:\x05\x40\x01""Finished. Not yet.", "\x05\x41Ganondorf:\x05\x40\x01""Sit still. Someone'll fix you. Probably me. Unfortunately." } },
{ 0x3058, { "\x05\x41Ganondorf:\x05\x40\x01""Politely. Ha.", "\x05\x41Ganondorf:\x05\x40\x01""I'll say hello. He won't enjoy it." } },
{ 0x305A, { "\x05\x41Ganondorf:\x05\x40\x01""Working great. Good.", "" } },
{ 0x305C, { "\x05\x41Ganondorf:\x05\x40\x01""Even a king can wait. Can he.", "\x05\x41Ganondorf:\x05\x40\x01""A few days. Then I break the door down." } },
{ 0x305D, { "\x05\x41Ganondorf:\x05\x40\x01""Impatient. Like all tyrants. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""Tyrants who wait don't stay tyrants." } },
{ 0x305E, { "\x05\x41Ganondorf:\x05\x40\x01""Your finest. Shame about the wielder, you'll say.", "\x05\x41Ganondorf:\x05\x40\x01""Use it wisely. I'll use it." } },
{ 0x3062, { "\x05\x41Ganondorf:\x05\x40\x01""The summit. Clouds and moods. Poetic.", "\x05\x41Ganondorf:\x05\x40\x01""Death Mountain. Named by optimists." } },
{ 0x3063, { "\x05\x41Ganondorf:\x05\x40\x01""You won't call me a hero. Good.", "\x05\x41Ganondorf:\x05\x40\x01""Heroes die young. I'm not in a hurry." } },
{ 0x3064, { "\x05\x41Ganondorf:\x05\x40\x01""She won't want to see me. Nobody does.", "\x05\x41Ganondorf:\x05\x40\x01""She'll see me anyway." } },
{ 0x3065, { "\x05\x41Ganondorf:\x05\x40\x01""A big shield. I am one.", "" } },
{ 0x3067, { "\x05\x41Ganondorf:\x05\x40\x01""One lick of the stone? Disgusting.", "\x05\x41Ganondorf:\x05\x40\x01""The worst. Yes. Thanks for noticing." } },
{ 0x3068, { "\x05\x41Ganondorf:\x05\x40\x01""On monsters, not on you. We'll see.", "\x05\x41Ganondorf:\x05\x40\x01""I'll see the Great Fairy. She'll pretend she's happy." } },
{ 0x3069, { "\x05\x41Ganondorf:\x05\x40\x01""Even though I caged you. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""A secret from the prisoner. Doors that fall. Thanks." } },
{ 0x306A, { "\x05\x41Ganondorf:\x05\x40\x01""On fire? Roll forward. Riveting.", "\x05\x41Ganondorf:\x05\x40\x01""Fire's never bothered me." } },
{ 0x306B, { "\x05\x41Ganondorf:\x05\x40\x01""Dancing creatures. Arrows won't work.", "\x05\x41Ganondorf:\x05\x40\x01""Nothing works on the things that dance. Like politics." } },
{ 0x306C, { "\x05\x41Ganondorf:\x05\x40\x01""Cut the switches. Or blow them up.", "\x05\x41Ganondorf:\x05\x40\x01""Blow them up. Always blow them up." } },
{ 0x306D, { "\x05\x41Ganondorf:\x05\x40\x01""Can see it, can't reach it. Story of my life.", "\x05\x41Ganondorf:\x05\x40\x01""I'll play. The Ocarina fixes everything, apparently." } },
{ 0x306E, { "\x05\x41Ganondorf:\x05\x40\x01""The pillar. In the ceiling.", "\x05\x41Ganondorf:\x05\x40\x01""I'll bring it down. And the ceiling." } },
{ 0x306F, { "\x05\x41Ganondorf:\x05\x40\x01""A door in the statue. Clever.", "" } },
{ 0x3070, { "\x05\x41Ganondorf:\x05\x40\x01""Different sound. I'll knock on everything.", "\x05\x41Ganondorf:\x05\x40\x01""I'll knock on every wall. Someone's always hiding behind one." } },
// Zora's Domain, Zora's Fountain, Lake Hylia and the fishing pond
{ 0x4002, { "\x05\x41Ganondorf:\x05\x40\x01""Saria. Peace. Owl, you're boring.", "" } },
{ 0x4003, { "\x05\x41Ganondorf:\x05\x40\x01""The map. Thank you, mother.", "\x05\x41Ganondorf:\x05\x40\x01""A beautiful lake. Every beautiful thing is just waiting to be ruined." } },
{ 0x4004, { "\x05\x41Ganondorf:\x05\x40\x01""Hold your talons? I'd rather fall.", "" } },
{ 0x4006, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. Me. A Gerudo. Try to keep up.", "\x05\x41Ganondorf:\x05\x40\x01""Proud people. I love proud people. They fall so loudly." } },
{ 0x4007, { "\x05\x41Ganondorf:\x05\x40\x01""Can I swim? Better than you can think.", "\x05\x41Ganondorf:\x05\x40\x01""Your diving game. Sure. I'll take your prize and your pride." } },
{ 0x4008, { "\x05\x41Ganondorf:\x05\x40\x01""Jabu-Jabu. The big sick fish.", "" } },
{ 0x4009, { "\x05\x41Ganondorf:\x05\x40\x01""Sick since a Gerudo came by. Imagine that.", "\x05\x41Ganondorf:\x05\x40\x01""Your god eats out of a princess's hand. Then gets sick. Gods aren't what they used to be." } },
{ 0x400A, { "\x05\x41Ganondorf:\x05\x40\x01""Never me. Your king will learn.", "\x05\x41Ganondorf:\x05\x40\x01""Serve him. Then serve me. Loyalty's just habit." } },
{ 0x400B, { "\x05\x41Ganondorf:\x05\x40\x01""The Royal Chamber. Where the fat one sits.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find him. Can't miss him." } },
{ 0x400D, { "\x05\x41Ganondorf:\x05\x40\x01""Happy. Even me. Fish make everyone happy.", "\x05\x41Ganondorf:\x05\x40\x01""Feed the god a fish. That's your religion." } },
{ 0x400E, { "\x05\x41Ganondorf:\x05\x40\x01""Not good. For you.", "\x05\x41Ganondorf:\x05\x40\x01""I've seen Jabu-Jabu. Once was more than enough." } },
{ 0x400F, { "\x05\x41Ganondorf:\x05\x40\x01""You searched as far as the lake. Not far enough.", "\x05\x41Ganondorf:\x05\x40\x01""Princesses don't get lost. They get taken. Think about it." } },
{ 0x4010, { "\x05\x41Ganondorf:\x05\x40\x01""If I've harmed her... Finish the sentence.", "\x05\x41Ganondorf:\x05\x40\x01""You'll what? Splash me?" } },
{ 0x4011, { "\x05\x41Ganondorf:\x05\x40\x01""All the water. From one fountain.", "\x05\x41Ganondorf:\x05\x40\x01""One fountain, one throat. Easy to squeeze." } },
{ 0x4012, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. The Gerudo King saved you. Swallow it.", "\x05\x41Ganondorf:\x05\x40\x01""Breathing underwater? I don't need to. I just need you to." } },
{ 0x4013, { "\x05\x41Ganondorf:\x05\x40\x01""Worried again. Your princess runs a lot.", "\x05\x41Ganondorf:\x05\x40\x01""She'll turn up. They always do, usually at the worst time." } },
{ 0x4014, { "\x05\x41Ganondorf:\x05\x40\x01""Eye drops. You might have them. You do.", "" } },
{ 0x4016, { "\x05\x41Ganondorf:\x05\x40\x01""Spoil before I get there. Then I'll ride.", "\x05\x41Ganondorf:\x05\x40\x01""A king has a horse. And a schedule. Don't waste either." } },
{ 0x4017, { "\x05\x41Ganondorf:\x05\x40\x01""Comfortable in my role. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Zelda's waiting. Let her. Waiting is what royals do best." } },
{ 0x4018, { "\x05\x41Ganondorf:\x05\x40\x01""Big fellow. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""The old lady in Kakariko. Medicine and secrets. Everyone has both." } },
{ 0x401A, { "\x05\x41Ganondorf:\x05\x40\x01""Where has she gone? Ask the fish.", "" } },
{ 0x401B, { "\x05\x41Ganondorf:\x05\x40\x01""Inside the fish. Of course she is.", "" } },
{ 0x401C, { "\x05\x41Ganondorf:\x05\x40\x01""Undo what I've done. You're shouting.", "\x05\x41Ganondorf:\x05\x40\x01""Shout louder. It doesn't change anything, but it suits you." } },
{ 0x401E, { "\x05\x41Ganondorf:\x05\x40\x01""Oh no. Yes. Oh no.", "\x05\x41Ganondorf:\x05\x40\x01""Calm down. Panic is ugly on a king." } },
{ 0x401F, { "\x05\x41Ganondorf:\x05\x40\x01""Smug? Me? Always.", "\x05\x41Ganondorf:\x05\x40\x01""A Zora Tunic. Thank you. It almost makes up for the smell." } },
{ 0x4020, { "\x05\x41Ganondorf:\x05\x40\x01""Pretty Zora girl. Never heard of her.", "\x05\x41Ganondorf:\x05\x40\x01""Never forgive me. Get in line." } },
{ 0x4021, { "\x05\x41Ganondorf:\x05\x40\x01""Sorrow in the lake. Poetic.", "\x05\x41Ganondorf:\x05\x40\x01""The river carries whatever you throw in. Mostly people's problems." } },
{ 0x4022, { "\x05\x41Ganondorf:\x05\x40\x01""Useless. Late. Says the girl in the fish.", "\x05\x41Ganondorf:\x05\x40\x01""Lonely. Just a little. Not for me. Sure." } },
{ 0x4023, { "\x05\x41Ganondorf:\x05\x40\x01""Scared of the fish. Not me. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""You're terrified of me. It's fine. It's healthy." } },
{ 0x4024, { "\x05\x41Ganondorf:\x05\x40\x01""Yes, I'm here. Stop shrieking.", "\x05\x41Ganondorf:\x05\x40\x01""You'll call that name for the rest of your life now." } },
{ 0x4026, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. That one. The pretty rock.", "" } },
{ 0x4027, { "\x05\x41Ganondorf:\x05\x40\x01""Your husband. The engagement ring. Ha.", "\x05\x41Ganondorf:\x05\x40\x01""Give it to me. The marriage part I'll forget. You won't." } },
{ 0x4028, { "\x05\x41Ganondorf:\x05\x40\x01""He'd have me skewered. He'd try.", "\x05\x41Ganondorf:\x05\x40\x01""Your father couldn't skewer a fish." } },
{ 0x4029, { "\x05\x41Ganondorf:\x05\x40\x01""You know what I'm thinking? Doubt it.", "" } },
{ 0x402A, { "\x05\x41Ganondorf:\x05\x40\x01""Too expensive. Everything is, for the poor.", "\x05\x41Ganondorf:\x05\x40\x01""Catch your own. That's what I tell everyone." } },
{ 0x402B, { "\x05\x41Ganondorf:\x05\x40\x01""Thanks. You suppose. Generous.", "\x05\x41Ganondorf:\x05\x40\x01""Don't let it go to my head. My head's already got everything." } },
{ 0x402C, { "\x05\x41Ganondorf:\x05\x40\x01""For evil? Obviously.", "\x05\x41Ganondorf:\x05\x40\x01""It helped. That's all you need to know. Don't ask what." } },
{ 0x402D, { "\x05\x41Ganondorf:\x05\x40\x01""She talks about me. People can't help it.", "\x05\x41Ganondorf:\x05\x40\x01""Nobody understands it. That's what makes it work." } },
{ 0x402E, { "\x05\x41Ganondorf:\x05\x40\x01""Funny how that works. Isn't it.", "\x05\x41Ganondorf:\x05\x40\x01""I make things sick. Then I make them better. That's called leverage." } },
{ 0x402F, { "\x05\x41Ganondorf:\x05\x40\x01""A real king. Who sits on a pillow.", "\x05\x41Ganondorf:\x05\x40\x01""He has dignity. And a princess he can't keep track of." } },
{ 0x4030, { "\x05\x41Ganondorf:\x05\x40\x01""Run fast. In this armor. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Medicine without preservatives. Like Hylians. Doesn't last." } },
{ 0x4031, { "\x05\x41Ganondorf:\x05\x40\x01""Bigger and stronger. You noticed.", "\x05\x41Ganondorf:\x05\x40\x01""The Zoras serve the Royal Family. Not for long." } },
{ 0x4032, { "\x05\x41Ganondorf:\x05\x40\x01""Something I didn't steal. Rare.", "\x05\x41Ganondorf:\x05\x40\x01""I'll bring you something. You won't ask where it came from." } },
{ 0x4033, { "\x05\x41Ganondorf:\x05\x40\x01""Probably not to me. Ha. Watch.", "\x05\x41Ganondorf:\x05\x40\x01""Your king will hand it over. Kings always do, eventually." } },
{ 0x4036, { "\x05\x41Ganondorf:\x05\x40\x01""We meet again. Owl.", "" } },
{ 0x4037, { "\x05\x41Ganondorf:\x05\x40\x01""An evil curse. Mine, probably.", "\x05\x41Ganondorf:\x05\x40\x01""Shut off the source. That's how you deal with any problem." } },
{ 0x4038, { "\x05\x41Ganondorf:\x05\x40\x01""Noble ambition or tyranny. Same river.", "\x05\x41Ganondorf:\x05\x40\x01""The clear water you remember never existed. You were just young." } },
{ 0x4039, { "\x05\x41Ganondorf:\x05\x40\x01""This is what I made. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Admire it. Every kingdom ends up a frozen lake. I just got there first." } },
{ 0x403E, { "\x05\x41Ganondorf:\x05\x40\x01""Fiancee. Goddesses help me.", "\x05\x41Ganondorf:\x05\x40\x01""You said it. Out loud. I'll be using that against you forever." } },
{ 0x403F, { "\x05\x41Ganondorf:\x05\x40\x01""Not normal water. Thanks.", "\x05\x41Ganondorf:\x05\x40\x01""You care if I die. Interesting." } },
{ 0x4041, { "\x05\x41Ganondorf:\x05\x40\x01""Even a man like me. You chose badly.", "\x05\x41Ganondorf:\x05\x40\x01""Your people will come back. Don't thank me. I needed the water." } },
{ 0x4043, { "\x05\x41Ganondorf:\x05\x40\x01""She wanted to thank me. Of course she did.", "\x05\x41Ganondorf:\x05\x40\x01""Peace for her sake. Even me. Sure." } },
{ 0x4045, { "\x05\x41Ganondorf:\x05\x40\x01""The Water Temple. Again.", "\x05\x41Ganondorf:\x05\x40\x01""Your princess never could sit still. Or shut up." } },
{ 0x4046, { "\x05\x41Ganondorf:\x05\x40\x01""Eternal love. Pass.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it. It's worth what it costs, which is nothing." } },
{ 0x4047, { "\x05\x41Ganondorf:\x05\x40\x01""Zelda's alive. Shame.", "\x05\x41Ganondorf:\x05\x40\x01""Don't get your hopes up. I never do." } },
{ 0x4049, { "\x05\x41Ganondorf:\x05\x40\x01""You can't hide anything. Neither can you.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. I'm looking for her. You'll see why." } },
{ 0x404A, { "\x05\x41Ganondorf:\x05\x40\x01""Pray it's justice. Pray louder.", "\x05\x41Ganondorf:\x05\x40\x01""Respectfully. Fine. I'll respect it all the way to the bank." } },
{ 0x404B, { "\x05\x41Ganondorf:\x05\x40\x01""A Gerudo. In here. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Your father asked me to save you. That's how desperate he is." } },
{ 0x404F, { "\x05\x41Ganondorf:\x05\x40\x01""Throw you. With pleasure.", "\x05\x41Ganondorf:\x05\x40\x01""Big lug. Says the girl being thrown." } },
{ 0x4051, { "\x05\x41Ganondorf:\x05\x40\x01""Your mother's stone. Lost in a fish.", "\x05\x41Ganondorf:\x05\x40\x01""You lose everything, don't you. Hold on to it. Or don't." } },
{ 0x4052, { "\x05\x41Ganondorf:\x05\x40\x01""Carry you. Like luggage.", "\x05\x41Ganondorf:\x05\x40\x01""Hold still. You're heavier than your attitude." } },
{ 0x4057, { "\x05\x41Ganondorf:\x05\x40\x01""Undid my own evil. Don't get used to it.", "\x05\x41Ganondorf:\x05\x40\x01""I do what pays. Today it paid to be good." } },
{ 0x4058, { "\x05\x41Ganondorf:\x05\x40\x01""You want to believe. Of course you do.", "\x05\x41Ganondorf:\x05\x40\x01""Believe what you like. Belief's free. That's why it's worth nothing." } },
{ 0x4059, { "\x05\x41Ganondorf:\x05\x40\x01""Pure water. Back to normal.", "\x05\x41Ganondorf:\x05\x40\x01""All as it was. Nothing stays that way." } },
{ 0x4068, { "\x05\x41Ganondorf:\x05\x40\x01""Chomp chomp. Riveting.", "" } },
{ 0x4069, { "\x05\x41Ganondorf:\x05\x40\x01""Even if I glare. Brave beans.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be back with money. And the glare." } },
{ 0x406B, { "\x05\x41Ganondorf:\x05\x40\x01""Not for sale. Then why are they there?", "\x05\x41Ganondorf:\x05\x40\x01""Keep your beans. I'll take the field later." } },
{ 0x406C, { "\x05\x41Ganondorf:\x05\x40\x01""Soft soil. Like Hylians.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find it. I always find soft things." } },
{ 0x4074, { "\x05\x41Ganondorf:\x05\x40\x01""You've been watching me. Creepy.", "\x05\x41Ganondorf:\x05\x40\x01""Leave the lake. Gladly. It smells like you." } },
{ 0x4075, { "\x05\x41Ganondorf:\x05\x40\x01""Stay at the bottom. Subtle.", "\x05\x41Ganondorf:\x05\x40\x01""I can take a hint. I just don't." } },
{ 0x4076, { "\x05\x41Ganondorf:\x05\x40\x01""Stuck here with me. Lucky you.", "" } },
{ 0x407E, { "\x05\x41Ganondorf:\x05\x40\x01""Not enough money. As usual.", "" } },
{ 0x4085, { "\x05\x41Ganondorf:\x05\x40\x01""Neither will glaring. It works on kings.", "\x05\x41Ganondorf:\x05\x40\x01""I'll catch something. I always do." } },
{ 0x4088, { "\x05\x41Ganondorf:\x05\x40\x01""Conquering can wait. The fish don't care who I am.", "\x05\x41Ganondorf:\x05\x40\x01""That's the only honest relationship in Hyrule." } },
{ 0x408D, { "\x05\x41Ganondorf:\x05\x40\x01""Selfish. Of course I am.", "\x05\x41Ganondorf:\x05\x40\x01""A great angler doesn't change lures. A great king changes everything." } },
{ 0x408E, { "\x05\x41Ganondorf:\x05\x40\x01""Company secrets. Even from a king.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. I'll take the company later. Then the secrets." } },
{ 0x408F, { "\x05\x41Ganondorf:\x05\x40\x01""An old pro. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""I'm telling the truth, says every liar." } },
{ 0x4090, { "\x05\x41Ganondorf:\x05\x40\x01""No conquering. Fine print.", "" } },
{ 0x4092, { "\x05\x41Ganondorf:\x05\x40\x01""Bigger fish. Maybe.", "\x05\x41Ganondorf:\x05\x40\x01""Everything grows. Except your business." } },
{ 0x4094, { "\x05\x41Ganondorf:\x05\x40\x01""Out of business. Sad.", "" } },
{ 0x4095, { "\x05\x41Ganondorf:\x05\x40\x01""Nerves. I make people nervous.", "" } },
{ 0x4096, { "\x05\x41Ganondorf:\x05\x40\x01""Cloudy water. Cloudy brain.", "" } },
{ 0x409D, { "\x05\x41Ganondorf:\x05\x40\x01""Walk quietly. I'll try. Badly.", "" } },
{ 0x409E, { "\x05\x41Ganondorf:\x05\x40\x01""Not even me. Brave.", "\x05\x41Ganondorf:\x05\x40\x01""I'll return it. I don't steal rods. I steal kingdoms." } },
{ 0x40A1, { "\x05\x41Ganondorf:\x05\x40\x01""My evil little tunes. You remember them.", "\x05\x41Ganondorf:\x05\x40\x01""Then remember who wrote them." } },
{ 0x40A2, { "\x05\x41Ganondorf:\x05\x40\x01""Pierre. Your scarecrow friend.", "\x05\x41Ganondorf:\x05\x40\x01""I'll play. He'll come running. Everyone does." } },
{ 0x40AD, { "\x05\x41Ganondorf:\x05\x40\x01""Good golly. Indeed.", "\x05\x41Ganondorf:\x05\x40\x01""You forgot it. Lucky you." } },
{ 0x40AF, { "\x05\x41Ganondorf:\x05\x40\x01""A different lure. I found it.", "" } },
// Kakariko Village, the Graveyard and the windmill
{ 0x5000, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. Me. You're dead. Calm down.", "\x05\x41Ganondorf:\x05\x40\x01""The Sun's Song. Even the dead give me what I want." } },
{ 0x5001, { "\x05\x41Ganondorf:\x05\x40\x01""Boing. You found a toy.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it. Least of all me. Fine. It's junk anyway." } },
{ 0x500D, { "\x05\x41Ganondorf:\x05\x40\x01""Come back and visit. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh it up. You've got nothing to lose. You're dead." } },
{ 0x500E, { "\x05\x41Ganondorf:\x05\x40\x01""Even tyrants pay. Do they.", "\x05\x41Ganondorf:\x05\x40\x01""I'll be back with Rupees. And less patience." } },
{ 0x500F, { "\x05\x41Ganondorf:\x05\x40\x01""You died to keep this from me. And here I am.", "" } },
{ 0x5010, { "\x05\x41Ganondorf:\x05\x40\x01""Born to serve the Royal Family. Poor you.", "" } },
{ 0x5012, { "\x05\x41Ganondorf:\x05\x40\x01""Her scent. You can smell royalty.", "" } },
{ 0x5013, { "\x05\x41Ganondorf:\x05\x40\x01""Again. Dying gets old.", "" } },
{ 0x5014, { "\x05\x41Ganondorf:\x05\x40\x01""Sun and moon. Teach me both.", "" } },
{ 0x5015, { "\x05\x41Ganondorf:\x05\x40\x01""Talon. Sleep-talking. Again.", "\x05\x41Ganondorf:\x05\x40\x01""She's fine. You're not. Go back to sleep." } },
{ 0x5016, { "\x05\x41Ganondorf:\x05\x40\x01""Ingo did it to please me. Of course he did.", "\x05\x41Ganondorf:\x05\x40\x01""You got kicked out. Look at you. Exactly where weak men end up." } },
{ 0x5017, { "\x05\x41Ganondorf:\x05\x40\x01""Me of all people. Yes. Thank me.", "\x05\x41Ganondorf:\x05\x40\x01""Go back to the ranch. Ingo will be thrilled." } },
{ 0x5018, { "\x05\x41Ganondorf:\x05\x40\x01""Scary face. Mine's scarier. Thanks.", "" } },
{ 0x501A, { "\x05\x41Ganondorf:\x05\x40\x01""Nothing here. As usual.", "\x05\x41Ganondorf:\x05\x40\x01""Keep digging. That's your whole life." } },
{ 0x501B, { "\x05\x41Ganondorf:\x05\x40\x01""Back where? Make me.", "" } },
{ 0x501C, { "\x05\x41Ganondorf:\x05\x40\x01""Released. The shadow spirit. Impa's mess.", "\x05\x41Ganondorf:\x05\x40\x01""I'll deal with it. Don't mistake that for kindness." } },
{ 0x501D, { "\x05\x41Ganondorf:\x05\x40\x01""For once, protect someone. Charming.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. Just this once. Don't make it a habit." } },
{ 0x5022, { "\x05\x41Ganondorf:\x05\x40\x01""Impa. You feared I'd come. I came.", "\x05\x41Ganondorf:\x05\x40\x01""Princess Zelda's caretaker. You took good care. She still ended up talking to me." } },
{ 0x5024, { "\x05\x41Ganondorf:\x05\x40\x01""The final showdown. Exciting.", "\x05\x41Ganondorf:\x05\x40\x01""However it ends, Impa, you'll have lost something. You always do." } },
{ 0x5025, { "\x05\x41Ganondorf:\x05\x40\x01""Generation to generation. Servants forever.", "\x05\x41Ganondorf:\x05\x40\x01""Seven years ago I took everything. You're still bowing. That's loyalty for you." } },
{ 0x5026, { "\x05\x41Ganondorf:\x05\x40\x01""Every Sheikah alive. Sounds like a lot of work.", "\x05\x41Ganondorf:\x05\x40\x01""Protect her on your behalf. I'll protect her my way." } },
{ 0x5027, { "\x05\x41Ganondorf:\x05\x40\x01""My Cucco. Happy. Not scared of me.", "\x05\x41Ganondorf:\x05\x40\x01""Smart bird. Dumber than it looks." } },
{ 0x5028, { "\x05\x41Ganondorf:\x05\x40\x01""No ambition. Young men. Shocking.", "" } },
{ 0x5029, { "\x05\x41Ganondorf:\x05\x40\x01""Worthless, he says. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""Relax. I don't conquer carpenters. Not worth the paperwork." } },
{ 0x502A, { "\x05\x41Ganondorf:\x05\x40\x01""Goose bumps from chickens. A trooper.", "\x05\x41Ganondorf:\x05\x40\x01""She works with what she hates. That's called life." } },
{ 0x502B, { "\x05\x41Ganondorf:\x05\x40\x01""Out of my reach. For now.", "\x05\x41Ganondorf:\x05\x40\x01""Safe. Nothing stays safe." } },
{ 0x502C, { "\x05\x41Ganondorf:\x05\x40\x01""The Wise Ones will seal me. Will they.", "\x05\x41Ganondorf:\x05\x40\x01""Try. I'll wait. I've got time." } },
{ 0x502D, { "\x05\x41Ganondorf:\x05\x40\x01""Fast for a big man. I've had practice.", "\x05\x41Ganondorf:\x05\x40\x01""A Hookshot. Thanks. It'll be useful for dragging people closer." } },
{ 0x502E, { "\x05\x41Ganondorf:\x05\x40\x01""Fun and useful. Like me.", "\x05\x41Ganondorf:\x05\x40\x01""Very useful. I've pulled down more than walls with it." } },
{ 0x5030, { "\x05\x41Ganondorf:\x05\x40\x01""Coming around. Unfortunately.", "" } },
{ 0x5031, { "\x05\x41Ganondorf:\x05\x40\x01""Impa needs help. Shocking.", "\x05\x41Ganondorf:\x05\x40\x01""I'll go. Don't confuse that with caring." } },
{ 0x5032, { "\x05\x41Ganondorf:\x05\x40\x01""Around and around. Like your life.", "\x05\x41Ganondorf:\x05\x40\x01""Spin until you're sick. That's what happens here." } },
{ 0x5033, { "\x05\x41Ganondorf:\x05\x40\x01""Too fast. I did that.", "\x05\x41Ganondorf:\x05\x40\x01""Everything goes too fast eventually." } },
{ 0x5034, { "\x05\x41Ganondorf:\x05\x40\x01""That day. The Ocarina player. Me.", "\x05\x41Ganondorf:\x05\x40\x01""Next time, what? You'll yell louder?" } },
{ 0x5035, { "\x05\x41Ganondorf:\x05\x40\x01""A big, mean kid. Hello again.", "\x05\x41Ganondorf:\x05\x40\x01""I broke your windmill. I'll break it again." } },
{ 0x5036, { "\x05\x41Ganondorf:\x05\x40\x01""Your Cuccos ran away. Smart birds.", "\x05\x41Ganondorf:\x05\x40\x01""Fine. I'll bring them back. Then they can run again." } },
{ 0x5037, { "\x05\x41Ganondorf:\x05\x40\x01""Four more. Fine.", "" } },
{ 0x5038, { "\x05\x41Ganondorf:\x05\x40\x01""Three more.", "" } },
{ 0x5039, { "\x05\x41Ganondorf:\x05\x40\x01""Two more.", "" } },
{ 0x503A, { "\x05\x41Ganondorf:\x05\x40\x01""Last one. Finally.", "" } },
{ 0x503D, { "\x05\x41Ganondorf:\x05\x40\x01""Don't eat them? No promises.", "" } },
{ 0x503E, { "\x05\x41Ganondorf:\x05\x40\x01""Pocket Cucco. Portable misery.", "" } },
{ 0x5041, { "\x05\x41Ganondorf:\x05\x40\x01""Fast on my feet? Watch.", "\x05\x41Ganondorf:\x05\x40\x01""Lead on. Don't look back. It's bad for your nerves." } },
{ 0x5042, { "\x05\x41Ganondorf:\x05\x40\x01""Make your Cucco happy. My life's work.", "" } },
{ 0x5043, { "\x05\x41Ganondorf:\x05\x40\x01""A good Cucco Keeper. My new title.", "" } },
{ 0x5047, { "\x05\x41Ganondorf:\x05\x40\x01""Lonely. Yes. Get used to it.", "\x05\x41Ganondorf:\x05\x40\x01""Lonely's the default. Company is the exception." } },
{ 0x5048, { "\x05\x41Ganondorf:\x05\x40\x01""Mysterious smells. The Lost Woods.", "\x05\x41Ganondorf:\x05\x40\x01""Medicine from fairy places. You'll poison someone." } },
{ 0x5049, { "\x05\x41Ganondorf:\x05\x40\x01""Sniffing me. Stop.", "" } },
{ 0x504A, { "\x05\x41Ganondorf:\x05\x40\x01""The forest. That bum. Yes.", "" } },
{ 0x504C, { "\x05\x41Ganondorf:\x05\x40\x01""Just a little. Everyone wants a little.", "\x05\x41Ganondorf:\x05\x40\x01""A little leads to a lot. Ask me how I know." } },
{ 0x504F, { "\x05\x41Ganondorf:\x05\x40\x01""No cure for a fool or a tyrant. Correct.", "\x05\x41Ganondorf:\x05\x40\x01""And no reason to want one." } },
{ 0x5050, { "\x05\x41Ganondorf:\x05\x40\x01""Can't get down. Then don't.", "\x05\x41Ganondorf:\x05\x40\x01""The mountain doesn't care you're watching." } },
{ 0x5051, { "\x05\x41Ganondorf:\x05\x40\x01""Safer than looking at me. Yes.", "\x05\x41Ganondorf:\x05\x40\x01""Stars are just fires too far away to hurt you." } },
{ 0x5052, { "\x05\x41Ganondorf:\x05\x40\x01""Something's happening on the mountain. Yes. Me.", "\x05\x41Ganondorf:\x05\x40\x01""Don't worry. Fire rolls downhill slowly." } },
{ 0x5053, { "\x05\x41Ganondorf:\x05\x40\x01""Back to normal. For now.", "" } },
{ 0x5054, { "\x05\x41Ganondorf:\x05\x40\x01""Never coming down. Good plan.", "\x05\x41Ganondorf:\x05\x40\x01""Stay up there forever. The world won't miss you." } },
{ 0x5055, { "\x05\x41Ganondorf:\x05\x40\x01""Good to see me. You think.", "\x05\x41Ganondorf:\x05\x40\x01""A memento. Thanks. I'll forget it by morning." } },
{ 0x5057, { "\x05\x41Ganondorf:\x05\x40\x01""Manners from the twins? Hardly.", "" } },
{ 0x5058, { "\x05\x41Ganondorf:\x05\x40\x01""Listen to the chicken lady. Riveting.", "" } },
{ 0x5059, { "\x05\x41Ganondorf:\x05\x40\x01""My upbringing was excellent. For a desert.", "" } },
{ 0x505A, { "\x05\x41Ganondorf:\x05\x40\x01""Allergic to chickens. Chicken keeper.", "\x05\x41Ganondorf:\x05\x40\x01""We all end up serving what makes us itch." } },
{ 0x505B, { "\x05\x41Ganondorf:\x05\x40\x01""Yes. It's me. Oh well.", "" } },
{ 0x505C, { "\x05\x41Ganondorf:\x05\x40\x01""Scarier than a ghost. Correct.", "\x05\x41Ganondorf:\x05\x40\x01""The dead don't scare me. The living are worse." } },
{ 0x505D, { "\x05\x41Ganondorf:\x05\x40\x01""First time? I own this village now.", "" } },
{ 0x505E, { "\x05\x41Ganondorf:\x05\x40\x01""Make myself at home. Already have.", "\x05\x41Ganondorf:\x05\x40\x01""The food's not ready. Neither are you." } },
{ 0x505F, { "\x05\x41Ganondorf:\x05\x40\x01""Did I happen to Impa? Probably.", "\x05\x41Ganondorf:\x05\x40\x01""She's somewhere being noble. It's her hobby." } },
{ 0x5060, { "\x05\x41Ganondorf:\x05\x40\x01""Everyone has hardships. Mine just win.", "" } },
{ 0x5061, { "\x05\x41Ganondorf:\x05\x40\x01""Even him. Troubles. Wow.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone has troubles. Some of us turn them into armies." } },
{ 0x5062, { "\x05\x41Ganondorf:\x05\x40\x01""Back to the ranch. Happy. Good for him.", "\x05\x41Ganondorf:\x05\x40\x01""Happiness. Enjoy it while it lasts. It won't." } },
{ 0x5066, { "\x05\x41Ganondorf:\x05\x40\x01""Testing my courage. No. Testing yours.", "" } },
{ 0x5068, { "\x05\x41Ganondorf:\x05\x40\x01""A strange guy. Yes. We've met.", "\x05\x41Ganondorf:\x05\x40\x01""Strange and angry. My favourite combination." } },
{ 0x5069, { "\x05\x41Ganondorf:\x05\x40\x01""People are disgusting. Finally, someone sensible.", "\x05\x41Ganondorf:\x05\x40\x01""You're right. About everyone. Including yourself." } },
{ 0x506A, { "\x05\x41Ganondorf:\x05\x40\x01""Construction. Forever.", "\x05\x41Ganondorf:\x05\x40\x01""Your boss works you hard. That's what bosses are for." } },
{ 0x506B, { "\x05\x41Ganondorf:\x05\x40\x01""Dinner. Not with me.", "\x05\x41Ganondorf:\x05\x40\x01""I wasn't asking." } },
{ 0x506C, { "\x05\x41Ganondorf:\x05\x40\x01""Half a man each. Generous.", "\x05\x41Ganondorf:\x05\x40\x01""Lazy slackers. You've just described every worker in Hyrule." } },
{ 0x5070, { "\x05\x41Ganondorf:\x05\x40\x01""Six more. Fine.", "" } },
{ 0x5072, { "\x05\x41Ganondorf:\x05\x40\x01""Five more. Of course.", "" } },
{ 0x5074, { "\x05\x41Ganondorf:\x05\x40\x01""Never worked a day? I worked a kingdom.", "\x05\x41Ganondorf:\x05\x40\x01""Your hands look soft. That's what work does to Hylians." } },
{ 0x5075, { "\x05\x41Ganondorf:\x05\x40\x01""King of Thieves. You remembered.", "\x05\x41Ganondorf:\x05\x40\x01""Easy money doesn't exist. Somebody always pays." } },
{ 0x5076, { "\x05\x41Ganondorf:\x05\x40\x01""Your boss hides his house. Smart man.", "\x05\x41Ganondorf:\x05\x40\x01""I'll tell everyone. Kidding. Maybe." } },
{ 0x5079, { "\x05\x41Ganondorf:\x05\x40\x01""Free to go in. I go wherever I like.", "\x05\x41Ganondorf:\x05\x40\x01""Impa's house. Open to all. That's how you lose a house." } },
{ 0x507A, { "\x05\x41Ganondorf:\x05\x40\x01""Almost everyone. Not me.", "\x05\x41Ganondorf:\x05\x40\x01""I'll take it anyway." } },
{ 0x507B, { "\x05\x41Ganondorf:\x05\x40\x01""The ghost had a treasure. Interesting.", "\x05\x41Ganondorf:\x05\x40\x01""Ghosts and treasure. My two favourite things to rob." } },
{ 0x507C, { "\x05\x41Ganondorf:\x05\x40\x01""Yes, it's me. Happy now?", "\x05\x41Ganondorf:\x05\x40\x01""They believe you. Now they're terrified too. Congratulations." } },
{ 0x507D, { "\x05\x41Ganondorf:\x05\x40\x01""Seven years. Nobody believes you.", "\x05\x41Ganondorf:\x05\x40\x01""Prophets are always alone. Then they're right. Then they're dead." } },
{ 0x507E, { "\x05\x41Ganondorf:\x05\x40\x01""My fire. You put it out.", "\x05\x41Ganondorf:\x05\x40\x01""Next one, you won't." } },
{ 0x507F, { "\x05\x41Ganondorf:\x05\x40\x01""Timid. And now I show up.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh. I'll wait for the crying." } },
{ 0x5080, { "\x05\x41Ganondorf:\x05\x40\x01""Seeing things. Nope. Me.", "\x05\x41Ganondorf:\x05\x40\x01""Laughter dies. Funny how quickly." } },
{ 0x5081, { "\x05\x41Ganondorf:\x05\x40\x01""Funny clothes. Laugh.", "\x05\x41Ganondorf:\x05\x40\x01""I won't kill you. I'll let you live with that joke." } },
{ 0x5082, { "\x05\x41Ganondorf:\x05\x40\x01""Laughter's medicine. You'll need a lot.", "\x05\x41Ganondorf:\x05\x40\x01""Tough times. I'll make them tougher." } },
{ 0x5083, { "\x05\x41Ganondorf:\x05\x40\x01""On top of the world. On a roof.", "\x05\x41Ganondorf:\x05\x40\x01""You can't have the roof. I'll take the world." } },
{ 0x5084, { "\x05\x41Ganondorf:\x05\x40\x01""You'll fall.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone falls. Some of us push." } },
{ 0x5085, { "\x05\x41Ganondorf:\x05\x40\x01""The well dried up since I came. Correct.", "\x05\x41Ganondorf:\x05\x40\x01""Things have been bad since I came. Get used to it." } },
{ 0x5086, { "\x05\x41Ganondorf:\x05\x40\x01""Generous. She'd feed me too.", "\x05\x41Ganondorf:\x05\x40\x01""Generosity is just a slower way to be robbed." } },
{ 0x5087, { "\x05\x41Ganondorf:\x05\x40\x01""An eye to see the truth.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find it. The truth is usually uglier than you'd like." } },
{ 0x5088, { "\x05\x41Ganondorf:\x05\x40\x01""A rich family, cursed. Greed.", "\x05\x41Ganondorf:\x05\x40\x01""Greed doesn't curse you. Getting caught does." } },
{ 0x5089, { "\x05\x41Ganondorf:\x05\x40\x01""An annoying brute. Fair.", "\x05\x41Ganondorf:\x05\x40\x01""Enjoy each other. Love's a fine way to waste time." } },
{ 0x508A, { "\x05\x41Ganondorf:\x05\x40\x01""Ruin a kingdom elsewhere. I'm on it.", "\x05\x41Ganondorf:\x05\x40\x01""Personal space. Cute. I'll leave you both to it." } },
{ 0x508B, { "\x05\x41Ganondorf:\x05\x40\x01""My man Ingo. Fired the bearded one.", "" } },
{ 0x508C, { "\x05\x41Ganondorf:\x05\x40\x01""Carefree. In times I made hard.", "\x05\x41Ganondorf:\x05\x40\x01""Some men float. They drown last." } },
{ 0x508D, { "\x05\x41Ganondorf:\x05\x40\x01""Little Richard. The famous puppy.", "" } },
{ 0x508E, { "\x05\x41Ganondorf:\x05\x40\x01""The storm. Yes. I played it.", "\x05\x41Ganondorf:\x05\x40\x01""Grrr all you like. The windmill still turns for me." } },
// Gerudo Valley, the Fortress, the Training Ground and the Spirit Temple
{ 0x6000, { "\x05\x41Ganondorf:\x05\x40\x01""Halt? Me? Bold.", "\x05\x41Ganondorf:\x05\x40\x01""Forgiven. You were doing your job. Keep doing it." } },
{ 0x6001, { "\x05\x41Ganondorf:\x05\x40\x01""Hail me louder.", "\x05\x41Ganondorf:\x05\x40\x01""The ones who cheer loudest stab last. Remember that." } },
{ 0x6002, { "\x05\x41Ganondorf:\x05\x40\x01""Open it. I'm not getting younger.", "\x05\x41Ganondorf:\x05\x40\x01""Wait a moment. My whole life is waiting for gates." } },
{ 0x6003, { "\x05\x41Ganondorf:\x05\x40\x01""Lightly? I take nothing lightly.", "\x05\x41Ganondorf:\x05\x40\x01""Good. Stay dangerous. It's the only thing that keeps you alive." } },
{ 0x6005, { "\x05\x41Ganondorf:\x05\x40\x01""The desert gate. Mine. It always was.", "\x05\x41Ganondorf:\x05\x40\x01""Nabooru's out there. Being noble. It's exhausting to watch." } },
{ 0x6006, { "\x05\x41Ganondorf:\x05\x40\x01""The twins' orders. My mothers. Of course.", "\x05\x41Ganondorf:\x05\x40\x01""Get in there and keep quiet. Fine. I'll pretend I'm humble." } },
{ 0x6007, { "\x05\x41Ganondorf:\x05\x40\x01""The guards salute me. Your guts aren't the point.", "\x05\x41Ganondorf:\x05\x40\x01""Guts get you in. Fear keeps you in charge." } },
{ 0x600C, { "\x05\x41Ganondorf:\x05\x40\x01""A ship through time. Sail it, then.", "\x05\x41Ganondorf:\x05\x40\x01""I never thought of it that way. I never needed to." } },
{ 0x600E, { "\x05\x41Ganondorf:\x05\x40\x01""Guts. Of course I have them.", "\x05\x41Ganondorf:\x05\x40\x01""Lead on." } },
{ 0x600F, { "\x05\x41Ganondorf:\x05\x40\x01""No horse, no race. Even for me.", "\x05\x41Ganondorf:\x05\x40\x01""Rules for kings. Cute." } },
