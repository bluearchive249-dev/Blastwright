// SoH: "Play as Ganondorf", his greetings and goodbyes (GanondorfNpcs.cpp): a first pass, Kokiri Forest. Each line
// written for that NPC and that line; his own box before theirs, and his last word after it.
{ 0x1006, { "\x05\x41Ganondorf:\x05\x40\x01Little sprout. Run along and\x01""ask your tree what it made.\x01I'll wait.", "\x05\x41Ganondorf:\x05\x40\x01""Ask him soon. Trees burn so\x01""easily these days." } },
{ 0x1009, { "\x05\x41Ganondorf:\x05\x40\x01""Afraid to step past the trees,\x01""child? How sensible.", "\x05\x41Ganondorf:\x05\x40\x01Stay in your little woods,\x01then. I'll bring the world to\x01you." } },
{ 0x1021, { "\x05\x41Ganondorf:\x05\x40\x01""Disappointed to see me, little\x01one? Good. Fear suits you.", "\x05\x41Ganondorf:\x05\x40\x01Keep watching the forest's\x01""edge. I'll be the shadow on it." } },
{ 0x1023, { "\x05\x41Ganondorf:\x05\x40\x01You there. Where does the girl\x01with the ocarina hide?", "\x05\x41Ganondorf:\x05\x40\x01Tell no one I asked. Or do.\x01They'll fear me either way." } },
{ 0x1028, { "\x05\x41Ganondorf:\x05\x40\x01Speak, child. I'm told someone\x01here knows the way.", "\x05\x41Ganondorf:\x05\x40\x01Up the cliff, then. The woods\x01will learn my name." } },
{ 0x1042, { "\x05\x41Ganondorf:\x05\x40\x01""Ah, Mido's little herald. Has\x01the boy been crying again?", "\x05\x41Ganondorf:\x05\x40\x01Tell Mido his king sends his\x01regards. Then watch him run." } },
{ 0x1049, { "\x05\x41Ganondorf:\x05\x40\x01Such a worried face. Has\x01something wilted, child?", "\x05\x41Ganondorf:\x05\x40\x01Wonder all you like. Old trees\x01""die. I merely helped." } },
{ 0x104A, { "\x05\x41Ganondorf:\x05\x40\x01""Breathe deep, little one. Smell\x01that? That's change.", "\x05\x41Ganondorf:\x05\x40\x01Get used to it. Soon the whole\x01""forest will smell of it." } },
{ 0x104C, { "\x05\x41Ganondorf:\x05\x40\x01""A shield? I need no shield,\x01""child. Others need one from me.", "\x05\x41Ganondorf:\x05\x40\x01Pray I never come back angry.\x01Pray harder that I do not." } },
{ 0x1052, { "\x05\x41Ganondorf:\x05\x40\x01Tremble less, little merchant.\x01I'm not hungry. Yet.", "\x05\x41Ganondorf:\x05\x40\x01Keep your toy shields. Kings\x01""carry their own protection." } },
{ 0x1054, { "\x05\x41Ganondorf:\x05\x40\x01You look restless. Lost your\x01""fearless leader?", "\x05\x41Ganondorf:\x05\x40\x01When Mido stops hiding, tell\x01him I'm waiting. Patiently." } },
{ 0x1056, { "\x05\x41Ganondorf:\x05\x40\x01Hiding indoors? Wise. Walls\x01make people feel safe.", "\x05\x41Ganondorf:\x05\x40\x01Stay bored, child. Boredom is\x01""better than the alternative." } },
{ 0x1057, { "\x05\x41Ganondorf:\x05\x40\x01""Arrows, bows... such small\x01weapons for small hands.", "\x05\x41Ganondorf:\x05\x40\x01I'll throw something bigger.\x01Mind your windows." } },
{ 0x105A, { "\x05\x41Ganondorf:\x05\x40\x01You stare as if you know me. Do\x01you, child?", "\x05\x41Ganondorf:\x05\x40\x01Sleep well tonight. If you can." } },
{ 0x1073, { "\x05\x41Ganondorf:\x05\x40\x01Still staring, little one? Take\x01""a good long look.", "\x05\x41Ganondorf:\x05\x40\x01No one wanted to play with him?\x01Then he made his own game." } },
{ 0x1074, { "\x05\x41Ganondorf:\x05\x40\x01You admire strength? Then you\x01""admire me, child.", "\x05\x41Ganondorf:\x05\x40\x01Grow strong someday. Then come\x01""and kneel properly." } },
{ 0x1076, { "\x05\x41Ganondorf:\x05\x40\x01You've known me long, you say?\x01Since your nightmares, perhaps.", "\x05\x41Ganondorf:\x05\x40\x01Run, then. I like to watch them\x01run." } },
{ 0x1078, { "\x05\x41Ganondorf:\x05\x40\x01Protect the forest from me? How\x01""brave. How small.", "\x05\x41Ganondorf:\x05\x40\x01Work together, children. It\x01makes you easier to find." } },
{ 0x1079, { "\x05\x41Ganondorf:\x05\x40\x01""A fair wind, you say? Winds\x01""change, child.", "\x05\x41Ganondorf:\x05\x40\x01""Enjoy the breeze. Storms start\x01the same way." } },
{ 0x10BC, { "\x05\x41Ganondorf:\x05\x40\x01Plain? Child, you should see\x01""faces I have made afraid.", "\x05\x41Ganondorf:\x05\x40\x01Keep your plain face. It's\x01""forgettable. That keeps you\x01""alive." } },
{ 0x1097, { "\x05\x41Ganondorf:\x05\x40\x01""Backflips? I prefer to watch\x01the world flip for me.", "\x05\x41Ganondorf:\x05\x40\x01In this armour I do not leap,\x01""child. I land. Heavily." } },
// Kokiri Forest, the Lost Woods and the Deku Tree: the rest (his lead-in before their line; his answer after it,
// where the line ends the talk)
{ 0x1001, { "\x05\x41Ganondorf:\x05\x40\x01""The little flute-player. You\x01""are the one they call Saria.", "\x05\x41Ganondorf:\x05\x40\x01""Bigger, older, and a king. You\x01""count well, child." } },
{ 0x1003, { "\x05\x41Ganondorf:\x05\x40\x01""You are still here, girl. Loyal\x01""little thing.", "\x05\x41Ganondorf:\x05\x40\x01""Nice? I shall be exactly as\x01""nice as the tree deserves." } },
{ 0x1008, { "\x05\x41Ganondorf:\x05\x40\x01""Guarding the way out, sprout?\x01""From me?", "" } },
{ 0x100A, { "\x05\x41Ganondorf:\x05\x40\x01""You look worn, child. Has\x01""someone put you to work?", "" } },
{ 0x100B, { "\x05\x41Ganondorf:\x05\x40\x01""You have a favour to ask. Of\x01""me. How novel.", "\x05\x41Ganondorf:\x05\x40\x01""A king, cutting grass. I will\x01""pretend you did not ask." } },
{ 0x100F, { "\x05\x41Ganondorf:\x05\x40\x01""You have news, little one. Out\x01""with it.", "" } },
{ 0x1010, { "\x05\x41Ganondorf:\x05\x40\x01""Word travels fast among the\x01""leaves, I see.", "" } },
{ 0x1011, { "\x05\x41Ganondorf:\x05\x40\x01""There she is. Waiting on the\x01""bridge like a sentry.", "\x05\x41Ganondorf:\x05\x40\x01""Leaving? I am only beginning." } },
{ 0x1012, { "\x05\x41Ganondorf:\x05\x40\x01""Say what you came to say, girl.", "\x05\x41Ganondorf:\x05\x40\x01""Forever is a long time to keep\x01""bad company. But yes." } },
{ 0x1013, { "\x05\x41Ganondorf:\x05\x40\x01""What is that you are holding\x01""out to me?", "\x05\x41Ganondorf:\x05\x40\x01""An ocarina. Small. But I know\x01""what songs can open." } },
{ 0x1014, { "\x05\x41Ganondorf:\x05\x40\x01""You have more to say. Be quick,\x01""the bridge is draughty.", "\x05\x41Ganondorf:\x05\x40\x01""I will come back. Whether the\x01""forest enjoys it is another\x01""matter." } },
{ 0x1019, { "\x05\x41Ganondorf:\x05\x40\x01""You have advice for me, child?\x01""This should be rich.", "\x05\x41Ganondorf:\x05\x40\x01""I learned to fight before your\x01""tree learned to talk." } },
{ 0x101B, { "\x05\x41Ganondorf:\x05\x40\x01""You are staring at the mask,\x01""little one.", "\x05\x41Ganondorf:\x05\x40\x01""Whispers. Good. Let them grow\x01""into screams." } },
{ 0x101D, { "\x05\x41Ganondorf:\x05\x40\x01""Something disappoints you,\x01""child?", "\x05\x41Ganondorf:\x05\x40\x01""Your loss troubles me less than\x01""you can imagine." } },
{ 0x101E, { "\x05\x41Ganondorf:\x05\x40\x01""You seem pleased with yourself.", "\x05\x41Ganondorf:\x05\x40\x01""Wear it well. Fear is the only\x01""armour that fits everyone." } },
{ 0x101F, { "\x05\x41Ganondorf:\x05\x40\x01""You are about to scold me. Do\x01""think twice.", "" } },
{ 0x1020, { "\x05\x41Ganondorf:\x05\x40\x01""Your little friends want\x01""something of mine?", "\x05\x41Ganondorf:\x05\x40\x01""Then let them come and ask me\x01""themselves. If they dare." } },
{ 0x1024, { "\x05\x41Ganondorf:\x05\x40\x01""Old tree. You still have breath\x01""to spend on me.", "\x05\x41Ganondorf:\x05\x40\x01""Spare me your praise. I came\x01""for the stone." } },
{ 0x1026, { "\x05\x41Ganondorf:\x05\x40\x01""You sound tired, guardian. I\x01""wonder why.", "\x05\x41Ganondorf:\x05\x40\x01""I did. And I would again. Rest,\x01""tree." } },
{ 0x1027, { "\x05\x41Ganondorf:\x05\x40\x01""Go on, old one. Tell the tale.\x01""I know how it ends.", "\x05\x41Ganondorf:\x05\x40\x01""A wicked man of the desert. How\x01""well you describe me." } },
{ 0x1029, { "\x05\x41Ganondorf:\x05\x40\x01""A last command from a dying\x01""tree. To me, of all men.", "\x05\x41Ganondorf:\x05\x40\x01""You ask the wolf to guard the\x01""lamb. Even dying, you amuse me." } },
{ 0x102B, { "\x05\x41Ganondorf:\x05\x40\x01""The fairy speaks. It has\x01""opinions, I see.", "\x05\x41Ganondorf:\x05\x40\x01""Something bad? No. Something\x01""magnificent." } },
{ 0x102D, { "\x05\x41Ganondorf:\x05\x40\x01""You find something funny,\x01""sprout?", "\x05\x41Ganondorf:\x05\x40\x01""Laugh while you can. I am\x01""keeping count." } },
{ 0x102F, { "\x05\x41Ganondorf:\x05\x40\x01""You. The loud one. You are in\x01""my road.", "" } },
{ 0x1030, { "\x05\x41Ganondorf:\x05\x40\x01""Rules. You are quoting rules.\x01""At me.", "\x05\x41Ganondorf:\x05\x40\x01""Rules are for those too weak to\x01""break them, boy." } },
{ 0x1031, { "\x05\x41Ganondorf:\x05\x40\x01""What has the little chief done\x01""now?", "" } },
{ 0x1032, { "\x05\x41Ganondorf:\x05\x40\x01""You sell advice now, child?", "\x05\x41Ganondorf:\x05\x40\x01""I carry a sword taller than\x01""you. Keep your toy." } },
{ 0x1033, { "\x05\x41Ganondorf:\x05\x40\x01""Still barring the path, Mido?", "" } },
{ 0x1034, { "\x05\x41Ganondorf:\x05\x40\x01""The great Mido. Do go on, I\x01""enjoy theatre.", "\x05\x41Ganondorf:\x05\x40\x01""Her friend? I am no one's\x01""friend, boy. She will learn\x01""that last." } },
{ 0x103C, { "\x05\x41Ganondorf:\x05\x40\x01""You look as if you are bursting\x01""to tell someone something.", "\x05\x41Ganondorf:\x05\x40\x01""Rupees. Your whole forest could\x01""not ransom my horse." } },
{ 0x1040, { "\x05\x41Ganondorf:\x05\x40\x01""You were explaining something,\x01""child.", "\x05\x41Ganondorf:\x05\x40\x01""I do not play. I master." } },
{ 0x1041, { "\x05\x41Ganondorf:\x05\x40\x01""You wince, child. The tune\x01""offends you?", "\x05\x41Ganondorf:\x05\x40\x01""It will be the right song when\x01""I say it is." } },
{ 0x1043, { "\x05\x41Ganondorf:\x05\x40\x01""Why do you gape at me, sprout?", "\x05\x41Ganondorf:\x05\x40\x01""Take it over? What a clever\x01""child you are." } },
{ 0x1044, { "\x05\x41Ganondorf:\x05\x40\x01""You look frightened. More than\x01""usual.", "\x05\x41Ganondorf:\x05\x40\x01""Then stay and wither here. The\x01""world outside is spoken for." } },
{ 0x1046, { "\x05\x41Ganondorf:\x05\x40\x01""A small house. A small owner.\x01""Loud, though.", "\x05\x41Ganondorf:\x05\x40\x01""Your house is mine while I\x01""stand in it. Be glad I am\x01""leaving." } },
{ 0x1047, { "\x05\x41Ganondorf:\x05\x40\x01""The girl again. And relieved,\x01""by the look of her.", "" } },
{ 0x1048, { "\x05\x41Ganondorf:\x05\x40\x01""You have something to announce,\x01""child.", "\x05\x41Ganondorf:\x05\x40\x01""Then she has chosen her friends\x01""poorly. It is not my concern." } },
{ 0x104B, { "\x05\x41Ganondorf:\x05\x40\x01""You are watching me go, little\x01""one.", "\x05\x41Ganondorf:\x05\x40\x01""Bye. Such a small word for such\x01""a large relief." } },
{ 0x104E, { "\x05\x41Ganondorf:\x05\x40\x01""You look over your shoulder a\x01""great deal, child.", "\x05\x41Ganondorf:\x05\x40\x01""Monsters come when a guardian\x01""dies. I know. I arranged it." } },
{ 0x104F, { "\x05\x41Ganondorf:\x05\x40\x01""You smell it too, child. The\x01""wind has changed.", "" } },
{ 0x1050, { "\x05\x41Ganondorf:\x05\x40\x01""You know where the temple lies.\x01""Say it.", "\x05\x41Ganondorf:\x05\x40\x01""The far side of the woods. My\x01""phantom keeps it warm for me." } },
{ 0x1051, { "\x05\x41Ganondorf:\x05\x40\x01""You have an accusation in your\x01""eyes, sprout.", "\x05\x41Ganondorf:\x05\x40\x01""Forgive me? Child, I have never\x01""once asked to be forgiven." } },
{ 0x1053, { "\x05\x41Ganondorf:\x05\x40\x01""You are looking for someone,\x01""little one.", "" } },
{ 0x1055, { "\x05\x41Ganondorf:\x05\x40\x01""You watched me come in. I saw\x01""you watching.", "" } },
{ 0x1058, { "\x05\x41Ganondorf:\x05\x40\x01""You ask every traveller the\x01""same question, don't you.", "" } },
{ 0x1059, { "\x05\x41Ganondorf:\x05\x40\x01""You are doubting yourself,\x01""child. Good. Doubt is honest.", "\x05\x41Ganondorf:\x05\x40\x01""Mido was right. It will be the\x01""only time." } },
{ 0x105B, { "\x05\x41Ganondorf:\x05\x40\x01""Another one asking after the\x01""lost boy.", "" } },
{ 0x105C, { "\x05\x41Ganondorf:\x05\x40\x01""You are still waiting for him.", "\x05\x41Ganondorf:\x05\x40\x01""If he returns, child, pray he\x01""does look like me. He will need\x01""to." } },
{ 0x105D, { "\x05\x41Ganondorf:\x05\x40\x01""You look up at me as if I were\x01""a mountain.", "" } },
{ 0x105E, { "\x05\x41Ganondorf:\x05\x40\x01""Never to grow. And you call\x01""that a blessing, sprout?", "\x05\x41Ganondorf:\x05\x40\x01""A bummer. Yes. Eternity as a\x01""child. I would rather burn." } },
{ 0x1060, { "\x05\x41Ganondorf:\x05\x40\x01""You see through me, boy? Then\x01""look closer.", "" } },
{ 0x1061, { "\x05\x41Ganondorf:\x05\x40\x01""Still guarding her path, Mido.\x01""How devoted.", "\x05\x41Ganondorf:\x05\x40\x01""Especially not me. At last,\x01""someone here with sense." } },
{ 0x1062, { "\x05\x41Ganondorf:\x05\x40\x01""A sapling. They replaced the\x01""old tree with a twig.", "\x05\x41Ganondorf:\x05\x40\x01""Grow quickly, little root. I\x01""felled the last one in a day." } },
{ 0x1063, { "\x05\x41Ganondorf:\x05\x40\x01""You speak as though you know\x01""me, sprout.", "\x05\x41Ganondorf:\x05\x40\x01""They never grow up. I never\x01""forget. We are all cursed,\x01""twig." } },
{ 0x1064, { "\x05\x41Ganondorf:\x05\x40\x01""You have a revelation for me.\x01""How kind.", "\x05\x41Ganondorf:\x05\x40\x01""No Kokiri. Truly? And here I\x01""thought the height gave it\x01""away." } },
{ 0x1066, { "\x05\x41Ganondorf:\x05\x40\x01""You talk of destiny, seedling.", "\x05\x41Ganondorf:\x05\x40\x01""I know my destiny. I am walking\x01""toward it over your roots." } },
{ 0x1067, { "\x05\x41Ganondorf:\x05\x40\x01""You know that tune, boy. I see\x01""it in your face.", "" } },
{ 0x1068, { "\x05\x41Ganondorf:\x05\x40\x01""You look at me as if you were\x01""remembering someone.", "\x05\x41Ganondorf:\x05\x40\x01""Big and quiet. He should have\x01""stayed quiet." } },
{ 0x1069, { "\x05\x41Ganondorf:\x05\x40\x01""My own phantom. Raising its\x01""hand against its maker.", "\x05\x41Ganondorf:\x05\x40\x01""A gap between dreams? Puppet, I\x01""AM the dream. Back to your\x01""void." } },
{ 0x106A, { "\x05\x41Ganondorf:\x05\x40\x01""The girl. Awake, and more than\x01""a girl now.", "\x05\x41Ganondorf:\x05\x40\x01""A Sage. You will find it a\x01""lonelier seat than you think." } },
{ 0x106C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of time as if it were\x01""a river, Sage.", "\x05\x41Ganondorf:\x05\x40\x01""Cruel, yes. Time kneels to no\x01""one. But it has been bargained\x01""with." } },
{ 0x106D, { "\x05\x41Ganondorf:\x05\x40\x01""You are fading already.", "\x05\x41Ganondorf:\x05\x40\x01""Good? I intend to be far better\x01""than good. I intend to be king." } },
{ 0x106E, { "\x05\x41Ganondorf:\x05\x40\x01""You are still waiting for her.", "\x05\x41Ganondorf:\x05\x40\x01""Unless I have. Hold on to that\x01""thought. It suits you." } },
{ 0x106F, { "\x05\x41Ganondorf:\x05\x40\x01""You have made up your mind\x01""about me, boy.", "" } },
{ 0x1070, { "\x05\x41Ganondorf:\x05\x40\x01""Your face has fallen, Mido.", "" } },
{ 0x1071, { "\x05\x41Ganondorf:\x05\x40\x01""You. You have a message to pass\x01""on. To me, of all people.", "" } },
{ 0x1075, { "\x05\x41Ganondorf:\x05\x40\x01""Still watching the path,\x01""sprout.", "\x05\x41Ganondorf:\x05\x40\x01""He will come back. They always\x01""do, and I always wait." } },
{ 0x1077, { "\x05\x41Ganondorf:\x05\x40\x01""The forest has changed its\x01""mood, I see.", "\x05\x41Ganondorf:\x05\x40\x01""Back to normal. Enjoy it.\x01""Normal is what I come to end." } },
{ 0x107A, { "\x05\x41Ganondorf:\x05\x40\x01""You feel a fair wind, child? I\x01""had not noticed.", "\x05\x41Ganondorf:\x05\x40\x01""Fair winds turn. I am the one\x01""who turns them." } },
{ 0x107B, { "\x05\x41Ganondorf:\x05\x40\x01""You sigh a great deal for one\x01""so young.", "\x05\x41Ganondorf:\x05\x40\x01""She has a temple to keep now.\x01""Wonder all you like." } },
{ 0x107C, { "\x05\x41Ganondorf:\x05\x40\x01""Such faith, little one. In a\x01""boy.", "\x05\x41Ganondorf:\x05\x40\x01""Someday. I shall leave a light\x01""on for him." } },
{ 0x107D, { "\x05\x41Ganondorf:\x05\x40\x01""The fairy returns to a dead\x01""tree. And brings me.", "\x05\x41Ganondorf:\x05\x40\x01""The man who killed you. It has\x01""a ring to it." } },
{ 0x107E, { "\x05\x41Ganondorf:\x05\x40\x01""The old tree is telling tales\x01""about me again.", "\x05\x41Ganondorf:\x05\x40\x01""Ceaselessly. Yes. I am nothing\x01""if not thorough." } },
{ 0x108F, { "\x05\x41Ganondorf:\x05\x40\x01""You speak as if you had\x01""expected me, Sage.", "\x05\x41Ganondorf:\x05\x40\x01""You know me? No one knows me,\x01""girl. That is how I have come\x01""this far." } },
{ 0x1090, { "\x05\x41Ganondorf:\x05\x40\x01""You mean to watch over me. From\x01""a temple.", "\x05\x41Ganondorf:\x05\x40\x01""Keep watch. I enjoy an\x01""audience." } },
{ 0x1091, { "\x05\x41Ganondorf:\x05\x40\x01""The old tree judges me. Even\x01""now.", "\x05\x41Ganondorf:\x05\x40\x01""Strength was all I ever\x01""brought. It was enough to kill\x01""you." } },
{ 0x1093, { "\x05\x41Ganondorf:\x05\x40\x01""You are sending me to the\x01""castle, old one.", "\x05\x41Ganondorf:\x05\x40\x01""The Princess of Destiny. Oh, I\x01""intend to meet her." } },
{ 0x1094, { "\x05\x41Ganondorf:\x05\x40\x01""You knew I would leave, girl.", "\x05\x41Ganondorf:\x05\x40\x01""Different. That is the kindest\x01""word anyone here has for me." } },
{ 0x10A0, { "\x05\x41Ganondorf:\x05\x40\x01""A talking shrub. And it wishes\x01""to bargain.", "" } },
{ 0x10A1, { "\x05\x41Ganondorf:\x05\x40\x01""You yield quickly, shrub. Wise.", "" } },
{ 0x10A2, { "\x05\x41Ganondorf:\x05\x40\x01""Another scrub with something to\x01""sell.", "" } },
{ 0x10A4, { "\x05\x41Ganondorf:\x05\x40\x01""You are trembling, little\x01""shrub.", "\x05\x41Ganondorf:\x05\x40\x01""Run. It is the first sensible\x01""thing a scrub has done today." } },
{ 0x10A5, { "\x05\x41Ganondorf:\x05\x40\x01""You refuse me, shrub? On\x01""account of rupees?", "\x05\x41Ganondorf:\x05\x40\x01""Kings pay in mercy. Yours has\x01""just run short." } },
{ 0x10A6, { "\x05\x41Ganondorf:\x05\x40\x01""You are holding something back\x01""from me, scrub.", "\x05\x41Ganondorf:\x05\x40\x01""Mad? No. I am patient. That\x01""should frighten you more." } },
{ 0x10A8, { "\x05\x41Ganondorf:\x05\x40\x01""The meadow. And the girl,\x01""waiting on her stump.", "" } },
{ 0x10AA, { "\x05\x41Ganondorf:\x05\x40\x01""You mean to teach me a song,\x01""girl.", "\x05\x41Ganondorf:\x05\x40\x01""Gentle. These hands have broken\x01""kingdoms. We shall see." } },
{ 0x10AB, { "\x05\x41Ganondorf:\x05\x40\x01""You are impatient with me.\x01""Careful.", "\x05\x41Ganondorf:\x05\x40\x01""Boring. Child, you have no\x01""notion who you are hurrying." } },
{ 0x10AC, { "\x05\x41Ganondorf:\x05\x40\x01""You look delighted. I must have\x01""done something right.", "" } },
{ 0x10AD, { "\x05\x41Ganondorf:\x05\x40\x01""A song that carries your voice.\x01""Useful.", "\x05\x41Ganondorf:\x05\x40\x01""A way to hear the forest's\x01""secrets from anywhere. I shall\x01""use it." } },
{ 0x10AE, { "\x05\x41Ganondorf:\x05\x40\x01""You are checking on your gift,\x01""girl.", "\x05\x41Ganondorf:\x05\x40\x01""It is safe. I never break what\x01""still has a use." } },
{ 0x10B0, { "\x05\x41Ganondorf:\x05\x40\x01""You know where the chief of the\x01""sprouts is hiding.", "\x05\x41Ganondorf:\x05\x40\x01""Sulking in a house. A leader\x01""after this forest's own heart." } },
{ 0x10B4, { "\x05\x41Ganondorf:\x05\x40\x01""Something has finally dawned on\x01""you, child.", "\x05\x41Ganondorf:\x05\x40\x01""Not a nice guy. It took you\x01""this long." } },
{ 0x10B5, { "\x05\x41Ganondorf:\x05\x40\x01""You have a message from the\x01""girl.", "\x05\x41Ganondorf:\x05\x40\x01""If she finds me, she may wish\x01""she had not." } },
{ 0x10B6, { "\x05\x41Ganondorf:\x05\x40\x01""You are giving me errands,\x01""child?", "\x05\x41Ganondorf:\x05\x40\x01""An old hag's errand. I was\x01""raised by two. I know the type." } },
{ 0x10B7, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the lost ones,\x01""imp.", "" } },
{ 0x10B9, { "\x05\x41Ganondorf:\x05\x40\x01""You are giggling at me, imp.", "\x05\x41Ganondorf:\x05\x40\x01""A Stalfos? No. When I am bones,\x01""they will still rule." } },
{ 0x10BB, { "\x05\x41Ganondorf:\x05\x40\x01""You like the song, little imp.", "\x05\x41Ganondorf:\x05\x40\x01""Friends. A king has subjects,\x01""imp. But I will keep the gift." } },
{ 0x10BD, { "\x05\x41Ganondorf:\x05\x40\x01""You are fond of games, imp.", "\x05\x41Ganondorf:\x05\x40\x01""I promise nothing. It is why my\x01""promises are never broken." } },
{ 0x10BE, { "\x05\x41Ganondorf:\x05\x40\x01""The masked children want a tune\x01""from me.", "\x05\x41Ganondorf:\x05\x40\x01""Lead, then. I follow no one for\x01""long." } },
{ 0x10BF, { "\x05\x41Ganondorf:\x05\x40\x01""You were listening, imp. All of\x01""you.", "\x05\x41Ganondorf:\x05\x40\x01""A warlord with an ear for\x01""music. Tell the woods." } },
{ 0x10C0, { "\x05\x41Ganondorf:\x05\x40\x01""The owl. The old spy has found\x01""me again.", "" } },
{ 0x10C3, { "\x05\x41Ganondorf:\x05\x40\x01""You have counsel for me, bird.", "\x05\x41Ganondorf:\x05\x40\x01""Not courage, no. Something\x01""heavier. You know its name." } },
{ 0x10C4, { "\x05\x41Ganondorf:\x05\x40\x01""You heard the girl's song,\x01""bird. You hear everything.", "" } },
{ 0x10C7, { "\x05\x41Ganondorf:\x05\x40\x01""You lecture like a\x01""schoolmaster, bird.", "\x05\x41Ganondorf:\x05\x40\x01""I forget nothing, owl. Least of\x01""all who watched me." } },
{ 0x10C8, { "\x05\x41Ganondorf:\x05\x40\x01""The fairy is cross with\x01""someone. Not me, for once.", "" } },
{ 0x10C9, { "\x05\x41Ganondorf:\x05\x40\x01""You think the forest is out of\x01""sorts, child.", "" } },
{ 0x10CA, { "\x05\x41Ganondorf:\x05\x40\x01""You cower well, shrub.", "" } },
{ 0x10CB, { "\x05\x41Ganondorf:\x05\x40\x01""A shield? You offer a king a\x01""shield of bark?", "" } },
{ 0x10CC, { "\x05\x41Ganondorf:\x05\x40\x01""Bombs. Now the shrub has my\x01""attention.", "" } },
{ 0x10CD, { "\x05\x41Ganondorf:\x05\x40\x01""You sell arrows, shrub? To the\x01""man you fear?", "" } },
{ 0x10CE, { "\x05\x41Ganondorf:\x05\x40\x01""A red potion. You think I\x01""bleed, scrub?", "" } },
{ 0x10CF, { "\x05\x41Ganondorf:\x05\x40\x01""A green potion. For magic like\x01""mine?", "" } },
{ 0x10D1, { "\x05\x41Ganondorf:\x05\x40\x01""The little chief is outraged.\x01""Again.", "" } },
{ 0x10D2, { "\x05\x41Ganondorf:\x05\x40\x01""You are inspecting me, boy.\x01""Like a merchant.", "" } },
{ 0x10D3, { "\x05\x41Ganondorf:\x05\x40\x01""You have a parting insult\x01""ready, Mido.", "" } },
{ 0x10D4, { "\x05\x41Ganondorf:\x05\x40\x01""You lost, shrub. Now pay the\x01""victor.", "" } },
{ 0x10D5, { "\x05\x41Ganondorf:\x05\x40\x01""You know your place now, scrub.", "" } },
{ 0x10D6, { "\x05\x41Ganondorf:\x05\x40\x01""There is more you want carried\x01""to him, boy.", "\x05\x41Ganondorf:\x05\x40\x01""I shall tell him. Just before I\x01""end him." } },
{ 0x10D7, { "\x05\x41Ganondorf:\x05\x40\x01""You climbed up here to laugh at\x01""me, child?", "" } },
{ 0x10D9, { "\x05\x41Ganondorf:\x05\x40\x01""You demand answers of me,\x01""sprout?", "\x05\x41Ganondorf:\x05\x40\x01""I asked it for a stone. It\x01""refused. Now it is firewood." } },
{ 0x10DA, { "\x05\x41Ganondorf:\x05\x40\x01""You have warnings for me,\x01""child. About the woods.", "\x05\x41Ganondorf:\x05\x40\x01""Nothing in there scares me. I\x01""put half of it there." } },
{ 0x10DC, { "\x05\x41Ganondorf:\x05\x40\x01""You surrender, shrub. Go on.", "" } },
{ 0x10DD, { "\x05\x41Ganondorf:\x05\x40\x01""Another surrender. This forest\x01""is full of them.", "" } },
{ 0x10DE, { "\x05\x41Ganondorf:\x05\x40\x01""You are stammering, scrub.", "\x05\x41Ganondorf:\x05\x40\x01""Hurt you? For that? I save my\x01""wrath for kings." } },
{ 0x10DF, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the lost ones\x01""again, imp.", "\x05\x41Ganondorf:\x05\x40\x01""Everyone becomes a Stalfos.\x01""Then the forest is an army\x01""waiting for me." } },
