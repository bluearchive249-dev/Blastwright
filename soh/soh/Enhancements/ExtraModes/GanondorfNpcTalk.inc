{ 0x4014, { "\x05\x41Ganondorf:\x05\x40\x01""Eye drops. Maybe.", "" } },
{ 0x4016, { "\x05\x41Ganondorf:\x05\x40\x01""I have a horse.", "\x05\x41Ganondorf:\x05\x40\x01""Then I'll ride. Fast." } },
