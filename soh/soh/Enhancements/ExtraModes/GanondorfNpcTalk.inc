// SoH: "Play as Ganondorf", his own lines in each conversation (GanondorfNpcs.cpp): a lead-in before their line, and
// his answer after it where the line ends the talk. Written for that NPC and that line, in the voice of a king:
// measured, proud, his threats spoken as decrees. Generated from plain lines, wrapped to the box under his name.
// Kokiri Forest, the Lost Woods and the Deku Tree
{ 0x1001, { "\x05\x41Ganondorf:\x05\x40\x01""So this is the one the forest\x01""sings of. Lift your eyes, girl.\x01""A king has crossed your\x04\x05\x41Ganondorf:\x05\x40\x01""threshold.", "\x05\x41Ganondorf:\x05\x40\x01""Greater in stature and in\x01""purpose both. Mark the\x01""difference well, for all Hyrule\x04\x05\x41Ganondorf:\x05\x40\x01""shall learn it." } },
{ 0x1003, { "\x05\x41Ganondorf:\x05\x40\x01""Faithful still. I have known\x01""captains with less constancy\x01""than you, child of the wood.", "\x05\x41Ganondorf:\x05\x40\x01""I shall show your guardian the\x01""courtesy one sovereign owes\x01""another at the end of his\x04\x05\x41Ganondorf:\x05\x40\x01""reign." } },
{ 0x1006, { "\x05\x41Ganondorf:\x05\x40\x01""Ask your question, small one. A\x01""king does not begrudge an\x01""answer to the curious.", "\x05\x41Ganondorf:\x05\x40\x01""No tree gave me breath. The\x01""desert bore me, and the desert\x01""gives nothing it does not mean\x04\x05\x41Ganondorf:\x05\x40\x01""to take back." } },
{ 0x1008, { "\x05\x41Ganondorf:\x05\x40\x01""You would bar the road to me. I\x01""have seen gates of iron attempt\x01""the same.", "" } },
{ 0x1009, { "\x05\x41Ganondorf:\x05\x40\x01""There is terror in you of what\x01""lies past the trees. Speak of\x01""it.", "\x05\x41Ganondorf:\x05\x40\x01""Death waits beyond the wood for\x01""your kind. For mine it waited\x01""within the sand, and I did not\x04\x05\x41Ganondorf:\x05\x40\x01""kneel to it." } },
{ 0x100A, { "\x05\x41Ganondorf:\x05\x40\x01""Toil sits heavily on one so\x01""small. Who lays such burdens on\x01""you?", "" } },
{ 0x100B, { "\x05\x41Ganondorf:\x05\x40\x01""You come to me as a petitioner.\x01""Name your suit.", "\x05\x41Ganondorf:\x05\x40\x01""I have reaped kingdoms, child.\x01""I do not reap grass. Yet I\x01""shall forget the asking." } },
{ 0x100F, { "\x05\x41Ganondorf:\x05\x40\x01""Tidings shine in your face.\x01""Deliver them.", "" } },
{ 0x1010, { "\x05\x41Ganondorf:\x05\x40\x01""The leaves carry word swiftly.\x01""What have they told you of me?", "" } },
{ 0x1011, { "\x05\x41Ganondorf:\x05\x40\x01""She keeps her vigil upon the\x01""bridge, as if a parting could\x01""be forbidden.", "\x05\x41Ganondorf:\x05\x40\x01""I depart a wood to claim a\x01""world. Do not weep at so fair\x01""an exchange." } },
{ 0x1012, { "\x05\x41Ganondorf:\x05\x40\x01""Speak, girl. There is something\x01""you would have me swear.", "\x05\x41Ganondorf:\x05\x40\x01""Friendship is a coin I have\x01""never minted. Yet keep yours.\x01""It may buy you mercy when the\x04\x05\x41Ganondorf:\x05\x40\x01""hour comes." } },
{ 0x1013, { "\x05\x41Ganondorf:\x05\x40\x01""You offer tribute. The first\x01""freely given me in all this\x01""green country.", "\x05\x41Ganondorf:\x05\x40\x01""A small thing, to hold the keys\x01""of doors that armies could not\x01""force. I accept it." } },
{ 0x1014, { "\x05\x41Ganondorf:\x05\x40\x01""There is more upon your heart.\x01""Unburden it; the hour is mine\x01""to spend.", "\x05\x41Ganondorf:\x05\x40\x01""I shall return, as kings\x01""return: with banners. Pray the\x01""forest learns to love their\x04\x05\x41Ganondorf:\x05\x40\x01""shadow." } },
{ 0x1019, { "\x05\x41Ganondorf:\x05\x40\x01""You would counsel me in arms.\x01""Proceed; I am not too proud to\x01""be amused.", "\x05\x41Ganondorf:\x05\x40\x01""I was schooled in war by the\x01""waste itself, where the pupils\x01""who fail are buried by the\x04\x05\x41Ganondorf:\x05\x40\x01""wind." } },
{ 0x101B, { "\x05\x41Ganondorf:\x05\x40\x01""Your gaze lingers upon the\x01""mask, and upon what it fails to\x01""hide.", "\x05\x41Ganondorf:\x05\x40\x01""Let them whisper. A name spoken\x01""low in fear is nearer to a\x01""prayer than they know." } },
{ 0x101D, { "\x05\x41Ganondorf:\x05\x40\x01""Fortune has turned her face\x01""from you, little one.", "\x05\x41Ganondorf:\x05\x40\x01""So she turns from all who wait\x01""upon her. I learned long ago to\x01""take her by the throat." } },
{ 0x101E, { "\x05\x41Ganondorf:\x05\x40\x01""You wear your prize as a victor\x01""wears his laurel.", "\x05\x41Ganondorf:\x05\x40\x01""Then you have grasped in a\x01""morning what your elders never\x01""shall: to be feared is to be\x04\x05\x41Ganondorf:\x05\x40\x01""safe." } },
{ 0x101F, { "\x05\x41Ganondorf:\x05\x40\x01""I see reproof gathering in you.\x01""Weigh it before you spend it.", "" } },
{ 0x1020, { "\x05\x41Ganondorf:\x05\x40\x01""Your fellows covet what is\x01""mine. That is the beginning of\x01""ambition.", "\x05\x41Ganondorf:\x05\x40\x01""Let them come and beg it of me.\x01""I would see which among them\x01""has the stomach." } },
{ 0x1021, { "\x05\x41Ganondorf:\x05\x40\x01""You had thought me gone, and\x01""built some small hope upon it.", "\x05\x41Ganondorf:\x05\x40\x01""I depart when my purpose is\x01""served, and not one hour\x01""before. Grieve at your leisure." } },
{ 0x1023, { "\x05\x41Ganondorf:\x05\x40\x01""You bear a message. Kings are\x01""accustomed to messengers; say\x01""on.", "\x05\x41Ganondorf:\x05\x40\x01""One who does not fear me. I\x01""shall see with my own eyes\x01""whether that is courage, or\x04\x05\x41Ganondorf:\x05\x40\x01""only innocence." } },
{ 0x1024, { "\x05\x41Ganondorf:\x05\x40\x01""You have yet breath to bestow\x01""on me, ancient one. Spend it\x01""with care.", "\x05\x41Ganondorf:\x05\x40\x01""Keep your blessing. I came for\x01""the stone, and I do not leave a\x01""throne room empty-handed." } },
{ 0x1026, { "\x05\x41Ganondorf:\x05\x40\x01""There is a weariness in your\x01""boughs that was not there when\x01""first I came.", "\x05\x41Ganondorf:\x05\x40\x01""It is so. I laid the curse with\x01""my own hand, and I do not\x01""disown my works." } },
{ 0x1027, { "\x05\x41Ganondorf:\x05\x40\x01""Tell your tale, guardian. I\x01""would hear how the dying\x01""remember me.", "\x05\x41Ganondorf:\x05\x40\x01""A wicked man of the desert. So\x01""the conquered ever name the one\x01""who would not stay conquered." } },
{ 0x1028, { "\x05\x41Ganondorf:\x05\x40\x01""You know where she keeps her\x01""court. Disclose it.", "\x05\x41Ganondorf:\x05\x40\x01""Then I shall climb, and the\x01""wood that swallows wanderers\x01""will learn it has swallowed a\x04\x05\x41Ganondorf:\x05\x40\x01""king." } },
{ 0x1029, { "\x05\x41Ganondorf:\x05\x40\x01""A dying sovereign gives his\x01""last decree. I attend it.", "\x05\x41Ganondorf:\x05\x40\x01""You charge me to guard the\x01""Triforce from myself. The\x01""goddesses made that same jest\x04\x05\x41Ganondorf:\x05\x40\x01""when they hid it from my\x01""people." } },
{ 0x102B, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite presumes to counsel\x01""me. Say on, small light.", "\x05\x41Ganondorf:\x05\x40\x01""Evil is the name the\x01""comfortable give to hunger. I\x01""go to the castle to end a\x04\x05\x41Ganondorf:\x05\x40\x01""famine of a thousand years." } },
{ 0x102D, { "\x05\x41Ganondorf:\x05\x40\x01""You are merry at my expense.\x01""Few have afforded the luxury.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh, then. I keep a ledger of\x01""such things, and I am patient\x01""in the collecting." } },
{ 0x102F, { "\x05\x41Ganondorf:\x05\x40\x01""You stand athwart my road, boy,\x01""and you raise your voice. Have\x01""a care.", "" } },
{ 0x1030, { "\x05\x41Ganondorf:\x05\x40\x01""You recite your little statutes\x01""to me as though they bound me.", "\x05\x41Ganondorf:\x05\x40\x01""Law is but the breath of him\x01""who sits the throne. In time\x01""you will be reciting mine." } },
{ 0x1031, { "\x05\x41Ganondorf:\x05\x40\x01""What has your small chieftain\x01""dared, that you tremble to tell\x01""it?", "" } },
{ 0x1032, { "\x05\x41Ganondorf:\x05\x40\x01""Counsel, from a child,\x01""concerning arms.", "\x05\x41Ganondorf:\x05\x40\x01""The blade I bear was forged for\x01""the breaking of dynasties. Keep\x01""your trinkets for your games." } },
{ 0x1033, { "\x05\x41Ganondorf:\x05\x40\x01""Still you hold the pass, Mido.\x01""I have razed forts with weaker\x01""hearts in them.", "" } },
{ 0x1034, { "\x05\x41Ganondorf:\x05\x40\x01""Declaim, small lord. I have\x01""endured the speeches of kings;\x01""I can endure yours.", "\x05\x41Ganondorf:\x05\x40\x01""I am friend to no one, boy. I\x01""am the end toward which this\x01""age is bent, and she, too, will\x04\x05\x41Ganondorf:\x05\x40\x01""learn it." } },
{ 0x103C, { "\x05\x41Ganondorf:\x05\x40\x01""Some secret presses to be told.\x01""Out with it; I am a patient\x01""confessor.", "\x05\x41Ganondorf:\x05\x40\x01""Count your green coins, child.\x01""I have come for a treasure that\x01""cannot be counted." } },
{ 0x1040, { "\x05\x41Ganondorf:\x05\x40\x01""You were instructing me, small\x01""one. Continue.", "\x05\x41Ganondorf:\x05\x40\x01""I do not play at things. I\x01""learn them, and then they are\x01""mine." } },
{ 0x1041, { "\x05\x41Ganondorf:\x05\x40\x01""The measure displeases you.", "\x05\x41Ganondorf:\x05\x40\x01""Then I shall play it until the\x01""wood itself forgets how it once\x01""went." } },
{ 0x1042, { "\x05\x41Ganondorf:\x05\x40\x01""You come as herald for another.\x01""Deliver your charge.", "\x05\x41Ganondorf:\x05\x40\x01""I did nothing to him but stand\x01""in his sight. For some, that\x01""suffices." } },
{ 0x1043, { "\x05\x41Ganondorf:\x05\x40\x01""Why do you stare so, as at a\x01""storm upon the horizon?", "\x05\x41Ganondorf:\x05\x40\x01""You have guessed in jest what\x01""princes failed to guess in\x01""council. Yes, child. I go to\x04\x05\x41Ganondorf:\x05\x40\x01""take it." } },
{ 0x1044, { "\x05\x41Ganondorf:\x05\x40\x01""Dread rides you harder than is\x01""your custom.", "\x05\x41Ganondorf:\x05\x40\x01""Then abide, and be eternal and\x01""small. The wide world is\x01""promised elsewhere." } },
{ 0x1046, { "\x05\x41Ganondorf:\x05\x40\x01""A low door and a loud master. I\x01""have stooped to enter worse\x01""halls.", "\x05\x41Ganondorf:\x05\x40\x01""Wherever I stand, I hold court.\x01""Be content that this court is\x01""brief." } },
{ 0x1047, { "\x05\x41Ganondorf:\x05\x40\x01""The girl again, and gladness in\x01""her, as though I were one to be\x01""glad of.", "" } },
{ 0x1048, { "\x05\x41Ganondorf:\x05\x40\x01""You have a proclamation, little\x01""one. Proclaim it.", "\x05\x41Ganondorf:\x05\x40\x01""She has chosen her ally as the\x01""lamb chooses the mountain's\x01""shade, not knowing what dwells\x04\x05\x41Ganondorf:\x05\x40\x01""upon the mountain." } },
{ 0x1049, { "\x05\x41Ganondorf:\x05\x40\x01""Trouble is written upon your\x01""brow. Read it to me.", "\x05\x41Ganondorf:\x05\x40\x01""All that grows must fall. I but\x01""appointed the season." } },
{ 0x104A, { "\x05\x41Ganondorf:\x05\x40\x01""You taste it too. The very air\x01""has changed its allegiance.", "\x05\x41Ganondorf:\x05\x40\x01""Sand and burning. It is the\x01""breath of my homeland, come at\x01""last to visit yours." } },
{ 0x104B, { "\x05\x41Ganondorf:\x05\x40\x01""You watch my going as the\x01""watchman watches a fire burn\x01""low.", "\x05\x41Ganondorf:\x05\x40\x01""Take your ease. But know that\x01""such fires as I do not go out;\x01""they travel." } },
{ 0x104C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of my return as one\x01""speaks of winter.", "\x05\x41Ganondorf:\x05\x40\x01""Whether I come in wrath or in\x01""triumph, child, will be for\x01""Hyrule to decide, not you." } },
{ 0x104E, { "\x05\x41Ganondorf:\x05\x40\x01""You look behind you oft, as the\x01""hunted do.", "\x05\x41Ganondorf:\x05\x40\x01""When a guardian falls, the\x01""wolves grow bold. I knew it\x01""would be so. I counted upon it." } },
{ 0x104F, { "\x05\x41Ganondorf:\x05\x40\x01""The wind has turned, child, and\x01""you have felt it turn.", "" } },
{ 0x1050, { "\x05\x41Ganondorf:\x05\x40\x01""You know where the temple\x01""stands. Speak it plainly.", "\x05\x41Ganondorf:\x05\x40\x01""Beyond the wood that devours\x01""the lost. A fit place; I have\x01""set a shadow of myself to keep\x04\x05\x41Ganondorf:\x05\x40\x01""it." } },
{ 0x1051, { "\x05\x41Ganondorf:\x05\x40\x01""There is accusation in your\x01""eyes. Give it a tongue, if you\x01""dare.", "\x05\x41Ganondorf:\x05\x40\x01""I have never sued for pardon,\x01""child, of gods or of men. I\x01""shall not begin with you." } },
{ 0x1052, { "\x05\x41Ganondorf:\x05\x40\x01""Be still, little merchant. I\x01""have not come for you.", "\x05\x41Ganondorf:\x05\x40\x01""I bear no shield, child. A\x01""shield is the confession of a\x01""man who expects to be struck." } },
{ 0x1053, { "\x05\x41Ganondorf:\x05\x40\x01""You seek one who is gone. I\x01""know that look; I have caused\x01""it often.", "" } },
{ 0x1054, { "\x05\x41Ganondorf:\x05\x40\x01""You search for your chieftain\x01""in the hour of need.", "\x05\x41Ganondorf:\x05\x40\x01""He has hidden. It is the first\x01""act of his I can call wise." } },
{ 0x1055, { "\x05\x41Ganondorf:\x05\x40\x01""You marked my coming. I am\x01""accustomed to being watched.", "" } },
{ 0x1056, { "\x05\x41Ganondorf:\x05\x40\x01""You keep to your walls. So did\x01""the lords of many a city that\x01""is now a name.", "\x05\x41Ganondorf:\x05\x40\x01""No door has yet been made that\x01""is proof against tedium, child.\x01""Nor against me." } },
{ 0x1057, { "\x05\x41Ganondorf:\x05\x40\x01""You would speak to me of bows\x01""and of arrows.", "\x05\x41Ganondorf:\x05\x40\x01""My people are born to the bow.\x01""But I have no need to strike\x01""from afar what I may break in\x04\x05\x41Ganondorf:\x05\x40\x01""my hand." } },
{ 0x1058, { "\x05\x41Ganondorf:\x05\x40\x01""You put one question to every\x01""stranger. Put it, then, to me.", "" } },
{ 0x1059, { "\x05\x41Ganondorf:\x05\x40\x01""Doubt gnaws you. It is the\x01""first honest counsellor you\x01""have had.", "\x05\x41Ganondorf:\x05\x40\x01""Your chieftain spoke truer than\x01""he knew. Let it console him; he\x01""will not be right again." } },
{ 0x105A, { "\x05\x41Ganondorf:\x05\x40\x01""You have seen my face before,\x01""you think.", "\x05\x41Ganondorf:\x05\x40\x01""In dreams. Yes. I have walked\x01""there before my feet ever\x01""touched your soil." } },
{ 0x105B, { "\x05\x41Ganondorf:\x05\x40\x01""Another who mourns the boy that\x01""went away.", "" } },
{ 0x105C, { "\x05\x41Ganondorf:\x05\x40\x01""Still you keep watch for him.", "\x05\x41Ganondorf:\x05\x40\x01""Should he come again, pray he\x01""has grown to be as I am.\x01""Nothing less will serve him\x04\x05\x41Ganondorf:\x05\x40\x01""against me." } },
{ 0x105D, { "\x05\x41Ganondorf:\x05\x40\x01""You look upon me as upon a\x01""mountain. It is well; I mean to\x01""be seen so.", "" } },
{ 0x105E, { "\x05\x41Ganondorf:\x05\x40\x01""Never to age. They have told\x01""you it is a gift.", "\x05\x41Ganondorf:\x05\x40\x01""To be a child for ever is to be\x01""for ever ruled. I would sooner\x01""burn in one day than endure so\x04\x05\x41Ganondorf:\x05\x40\x01""through all the ages." } },
{ 0x1060, { "\x05\x41Ganondorf:\x05\x40\x01""You claim to see what I am.\x01""Look longer, boy.", "" } },
{ 0x1061, { "\x05\x41Ganondorf:\x05\x40\x01""Yet you keep her road. Devotion\x01""I can honour, even in a foe so\x01""small.", "\x05\x41Ganondorf:\x05\x40\x01""Me least of all. At last this\x01""forest has spoken one true\x01""word." } },
{ 0x1062, { "\x05\x41Ganondorf:\x05\x40\x01""So this seedling is the heir.\x01""Great houses do dwindle.", "\x05\x41Ganondorf:\x05\x40\x01""Grow swiftly, little root. Your\x01""father stood ten thousand\x01""years, and fell to me between\x04\x05\x41Ganondorf:\x05\x40\x01""one dawn and the next." } },
{ 0x1063, { "\x05\x41Ganondorf:\x05\x40\x01""You speak as one who knows me,\x01""sapling.", "\x05\x41Ganondorf:\x05\x40\x01""They do not grow, and I do not\x01""forget. Each of us bears his\x01""own curse." } },
{ 0x1064, { "\x05\x41Ganondorf:\x05\x40\x01""A revelation, and offered so\x01""solemnly.", "\x05\x41Ganondorf:\x05\x40\x01""No child of the wood, I. That\x01""truth was plain the hour I\x01""first cast a shadow here." } },
{ 0x1066, { "\x05\x41Ganondorf:\x05\x40\x01""You prate of destiny, who have\x01""had but a season of life.", "\x05\x41Ganondorf:\x05\x40\x01""I know mine. It is not given; I\x01""am seizing it, and its road\x01""lies across your roots." } },
{ 0x1067, { "\x05\x41Ganondorf:\x05\x40\x01""That air is known to you. I\x01""read it in your face.", "" } },
{ 0x1068, { "\x05\x41Ganondorf:\x05\x40\x01""Your eyes go past me, to some\x01""other you remember.", "\x05\x41Ganondorf:\x05\x40\x01""Whoever he was, his silence was\x01""the wiser part. He should have\x01""kept it." } },
{ 0x1069, { "\x05\x41Ganondorf:\x05\x40\x01""My own shade lifts its hand\x01""against the hand that shaped\x01""it.", "\x05\x41Ganondorf:\x05\x40\x01""I wrought you from my shadow,\x01""phantom, and to shadow I return\x01""you. No creature of mine shall\x04\x05\x41Ganondorf:\x05\x40\x01""name itself my master." } },
{ 0x106A, { "\x05\x41Ganondorf:\x05\x40\x01""The girl wakes, and is a girl\x01""no longer.", "\x05\x41Ganondorf:\x05\x40\x01""A Sage. You will find it a cold\x01""throne, and a long watch, and\x01""no thanks at the end of it." } },
{ 0x106C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of time as of a river\x01""that carries all alike.", "\x05\x41Ganondorf:\x05\x40\x01""It is cruel; it kneels to no\x01""crown. Yet I have made treaty\x01""with harder things than time." } },
{ 0x106D, { "\x05\x41Ganondorf:\x05\x40\x01""Already you grow faint, as\x01""stars do at morning.", "\x05\x41Ganondorf:\x05\x40\x01""Goodness is the virtue of those\x01""who cannot rule. I shall be\x01""king, and let the chronicles\x04\x05\x41Ganondorf:\x05\x40\x01""choose the word." } },
{ 0x106E, { "\x05\x41Ganondorf:\x05\x40\x01""Still you attend her coming.", "\x05\x41Ganondorf:\x05\x40\x01""Hold fast to that suspicion,\x01""boy. It is the nearest you have\x01""come to wisdom." } },
{ 0x106F, { "\x05\x41Ganondorf:\x05\x40\x01""You have reached your verdict\x01""upon me.", "" } },
{ 0x1070, { "\x05\x41Ganondorf:\x05\x40\x01""Your countenance is fallen,\x01""small lord.", "" } },
{ 0x1071, { "\x05\x41Ganondorf:\x05\x40\x01""You would make me your\x01""messenger. Me.", "" } },
{ 0x1073, { "\x05\x41Ganondorf:\x05\x40\x01""Again you search my face for\x01""another's.", "\x05\x41Ganondorf:\x05\x40\x01""One whom none would play with.\x01""Then he had the better part;\x01""solitude is the school of\x04\x05\x41Ganondorf:\x05\x40\x01""kings." } },
{ 0x1074, { "\x05\x41Ganondorf:\x05\x40\x01""You would be as I am. Consider\x01""what you ask.", "\x05\x41Ganondorf:\x05\x40\x01""There is no taking the strength\x01""and leaving the rest, child.\x01""They are one metal." } },
{ 0x1075, { "\x05\x41Ganondorf:\x05\x40\x01""Still at your post, small\x01""sentinel.", "\x05\x41Ganondorf:\x05\x40\x01""He will return. They ever do.\x01""And I am ever waiting." } },
{ 0x1076, { "\x05\x41Ganondorf:\x05\x40\x01""Some old knowledge of me stirs\x01""in you.", "\x05\x41Ganondorf:\x05\x40\x01""Heed the second instinct,\x01""child. It is the truer." } },
{ 0x1077, { "\x05\x41Ganondorf:\x05\x40\x01""The wood wears a gentler face,\x01""I see.", "\x05\x41Ganondorf:\x05\x40\x01""Take joy of your peace. It is\x01""to such peace as this that I am\x01""sent as an ending." } },
{ 0x1078, { "\x05\x41Ganondorf:\x05\x40\x01""Bold words, and a little army\x01""to speak them.", "\x05\x41Ganondorf:\x05\x40\x01""Then stand to your defence. I\x01""should think the less of a\x01""realm that did not." } },
{ 0x1079, { "\x05\x41Ganondorf:\x05\x40\x01""A fair wind, you say.", "\x05\x41Ganondorf:\x05\x40\x01""Winds are fair or foul as I\x01""ordain. This one I have merely\x01""not yet turned." } },
{ 0x107A, { "\x05\x41Ganondorf:\x05\x40\x01""You scent hope upon the air.", "\x05\x41Ganondorf:\x05\x40\x01""Hope is the last thing I take\x01""from a land. I am in no haste;\x01""it sweetens the taking." } },
{ 0x107B, { "\x05\x41Ganondorf:\x05\x40\x01""Sighs, in one who cannot grow\x01""old.", "\x05\x41Ganondorf:\x05\x40\x01""She keeps a temple now, and\x01""temples keep their own. Wonder\x01""as you will." } },
{ 0x107C, { "\x05\x41Ganondorf:\x05\x40\x01""Such faith, and bestowed upon a\x01""boy.", "\x05\x41Ganondorf:\x05\x40\x01""Let him come. I shall keep a\x01""welcome for him, and it will be\x01""warm." } },
{ 0x107D, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite returns to a throne\x01""without a king, and brings the\x01""usurper with her.", "\x05\x41Ganondorf:\x05\x40\x01""The man who slew you. I have\x01""borne heavier titles, and worn\x01""them lightly." } },
{ 0x107E, { "\x05\x41Ganondorf:\x05\x40\x01""The ancient one speaks of me\x01""yet.", "\x05\x41Ganondorf:\x05\x40\x01""Without ceasing. It is so. What\x01""I have begun, no hand in this\x01""world shall see left undone." } },
{ 0x108F, { "\x05\x41Ganondorf:\x05\x40\x01""You say you looked for my\x01""coming, Sage.", "\x05\x41Ganondorf:\x05\x40\x01""None knows me, girl. That is\x01""the secret of my ascent: men\x01""see the desert, and never the\x04\x05\x41Ganondorf:\x05\x40\x01""storm it sends." } },
{ 0x1090, { "\x05\x41Ganondorf:\x05\x40\x01""You would keep watch on me from\x01""your sanctuary.", "\x05\x41Ganondorf:\x05\x40\x01""Watch, then. I have never\x01""wanted for witnesses, nor\x01""shrunk from them." } },
{ 0x1091, { "\x05\x41Ganondorf:\x05\x40\x01""You sit in judgment still, in\x01""your last hour.", "\x05\x41Ganondorf:\x05\x40\x01""Strength was the whole of my\x01""embassy. You yourself are the\x01""proof that it sufficed." } },
{ 0x1093, { "\x05\x41Ganondorf:\x05\x40\x01""You send me to the castle. I\x01""was bound there before your\x01""first leaf fell.", "\x05\x41Ganondorf:\x05\x40\x01""The Princess of Destiny. Yes.\x01""Her destiny and mine have an\x01""appointment, and I am never\x04\x05\x41Ganondorf:\x05\x40\x01""late." } },
{ 0x1094, { "\x05\x41Ganondorf:\x05\x40\x01""You knew this wood could not\x01""hold me.", "\x05\x41Ganondorf:\x05\x40\x01""Different. It is the gentlest\x01""word this country has ever\x01""spared me. I shall remember who\x04\x05\x41Ganondorf:\x05\x40\x01""spoke it." } },
{ 0x1097, { "\x05\x41Ganondorf:\x05\x40\x01""You vault and tumble like a\x01""court fool before a king.", "\x05\x41Ganondorf:\x05\x40\x01""I do not caper, child. When I\x01""leave the ground, cities look\x01""up." } },
{ 0x10A0, { "\x05\x41Ganondorf:\x05\x40\x01""A shrub that parleys. This\x01""forest does not lack for\x01""wonders.", "" } },
{ 0x10A1, { "\x05\x41Ganondorf:\x05\x40\x01""You yield with admirable speed.\x01""It is the beginning of\x01""statecraft.", "" } },
{ 0x10A2, { "\x05\x41Ganondorf:\x05\x40\x01""Another small merchant sues for\x01""terms.", "" } },
{ 0x10A4, { "\x05\x41Ganondorf:\x05\x40\x01""You quake, little thicket.", "\x05\x41Ganondorf:\x05\x40\x01""Flee. It is the oldest wisdom\x01""of small things, and I do not\x01""despise it." } },
{ 0x10A5, { "\x05\x41Ganondorf:\x05\x40\x01""You deny me, and for want of\x01""coin.", "\x05\x41Ganondorf:\x05\x40\x01""Kings pay in clemency, shrub.\x01""See that you do not exhaust my\x01""treasury." } },
{ 0x10A6, { "\x05\x41Ganondorf:\x05\x40\x01""You withhold your wares from\x01""me.", "\x05\x41Ganondorf:\x05\x40\x01""I am not wroth. I am patient;\x01""and of the two, my patience is\x01""the more to be feared." } },
{ 0x10A8, { "\x05\x41Ganondorf:\x05\x40\x01""So this is her court. A stump\x01""for a throne, and silence for a\x01""guard.", "" } },
{ 0x10AA, { "\x05\x41Ganondorf:\x05\x40\x01""You would be my tutor in music.\x01""Begin.", "\x05\x41Ganondorf:\x05\x40\x01""These hands have unseated\x01""kings. Let us learn whether\x01""they may yet be taught\x04\x05\x41Ganondorf:\x05\x40\x01""gentleness." } },
{ 0x10AB, { "\x05\x41Ganondorf:\x05\x40\x01""You grow impatient with a king.", "\x05\x41Ganondorf:\x05\x40\x01""You hasten one whom the\x01""centuries themselves have\x01""waited upon, child." } },
{ 0x10AC, { "\x05\x41Ganondorf:\x05\x40\x01""You are well pleased. I have\x01""done something to earn it, it\x01""seems.", "" } },
{ 0x10AD, { "\x05\x41Ganondorf:\x05\x40\x01""A song that bears your voice\x01""across the leagues.", "\x05\x41Ganondorf:\x05\x40\x01""Then the forest shall have no\x01""secret from me, wherever I hold\x01""my court. I thank you for the\x04\x05\x41Ganondorf:\x05\x40\x01""gift." } },
{ 0x10AE, { "\x05\x41Ganondorf:\x05\x40\x01""You ask after your gift, as a\x01""mother after a child sent\x01""abroad.", "\x05\x41Ganondorf:\x05\x40\x01""It is kept. I break nothing\x01""that has yet a use to me." } },
{ 0x10B0, { "\x05\x41Ganondorf:\x05\x40\x01""You know the hole wherein your\x01""chieftain sulks.", "\x05\x41Ganondorf:\x05\x40\x01""Skulking beneath a roof while\x01""his people wonder. So perish\x01""all petty thrones." } },
{ 0x10B4, { "\x05\x41Ganondorf:\x05\x40\x01""Understanding dawns in you at\x01""last.", "\x05\x41Ganondorf:\x05\x40\x01""No, child. I am not kind. I am\x01""necessary; it is a colder\x01""thing, and it endures." } },
{ 0x10B5, { "\x05\x41Ganondorf:\x05\x40\x01""You carry her word to me.", "\x05\x41Ganondorf:\x05\x40\x01""If she seeks me, let her find\x01""me. Many have, and wished the\x01""search had failed." } },
{ 0x10B6, { "\x05\x41Ganondorf:\x05\x40\x01""You set me errands, as if I\x01""were your page.", "\x05\x41Ganondorf:\x05\x40\x01""A crone's errand. Two such\x01""raised me. I know the breed,\x01""and I do not keep them waiting." } },
{ 0x10B7, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of those the wood has\x01""taken.", "" } },
{ 0x10B9, { "\x05\x41Ganondorf:\x05\x40\x01""My fate amuses you, masked one.", "\x05\x41Ganondorf:\x05\x40\x01""No. When I am bone I shall rule\x01""yet, and the worms will hold\x01""their office by my leave." } },
{ 0x10BB, { "\x05\x41Ganondorf:\x05\x40\x01""The air pleases you, little\x01""mask.", "\x05\x41Ganondorf:\x05\x40\x01""A king has subjects, not\x01""friends. Yet I receive your\x01""tribute." } },
{ 0x10BC, { "\x05\x41Ganondorf:\x05\x40\x01""You ask a king's opinion of\x01""your face.", "\x05\x41Ganondorf:\x05\x40\x01""Mine was graven by wind and by\x01""war. Be thankful that yours has\x01""known neither." } },
{ 0x10BD, { "\x05\x41Ganondorf:\x05\x40\x01""You love your games, imp.", "\x05\x41Ganondorf:\x05\x40\x01""I swear to nothing. Hence no\x01""man living can say that\x01""Ganondorf has broken faith." } },
{ 0x10BE, { "\x05\x41Ganondorf:\x05\x40\x01""The masked children would have\x01""music of me.", "\x05\x41Ganondorf:\x05\x40\x01""Lead on. I shall follow, as the\x01""tide follows, until it is time\x01""to cover all." } },
{ 0x10BF, { "\x05\x41Ganondorf:\x05\x40\x01""You were listening. All of you.", "\x05\x41Ganondorf:\x05\x40\x01""Let it be told in the wood that\x01""the conqueror keeps time as\x01""truly as he keeps his word." } },
{ 0x10C0, { "\x05\x41Ganondorf:\x05\x40\x01""The old watcher. Wherever I\x01""turn, there are your eyes.", "" } },
{ 0x10C3, { "\x05\x41Ganondorf:\x05\x40\x01""Counsel, from the bird.", "\x05\x41Ganondorf:\x05\x40\x01""It is not courage. It is a\x01""heavier thing, and older, and\x01""you know well its name." } },
{ 0x10C4, { "\x05\x41Ganondorf:\x05\x40\x01""You heard the girl's song.\x01""There is nothing you do not\x01""hear.", "" } },
{ 0x10C7, { "\x05\x41Ganondorf:\x05\x40\x01""You lesson me as a tutor\x01""lessons a slow prince.", "\x05\x41Ganondorf:\x05\x40\x01""I forget nothing, owl. Least of\x01""all those who have set\x01""themselves to watch me." } },
{ 0x10C8, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite is wroth, and for\x01""once not with me.", "" } },
{ 0x10C9, { "\x05\x41Ganondorf:\x05\x40\x01""You hold that the forest\x01""sickens.", "" } },
{ 0x10CA, { "\x05\x41Ganondorf:\x05\x40\x01""You abase yourself prettily,\x01""shrub.", "" } },
{ 0x10CB, { "\x05\x41Ganondorf:\x05\x40\x01""You offer a king a shield of\x01""bark.", "" } },
{ 0x10CC, { "\x05\x41Ganondorf:\x05\x40\x01""Fire in a casket. Now, shrub,\x01""you speak a tongue I honour.", "" } },
{ 0x10CD, { "\x05\x41Ganondorf:\x05\x40\x01""You would arm the very one you\x01""dread.", "" } },
{ 0x10CE, { "\x05\x41Ganondorf:\x05\x40\x01""A draught for wounds. You\x01""suppose that I may be wounded.", "" } },
{ 0x10CF, { "\x05\x41Ganondorf:\x05\x40\x01""A draught for sorcery such as\x01""mine.", "" } },
{ 0x10D1, { "\x05\x41Ganondorf:\x05\x40\x01""The small lord is affronted\x01""once more.", "" } },
{ 0x10D2, { "\x05\x41Ganondorf:\x05\x40\x01""You take my inventory, boy, as\x01""a steward counts plate.", "" } },
{ 0x10D3, { "\x05\x41Ganondorf:\x05\x40\x01""You have one barb left in your\x01""quiver, Mido. Loose it.", "" } },
{ 0x10D4, { "\x05\x41Ganondorf:\x05\x40\x01""You are beaten, shrub. Render\x01""what the beaten owe.", "" } },
{ 0x10D5, { "\x05\x41Ganondorf:\x05\x40\x01""You have learned your station.", "" } },
{ 0x10D6, { "\x05\x41Ganondorf:\x05\x40\x01""There is more you would have me\x01""bear to him.", "\x05\x41Ganondorf:\x05\x40\x01""He shall have your words from\x01""my own mouth, in the last hour\x01""that he has ears to hear them." } },
{ 0x10D7, { "\x05\x41Ganondorf:\x05\x40\x01""You have climbed far to laugh\x01""at a king.", "" } },
{ 0x10D9, { "\x05\x41Ganondorf:\x05\x40\x01""You demand an account of me.\x01""You.", "\x05\x41Ganondorf:\x05\x40\x01""I required one thing of it. It\x01""chose to die a guardian sooner\x01""than live my vassal, and I\x04\x05\x41Ganondorf:\x05\x40\x01""honoured the choice." } },
{ 0x10DA, { "\x05\x41Ganondorf:\x05\x40\x01""Warnings, of the wood, to me.", "\x05\x41Ganondorf:\x05\x40\x01""Half of what stalks those paths\x01""went in at my bidding. The wood\x01""and I are of one mind." } },
{ 0x10DC, { "\x05\x41Ganondorf:\x05\x40\x01""You sue for peace. I hear you.", "" } },
{ 0x10DD, { "\x05\x41Ganondorf:\x05\x40\x01""Another banner lowered. This\x01""forest yields like wheat.", "" } },
{ 0x10DE, { "\x05\x41Ganondorf:\x05\x40\x01""Your tongue stumbles, shrub.", "\x05\x41Ganondorf:\x05\x40\x01""I do not spend my wrath on such\x01""as you. It is laid by for\x01""kings." } },
{ 0x10DF, { "\x05\x41Ganondorf:\x05\x40\x01""Again you speak of the lost,\x01""imp.", "\x05\x41Ganondorf:\x05\x40\x01""Then the wood is a barracks,\x01""and every wanderer it takes, a\x01""soldier laid up against my\x04\x05\x41Ganondorf:\x05\x40\x01""need." } },
// Lon Lon Ranch and Hyrule Field
{ 0x2001, { "\x05\x41Ganondorf:\x05\x40\x01""The girl of the ranch. You have\x01""the bearing of one who commands\x01""beasts, and is obeyed.", "\x05\x41Ganondorf:\x05\x40\x01""A mare that answers to a song.\x01""In the desert we bind our\x01""mounts with fear. Your way is\x04\x05\x41Ganondorf:\x05\x40\x01""the subtler chain." } },
{ 0x2002, { "\x05\x41Ganondorf:\x05\x40\x01""You look upon the horse as a\x01""mother upon a daughter given in\x01""marriage.", "" } },
{ 0x2009, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah deigns to instruct\x01""me. I attend, woman.", "\x05\x41Ganondorf:\x05\x40\x01""You bid me guard her. I shall\x01""keep her as the miser keeps his\x01""gold: for my own ends, and\x04\x05\x41Ganondorf:\x05\x40\x01""close." } },
{ 0x200A, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at a king, soldier. I\x01""have had men flayed for a\x01""smaller mirth.", "" } },
{ 0x200D, { "\x05\x41Ganondorf:\x05\x40\x01""You sleep at your post, master\x01""of the house. Thus do realms\x01""fall.", "\x05\x41Ganondorf:\x05\x40\x01""Your welcome comes late and\x01""trembling. I accept it as I\x01""accept all tribute: without\x04\x05\x41Ganondorf:\x05\x40\x01""thanks." } },
{ 0x200E, { "\x05\x41Ganondorf:\x05\x40\x01""You hold a road against me with\x01""a sign for your authority.", "\x05\x41Ganondorf:\x05\x40\x01""Roads close to subjects. They\x01""open to kings, or they are\x01""opened." } },
{ 0x200F, { "\x05\x41Ganondorf:\x05\x40\x01""You refuse what is offered by\x01""my hand.", "\x05\x41Ganondorf:\x05\x40\x01""Remember this refusal. I shall,\x01""and my memory is long." } },
{ 0x2011, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, soldier, with\x01""fear behind your teeth.", "\x05\x41Ganondorf:\x05\x40\x01""Labour is its own reward, they\x01""tell the poor. I have found\x01""dominion to be a better one." } },
{ 0x2014, { "\x05\x41Ganondorf:\x05\x40\x01""A groom who names himself\x01""master. Speak, Ingo; I know\x01""ambition when I smell it.", "\x05\x41Ganondorf:\x05\x40\x01""There is hunger in you, stable-\x01""hand. Hunger I can use. Stay\x01""where I may find you." } },
{ 0x2016, { "\x05\x41Ganondorf:\x05\x40\x01""A soldier sighing at his post.\x01""What grief can a gate have\x01""taught you?", "\x05\x41Ganondorf:\x05\x40\x01""You would give your child a\x01""mask. I shall give all the\x01""children of Hyrule a new king." } },
{ 0x2017, { "\x05\x41Ganondorf:\x05\x40\x01""What have you there, that your\x01""voice breaks upon it?", "\x05\x41Ganondorf:\x05\x40\x01""All that runs is run down at\x01""last. Dry your eyes. It is the\x01""one law I did not need to\x04\x05\x41Ganondorf:\x05\x40\x01""write." } },
{ 0x2018, { "\x05\x41Ganondorf:\x05\x40\x01""You start as at a thunderclap.", "\x05\x41Ganondorf:\x05\x40\x01""Collect yourself. You will see\x01""stranger things before my reign\x01""is old." } },
{ 0x2019, { "\x05\x41Ganondorf:\x05\x40\x01""You have lost what you pursued.\x01""I know the taste of it.", "\x05\x41Ganondorf:\x05\x40\x01""Then pursue again, and harder.\x01""What I lost, I took back with\x01""interest." } },
{ 0x2022, { "\x05\x41Ganondorf:\x05\x40\x01""The dead draw you, child, and\x01""you are forbidden them.", "\x05\x41Ganondorf:\x05\x40\x01""The living forbid; the dead\x01""make no objection. You show\x01""sound judgment in your choice\x04\x05\x41Ganondorf:\x05\x40\x01""of company." } },
{ 0x2024, { "\x05\x41Ganondorf:\x05\x40\x01""You protest your wealth to me.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it close. In the days\x01""coming, coin will buy less than\x01""obedience." } },
{ 0x2026, { "\x05\x41Ganondorf:\x05\x40\x01""You would wear another's face,\x01""and pay for the privilege.", "\x05\x41Ganondorf:\x05\x40\x01""Dig deep, then. Beneath every\x01""kingdom lies an older one, and\x01""I mean to have them all." } },
{ 0x2027, { "\x05\x41Ganondorf:\x05\x40\x01""Reproof again. You are fond of\x01""this instrument.", "" } },
{ 0x2028, { "\x05\x41Ganondorf:\x05\x40\x01""You are eager for the spade.", "\x05\x41Ganondorf:\x05\x40\x01""Dig, child. The earth of this\x01""land will be well turned before\x01""I have finished with it." } },
{ 0x2029, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of creatures that are\x01""no more.", "\x05\x41Ganondorf:\x05\x40\x01""They were hunted out by lesser\x01""huntsmen than I. Take note of\x01""what befalls the gentle." } },
{ 0x202A, { "\x05\x41Ganondorf:\x05\x40\x01""You admire the ears, and the\x01""hearing they promise.", "" } },
{ 0x202C, { "\x05\x41Ganondorf:\x05\x40\x01""My answer has not pleased you.", "\x05\x41Ganondorf:\x05\x40\x01""I do not shape my answers to\x01""please. Nations have learned it\x01""at greater cost than you." } },
{ 0x202E, { "\x05\x41Ganondorf:\x05\x40\x01""You reckon up my gains like a\x01""clerk.", "" } },
{ 0x2030, { "\x05\x41Ganondorf:\x05\x40\x01""Rumour dogs you, Ingo, and you\x01""would be shriven of it.", "" } },
{ 0x2032, { "\x05\x41Ganondorf:\x05\x40\x01""You swallow an insult and bring\x01""up a courtesy. You learn\x01""swiftly.", "\x05\x41Ganondorf:\x05\x40\x01""See that the lesson holds. I do\x01""not teach it twice." } },
{ 0x2033, { "\x05\x41Ganondorf:\x05\x40\x01""You speak to me of payment.", "\x05\x41Ganondorf:\x05\x40\x01""Rules. Keep them, steward, for\x01""those who must. I shall\x01""remember that you kept them\x04\x05\x41Ganondorf:\x05\x40\x01""even with me." } },
{ 0x2039, { "\x05\x41Ganondorf:\x05\x40\x01""You observe that I carry no\x01""purse.", "\x05\x41Ganondorf:\x05\x40\x01""A king's wealth is not in his\x01""wallet but in whatever lies\x01""between the horizons. Reckon\x04\x05\x41Ganondorf:\x05\x40\x01""that, if you can." } },
{ 0x203E, { "\x05\x41Ganondorf:\x05\x40\x01""You crow, and then recall\x01""before whom you crow.", "\x05\x41Ganondorf:\x05\x40\x01""Enjoy your victory. I granted\x01""it, as I grant all things here,\x01""and I may yet revoke it." } },
{ 0x203F, { "\x05\x41Ganondorf:\x05\x40\x01""You challenge my presence, and\x01""choke upon the challenge.", "" } },
{ 0x2040, { "\x05\x41Ganondorf:\x05\x40\x01""You lament the working man's\x01""lot before a king.", "\x05\x41Ganondorf:\x05\x40\x01""I was born in a land where even\x01""kings go thirsty. Do not\x01""instruct me in hardship." } },
{ 0x2042, { "\x05\x41Ganondorf:\x05\x40\x01""Your father is gone to the\x01""castle, and you look to the\x01""road.", "\x05\x41Ganondorf:\x05\x40\x01""I saw many in that castle. Soon\x01""it will matter little who went\x01""in. What matters is who comes\x04\x05\x41Ganondorf:\x05\x40\x01""out its master." } },
{ 0x2045, { "\x05\x41Ganondorf:\x05\x40\x01""The groom rages at his lot.\x01""Rage on; I am listening with\x01""interest.", "" } },
{ 0x2046, { "\x05\x41Ganondorf:\x05\x40\x01""You would see the ranch change\x01""hands. You say it to the right\x01""man.", "\x05\x41Ganondorf:\x05\x40\x01""Someone powerful. Yes. Serve me\x01""well, and you shall learn how\x01""swiftly a deed changes its\x04\x05\x41Ganondorf:\x05\x40\x01""name." } },
{ 0x2049, { "\x05\x41Ganondorf:\x05\x40\x01""A song of your mother's making.\x01""You would have a king sing.", "\x05\x41Ganondorf:\x05\x40\x01""I do not sing, girl. But I will\x01""hear it. My own mothers sang of\x01""little save revenge." } },
{ 0x204B, { "\x05\x41Ganondorf:\x05\x40\x01""Asleep. So does all Hyrule\x01""slumber, and I walk through it\x01""unchallenged.", "\x05\x41Ganondorf:\x05\x40\x01""Sleep on. When you wake, the\x01""world will have a new master\x01""and you will not have noticed\x04\x05\x41Ganondorf:\x05\x40\x01""the changing." } },
{ 0x204C, { "\x05\x41Ganondorf:\x05\x40\x01""You greet a guest, and then you\x01""see his face.", "\x05\x41Ganondorf:\x05\x40\x01""No visitor has ever been so\x01""long remembered as I shall be.\x01""Mark the day." } },
{ 0x204D, { "\x05\x41Ganondorf:\x05\x40\x01""Swiftness gained, and you\x01""cannot tell if it is a\x01""blessing.", "\x05\x41Ganondorf:\x05\x40\x01""Speed without purpose is\x01""flight. Find a purpose, or you\x01""will only ever be running from\x04\x05\x41Ganondorf:\x05\x40\x01""mine." } },
{ 0x204E, { "\x05\x41Ganondorf:\x05\x40\x01""Even in sleep the song\x01""disquiets you.", "\x05\x41Ganondorf:\x05\x40\x01""Dream on, little man. The\x01""waking will be harder." } },
{ 0x204F, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah points me to the\x01""mountain. I had marked it\x01""already.", "\x05\x41Ganondorf:\x05\x40\x01""I know that mountain. I have\x01""stopped its mouth with a stone,\x01""and its people starve at my\x04\x05\x41Ganondorf:\x05\x40\x01""pleasure." } },
{ 0x2050, { "\x05\x41Ganondorf:\x05\x40\x01""You fear the groom should hear\x01""you sing. And me.", "\x05\x41Ganondorf:\x05\x40\x01""Your secret is beneath my\x01""notice, and therefore safe. Few\x01""can say as much." } },
{ 0x2051, { "\x05\x41Ganondorf:\x05\x40\x01""The air has reached you, girl.\x01""I see your mother in your eyes.", "" } },
{ 0x2052, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the mare, and of\x01""who may master her.", "\x05\x41Ganondorf:\x05\x40\x01""What will not be broken must be\x01""won. I know both arts, and I am\x01""patient in the second." } },
{ 0x2053, { "\x05\x41Ganondorf:\x05\x40\x01""A stone that watches. Even the\x01""rocks of this land keep spies.", "\x05\x41Ganondorf:\x05\x40\x01""It looks away. Stone is wiser\x01""than men." } },
{ 0x2054, { "\x05\x41Ganondorf:\x05\x40\x01""The stone speaks to the mask.\x01""It has secrets to sell.", "\x05\x41Ganondorf:\x05\x40\x01""I am told the stones of Hyrule\x01""gossip. Good. I shall have need\x01""of informers." } },
{ 0x2055, { "\x05\x41Ganondorf:\x05\x40\x01""You vow amendment, and name me\x01""in the vow.", "\x05\x41Ganondorf:\x05\x40\x01""Turn what leaves you will. The\x01""tree is mine, root and branch." } },
{ 0x2056, { "\x05\x41Ganondorf:\x05\x40\x01""You plead the groom's cause to\x01""the one who tempted him.", "\x05\x41Ganondorf:\x05\x40\x01""I tempt no man. I merely show\x01""him his own heart, and stand\x01""aside." } },
{ 0x2057, { "\x05\x41Ganondorf:\x05\x40\x01""Still you slumber, and mutter\x01""of toil.", "\x05\x41Ganondorf:\x05\x40\x01""Rest, working man. I shall set\x01""your whole kingdom to labour\x01""soon enough." } },
{ 0x2059, { "\x05\x41Ganondorf:\x05\x40\x01""You leave the door ajar for me.", "\x05\x41Ganondorf:\x05\x40\x01""I do not change my mind. I\x01""change the world, until it\x01""agrees with me." } },
{ 0x205D, { "\x05\x41Ganondorf:\x05\x40\x01""You fear the groom's\x01""displeasure more than mine.", "\x05\x41Ganondorf:\x05\x40\x01""A wise fear of a small master.\x01""You will make a tolerable\x01""subject." } },
{ 0x205F, { "\x05\x41Ganondorf:\x05\x40\x01""You abase yourself, Ingo, with\x01""an eye upon the door.", "\x05\x41Ganondorf:\x05\x40\x01""Take it from you? What I gave,\x01""I may reclaim. Let that keep\x01""you honest." } },
{ 0x2060, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah marvels that her\x01""princess should trust me.", "\x05\x41Ganondorf:\x05\x40\x01""We shall protect this land, you\x01""and I, as the wolf and the\x01""shepherd both protect the\x04\x05\x41Ganondorf:\x05\x40\x01""flock. To different ends." } },
{ 0x2061, { "\x05\x41Ganondorf:\x05\x40\x01""My instrument amuses you, girl.", "\x05\x41Ganondorf:\x05\x40\x01""These hands have closed upon\x01""the throat of a kingdom. They\x01""can yet find a tune." } },
{ 0x2062, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me of your village,\x01""Sheikah, as if I had not long\x01""since numbered it.", "\x05\x41Ganondorf:\x05\x40\x01""Kakariko. A name I shall write\x01""in ash, when its hour comes." } },
{ 0x2063, { "\x05\x41Ganondorf:\x05\x40\x01""A song kept for the blood royal\x01""alone.", "\x05\x41Ganondorf:\x05\x40\x01""Only the Royal Family. Then I\x01""am learning it betimes; I shall\x01""be the whole of that family ere\x04\x05\x41Ganondorf:\x05\x40\x01""long." } },
{ 0x2064, { "\x05\x41Ganondorf:\x05\x40\x01""The old watcher, perched above\x01""my road again.", "" } },
{ 0x2065, { "\x05\x41Ganondorf:\x05\x40\x01""You show me the castle road,\x01""bird, as though I were a\x01""stranger to it.", "" } },
{ 0x2067, { "\x05\x41Ganondorf:\x05\x40\x01""You will keep your eye upon me.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it, owl. I would have one\x01""witness who understood what he\x01""saw." } },
{ 0x206B, { "\x05\x41Ganondorf:\x05\x40\x01""You name me clever, bird, and\x01""fear the word as you say it.", "\x05\x41Ganondorf:\x05\x40\x01""Too wise for your peace, yes.\x01""Fortune I do not need; I have\x01""appetite." } },
{ 0x206E, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me choose wisely.", "\x05\x41Ganondorf:\x05\x40\x01""I chose long ago, in a cradle\x01""of sand, with two witches for\x01""my witnesses. There is no\x04\x05\x41Ganondorf:\x05\x40\x01""unchoosing." } },
{ 0x2070, { "\x05\x41Ganondorf:\x05\x40\x01""You counsel me against anger.", "\x05\x41Ganondorf:\x05\x40\x01""My wrath is not a weather,\x01""bird. It is a blade, and I draw\x01""it when I choose." } },
{ 0x2072, { "\x05\x41Ganondorf:\x05\x40\x01""You speed me on my way.", "\x05\x41Ganondorf:\x05\x40\x01""I go. And where I go, the map\x01""is redrawn behind me." } },
{ 0x208A, { "\x05\x41Ganondorf:\x05\x40\x01""You offer milk, and find no\x01""vessel in my hands.", "\x05\x41Ganondorf:\x05\x40\x01""Hyrule overflows, and has no\x01""cup to give the thirsty. That\x01""is the whole of my quarrel with\x04\x05\x41Ganondorf:\x05\x40\x01""it." } },
{ 0x208E, { "\x05\x41Ganondorf:\x05\x40\x01""You would school me in\x01""horsemanship.", "\x05\x41Ganondorf:\x05\x40\x01""I rode before I walked, girl,\x01""across wastes that would kill\x01""your finest mare. But say on." } },
// Death Mountain, Goron City and the Fire Temple
{ 0x3002, { "\x05\x41Ganondorf:\x05\x40\x01""The great smith of the\x01""mountain. Even kings must look\x01""up to address you.", "\x05\x41Ganondorf:\x05\x40\x01""A fair exchange. I honour a\x01""maker, though I unmake so much." } },
{ 0x3003, { "\x05\x41Ganondorf:\x05\x40\x01""You bestow a gift upon the one\x01""who starved your kin.", "\x05\x41Ganondorf:\x05\x40\x01""Not upon Gorons. You bargain\x01""shrewdly, giant, even in your\x01""giving." } },
{ 0x3004, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh, child of stone, and\x01""name my deed to my face.", "\x05\x41Ganondorf:\x05\x40\x01""I sealed it, and I unsealed it.\x01""Let the mountain learn that\x01""both its hunger and its feast\x04\x05\x41Ganondorf:\x05\x40\x01""are mine to give." } },
{ 0x3007, { "\x05\x41Ganondorf:\x05\x40\x01""The chieftain dances. So fell\x01""the gravity of the mountain\x01""kings.", "\x05\x41Ganondorf:\x05\x40\x01""A people who can be moved by a\x01""tune can be ruled by one. I\x01""shall remember it." } },
{ 0x3008, { "\x05\x41Ganondorf:\x05\x40\x01""A son of the rock. Declare\x01""yourself.", "" } },
{ 0x3009, { "\x05\x41Ganondorf:\x05\x40\x01""You dream of falling like\x01""thunder upon the lowlands.", "\x05\x41Ganondorf:\x05\x40\x01""Ruin, then, is your heart's\x01""desire. We are nearer kin than\x01""your chief would own." } },
{ 0x300B, { "\x05\x41Ganondorf:\x05\x40\x01""You show me the mountain's\x01""black harvest.", "\x05\x41Ganondorf:\x05\x40\x01""A flower that bears fire. Your\x01""whole land flowers so, and I am\x01""come to gather it." } },
{ 0x300D, { "\x05\x41Ganondorf:\x05\x40\x01""You name the cavern, and you\x01""name its jailer.", "\x05\x41Ganondorf:\x05\x40\x01""I closed it with one hand.\x01""Think what the other is kept\x01""for." } },
{ 0x300E, { "\x05\x41Ganondorf:\x05\x40\x01""You do not know my face, stone-\x01""eater. That is rare, and will\x01""be rarer.", "" } },
{ 0x3011, { "\x05\x41Ganondorf:\x05\x40\x01""You resent being halted in your\x01""course.", "\x05\x41Ganondorf:\x05\x40\x01""Mountains have halted for me.\x01""You will learn to." } },
{ 0x3013, { "\x05\x41Ganondorf:\x05\x40\x01""Your thanks come grudging and\x01""in motion.", "\x05\x41Ganondorf:\x05\x40\x01""Roll on. I ask no gratitude,\x01""only that I be remembered when\x01""the choosing comes." } },
{ 0x3014, { "\x05\x41Ganondorf:\x05\x40\x01""Famine has you by the belly. I\x01""know that grip; it nursed me.", "" } },
{ 0x3015, { "\x05\x41Ganondorf:\x05\x40\x01""You hunger for the cavern's\x01""meat, and demand it of me.", "\x05\x41Ganondorf:\x05\x40\x01""Demand. Good. It is a word my\x01""people were forbidden for four\x01""hundred years." } },
{ 0x3016, { "\x05\x41Ganondorf:\x05\x40\x01""You cry warning to me upon the\x01""height.", "" } },
{ 0x3017, { "\x05\x41Ganondorf:\x05\x40\x01""Your chieftain bars his door\x01""and waits upon a king's\x01""messenger.", "\x05\x41Ganondorf:\x05\x40\x01""He waits for a herald of the\x01""crown. He shall have the next\x01""wearer of it." } },
{ 0x3018, { "\x05\x41Ganondorf:\x05\x40\x01""Hunger has unseated your wits.", "" } },
{ 0x3019, { "\x05\x41Ganondorf:\x05\x40\x01""Your Big Brother has an ear for\x01""the forest's music, you say.", "" } },
{ 0x301A, { "\x05\x41Ganondorf:\x05\x40\x01""Darunia. You looked for a royal\x01""envoy, and the mountain sends\x01""you me.", "" } },
{ 0x301B, { "\x05\x41Ganondorf:\x05\x40\x01""You would shut me out of your\x01""people's sorrow.", "\x05\x41Ganondorf:\x05\x40\x01""There is no trouble on this\x01""mountain that is not mine. I am\x01""its author." } },
{ 0x301C, { "\x05\x41Ganondorf:\x05\x40\x01""The song has drawn your fangs,\x01""chieftain.", "\x05\x41Ganondorf:\x05\x40\x01""Most of your wrath. Keep the\x01""rest; I should think less of\x01""you without it." } },
{ 0x301D, { "\x05\x41Ganondorf:\x05\x40\x01""You set me a labour, as kings\x01""set labours for heroes.", "\x05\x41Ganondorf:\x05\x40\x01""I shall cleanse the cavern,\x01""because it serves me. Do not\x01""mistake the motive, nor forget\x04\x05\x41Ganondorf:\x05\x40\x01""the service." } },
{ 0x301E, { "\x05\x41Ganondorf:\x05\x40\x01""You would have the tune and not\x01""the player.", "\x05\x41Ganondorf:\x05\x40\x01""You may not sunder them. Where\x01""my music goes, I follow." } },
{ 0x301F, { "\x05\x41Ganondorf:\x05\x40\x01""It does not stale for you,\x01""though my hands make it.", "\x05\x41Ganondorf:\x05\x40\x01""Then you are already half\x01""conquered. The rest is merely a\x01""matter of time." } },
{ 0x3020, { "\x05\x41Ganondorf:\x05\x40\x01""My offering falls short of your\x01""desire.", "\x05\x41Ganondorf:\x05\x40\x01""You shall have your tune when\x01""it suits my design. All things\x01""come so." } },
{ 0x3021, { "\x05\x41Ganondorf:\x05\x40\x01""The cavern stands open, and you\x01""find the manner of it strange.", "\x05\x41Ganondorf:\x05\x40\x01""What I bind I may loose. That\x01""is all the meaning of the word\x01""king." } },
{ 0x3023, { "\x05\x41Ganondorf:\x05\x40\x01""Darunia. You praise me through\x01""your teeth.", "\x05\x41Ganondorf:\x05\x40\x01""Sworn Brother. I have had the\x01""title of many, and kept faith\x01""with none. Yet give me the\x04\x05\x41Ganondorf:\x05\x40\x01""stone." } },
{ 0x3024, { "\x05\x41Ganondorf:\x05\x40\x01""You have no thought but your\x01""belly.", "" } },
{ 0x3025, { "\x05\x41Ganondorf:\x05\x40\x01""You would have fire fetched\x01""from your chieftain's hall.", "\x05\x41Ganondorf:\x05\x40\x01""I am no torch-bearer. Yet fire\x01""is an old servant of mine, and\x01""comes when I call." } },
{ 0x3026, { "\x05\x41Ganondorf:\x05\x40\x01""You regret the bomb was not\x01""better aimed.", "\x05\x41Ganondorf:\x05\x40\x01""You have the wish, and lack the\x01""nerve. I have ever had both." } },
{ 0x3027, { "\x05\x41Ganondorf:\x05\x40\x01""You are at a loss how to name\x01""me.", "\x05\x41Ganondorf:\x05\x40\x01""Lord will serve. It serves in\x01""the desert, and it will serve\x01""upon the mountain." } },
{ 0x3029, { "\x05\x41Ganondorf:\x05\x40\x01""You owe me, and it galls you.", "\x05\x41Ganondorf:\x05\x40\x01""Name him what you will. The\x01""whole age shall bear my name;\x01""one child the more is nothing." } },
{ 0x302A, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me the gossip of your\x01""city.", "\x05\x41Ganondorf:\x05\x40\x01""I gather tidings as other kings\x01""gather taxes. I shall come up." } },
{ 0x302C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of your city when its\x01""fires were lit.", "\x05\x41Ganondorf:\x05\x40\x01""I have seen it dark. I confess\x01""I found it the more\x01""instructive." } },
{ 0x302E, { "\x05\x41Ganondorf:\x05\x40\x01""No bombs, no bread, and you lay\x01""it at my door.", "" } },
{ 0x302F, { "\x05\x41Ganondorf:\x05\x40\x01""You ask how your chieftain\x01""received me.", "" } },
{ 0x3030, { "\x05\x41Ganondorf:\x05\x40\x01""You know me, and you fly.", "\x05\x41Ganondorf:\x05\x40\x01""Then you are wiser than your\x01""elders, who stood and argued." } },
{ 0x3031, { "\x05\x41Ganondorf:\x05\x40\x01""You shrink before my name.", "\x05\x41Ganondorf:\x05\x40\x01""It is well. A name that does\x01""not make men tremble is but a\x01""noise." } },
{ 0x3032, { "\x05\x41Ganondorf:\x05\x40\x01""Your father named you for a\x01""stranger's deed.", "" } },
{ 0x3035, { "\x05\x41Ganondorf:\x05\x40\x01""You tell the old tale of the\x01""dragon.", "" } },
{ 0x3036, { "\x05\x41Ganondorf:\x05\x40\x01""Your people are borne away to\x01""the temple, and you name my\x01""servants as the takers.", "\x05\x41Ganondorf:\x05\x40\x01""It was done at my word. The\x01""mountain defied me once; I am\x01""teaching it the price, with a\x04\x05\x41Ganondorf:\x05\x40\x01""dragon for my schoolmaster." } },
{ 0x3037, { "\x05\x41Ganondorf:\x05\x40\x01""Your father charged you to let\x01""none follow.", "" } },
{ 0x3038, { "\x05\x41Ganondorf:\x05\x40\x01""You disclose the secret of your\x01""father's door.", "\x05\x41Ganondorf:\x05\x40\x01""Sons have ever sold their\x01""fathers' gates. It is how most\x01""cities fall." } },
{ 0x3039, { "\x05\x41Ganondorf:\x05\x40\x01""You know my step, chieftain,\x01""even in the dark.", "\x05\x41Ganondorf:\x05\x40\x01""I am grown, Darunia. So grow\x01""all things that are fed upon\x01""kingdoms." } },
{ 0x303A, { "\x05\x41Ganondorf:\x05\x40\x01""You cannot credit your\x01""deliverer.", "\x05\x41Ganondorf:\x05\x40\x01""Take what you are given and do\x01""not look for a reason. I had\x01""one. It was not you." } },
{ 0x303B, { "\x05\x41Ganondorf:\x05\x40\x01""Your strength fails you at the\x01""gate.", "\x05\x41Ganondorf:\x05\x40\x01""Go? I do not fly from my own\x01""beast. Stand aside, and watch\x01""how a master corrects his\x04\x05\x41Ganondorf:\x05\x40\x01""hound." } },
{ 0x303C, { "\x05\x41Ganondorf:\x05\x40\x01""You saw me slay what I had\x01""raised.", "\x05\x41Ganondorf:\x05\x40\x01""What I make, I may unmake. Let\x01""the mountain remember it when\x01""next I ask for its allegiance." } },
{ 0x303E, { "\x05\x41Ganondorf:\x05\x40\x01""You speak to me of friendship,\x01""grown slow as stone.", "\x05\x41Ganondorf:\x05\x40\x01""A feeling of the heart. I laid\x01""my heart aside long ago,\x01""chieftain, the better to carry\x04\x05\x41Ganondorf:\x05\x40\x01""a crown." } },
{ 0x303F, { "\x05\x41Ganondorf:\x05\x40\x01""You part from me in doubt.", "\x05\x41Ganondorf:\x05\x40\x01""Friend or nothing. You offer me\x01""two things I have never\x01""required." } },
{ 0x3041, { "\x05\x41Ganondorf:\x05\x40\x01""Your people return, and you\x01""cannot fit my part into the\x01""tale.", "" } },
{ 0x3042, { "\x05\x41Ganondorf:\x05\x40\x01""You would have my strength,\x01""wedded to your father's\x01""goodness.", "\x05\x41Ganondorf:\x05\x40\x01""They do not wed, child. I have\x01""looked. Choose the one that\x01""wins." } },
{ 0x3043, { "\x05\x41Ganondorf:\x05\x40\x01""My name sticks in your throat.", "\x05\x41Ganondorf:\x05\x40\x01""It will come easier. All Hyrule\x01""is learning to say it." } },
{ 0x3044, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, and beg in the\x01""same breath.", "" } },
{ 0x3045, { "\x05\x41Ganondorf:\x05\x40\x01""The wild chieftain finds\x01""himself a Sage.", "\x05\x41Ganondorf:\x05\x40\x01""A Sage. So the mountain, too,\x01""sets a watchman over me. I am\x01""flattered by so many gaolers." } },
{ 0x3046, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me the fire's token,\x01""and your trust beside it.", "\x05\x41Ganondorf:\x05\x40\x01""Your trust is a heavy gift,\x01""chieftain, and I am a careless\x01""bearer. The medallion I shall\x04\x05\x41Ganondorf:\x05\x40\x01""keep." } },
{ 0x3047, { "\x05\x41Ganondorf:\x05\x40\x01""Your city is emptied, and still\x01""you keep shop.", "" } },
{ 0x3048, { "\x05\x41Ganondorf:\x05\x40\x01""You make a hero's tale of it.", "\x05\x41Ganondorf:\x05\x40\x01""Tell it as you please. In every\x01""telling worth the hearing, I am\x01""the one who remains." } },
{ 0x3049, { "\x05\x41Ganondorf:\x05\x40\x01""You strain at the narrow way.", "\x05\x41Ganondorf:\x05\x40\x01""This land was built for smaller\x01""men. I am widening it." } },
{ 0x304A, { "\x05\x41Ganondorf:\x05\x40\x01""You labour at some great work,\x01""smith.", "" } },
{ 0x304B, { "\x05\x41Ganondorf:\x05\x40\x01""Years, you say, and bid me keep\x01""my hands from conquest the\x01""while.", "\x05\x41Ganondorf:\x05\x40\x01""I have waited longer for less.\x01""But conquest keeps its own\x01""calendar, smith." } },
{ 0x304C, { "\x05\x41Ganondorf:\x05\x40\x01""A blade new from the forge, and\x01""a condition laid upon it.", "" } },
{ 0x304D, { "\x05\x41Ganondorf:\x05\x40\x01""You ask how it sits in the\x01""hand.", "\x05\x41Ganondorf:\x05\x40\x01""It will serve. All steel\x01""serves, once it has found the\x01""hand it was made for." } },
{ 0x304E, { "\x05\x41Ganondorf:\x05\x40\x01""You confess a flaw in your\x01""work.", "" } },
{ 0x3050, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me return.", "\x05\x41Ganondorf:\x05\x40\x01""I return to all places. It is\x01""the staying that others have\x01""cause to dread." } },
{ 0x3051, { "\x05\x41Ganondorf:\x05\x40\x01""You beg not to be devoured.", "\x05\x41Ganondorf:\x05\x40\x01""I do not eat my subjects, small\x01""one. I merely take the measure\x01""of them." } },
{ 0x3052, { "\x05\x41Ganondorf:\x05\x40\x01""Your Big Brother sent me, of\x01""all the world, to bring you\x01""off.", "\x05\x41Ganondorf:\x05\x40\x01""He was in desperate case. Such\x01""men make the most faithful\x01""debtors." } },
{ 0x3053, { "\x05\x41Ganondorf:\x05\x40\x01""The giant speaks of his\x01""brother's forge.", "\x05\x41Ganondorf:\x05\x40\x01""A house of blades. I shall look\x01""in. One may never own too many\x01""arguments." } },
{ 0x3054, { "\x05\x41Ganondorf:\x05\x40\x01""You know your own work, though\x01""it be broken.", "" } },
{ 0x3056, { "\x05\x41Ganondorf:\x05\x40\x01""Your eyes afflict you, maker of\x01""swords.", "\x05\x41Ganondorf:\x05\x40\x01""Even mountains weep. I have\x01""made several do so." } },
{ 0x3058, { "\x05\x41Ganondorf:\x05\x40\x01""You have waited with tears.", "\x05\x41Ganondorf:\x05\x40\x01""I carry your greeting. A king\x01""may be a courier, when the road\x01""is his in any case." } },
{ 0x305A, { "\x05\x41Ganondorf:\x05\x40\x01""The remedy takes hold, and you\x01""roar like a furnace.", "" } },
{ 0x305C, { "\x05\x41Ganondorf:\x05\x40\x01""You counsel patience to a king.", "\x05\x41Ganondorf:\x05\x40\x01""I have been patient since\x01""before your mountain cooled. A\x01""few days are nothing." } },
{ 0x305D, { "\x05\x41Ganondorf:\x05\x40\x01""You name me tyrant for my\x01""haste.", "\x05\x41Ganondorf:\x05\x40\x01""Tyrant is but the word the slow\x01""have for the swift. Finish your\x01""work." } },
{ 0x305E, { "\x05\x41Ganondorf:\x05\x40\x01""Your masterwork, and a charge\x01""to bear it wisely.", "\x05\x41Ganondorf:\x05\x40\x01""Wisely. I shall bear it as I\x01""bear all things: to the end for\x01""which I took it." } },
{ 0x3062, { "\x05\x41Ganondorf:\x05\x40\x01""The watcher greets me at the\x01""summit.", "\x05\x41Ganondorf:\x05\x40\x01""The summit of the sacred\x01""mountain. And still I stand\x01""above it. Let the heavens take\x04\x05\x41Ganondorf:\x05\x40\x01""note." } },
{ 0x3063, { "\x05\x41Ganondorf:\x05\x40\x01""You mark how my strength is\x01""increased, bird.", "\x05\x41Ganondorf:\x05\x40\x01""Every power in this land, fairy\x01""or flame, comes at last to my\x01""hand. You have a long watch\x04\x05\x41Ganondorf:\x05\x40\x01""before you." } },
{ 0x3064, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of a fair spirit upon\x01""the peak.", "\x05\x41Ganondorf:\x05\x40\x01""I have had dealings with her\x01""sisterhood. They give to all\x01""who ask boldly, and I ask no\x04\x05\x41Ganondorf:\x05\x40\x01""other way." } },
{ 0x3065, { "\x05\x41Ganondorf:\x05\x40\x01""You point me up the mountain.", "\x05\x41Ganondorf:\x05\x40\x01""I climb where I will. The\x01""mountain has not been raised\x01""that keeps me at its foot." } },
{ 0x3067, { "\x05\x41Ganondorf:\x05\x40\x01""You ask after the red stone,\x01""child, with your tongue out.", "\x05\x41Ganondorf:\x05\x40\x01""The stone is not for tasting.\x01""It is one key of three, and the\x01""door they open is the world's." } },
{ 0x3068, { "\x05\x41Ganondorf:\x05\x40\x01""You wish me well in my arts,\x01""and wish me scant time to use\x01""them.", "\x05\x41Ganondorf:\x05\x40\x01""My skill grows with every\x01""league. It is your hope that\x01""withers." } },
{ 0x3069, { "\x05\x41Ganondorf:\x05\x40\x01""You pay your ransom in secrets,\x01""to him who held you.", "\x05\x41Ganondorf:\x05\x40\x01""Caged by my word and loosed by\x01""my hand. Now you know both\x01""edges of my rule." } },
{ 0x306A, { "\x05\x41Ganondorf:\x05\x40\x01""You repay your freedom with\x01""counsel.", "\x05\x41Ganondorf:\x05\x40\x01""Fire has never harmed me; it is\x01""my oldest ally. Yet I hear you." } },
{ 0x306B, { "\x05\x41Ganondorf:\x05\x40\x01""You have a warning for your\x01""rescuer.", "\x05\x41Ganondorf:\x05\x40\x01""I bred half the horrors in this\x01""place. I shall know them when\x01""we meet." } },
{ 0x306C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of what must be cut\x01""to be turned.", "\x05\x41Ganondorf:\x05\x40\x01""Much in this world must be cut\x01""before it will turn. It is my\x01""whole craft." } },
{ 0x306D, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of the room the chart\x01""conceals.", "\x05\x41Ganondorf:\x05\x40\x01""No chamber stays hidden from me\x01""for long. Walls are only\x01""patience made stone." } },
{ 0x306E, { "\x05\x41Ganondorf:\x05\x40\x01""You name the way your chieftain\x01""went.", "\x05\x41Ganondorf:\x05\x40\x01""Where he has gone, I follow.\x01""There is no door on this\x01""mountain I did not first\x04\x05\x41Ganondorf:\x05\x40\x01""permit." } },
{ 0x306F, { "\x05\x41Ganondorf:\x05\x40\x01""A door within the statue's\x01""breast, you say.", "\x05\x41Ganondorf:\x05\x40\x01""Every idol is hollow, Goron. I\x01""learned it young, at the feet\x01""of goddesses." } },
{ 0x3070, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of walls that your\x01""crop may breach.", "\x05\x41Ganondorf:\x05\x40\x01""Then your people have always\x01""carried the means of their own\x01""siege. I merely showed them the\x04\x05\x41Ganondorf:\x05\x40\x01""wall." } },
// Zora's Domain, Zora's Fountain, Lake Hylia and the fishing pond
{ 0x4002, { "\x05\x41Ganondorf:\x05\x40\x01""The owl summons me by a name\x01""not mine, as though I were some\x01""errant boy.", "" } },
{ 0x4003, { "\x05\x41Ganondorf:\x05\x40\x01""You marvel at the height I have\x01""climbed. I have climbed higher,\x01""bird, and will climb higher\x04\x05\x41Ganondorf:\x05\x40\x01""still.", "\x05\x41Ganondorf:\x05\x40\x01""Look about you, you say. I have\x01""looked. All of it is mine in\x01""prospect." } },
{ 0x4004, { "\x05\x41Ganondorf:\x05\x40\x01""You offer to bear me to the\x01""castle upon your talons.", "\x05\x41Ganondorf:\x05\x40\x01""I go to the castle on my own\x01""feet, owl, and enter it by its\x01""front gate. As its next master\x04\x05\x41Ganondorf:\x05\x40\x01""should." } },
{ 0x4006, { "\x05\x41Ganondorf:\x05\x40\x01""You challenge me at the\x01""threshold of your realm, fish.\x01""Proud words, from a proud race.", "\x05\x41Ganondorf:\x05\x40\x01""A connection to the royal\x01""family? I have their ear, their\x01""hospitality, and soon their\x04\x05\x41Ganondorf:\x05\x40\x01""throne." } },
{ 0x4007, { "\x05\x41Ganondorf:\x05\x40\x01""You boast of your diving to one\x01""bred in the waste.", "\x05\x41Ganondorf:\x05\x40\x01""The desert taught me that water\x01""is a weapon. I need not swim in\x01""it to rule it." } },
{ 0x4008, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the fountain that\x01""is the wellspring of Hyrule.", "" } },
{ 0x4009, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of your god, and of\x01""the princess who tends him.", "\x05\x41Ganondorf:\x05\x40\x01""A god that must be fed by a\x01""child. I have overthrown gods\x01""who asked for less." } },
{ 0x400A, { "\x05\x41Ganondorf:\x05\x40\x01""You declare your loyalty, and\x01""fling it at me like a spear.", "\x05\x41Ganondorf:\x05\x40\x01""Never. I have heard that word\x01""from many tongues. It has\x01""always proved a matter of time." } },
{ 0x400B, { "\x05\x41Ganondorf:\x05\x40\x01""You direct me to your king's\x01""chamber.", "\x05\x41Ganondorf:\x05\x40\x01""I shall go to him. Kings should\x01""be visited by the one who will\x01""succeed them." } },
{ 0x400D, { "\x05\x41Ganondorf:\x05\x40\x01""You recite your people's legend\x01""of the fish.", "\x05\x41Ganondorf:\x05\x40\x01""A god that may be bribed with a\x01""fish. Your faith is very tidy,\x01""Zora." } },
{ 0x400E, { "\x05\x41Ganondorf:\x05\x40\x01""You lament some small ill upon\x01""your waters.", "\x05\x41Ganondorf:\x05\x40\x01""Every pilgrim should see your\x01""god once, you say. Before the\x01""end, I agree." } },
{ 0x400F, { "\x05\x41Ganondorf:\x05\x40\x01""Your princess is lost, and your\x01""searchers turn up nothing.", "\x05\x41Ganondorf:\x05\x40\x01""Lost things are found by those\x01""who know where they were put. I\x01""know a great many such places." } },
{ 0x4010, { "\x05\x41Ganondorf:\x05\x40\x01""You would have me bear tidings\x01""to your king.", "\x05\x41Ganondorf:\x05\x40\x01""I shall bring him tidings.\x01""Whether he will thank me for\x01""them is another question." } },
{ 0x4011, { "\x05\x41Ganondorf:\x05\x40\x01""You trace the river of Hyrule\x01""back to its source.", "\x05\x41Ganondorf:\x05\x40\x01""He who holds the spring holds\x01""every field and every throat\x01""downstream. You have told me\x04\x05\x41Ganondorf:\x05\x40\x01""more than you know." } },
{ 0x4012, { "\x05\x41Ganondorf:\x05\x40\x01""You wake, and find your\x01""deliverer is the Gerudo King.", "\x05\x41Ganondorf:\x05\x40\x01""Even I. Life, like death, comes\x01""by my hand in this age.\x01""Remember from whose." } },
{ 0x4013, { "\x05\x41Ganondorf:\x05\x40\x01""You fret for your princess,\x01""gone to the lake's temple.", "\x05\x41Ganondorf:\x05\x40\x01""The temple keeps her. In time I\x01""shall decide what keeps the\x01""temple." } },
{ 0x4014, { "\x05\x41Ganondorf:\x05\x40\x01""You hesitate, merchant, over so\x01""small a thing as drops for the\x01""eyes.", "" } },
{ 0x4016, { "\x05\x41Ganondorf:\x05\x40\x01""You warn that the cure may\x01""spoil upon the road.", "\x05\x41Ganondorf:\x05\x40\x01""Nothing spoils that I carry. It\x01""would not dare." } },
{ 0x4017, { "\x05\x41Ganondorf:\x05\x40\x01""The owl again. You think I grow\x01""comfortable in my part.", "\x05\x41Ganondorf:\x05\x40\x01""It is no part, bird. It is the\x01""whole play, and I wrote it." } },
{ 0x4018, { "\x05\x41Ganondorf:\x05\x40\x01""You pursue your physic by the\x01""lake's waters.", "\x05\x41Ganondorf:\x05\x40\x01""Seek your cures, scholar. The\x01""ill I bring has no remedy in\x01""any vial." } },
{ 0x401A, { "\x05\x41Ganondorf:\x05\x40\x01""Your majesty grieves. It ill\x01""becomes so large a monarch.", "" } },
{ 0x401B, { "\x05\x41Ganondorf:\x05\x40\x01""The letter moves you more than\x01""any appeal of mine could.", "" } },
{ 0x401C, { "\x05\x41Ganondorf:\x05\x40\x01""You command me, Zora, as if I\x01""were your servant.", "\x05\x41Ganondorf:\x05\x40\x01""I undo nothing, king. I only\x01""decide which of my works the\x01""world shall see." } },
{ 0x401E, { "\x05\x41Ganondorf:\x05\x40\x01""You wail at the sight of it.", "\x05\x41Ganondorf:\x05\x40\x01""Lament is the music of\x01""conquered places. I have\x01""learned to hear it as applause." } },
{ 0x401F, { "\x05\x41Ganondorf:\x05\x40\x01""You live again, and resent the\x01""hand that gave it.", "\x05\x41Ganondorf:\x05\x40\x01""Smug? No. Satisfied. It is the\x01""face kings wear when the world\x01""proceeds as they intend." } },
{ 0x4020, { "\x05\x41Ganondorf:\x05\x40\x01""You ask after your lost girl,\x01""and threaten me in the same\x01""breath.", "\x05\x41Ganondorf:\x05\x40\x01""Should I have harmed her, you\x01""would not be standing here to\x01""ask." } },
{ 0x4021, { "\x05\x41Ganondorf:\x05\x40\x01""You ask what strangeness the\x01""lake has shown me.", "\x05\x41Ganondorf:\x05\x40\x01""The waters carry much. Some of\x01""it I sent, and some of it is\x01""still on its way." } },
{ 0x4022, { "\x05\x41Ganondorf:\x05\x40\x01""The princess scolds her\x01""rescuer. A novel discourtesy.", "\x05\x41Ganondorf:\x05\x40\x01""Useless. I have been called\x01""many things in my life; that is\x01""the first that was untrue." } },
{ 0x4023, { "\x05\x41Ganondorf:\x05\x40\x01""You admit to fear, and then\x01""retract the admission.", "\x05\x41Ganondorf:\x05\x40\x01""Of the fish, then. Keep that\x01""fiction. It is a comfort that\x01""will not last." } },
{ 0x4024, { "\x05\x41Ganondorf:\x05\x40\x01""You are struck dumb, child.", "\x05\x41Ganondorf:\x05\x40\x01""Silence is the first lesson my\x01""presence teaches. Most learn it\x01""more quickly than you." } },
{ 0x4026, { "\x05\x41Ganondorf:\x05\x40\x01""You name the stone I came for.", "" } },
{ 0x4027, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of your mother's\x01""gift, and of the man who should\x01""have it.", "\x05\x41Ganondorf:\x05\x40\x01""I have no use for a bride,\x01""girl. But I will take her\x01""dowry." } },
{ 0x4028, { "\x05\x41Ganondorf:\x05\x40\x01""You warn me of your father's\x01""spears.", "\x05\x41Ganondorf:\x05\x40\x01""He may skewer me if he can find\x01""the courage. Many kings have\x01""tried less." } },
{ 0x4029, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at me, and pretend to\x01""read my thoughts.", "" } },
{ 0x402A, { "\x05\x41Ganondorf:\x05\x40\x01""You complain that fish come\x01""dear.", "\x05\x41Ganondorf:\x05\x40\x01""All things come dear in a\x01""kingdom ripe for its ending." } },
{ 0x402B, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, and resent it.", "\x05\x41Ganondorf:\x05\x40\x01""My head is the one thing in\x01""Hyrule that grows no larger,\x01""for it is already the size of\x04\x05\x41Ganondorf:\x05\x40\x01""my ambitions." } },
{ 0x402C, { "\x05\x41Ganondorf:\x05\x40\x01""You ask whether your treasure\x01""served me.", "\x05\x41Ganondorf:\x05\x40\x01""It served. Treasures always do,\x01""once they are in the right\x01""hand." } },
{ 0x402D, { "\x05\x41Ganondorf:\x05\x40\x01""Your princess speaks of me, and\x01""you cannot fathom why.", "\x05\x41Ganondorf:\x05\x40\x01""Nor can she, I think. The heart\x01""is a country even I have not\x01""fully conquered." } },
{ 0x402E, { "\x05\x41Ganondorf:\x05\x40\x01""Your god is restored, and you\x01""find the timing curious.", "\x05\x41Ganondorf:\x05\x40\x01""Curious, yes. Let your people\x01""remember who sickened their\x01""god, and who made him whole." } },
{ 0x402F, { "\x05\x41Ganondorf:\x05\x40\x01""You praise your king's dignity\x01""to my face.", "\x05\x41Ganondorf:\x05\x40\x01""He sits his throne. I shall\x01""take mine. The difference is\x01""the whole of dignity." } },
{ 0x4030, { "\x05\x41Ganondorf:\x05\x40\x01""You hand over the remedy.", "\x05\x41Ganondorf:\x05\x40\x01""It shall reach its patient. I\x01""have no quarrel with old\x01""smiths, only with old kings." } },
{ 0x4031, { "\x05\x41Ganondorf:\x05\x40\x01""The watcher marks my growth\x01""once more.", "\x05\x41Ganondorf:\x05\x40\x01""The rest of my growth, owl,\x01""will be measured in kingdoms." } },
{ 0x4032, { "\x05\x41Ganondorf:\x05\x40\x01""You ask a souvenir of me.", "\x05\x41Ganondorf:\x05\x40\x01""I shall bring you the whole\x01""world, scholar, though you may\x01""not like its wrapping." } },
{ 0x4033, { "\x05\x41Ganondorf:\x05\x40\x01""You expect your king to reward\x01""me.", "\x05\x41Ganondorf:\x05\x40\x01""Then let him pay. Every coin he\x01""gives me brings his throne\x01""nearer the edge." } },
{ 0x4036, { "\x05\x41Ganondorf:\x05\x40\x01""We meet again, Sheikah. Under\x01""the ice, as it happens.", "\x05\x41Ganondorf:\x05\x40\x01""Again, and yet again. Your\x01""vigil grows tiresome, and I\x01""grow stronger." } },
{ 0x4037, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the curse upon\x01""this place, as if I did not\x01""know its author.", "\x05\x41Ganondorf:\x05\x40\x01""A monster in the temple. I set\x01""it there. Do not expect me to\x01""weep at its handiwork." } },
{ 0x4038, { "\x05\x41Ganondorf:\x05\x40\x01""Time, and the river, and a\x01""child's memories. You are\x01""melancholy, Sheikah.", "\x05\x41Ganondorf:\x05\x40\x01""Time does not pass in my realm.\x01""It obeys." } },
{ 0x4039, { "\x05\x41Ganondorf:\x05\x40\x01""You speak to me among the\x01""frozen ruins.", "\x05\x41Ganondorf:\x05\x40\x01""All that remains. Yes. This is\x01""what the Zoras chose when they\x01""would not choose me." } },
{ 0x403E, { "\x05\x41Ganondorf:\x05\x40\x01""You know me, girl, even after\x01""seven years.", "\x05\x41Ganondorf:\x05\x40\x01""Princess Ruto. You still claim\x01""me. You are the only soul in\x01""Hyrule so bold." } },
{ 0x403F, { "\x05\x41Ganondorf:\x05\x40\x01""You cry warning to me in the\x01""temple.", "\x05\x41Ganondorf:\x05\x40\x01""I see it, princess. Nothing in\x01""this place is natural. I made\x01""it so." } },
{ 0x4041, { "\x05\x41Ganondorf:\x05\x40\x01""You hold to your betrothal,\x01""even now.", "\x05\x41Ganondorf:\x05\x40\x01""Husband. Spare me that word.\x01""Call me king. It is the only\x01""vow I have ever kept." } },
{ 0x4043, { "\x05\x41Ganondorf:\x05\x40\x01""You ask if Ruto spoke of you.", "\x05\x41Ganondorf:\x05\x40\x01""We will restore Hyrule to\x01""peace. Yes. As the grave is\x01""peaceful." } },
{ 0x4045, { "\x05\x41Ganondorf:\x05\x40\x01""You learn where your daughter\x01""has gone.", "\x05\x41Ganondorf:\x05\x40\x01""The temple holds her, and the\x01""ice holds you. All waters\x01""answer me now." } },
{ 0x4046, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me your love, and\x01""then think better of it.", "\x05\x41Ganondorf:\x05\x40\x01""Withhold it, princess. It is a\x01""heavier gift than any crown,\x01""and I have no hand free to\x04\x05\x41Ganondorf:\x05\x40\x01""carry it." } },
{ 0x4047, { "\x05\x41Ganondorf:\x05\x40\x01""You sense the other princess\x01""lives.", "\x05\x41Ganondorf:\x05\x40\x01""Hope is a thin ice, princess. I\x01""have walked on thinner. Keep\x01""your warning." } },
{ 0x4049, { "\x05\x41Ganondorf:\x05\x40\x01""You must stay to guard the\x01""temple.", "\x05\x41Ganondorf:\x05\x40\x01""Guard it well. I shall come for\x01""the waters in my own season." } },
{ 0x404A, { "\x05\x41Ganondorf:\x05\x40\x01""You pray I mean justice.", "\x05\x41Ganondorf:\x05\x40\x01""I mean what kings mean. Justice\x01""is merely the name for whatever\x01""they have accomplished." } },
{ 0x404B, { "\x05\x41Ganondorf:\x05\x40\x01""You are shocked to find a\x01""Gerudo in the belly of your\x01""god.", "\x05\x41Ganondorf:\x05\x40\x01""Ruto of the Zoras. And I am\x01""Ganondorf of the Gerudo. One of\x01""us will bear the other home." } },
{ 0x404F, { "\x05\x41Ganondorf:\x05\x40\x01""You have found what you sought,\x01""and command me to throw you.", "\x05\x41Ganondorf:\x05\x40\x01""I throw kings from their\x01""thrones, princess. A princess\x01""to a ledge is nothing." } },
{ 0x4051, { "\x05\x41Ganondorf:\x05\x40\x01""You have found your mother's\x01""stone.", "\x05\x41Ganondorf:\x05\x40\x01""Your mother's stone, and my\x01""key. Things may be both." } },
{ 0x4052, { "\x05\x41Ganondorf:\x05\x40\x01""You demand to be carried home.", "\x05\x41Ganondorf:\x05\x40\x01""I shall bear you to your\x01""father, girl. It may be the\x01""last kindness your house has of\x04\x05\x41Ganondorf:\x05\x40\x01""me." } },
{ 0x4057, { "\x05\x41Ganondorf:\x05\x40\x01""The water rises, and the evil\x01""ebbs.", "\x05\x41Ganondorf:\x05\x40\x01""Evil passes from the lake to\x01""the next place I need it.\x01""Nothing is wasted in my\x04\x05\x41Ganondorf:\x05\x40\x01""economy." } },
{ 0x4058, { "\x05\x41Ganondorf:\x05\x40\x01""You wish to believe I shall\x01""save this world.", "\x05\x41Ganondorf:\x05\x40\x01""Saving and ruling are one deed,\x01""Sheikah. Only the chronicles\x01""quarrel about the word." } },
{ 0x4059, { "\x05\x41Ganondorf:\x05\x40\x01""You marvel that Ruto and I\x01""struck down the beast together.", "\x05\x41Ganondorf:\x05\x40\x01""Together. Yes. The best\x01""alliances are those where only\x01""one party knows the terms." } },
{ 0x4068, { "\x05\x41Ganondorf:\x05\x40\x01""You chew your beans and pretend\x01""I am not here.", "" } },
{ 0x4069, { "\x05\x41Ganondorf:\x05\x40\x01""You refuse me for want of coin.", "\x05\x41Ganondorf:\x05\x40\x01""Glaring, he says. I have not\x01""yet begun." } },
{ 0x406B, { "\x05\x41Ganondorf:\x05\x40\x01""You are sold out, and cling to\x01""your beans.", "\x05\x41Ganondorf:\x05\x40\x01""Keep them. I do not covet your\x01""little crop." } },
{ 0x406C, { "\x05\x41Ganondorf:\x05\x40\x01""You counsel me on the planting\x01""of beans.", "\x05\x41Ganondorf:\x05\x40\x01""Soft soil. Hyrule is full of\x01""it." } },
{ 0x4074, { "\x05\x41Ganondorf:\x05\x40\x01""You have watched me, you say,\x01""all this while.", "\x05\x41Ganondorf:\x05\x40\x01""Many watch me. Few see." } },
{ 0x4075, { "\x05\x41Ganondorf:\x05\x40\x01""You praise my diving, and set\x01""me a further depth.", "\x05\x41Ganondorf:\x05\x40\x01""I have found the bottom of\x01""things before. It is where I\x01""keep what I do not wish found." } },
{ 0x4076, { "\x05\x41Ganondorf:\x05\x40\x01""A scarecrow that wishes to\x01""wander.", "" } },
{ 0x407E, { "\x05\x41Ganondorf:\x05\x40\x01""You turn me away for lack of\x01""rupees.", "" } },
{ 0x4085, { "\x05\x41Ganondorf:\x05\x40\x01""You lecture a king on patience\x01""and fish.", "\x05\x41Ganondorf:\x05\x40\x01""Passion took me from the desert\x01""to the throne room. Fish are a\x01""lesser quarry." } },
{ 0x4088, { "\x05\x41Ganondorf:\x05\x40\x01""You ask if I have no conquests\x01""waiting.", "\x05\x41Ganondorf:\x05\x40\x01""Even conquerors must keep their\x01""tempers sharp. I do it on fish." } },
{ 0x408D, { "\x05\x41Ganondorf:\x05\x40\x01""You accuse me of selfishness.", "\x05\x41Ganondorf:\x05\x40\x01""Selfishness is the virtue of\x01""those who succeed." } },
{ 0x408E, { "\x05\x41Ganondorf:\x05\x40\x01""You keep your secrets close,\x01""fisherman.", "\x05\x41Ganondorf:\x05\x40\x01""Keep them, then. Every man must\x01""have something his king may one\x01""day want." } },
{ 0x408F, { "\x05\x41Ganondorf:\x05\x40\x01""You boast of your craft.", "\x05\x41Ganondorf:\x05\x40\x01""An old professional. I am\x01""something of one myself, in my\x01""own trade." } },
{ 0x4090, { "\x05\x41Ganondorf:\x05\x40\x01""The rules of the pond, posted\x01""for all.", "" } },
{ 0x4092, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me return when I am\x01""grown.", "\x05\x41Ganondorf:\x05\x40\x01""I am grown, fisherman. You\x01""merely have not looked up." } },
{ 0x4094, { "\x05\x41Ganondorf:\x05\x40\x01""You will not lend me another\x01""pond.", "" } },
{ 0x4095, { "\x05\x41Ganondorf:\x05\x40\x01""You itch, and will not say why.", "" } },
{ 0x4096, { "\x05\x41Ganondorf:\x05\x40\x01""You doubt that I can see the\x01""fish.", "" } },
{ 0x409D, { "\x05\x41Ganondorf:\x05\x40\x01""The rules are posted again.", "" } },
{ 0x409E, { "\x05\x41Ganondorf:\x05\x40\x01""You forbid me to take your rod.", "\x05\x41Ganondorf:\x05\x40\x01""I take what I will, fisherman.\x01""But I leave you your rod; it is\x01""not worth a crown." } },
{ 0x40A1, { "\x05\x41Ganondorf:\x05\x40\x01""The scarecrow of music. You\x01""hear a song once, you say.", "\x05\x41Ganondorf:\x05\x40\x01""Then hear mine, and never\x01""forget it. Few who hear it ever\x01""do." } },
{ 0x40A2, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me how to summon your\x01""fellow.", "\x05\x41Ganondorf:\x05\x40\x01""I call. Others come. It is the\x01""oldest custom of my house." } },
{ 0x40AD, { "\x05\x41Ganondorf:\x05\x40\x01""The scarecrow has forgotten the\x01""tune.", "\x05\x41Ganondorf:\x05\x40\x01""Forgotten? Then I shall play\x01""something you will remember." } },
{ 0x40AF, { "\x05\x41Ganondorf:\x05\x40\x01""You think I seek a different\x01""lure.", "" } },
// Kakariko Village, the Graveyard and the windmill
{ 0x5000, { "\x05\x41Ganondorf:\x05\x40\x01""The keeper of graves rises from\x01""his own, and finds me waiting.", "\x05\x41Ganondorf:\x05\x40\x01""Death and I are on familiar\x01""terms, ghost. You had merely\x01""forgotten whose servant you\x04\x05\x41Ganondorf:\x05\x40\x01""are." } },
{ 0x5001, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me a treasure dragged\x01""from the earth.", "\x05\x41Ganondorf:\x05\x40\x01""The dead keep better gifts than\x01""the living. I have always\x01""thought so." } },
{ 0x500D, { "\x05\x41Ganondorf:\x05\x40\x01""You leave the door open behind\x01""me, keeper.", "\x05\x41Ganondorf:\x05\x40\x01""I visit all graves in time.\x01""Yours I shall come back to." } },
{ 0x500E, { "\x05\x41Ganondorf:\x05\x40\x01""You demand coin of a king.", "\x05\x41Ganondorf:\x05\x40\x01""Tyrants pay, you say. Yes. In\x01""the end, the whole land pays\x01""their debts." } },
{ 0x500F, { "\x05\x41Ganondorf:\x05\x40\x01""You curse me from beyond the\x01""tomb.", "" } },
{ 0x5010, { "\x05\x41Ganondorf:\x05\x40\x01""The dead composers. Your\x01""village keeps its ghosts close.", "" } },
{ 0x5012, { "\x05\x41Ganondorf:\x05\x40\x01""The ghost dies again at my\x01""hand, and complains of it.", "" } },
{ 0x5013, { "\x05\x41Ganondorf:\x05\x40\x01""Once more, brother of the tomb.", "" } },
{ 0x5014, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the songs your\x01""brothers sought.", "" } },
{ 0x5015, { "\x05\x41Ganondorf:\x05\x40\x01""The rancher sleeps, and mumbles\x01""of his daughter.", "\x05\x41Ganondorf:\x05\x40\x01""Sleep on, old man. The kingdom\x01""you dream in is already ending." } },
{ 0x5016, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me the groom has taken\x01""the ranch.", "\x05\x41Ganondorf:\x05\x40\x01""Ingo knows the trick of it now.\x01""Take what you are told is not\x01""yours. I teach by example." } },
{ 0x5017, { "\x05\x41Ganondorf:\x05\x40\x01""You give thanks for your\x01""daughter, and wonder at the\x01""hand that saved her.", "\x05\x41Ganondorf:\x05\x40\x01""Go home to her. Remember, when\x01""the reckoning comes, that I\x01""spared the house of milk." } },
{ 0x5018, { "\x05\x41Ganondorf:\x05\x40\x01""You warn me off the graves, and\x01""quail to see me.", "" } },
{ 0x501A, { "\x05\x41Ganondorf:\x05\x40\x01""You find nothing, and say so.", "\x05\x41Ganondorf:\x05\x40\x01""There is always something. Your\x01""spade is too timid." } },
{ 0x501B, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me stand back, Sheikah.", "\x05\x41Ganondorf:\x05\x40\x01""I stand where I please. You may\x01""stand aside." } },
{ 0x501C, { "\x05\x41Ganondorf:\x05\x40\x01""You bring me tidings of a\x01""terrible thing, woman.", "\x05\x41Ganondorf:\x05\x40\x01""The shadow is loosed. Then some\x01""of my servants were never so\x01""well chained as your elders\x04\x05\x41Ganondorf:\x05\x40\x01""believed." } },
{ 0x501D, { "\x05\x41Ganondorf:\x05\x40\x01""You would have me use my power\x01""to protect.", "\x05\x41Ganondorf:\x05\x40\x01""Protect? I use it to possess.\x01""In the end there is no\x01""difference to those beneath it." } },
{ 0x5022, { "\x05\x41Ganondorf:\x05\x40\x01""You know the princess's ocarina\x01""in my hands.", "\x05\x41Ganondorf:\x05\x40\x01""As you feared. Your fears have\x01""ever been the truest prophets\x01""in this land." } },
{ 0x5024, { "\x05\x41Ganondorf:\x05\x40\x01""Six are awake. You call it the\x01""final hour.", "\x05\x41Ganondorf:\x05\x40\x01""Let them gather. Six Sages and\x01""a girl, against the King of\x01""Evil. I have faced longer odds\x04\x05\x41Ganondorf:\x05\x40\x01""in the desert at noon." } },
{ 0x5025, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of your people's long\x01""service to the crown.", "\x05\x41Ganondorf:\x05\x40\x01""Shadows of the throne. Then\x01""serve its next occupant as\x01""faithfully, Sheikah, and your\x04\x05\x41Ganondorf:\x05\x40\x01""people may yet endure." } },
{ 0x5026, { "\x05\x41Ganondorf:\x05\x40\x01""You charge me to protect your\x01""princess.", "\x05\x41Ganondorf:\x05\x40\x01""I shall keep near her. Nearer\x01""than she would wish." } },
{ 0x5027, { "\x05\x41Ganondorf:\x05\x40\x01""You ask after my bird.", "\x05\x41Ganondorf:\x05\x40\x01""He thrives. All things under my\x01""hand thrive, so long as they\x01""are useful." } },
{ 0x5028, { "\x05\x41Ganondorf:\x05\x40\x01""The master of carpenters greets\x01""the master of Hyrule.", "" } },
{ 0x5029, { "\x05\x41Ganondorf:\x05\x40\x01""You despair of your workmen,\x01""and beg me not to conquer.", "\x05\x41Ganondorf:\x05\x40\x01""Worthless men are spared by\x01""conquerors. They build the\x01""gallows." } },
{ 0x502A, { "\x05\x41Ganondorf:\x05\x40\x01""You point out the girl and her\x01""chickens.", "\x05\x41Ganondorf:\x05\x40\x01""Diligence. I prize it in\x01""subjects. Rarely in kings." } },
{ 0x502B, { "\x05\x41Ganondorf:\x05\x40\x01""You think the princess beyond\x01""my reach.", "\x05\x41Ganondorf:\x05\x40\x01""There is no reach beyond mine.\x01""There is only what I have not\x01""yet chosen to grasp." } },
{ 0x502C, { "\x05\x41Ganondorf:\x05\x40\x01""You promise I shall meet the\x01""princess, and that she will\x01""explain.", "\x05\x41Ganondorf:\x05\x40\x01""She will explain herself to me,\x01""yes. Every captive does." } },
{ 0x502D, { "\x05\x41Ganondorf:\x05\x40\x01""You run as though wind were in\x01""your heels.", "\x05\x41Ganondorf:\x05\x40\x01""You are swift for a mortal. I\x01""am swift for a storm." } },
{ 0x502E, { "\x05\x41Ganondorf:\x05\x40\x01""You ask whether your gift was\x01""of use.", "\x05\x41Ganondorf:\x05\x40\x01""Use is the only measure of a\x01""gift. Yours has passed." } },
{ 0x5030, { "\x05\x41Ganondorf:\x05\x40\x01""You say I am coming round.", "\x05\x41Ganondorf:\x05\x40\x01""I was never gone. I was merely\x01""occupied elsewhere." } },
{ 0x5031, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me Impa went to seal\x01""the Shadow Temple again.", "\x05\x41Ganondorf:\x05\x40\x01""Again. It is the Sheikah way:\x01""to lock the same door until it\x01""rusts off its hinges." } },
{ 0x5032, { "\x05\x41Ganondorf:\x05\x40\x01""You spin, and laugh, and spin.", "\x05\x41Ganondorf:\x05\x40\x01""Spin. All Hyrule shall spin\x01""soon, at my pleasure." } },
{ 0x5033, { "\x05\x41Ganondorf:\x05\x40\x01""You cry that the wheel turns\x01""too fast.", "\x05\x41Ganondorf:\x05\x40\x01""Things turn as fast as I bid\x01""them. Learn to hold fast." } },
{ 0x5034, { "\x05\x41Ganondorf:\x05\x40\x01""You curse a day seven years\x01""past.", "\x05\x41Ganondorf:\x05\x40\x01""It was not I who turned your\x01""mill into a storm. That debt is\x01""owed elsewhere. But I shall\x04\x05\x41Ganondorf:\x05\x40\x01""collect it for you." } },
{ 0x5035, { "\x05\x41Ganondorf:\x05\x40\x01""You see the ocarina, and\x01""remember a tune.", "\x05\x41Ganondorf:\x05\x40\x01""That reminds you. Yes, the past\x01""has a way of returning to those\x01""who wronged it." } },
{ 0x5036, { "\x05\x41Ganondorf:\x05\x40\x01""Your birds have fled you.", "\x05\x41Ganondorf:\x05\x40\x01""A king commands armies; must he\x01""now gather fowl? Very well.\x01""Even poultry shall know my\x04\x05\x41Ganondorf:\x05\x40\x01""mastery." } },
{ 0x5037, { "\x05\x41Ganondorf:\x05\x40\x01""Four more, you say.", "\x05\x41Ganondorf:\x05\x40\x01""One flock at a time. That is\x01""how kingdoms are gathered." } },
{ 0x5038, { "\x05\x41Ganondorf:\x05\x40\x01""Three remain.", "\x05\x41Ganondorf:\x05\x40\x01""Patience. I have the patience\x01""of the sand." } },
{ 0x5039, { "\x05\x41Ganondorf:\x05\x40\x01""Two are left.", "\x05\x41Ganondorf:\x05\x40\x01""Nearly done. As the realm will\x01""be." } },
{ 0x503A, { "\x05\x41Ganondorf:\x05\x40\x01""The last of them.", "\x05\x41Ganondorf:\x05\x40\x01""Then your flock is whole, and\x01""owes it to the King of Evil." } },
{ 0x503D, { "\x05\x41Ganondorf:\x05\x40\x01""You beg me not to tease your\x01""birds.", "\x05\x41Ganondorf:\x05\x40\x01""Eat them? I have more expensive\x01""tastes than poultry." } },
{ 0x503E, { "\x05\x41Ganondorf:\x05\x40\x01""You have bred a smaller bird.", "" } },
{ 0x5041, { "\x05\x41Ganondorf:\x05\x40\x01""You challenge me to a race,\x01""boy.", "\x05\x41Ganondorf:\x05\x40\x01""You may not look it, you say.\x01""You do not." } },
{ 0x5042, { "\x05\x41Ganondorf:\x05\x40\x01""You would have your bird\x01""contented.", "\x05\x41Ganondorf:\x05\x40\x01""I shall make it as content as a\x01""creature can be under my roof." } },
{ 0x5043, { "\x05\x41Ganondorf:\x05\x40\x01""The bird is happy, and you are\x01""pleased.", "" } },
{ 0x5047, { "\x05\x41Ganondorf:\x05\x40\x01""You grieve for your lonely\x01""brother.", "\x05\x41Ganondorf:\x05\x40\x01""Loneliness is the throne's\x01""oldest companion. Your brother\x01""had a king's lot, without the\x04\x05\x41Ganondorf:\x05\x40\x01""crown." } },
{ 0x5048, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the strange wood\x01""where fairies dwell.", "\x05\x41Ganondorf:\x05\x40\x01""I know it. I have made it\x01""stranger still." } },
{ 0x5049, { "\x05\x41Ganondorf:\x05\x40\x01""Your nose has caught a scent\x01""upon me.", "" } },
{ 0x504A, { "\x05\x41Ganondorf:\x05\x40\x01""The vagabond has fled into the\x01""forest.", "" } },
{ 0x504C, { "\x05\x41Ganondorf:\x05\x40\x01""You lack only a little.", "\x05\x41Ganondorf:\x05\x40\x01""So does every peasant who has\x01""ever waited on his king. Wait\x01""on." } },
{ 0x504F, { "\x05\x41Ganondorf:\x05\x40\x01""There is no cure for a tyrant,\x01""you say.", "\x05\x41Ganondorf:\x05\x40\x01""No cure, old man. Only the long\x01""pain of endurance, and I am a\x01""patient sickness." } },
{ 0x5050, { "\x05\x41Ganondorf:\x05\x40\x01""You can only watch the\x01""mountain.", "\x05\x41Ganondorf:\x05\x40\x01""Watch it well. It is where I\x01""keep the dragon." } },
{ 0x5051, { "\x05\x41Ganondorf:\x05\x40\x01""You watch the stars, and think\x01""them safer.", "\x05\x41Ganondorf:\x05\x40\x01""The stars have never wept for\x01""any king. They will not weep\x01""for you." } },
{ 0x5052, { "\x05\x41Ganondorf:\x05\x40\x01""You see fire upon the mountain.", "\x05\x41Ganondorf:\x05\x40\x01""Something is happening. I am\x01""happening, child." } },
{ 0x5053, { "\x05\x41Ganondorf:\x05\x40\x01""The mountain is calm again.", "\x05\x41Ganondorf:\x05\x40\x01""For now. Mountains keep their\x01""own counsel. So do I." } },
{ 0x5054, { "\x05\x41Ganondorf:\x05\x40\x01""You will not come down while I\x01""walk below.", "\x05\x41Ganondorf:\x05\x40\x01""Wise child. Kings and roofs\x01""keep a respectful distance." } },
{ 0x5055, { "\x05\x41Ganondorf:\x05\x40\x01""You give me a memento.", "\x05\x41Ganondorf:\x05\x40\x01""I collect mementos. Most of\x01""them were once kingdoms." } },
{ 0x5057, { "\x05\x41Ganondorf:\x05\x40\x01""You protest my entering. You\x01""are bold within your own walls.", "" } },
{ 0x5058, { "\x05\x41Ganondorf:\x05\x40\x01""You advise me to heed the\x01""chicken woman.", "\x05\x41Ganondorf:\x05\x40\x01""I heed whom I choose. Today, it\x01""may be her." } },
{ 0x5059, { "\x05\x41Ganondorf:\x05\x40\x01""You chide me for my hour.", "" } },
{ 0x505A, { "\x05\x41Ganondorf:\x05\x40\x01""The keeper of chickens fears\x01""them. Comical.", "\x05\x41Ganondorf:\x05\x40\x01""Every ruler has a weakness. The\x01""trick is to keep it in a pen." } },
{ 0x505B, { "\x05\x41Ganondorf:\x05\x40\x01""You cry against my trespass,\x01""and then see whose it is.", "" } },
{ 0x505C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the gravekeeper's\x01""ghost.", "\x05\x41Ganondorf:\x05\x40\x01""Dead men keep their posts. It\x01""is the living who desert\x01""theirs." } },
{ 0x505D, { "\x05\x41Ganondorf:\x05\x40\x01""You welcome me as a visitor to\x01""your village.", "" } },
{ 0x505E, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me make myself at home.", "\x05\x41Ganondorf:\x05\x40\x01""I make myself at home wherever\x01""I stand. It is not a skill; it\x01""is a right." } },
{ 0x505F, { "\x05\x41Ganondorf:\x05\x40\x01""You ask what has befallen your\x01""great Impa.", "\x05\x41Ganondorf:\x05\x40\x01""I did not happen to her. Not\x01""yet." } },
{ 0x5060, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the shame all\x01""people carry.", "" } },
{ 0x5061, { "\x05\x41Ganondorf:\x05\x40\x01""You think even that sluggard\x01""has his secrets.", "\x05\x41Ganondorf:\x05\x40\x01""He has dreams. Secrets require\x01""the courage to act." } },
{ 0x5062, { "\x05\x41Ganondorf:\x05\x40\x01""The bearded one has gone home,\x01""and is happy.", "\x05\x41Ganondorf:\x05\x40\x01""Let him be. Happiness is a\x01""luxury I permit to the\x01""harmless." } },
{ 0x5066, { "\x05\x41Ganondorf:\x05\x40\x01""You ask why I walk at night.", "" } },
{ 0x5068, { "\x05\x41Ganondorf:\x05\x40\x01""You warn me of the stranger in\x01""the mill.", "\x05\x41Ganondorf:\x05\x40\x01""I have met stranger. I have\x01""been stranger." } },
{ 0x5069, { "\x05\x41Ganondorf:\x05\x40\x01""You find all people disgusting.", "\x05\x41Ganondorf:\x05\x40\x01""In that, child, you and I are\x01""of one mind. Only I have done\x01""something about it." } },
{ 0x506A, { "\x05\x41Ganondorf:\x05\x40\x01""You toil at building.", "\x05\x41Ganondorf:\x05\x40\x01""Build well. Strong walls make\x01""proud ruins." } },
{ 0x506B, { "\x05\x41Ganondorf:\x05\x40\x01""You hunger, and would eat\x01""without me.", "\x05\x41Ganondorf:\x05\x40\x01""Eat, then. I do not dine with\x01""labourers. Nor do I starve\x01""them, if they serve." } },
{ 0x506C, { "\x05\x41Ganondorf:\x05\x40\x01""You grumble that your men are\x01""half-men.", "\x05\x41Ganondorf:\x05\x40\x01""Then pay them half, and conquer\x01""the other half of the world\x01""with what you save." } },
{ 0x5070, { "\x05\x41Ganondorf:\x05\x40\x01""Six more, you say.", "\x05\x41Ganondorf:\x05\x40\x01""A small army. But even small\x01""armies obey me." } },
{ 0x5072, { "\x05\x41Ganondorf:\x05\x40\x01""Five more, then.", "\x05\x41Ganondorf:\x05\x40\x01""Diminishing. All things\x01""diminish before me." } },
{ 0x5074, { "\x05\x41Ganondorf:\x05\x40\x01""You weep for your hands.", "\x05\x41Ganondorf:\x05\x40\x01""Hands are made for labour or\x01""for conquest. Yours have\x01""chosen." } },
{ 0x5075, { "\x05\x41Ganondorf:\x05\x40\x01""You dream of money without\x01""labour.", "\x05\x41Ganondorf:\x05\x40\x01""There is such a trade. It is\x01""called kingship." } },
{ 0x5076, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me your master's house\x01""is near.", "\x05\x41Ganondorf:\x05\x40\x01""Masters keep their distance\x01""from the work. A habit I share." } },
{ 0x5079, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me Impa has gone from\x01""her house.", "\x05\x41Ganondorf:\x05\x40\x01""Sheikah houses are always half-\x01""empty. Their owners live in\x01""shadows." } },
{ 0x507A, { "\x05\x41Ganondorf:\x05\x40\x01""You tell how Impa opened her\x01""village to all.", "\x05\x41Ganondorf:\x05\x40\x01""A Sheikah's mercy. It will bury\x01""her people." } },
{ 0x507B, { "\x05\x41Ganondorf:\x05\x40\x01""You saw the gravekeeper's\x01""ghost, you say.", "\x05\x41Ganondorf:\x05\x40\x01""I believe you. The dead walk in\x01""my age. It is their best\x01""season." } },
{ 0x507C, { "\x05\x41Ganondorf:\x05\x40\x01""You saw me fall from the sky in\x01""blue fire.", "\x05\x41Ganondorf:\x05\x40\x01""Not I. But I will take the\x01""credit, if it frightens you." } },
{ 0x507D, { "\x05\x41Ganondorf:\x05\x40\x01""No one believes you.", "\x05\x41Ganondorf:\x05\x40\x01""I believe you. It is the worst\x01""news you have heard all year." } },
{ 0x507E, { "\x05\x41Ganondorf:\x05\x40\x01""You put out the fire together.", "\x05\x41Ganondorf:\x05\x40\x01""My fire. Yes. It is still\x01""burning, elsewhere." } },
{ 0x507F, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at a hunted man.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh while you may. When I am\x01""done, laughter will be taxed." } },
{ 0x5080, { "\x05\x41Ganondorf:\x05\x40\x01""You mock a vision, and then see\x01""it is no vision.", "\x05\x41Ganondorf:\x05\x40\x01""He was not seeing things. He\x01""was seeing me." } },
{ 0x5081, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at my garments.", "\x05\x41Ganondorf:\x05\x40\x01""My garments were stitched in\x01""the deep desert by women who\x01""could flay you with a word.\x04\x05\x41Ganondorf:\x05\x40\x01""Laugh more quietly." } },
{ 0x5082, { "\x05\x41Ganondorf:\x05\x40\x01""You say laughter is the best\x01""medicine.", "\x05\x41Ganondorf:\x05\x40\x01""Then laugh, and be cured. I am\x01""the sickness, and I do not\x01""care." } },
{ 0x5083, { "\x05\x41Ganondorf:\x05\x40\x01""You are on top of the world.", "\x05\x41Ganondorf:\x05\x40\x01""No one sits above me for long.\x01""Not even roofers." } },
{ 0x5084, { "\x05\x41Ganondorf:\x05\x40\x01""You fear falling asleep and\x01""falling.", "\x05\x41Ganondorf:\x05\x40\x01""All who sit high learn that\x01""fear. Few learn to hold on." } },
{ 0x5085, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me the mill draws\x01""water from the well.", "\x05\x41Ganondorf:\x05\x40\x01""The well. I know what lies at\x01""its bottom. I put some of it\x01""there." } },
{ 0x5086, { "\x05\x41Ganondorf:\x05\x40\x01""You praise the woman's\x01""generosity.", "\x05\x41Ganondorf:\x05\x40\x01""Generous people are the easiest\x01""to rule. They cannot help but\x01""give." } },
{ 0x5087, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of a man with a\x01""seeing eye.", "\x05\x41Ganondorf:\x05\x40\x01""Every village has its seer.\x01""Every seer misses the one thing\x01""that matters: me." } },
{ 0x5088, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of a rich family long\x01""gone.", "\x05\x41Ganondorf:\x05\x40\x01""Wealth is a guest. It leaves\x01""when a stronger host calls." } },
{ 0x5089, { "\x05\x41Ganondorf:\x05\x40\x01""You call me an annoying brute.", "\x05\x41Ganondorf:\x05\x40\x01""Brute, perhaps. Annoying is a\x01""word for small things." } },
{ 0x508A, { "\x05\x41Ganondorf:\x05\x40\x01""You complain I violate your\x01""space.", "\x05\x41Ganondorf:\x05\x40\x01""All space is mine. I merely\x01""visit it." } },
{ 0x508B, { "\x05\x41Ganondorf:\x05\x40\x01""You point at the man with the\x01""beard.", "" } },
{ 0x508C, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the sluggard's\x01""ease.", "\x05\x41Ganondorf:\x05\x40\x01""Carefree men are the happiest\x01""of my subjects. They do not\x01""notice they are subjects." } },
{ 0x508D, { "\x05\x41Ganondorf:\x05\x40\x01""The sluggard reminds you of\x01""your Richard.", "" } },
{ 0x508E, { "\x05\x41Ganondorf:\x05\x40\x01""You blame me for the storm.", "\x05\x41Ganondorf:\x05\x40\x01""The storm is my weather, old\x01""man. Get used to it." } },
// Gerudo Valley, the Fortress, the Training Ground and the Spirit Temple
{ 0x6000, { "\x05\x41Ganondorf:\x05\x40\x01""Stay your blade, daughter. It\x01""is your king who stands before\x01""you.", "\x05\x41Ganondorf:\x05\x40\x01""Forgiven. A guard who stays a\x01""stranger is the guard I would\x01""keep." } },
{ 0x6001, { "\x05\x41Ganondorf:\x05\x40\x01""Rise, sister of the sands. Your\x01""king is returned among his\x01""people.", "\x05\x41Ganondorf:\x05\x40\x01""Hold the fortress in my name.\x01""Hyrule shall be ours before the\x01""moon is old." } },
{ 0x6002, { "\x05\x41Ganondorf:\x05\x40\x01""The gate, daughter. Your king\x01""would pass.", "\x05\x41Ganondorf:\x05\x40\x01""Open every gate of this land\x01""so, at a word. In time, they\x01""all shall." } },
{ 0x6003, { "\x05\x41Ganondorf:\x05\x40\x01""You bid your king beware your\x01""strength. I am gladdened.", "\x05\x41Ganondorf:\x05\x40\x01""Never take the Gerudo lightly.\x01""It is the first law of Hyrule,\x01""though Hyrule has not yet\x04\x05\x41Ganondorf:\x05\x40\x01""learned it." } },
{ 0x6005, { "\x05\x41Ganondorf:\x05\x40\x01""The desert gate is mine, you\x01""say. It always was.", "\x05\x41Ganondorf:\x05\x40\x01""I pass where I please,\x01""daughter. But I thank you for\x01""the courtesy." } },
{ 0x6006, { "\x05\x41Ganondorf:\x05\x40\x01""You lay hands on your king, at\x01""the witches' command.", "\x05\x41Ganondorf:\x05\x40\x01""My mothers have a strange way\x01""of welcoming their son. I shall\x01""have words with them." } },
{ 0x6007, { "\x05\x41Ganondorf:\x05\x40\x01""You marvel at my coming within\x01""these walls.", "\x05\x41Ganondorf:\x05\x40\x01""Guts. Yes. My people are born\x01""with them, and I was born their\x01""king." } },
{ 0x600C, { "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah speaks of the sword\x01""that carves through time.", "\x05\x41Ganondorf:\x05\x40\x01""A ship across the ages, and the\x01""boy is its oarsman. I shall\x01""sink it before it reaches\x04\x05\x41Ganondorf:\x05\x40\x01""harbour." } },
{ 0x600E, { "\x05\x41Ganondorf:\x05\x40\x01""You praise your king's daring,\x01""and lead on.", "\x05\x41Ganondorf:\x05\x40\x01""Lead, daughter. I shall follow,\x01""as the storm follows the scout." } },
{ 0x600F, { "\x05\x41Ganondorf:\x05\x40\x01""No horse, no test. Even for a\x01""king.", "\x05\x41Ganondorf:\x05\x40\x01""The rule is a good one. I wrote\x01""it, after all." } },
{ 0x6010, { "\x05\x41Ganondorf:\x05\x40\x01""You will not suffer a coward.\x01""Nor shall I.", "\x05\x41Ganondorf:\x05\x40\x01""There is no coward in the\x01""Gerudo's king. Only patience,\x01""which fools mistake for it." } },
{ 0x6011, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me I fell short.", "\x05\x41Ganondorf:\x05\x40\x01""Short of perfect, sister. I\x01""shall return, and the target\x01""shall learn its error." } },
{ 0x6012, { "\x05\x41Ganondorf:\x05\x40\x01""You yield the day to your king.", "\x05\x41Ganondorf:\x05\x40\x01""My blood runs true, as the\x01""sands run red at sunset. I\x01""accept your tribute." } },
{ 0x6013, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the Training\x01""Ground's laws.", "\x05\x41Ganondorf:\x05\x40\x01""Laws are for those who would\x01""earn their place. I already sit\x01""at the summit." } },
{ 0x6016, { "\x05\x41Ganondorf:\x05\x40\x01""You turn me away for lack of\x01""coin. Bold.", "\x05\x41Ganondorf:\x05\x40\x01""Even the king pays at the\x01""training grounds. It is a good\x01""law. I shall keep it." } },
{ 0x6017, { "\x05\x41Ganondorf:\x05\x40\x01""Hail to you, daughter. The\x01""desert calls me.", "" } },
{ 0x6019, { "\x05\x41Ganondorf:\x05\x40\x01""You ask why your king descended\x01""to such a place.", "" } },
{ 0x601A, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me make the best of my\x01""fall.", "\x05\x41Ganondorf:\x05\x40\x01""I have made the best of worse\x01""falls. That is how one comes to\x01""stand at the top." } },
{ 0x601B, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, and say you\x01""cannot match my gift.", "\x05\x41Ganondorf:\x05\x40\x01""No one matches the king's\x01""gifts. That is how one knows\x01""they are the king's." } },
{ 0x601E, { "\x05\x41Ganondorf:\x05\x40\x01""You bar the temple to a Gerudo.\x01""You forget who rules the\x01""Gerudo.", "\x05\x41Ganondorf:\x05\x40\x01""The temple belongs to my\x01""mothers, and through them to\x01""me. Remember it, child." } },
{ 0x601F, { "\x05\x41Ganondorf:\x05\x40\x01""You know no Sage, and would not\x01""tell me if you did.", "\x05\x41Ganondorf:\x05\x40\x01""Then I shall find them myself.\x01""I have found harder things." } },
{ 0x6021, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at the king, Nabooru.\x01""You always did.", "" } },
{ 0x6022, { "\x05\x41Ganondorf:\x05\x40\x01""You grant me courage, and call\x01""it blood.", "" } },
{ 0x6023, { "\x05\x41Ganondorf:\x05\x40\x01""You name yourself, thief, as if\x01""I did not know you.", "" } },
{ 0x6025, { "\x05\x41Ganondorf:\x05\x40\x01""You thank your king with a\x01""mocking twist.", "" } },
{ 0x6026, { "\x05\x41Ganondorf:\x05\x40\x01""You promise something great for\x01""the gauntlets.", "\x05\x41Ganondorf:\x05\x40\x01""You would bargain with your\x01""king, Nabooru. You are the only\x01""Gerudo who dares." } },
{ 0x6027, { "\x05\x41Ganondorf:\x05\x40\x01""King of thieves. You spit the\x01""title.", "\x05\x41Ganondorf:\x05\x40\x01""It is the oldest crown my\x01""people own. I wear it gladly." } },
{ 0x6028, { "\x05\x41Ganondorf:\x05\x40\x01""You demand to know where I bear\x01""you.", "\x05\x41Ganondorf:\x05\x40\x01""Somewhere you will not like.\x01""But it will make you mine, at\x01""last." } },
{ 0x6029, { "\x05\x41Ganondorf:\x05\x40\x01""Mother Koume. You have found\x01""company.", "\x05\x41Ganondorf:\x05\x40\x01""I am no intruder in your\x01""temple, mothers. I am its\x01""purpose." } },
{ 0x602A, { "\x05\x41Ganondorf:\x05\x40\x01""Mother Kotake. Yes, it is your\x01""boy.", "\x05\x41Ganondorf:\x05\x40\x01""Your boy, mothers. Grown, and\x01""nearly crowned." } },
{ 0x602B, { "\x05\x41Ganondorf:\x05\x40\x01""You scold my boldness, mothers.", "\x05\x41Ganondorf:\x05\x40\x01""You taught me boldness. Do not\x01""chide me for the lessons." } },
{ 0x602C, { "\x05\x41Ganondorf:\x05\x40\x01""A lesson for your own son.", "\x05\x41Ganondorf:\x05\x40\x01""Teach on. I have outgrown your\x01""lessons, but not my love of the\x01""teaching." } },
{ 0x602D, { "\x05\x41Ganondorf:\x05\x40\x01""You call upon your servant.", "" } },
{ 0x602E, { "\x05\x41Ganondorf:\x05\x40\x01""You bid her destroy me gently.\x01""How like you.", "\x05\x41Ganondorf:\x05\x40\x01""Gently. You have always been\x01""gentle with me, mothers. Only\x01""with me." } },
{ 0x602F, { "\x05\x41Ganondorf:\x05\x40\x01""The bewitched warrior speaks my\x01""name with her last strength.", "\x05\x41Ganondorf:\x05\x40\x01""Your mind is not your own,\x01""sister. But your blade is still\x01""mine." } },
{ 0x6030, { "\x05\x41Ganondorf:\x05\x40\x01""You wake, sister, not knowing\x01""where.", "\x05\x41Ganondorf:\x05\x40\x01""In a world I have made. Look\x01""about you." } },
{ 0x6031, { "\x05\x41Ganondorf:\x05\x40\x01""She is herself again, mothers.", "\x05\x41Ganondorf:\x05\x40\x01""Leave her be. She was the best\x01""of you." } },
{ 0x6032, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of Nabooru's standing\x01""among the girls.", "\x05\x41Ganondorf:\x05\x40\x01""Respect is the coin of the\x01""desert. She is rich in it. So\x01""am I." } },
{ 0x6033, { "\x05\x41Ganondorf:\x05\x40\x01""You would keep her in my\x01""service a while longer.", "\x05\x41Ganondorf:\x05\x40\x01""Not by sorcery. I want her\x01""loyalty, mothers, not her\x01""stupor." } },
{ 0x6034, { "\x05\x41Ganondorf:\x05\x40\x01""You would bewitch her again,\x01""for my sake.", "\x05\x41Ganondorf:\x05\x40\x01""Leave her mind be. I have\x01""enough puppets." } },
{ 0x6035, { "\x05\x41Ganondorf:\x05\x40\x01""You thank me, mothers, in your\x01""way.", "\x05\x41Ganondorf:\x05\x40\x01""Look what the little king has\x01""done. Yes. Look upon it, and\x01""know I owe you nothing more." } },
{ 0x6037, { "\x05\x41Ganondorf:\x05\x40\x01""You offer me something precious\x01""to you.", "\x05\x41Ganondorf:\x05\x40\x01""Let us compete, then, Nabooru.\x01""You have always been the one\x01""rival I respected." } },
{ 0x6038, { "\x05\x41Ganondorf:\x05\x40\x01""We part, as enemies or not.", "\x05\x41Ganondorf:\x05\x40\x01""Neither, Nabooru. We are what\x01""the desert made us." } },
{ 0x6039, { "\x05\x41Ganondorf:\x05\x40\x01""You confess you were bewitched.", "\x05\x41Ganondorf:\x05\x40\x01""The witches are my mothers, and\x01""their magic is old. You were\x01""not the first to fall to it,\x04\x05\x41Ganondorf:\x05\x40\x01""nor the last." } },
{ 0x603A, { "\x05\x41Ganondorf:\x05\x40\x01""You call me King of the Gerudo,\x01""and mean it.", "\x05\x41Ganondorf:\x05\x40\x01""For once the title fits, you\x01""say. It has always fitted. You\x01""merely did not look." } },
{ 0x603B, { "\x05\x41Ganondorf:\x05\x40\x01""You struggle against your\x01""captors.", "\x05\x41Ganondorf:\x05\x40\x01""Struggle. It is a good sign.\x01""The fierce are worth saving." } },
{ 0x603C, { "\x05\x41Ganondorf:\x05\x40\x01""You name the witches my\x01""minions, and me their master.", "\x05\x41Ganondorf:\x05\x40\x01""They are my mothers, Nabooru,\x01""not my minions. And this is\x01""their doing, not mine." } },
{ 0x603D, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me flee.", "\x05\x41Ganondorf:\x05\x40\x01""I flee from no one. Least of\x01""all from the women who raised\x01""me." } },
{ 0x603E, { "\x05\x41Ganondorf:\x05\x40\x01""You name the witches my\x01""mothers.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. Black magic and a mother's\x01""love. It is a strange\x01""inheritance." } },
{ 0x603F, { "\x05\x41Ganondorf:\x05\x40\x01""You show me the archery field.", "\x05\x41Ganondorf:\x05\x40\x01""Our people's oldest art. I\x01""shall show you how a king takes\x01""it." } },
{ 0x6044, { "\x05\x41Ganondorf:\x05\x40\x01""You call me master.", "\x05\x41Ganondorf:\x05\x40\x01""I am master of all I strike.\x01""Give me what is owed." } },
{ 0x6046, { "\x05\x41Ganondorf:\x05\x40\x01""The ultimate master, you say.", "\x05\x41Ganondorf:\x05\x40\x01""The valley will sing. Let it.\x01""Songs are cheaper than statues." } },
{ 0x605B, { "\x05\x41Ganondorf:\x05\x40\x01""You think I came to save you.", "\x05\x41Ganondorf:\x05\x40\x01""I came for my fortress. You\x01""happened to be in it. Go." } },
{ 0x605C, { "\x05\x41Ganondorf:\x05\x40\x01""The carpenter Jiro thanks his\x01""liberator.", "\x05\x41Ganondorf:\x05\x40\x01""You were a prisoner of my\x01""people. Now you are a debtor of\x01""their king." } },
{ 0x605D, { "\x05\x41Ganondorf:\x05\x40\x01""The carpenter Sabooro calls me\x01""fantastic.", "\x05\x41Ganondorf:\x05\x40\x01""Fantastic. I have been called\x01""worse by better men." } },
{ 0x605E, { "\x05\x41Ganondorf:\x05\x40\x01""You thought I had forgotten\x01""you.", "\x05\x41Ganondorf:\x05\x40\x01""I forget nothing, carpenter.\x01""Least of all who owes me." } },
{ 0x605F, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me Nabooru's\x01""experiments with gold.", "" } },
{ 0x6060, { "\x05\x41Ganondorf:\x05\x40\x01""You see behind the thieves, and\x01""find their king.", "\x05\x41Ganondorf:\x05\x40\x01""The Evil King. You say it as if\x01""it were a curse. In my land, it\x01""is a coronation." } },
{ 0x6061, { "\x05\x41Ganondorf:\x05\x40\x01""You remember Nabooru's code.", "" } },
{ 0x6062, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of cruelty, and lay\x01""it at Nabooru's door.", "\x05\x41Ganondorf:\x05\x40\x01""Cruelty is a tool. In the right\x01""hands it builds empires. In the\x01""wrong, it builds witches." } },
{ 0x6063, { "\x05\x41Ganondorf:\x05\x40\x01""You suspected the witches. You\x01""were right.", "\x05\x41Ganondorf:\x05\x40\x01""My mothers have their methods.\x01""I do not always approve." } },
{ 0x6064, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the honour of the\x01""bow and saddle among my people.", "" } },
{ 0x6065, { "\x05\x41Ganondorf:\x05\x40\x01""You urge me to the fortress\x01""archery.", "\x05\x41Ganondorf:\x05\x40\x01""I need no urging, carpenter, to\x01""do what I was born for." } },
{ 0x6066, { "\x05\x41Ganondorf:\x05\x40\x01""You praise me and stumble on my\x01""title.", "\x05\x41Ganondorf:\x05\x40\x01""Majesty. Practise it. You will\x01""need it." } },
{ 0x6067, { "\x05\x41Ganondorf:\x05\x40\x01""You plan a bridge now all are\x01""home.", "\x05\x41Ganondorf:\x05\x40\x01""Build it. It will carry my\x01""armies." } },
{ 0x6068, { "\x05\x41Ganondorf:\x05\x40\x01""The thieves are less fearsome\x01""without the witches.", "\x05\x41Ganondorf:\x05\x40\x01""They are less frightening. They\x01""are not less dangerous. Learn\x01""the difference." } },
{ 0x6069, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me my fortress lies\x01""beyond.", "\x05\x41Ganondorf:\x05\x40\x01""I know where my fortress lies,\x01""carpenter. I have known it all\x01""my life." } },
{ 0x606A, { "\x05\x41Ganondorf:\x05\x40\x01""The craftsman bemoans his\x01""broken bridge.", "" } },
{ 0x606B, { "\x05\x41Ganondorf:\x05\x40\x01""You set me an errand to find\x01""your men.", "\x05\x41Ganondorf:\x05\x40\x01""I shall find them. Whether they\x01""come home depends on their\x01""usefulness." } },
{ 0x606C, { "\x05\x41Ganondorf:\x05\x40\x01""You heard I freed your men, and\x01""find it strange.", "\x05\x41Ganondorf:\x05\x40\x01""Strange, perhaps. But useful\x01""men are not to be wasted." } },
{ 0x606D, { "\x05\x41Ganondorf:\x05\x40\x01""You claim the saw.", "" } },
{ 0x606F, { "\x05\x41Ganondorf:\x05\x40\x01""You call me a thief.", "\x05\x41Ganondorf:\x05\x40\x01""King of Thieves, craftsman. You\x01""speak the title with less\x01""respect than it deserves." } },
{ 0x6070, { "\x05\x41Ganondorf:\x05\x40\x01""You forbid the unqualified.", "\x05\x41Ganondorf:\x05\x40\x01""I am qualified to rule. The\x01""rest is detail." } },
{ 0x6072, { "\x05\x41Ganondorf:\x05\x40\x01""You remind me of the rules.", "\x05\x41Ganondorf:\x05\x40\x01""I shall abide by them. A king\x01""who breaks his own laws invites\x01""his people to do the same." } },
{ 0x6074, { "\x05\x41Ganondorf:\x05\x40\x01""You lament my misfortune.", "\x05\x41Ganondorf:\x05\x40\x01""The mark that leads to the\x01""temple. I know it. It is my\x01""mothers' sign." } },
{ 0x6075, { "\x05\x41Ganondorf:\x05\x40\x01""You give no discount, even to\x01""your king.", "\x05\x41Ganondorf:\x05\x40\x01""Nor should you. I have no love\x01""for those who bargain away what\x01""is owed." } },
{ 0x6076, { "\x05\x41Ganondorf:\x05\x40\x01""You see I am busy.", "\x05\x41Ganondorf:\x05\x40\x01""I am always busy, merchant.\x01""Empires do not build\x01""themselves." } },
{ 0x6078, { "\x05\x41Ganondorf:\x05\x40\x01""You sell me fire in small\x01""boxes.", "\x05\x41Ganondorf:\x05\x40\x01""Bombchu. A weapon that runs on\x01""its own. I appreciate its\x01""ambition." } },
{ 0x6079, { "\x05\x41Ganondorf:\x05\x40\x01""You surprise me, Sheikah, in\x01""this desert of all places.", "" } },
{ 0x607A, { "\x05\x41Ganondorf:\x05\x40\x01""The future rests on me, you\x01""say.", "\x05\x41Ganondorf:\x05\x40\x01""It has rested on me since I was\x01""born. You merely noticed late." } },
{ 0x607C, { "\x05\x41Ganondorf:\x05\x40\x01""The owl swears to watch me\x01""still.", "\x05\x41Ganondorf:\x05\x40\x01""Watch, bird. I prefer an\x01""audience." } },
{ 0x607D, { "\x05\x41Ganondorf:\x05\x40\x01""You run the land, seeking\x01""something.", "" } },
{ 0x607F, { "\x05\x41Ganondorf:\x05\x40\x01""You give me a headstart, as\x01""though I needed one.", "\x05\x41Ganondorf:\x05\x40\x01""A head start for the king.\x01""Generous. I shall not need it." } },
{ 0x6080, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of my killer\x01""instinct.", "\x05\x41Ganondorf:\x05\x40\x01""It is not lost, runner. It is\x01""merely patient." } },
{ 0x6082, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me go ahead.", "\x05\x41Ganondorf:\x05\x40\x01""I always go ahead. Others\x01""follow, or are overtaken." } },
{ 0x6086, { "\x05\x41Ganondorf:\x05\x40\x01""The running man, again.", "\x05\x41Ganondorf:\x05\x40\x01""You have run the length of my\x01""kingdom. You must be weary of\x01""it." } },
// Market, Hyrule Castle, the Temple of Time and Ganon's Castle (first part)
{ 0x7000, { "\x05\x41Ganondorf:\x05\x40\x01""You chase a fowl through the\x01""streets, girl, and find a king\x01""in your path.", "\x05\x41Ganondorf:\x05\x40\x01""Fear is a sound instinct.\x01""Cultivate it." } },
{ 0x7001, { "\x05\x41Ganondorf:\x05\x40\x01""You run, and cry that you are\x01""late.", "\x05\x41Ganondorf:\x05\x40\x01""You are, child. The whole of\x01""Hyrule is late, and does not\x01""yet know it." } },
{ 0x7008, { "\x05\x41Ganondorf:\x05\x40\x01""You stand over something that\x01""has stopped.", "\x05\x41Ganondorf:\x05\x40\x01""All things stop. I hasten some\x01""of them." } },
{ 0x7009, { "\x05\x41Ganondorf:\x05\x40\x01""You point at a window, and\x01""doubt I can see it.", "\x05\x41Ganondorf:\x05\x40\x01""I see every window in this\x01""city, and who stands behind\x01""each. Do not doubt it again." } },
{ 0x700D, { "\x05\x41Ganondorf:\x05\x40\x01""A shop that never opens. A\x01""strange vigil.", "\x05\x41Ganondorf:\x05\x40\x01""All shops close in time. Some\x01""open again under new masters." } },
{ 0x700E, { "\x05\x41Ganondorf:\x05\x40\x01""You say dawn is slow to come.", "\x05\x41Ganondorf:\x05\x40\x01""It will come when I permit it.\x01""Night suits my purposes for\x01""now." } },
{ 0x700F, { "\x05\x41Ganondorf:\x05\x40\x01""You counsel me on the forest\x01""girl's rescue.", "\x05\x41Ganondorf:\x05\x40\x01""I go to Kakariko, Sheikah. Not\x01""for her. For what she guards." } },
{ 0x7010, { "\x05\x41Ganondorf:\x05\x40\x01""You judge me ready.", "\x05\x41Ganondorf:\x05\x40\x01""Ready? I was born ready. It is\x01""the world that has been slow." } },
{ 0x7011, { "\x05\x41Ganondorf:\x05\x40\x01""You lecture me on bottles.", "" } },
{ 0x7012, { "\x05\x41Ganondorf:\x05\x40\x01""A model, you confess, and blame\x01""the crisis.", "" } },
{ 0x7013, { "\x05\x41Ganondorf:\x05\x40\x01""You would sell me a shield for\x01""the mountain.", "" } },
{ 0x7014, { "\x05\x41Ganondorf:\x05\x40\x01""You protest that you are not\x01""dancing.", "\x05\x41Ganondorf:\x05\x40\x01""Itch, then, and dance. All my\x01""subjects will do one or the\x01""other before long." } },
{ 0x7015, { "\x05\x41Ganondorf:\x05\x40\x01""You tell me your ears catch the\x01""goddesses' voices.", "\x05\x41Ganondorf:\x05\x40\x01""The goddesses speak seldom, and\x01""never to the deserving. I have\x01""stopped listening." } },
{ 0x7016, { "\x05\x41Ganondorf:\x05\x40\x01""You ask whether I have tasted\x01""the ranch's milk.", "" } },
{ 0x7017, { "\x05\x41Ganondorf:\x05\x40\x01""You direct me to the ranch.", "\x05\x41Ganondorf:\x05\x40\x01""I know the way. I mark all\x01""roads to all wealth." } },
{ 0x7018, { "\x05\x41Ganondorf:\x05\x40\x01""You stole in to see the\x01""princess.", "" } },
{ 0x7019, { "\x05\x41Ganondorf:\x05\x40\x01""You found a drain beneath the\x01""castle.", "\x05\x41Ganondorf:\x05\x40\x01""A drain. Every castle has its\x01""weakness, child. I have\x01""catalogued them all." } },
{ 0x701A, { "\x05\x41Ganondorf:\x05\x40\x01""You preen your beard before a\x01""king.", "\x05\x41Ganondorf:\x05\x40\x01""Your pride is a fine thing.\x01""Mine is finer, and better\x01""defended." } },
{ 0x701B, { "\x05\x41Ganondorf:\x05\x40\x01""You preen your beard again.", "" } },
{ 0x701C, { "\x05\x41Ganondorf:\x05\x40\x01""You saw a shabby fellow deliver\x01""boxes.", "\x05\x41Ganondorf:\x05\x40\x01""The castle takes in many\x01""things. Some it will not\x01""survive." } },
{ 0x701D, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the Temple of\x01""Time.", "" } },
{ 0x701E, { "\x05\x41Ganondorf:\x05\x40\x01""You tell the legend of the\x01""temple's door.", "\x05\x41Ganondorf:\x05\x40\x01""The entrance to the Sacred\x01""Realm. Yes. I have stood before\x01""it. I mean to stand within." } },
{ 0x701F, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at one who tried the\x01""castle walls.", "" } },
{ 0x7020, { "\x05\x41Ganondorf:\x05\x40\x01""You blame a fool for the\x01""guards' vigilance.", "\x05\x41Ganondorf:\x05\x40\x01""Let them guard. I have no need\x01""of walls; I am invited." } },
{ 0x7021, { "\x05\x41Ganondorf:\x05\x40\x01""You have made your fortune.", "" } },
{ 0x7022, { "\x05\x41Ganondorf:\x05\x40\x01""You think to seek treasure at\x01""the lake.", "\x05\x41Ganondorf:\x05\x40\x01""Seek it. All that floats in\x01""Hyrule will soon float toward\x01""me." } },
{ 0x7023, { "\x05\x41Ganondorf:\x05\x40\x01""You welcome me to the city of\x01""Hyrule.", "" } },
{ 0x7024, { "\x05\x41Ganondorf:\x05\x40\x01""You show me the castle road.", "\x05\x41Ganondorf:\x05\x40\x01""I know it. I have walked it\x01""often, as a guest." } },
{ 0x7025, { "\x05\x41Ganondorf:\x05\x40\x01""You find me dangerous, and say\x01""so.", "\x05\x41Ganondorf:\x05\x40\x01""More than your king, yes. It is\x01""the beginning of wisdom to see\x01""it." } },
{ 0x7026, { "\x05\x41Ganondorf:\x05\x40\x01""You find me more frightening\x01""than anything you know.", "\x05\x41Ganondorf:\x05\x40\x01""You have known little. You will\x01""know more." } },
{ 0x7027, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the Shadow Folk.", "" } },
{ 0x7028, { "\x05\x41Ganondorf:\x05\x40\x01""You hear of a Sheikah woman in\x01""the castle.", "\x05\x41Ganondorf:\x05\x40\x01""One Sheikah. One is enough to\x01""be troublesome. I shall see to\x01""her." } },
{ 0x702A, { "\x05\x41Ganondorf:\x05\x40\x01""The rancher sleeps by the\x01""castle gate.", "\x05\x41Ganondorf:\x05\x40\x01""Sleep, rancher. Your deliveries\x01""have bought you my patience." } },
{ 0x702B, { "\x05\x41Ganondorf:\x05\x40\x01""You wake, and curse my\x01""intrusion.", "\x05\x41Ganondorf:\x05\x40\x01""Shut-eye is for those whom the\x01""world forgets. I have not\x01""forgotten you." } },
{ 0x703C, { "\x05\x41Ganondorf:\x05\x40\x01""You bid your attendant guide me\x01""out.", "\x05\x41Ganondorf:\x05\x40\x01""Afraid? Of the princess? No. I\x01""am only curious how long she\x01""will remain afraid of me." } },
{ 0x703D, { "\x05\x41Ganondorf:\x05\x40\x01""You see I have found the stone.", "\x05\x41Ganondorf:\x05\x40\x01""The races that hold them shall\x01""know their keeper. Yes. I am\x01""that keeper now." } },
{ 0x703E, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the princess's\x01""dreams.", "\x05\x41Ganondorf:\x05\x40\x01""She dreams of me. Let her. It\x01""is the only place she will be\x01""free of me." } },
{ 0x703F, { "\x05\x41Ganondorf:\x05\x40\x01""You shoo me away like a cat.", "\x05\x41Ganondorf:\x05\x40\x01""I go. You will remember you\x01""dismissed a king." } },
{ 0x7041, { "\x05\x41Ganondorf:\x05\x40\x01""You haggle, and then see who\x01""stands at your stall.", "\x05\x41Ganondorf:\x05\x40\x01""Free. You learn quickly. It\x01""will spare you much." } },
{ 0x7042, { "\x05\x41Ganondorf:\x05\x40\x01""You cling to what you found.", "\x05\x41Ganondorf:\x05\x40\x01""Keep it. I am after greater\x01""treasure than a beggar's prize." } },
{ 0x7043, { "\x05\x41Ganondorf:\x05\x40\x01""You complain of being jostled.", "\x05\x41Ganondorf:\x05\x40\x01""Never mind it. The crowd will\x01""thin, and you will wish it had\x01""not." } },
{ 0x7044, { "\x05\x41Ganondorf:\x05\x40\x01""You remark that Gerudo are\x01""seldom seen here.", "\x05\x41Ganondorf:\x05\x40\x01""You will see more. A great many\x01""more." } },
{ 0x7045, { "\x05\x41Ganondorf:\x05\x40\x01""You saw the princess flee on\x01""the white horse.", "\x05\x41Ganondorf:\x05\x40\x01""She fled. As she should. I give\x01""chase in my own time." } },
{ 0x7046, { "\x05\x41Ganondorf:\x05\x40\x01""You were nearly trampled by my\x01""horse.", "\x05\x41Ganondorf:\x05\x40\x01""He has a will of his own. He\x01""takes after his master." } },
{ 0x7047, { "\x05\x41Ganondorf:\x05\x40\x01""You knew me upon the black\x01""horse.", "\x05\x41Ganondorf:\x05\x40\x01""Yes. Ganondorf, the Gerudo\x01""King. Say it often. It will be\x01""the name on every lip." } },
{ 0x7048, { "\x05\x41Ganondorf:\x05\x40\x01""You ask what happened.", "\x05\x41Ganondorf:\x05\x40\x01""What happened? The end of one\x01""age, and the beginning of mine." } },
{ 0x7049, { "\x05\x41Ganondorf:\x05\x40\x01""You laugh at a coward.", "\x05\x41Ganondorf:\x05\x40\x01""Laugh. You will be in his place\x01""before long." } },
{ 0x704A, { "\x05\x41Ganondorf:\x05\x40\x01""You feel a terror coming.", "\x05\x41Ganondorf:\x05\x40\x01""Your feelings serve you well.\x01""Heed them." } },
{ 0x704B, { "\x05\x41Ganondorf:\x05\x40\x01""You ask what I did in the\x01""castle.", "\x05\x41Ganondorf:\x05\x40\x01""I did what a king does. I took\x01""my throne." } },
{ 0x704C, { "\x05\x41Ganondorf:\x05\x40\x01""You urge me on with the key.", "" } },
{ 0x704D, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the one who\x01""carried the girl on the white\x01""horse.", "\x05\x41Ganondorf:\x05\x40\x01""The Sheikah and the princess.\x01""They flee. Let them flee to the\x01""ends of the earth; I shall be\x04\x05\x41Ganondorf:\x05\x40\x01""waiting there." } },
{ 0x704E, { "\x05\x41Ganondorf:\x05\x40\x01""The Sage speaks to the sleeper,\x01""and finds me instead.", "" } },
{ 0x704F, { "\x05\x41Ganondorf:\x05\x40\x01""Rauru. You speak of the age\x01""when you built this temple.", "\x05\x41Ganondorf:\x05\x40\x01""You built it to keep me out. I\x01""have walked in." } },
{ 0x7050, { "\x05\x41Ganondorf:\x05\x40\x01""The sprite marvels at my\x01""growth.", "\x05\x41Ganondorf:\x05\x40\x01""Seven years, and I am grown\x01""into my ambitions." } },
{ 0x7052, { "\x05\x41Ganondorf:\x05\x40\x01""You would tell me all again, as\x01""if I were slow.", "" } },
{ 0x7053, { "\x05\x41Ganondorf:\x05\x40\x01""You warn me that the door has\x01""its price.", "\x05\x41Ganondorf:\x05\x40\x01""Every door has its price. I\x01""have always paid in full, and\x01""in another's coin." } },
{ 0x7054, { "\x05\x41Ganondorf:\x05\x40\x01""We return to the temple, and\x01""you count the years.", "\x05\x41Ganondorf:\x05\x40\x01""Seven years of my reign. Look\x01""about you, sprite. It is a good\x01""beginning." } },
{ 0x7055, { "\x05\x41Ganondorf:\x05\x40\x01""You defend your idleness.", "\x05\x41Ganondorf:\x05\x40\x01""Loiter, then. A loiterer has\x01""never threatened an empire." } },
{ 0x7056, { "\x05\x41Ganondorf:\x05\x40\x01""You have waited for me,\x01""Sheikah.", "\x05\x41Ganondorf:\x05\x40\x01""Many have waited. Few were glad\x01""of my arrival." } },
{ 0x7057, { "\x05\x41Ganondorf:\x05\x40\x01""You recite the prophecy of the\x01""awakening.", "\x05\x41Ganondorf:\x05\x40\x01""When evil rules all. Yes. I\x01""have arranged the first half.\x01""Let us see who arranges the\x04\x05\x41Ganondorf:\x05\x40\x01""second." } },
{ 0x7059, { "\x05\x41Ganondorf:\x05\x40\x01""You call for the sword to\x01""destroy Ganon.", "" } },
{ 0x705A, { "\x05\x41Ganondorf:\x05\x40\x01""You have waited for me,\x01""Sheikah.", "\x05\x41Ganondorf:\x05\x40\x01""And I have come. As I always\x01""do." } },
{ 0x705B, { "\x05\x41Ganondorf:\x05\x40\x01""You praise my hardships and my\x01""Sages.", "" } },
{ 0x705D, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the King of\x01""Thieves, and the door.", "" } },
{ 0x705E, { "\x05\x41Ganondorf:\x05\x40\x01""You name the holder of courage.", "" } },
{ 0x705F, { "\x05\x41Ganondorf:\x05\x40\x01""And the holder of wisdom.", "" } },
{ 0x7060, { "\x05\x41Ganondorf:\x05\x40\x01""The princess reveals herself.", "\x05\x41Ganondorf:\x05\x40\x01""Zelda. At last. You have hidden\x01""long, and well, but not well\x01""enough." } },
{ 0x7061, { "\x05\x41Ganondorf:\x05\x40\x01""You apologise for your\x01""disguise.", "\x05\x41Ganondorf:\x05\x40\x01""You hid from me, princess, and\x01""so you lived. It was wise. It\x01""will not stay so." } },
{ 0x7063, { "\x05\x41Ganondorf:\x05\x40\x01""You thought the ocarina beyond\x01""my reach.", "\x05\x41Ganondorf:\x05\x40\x01""Nothing is beyond my reach,\x01""princess. Only not yet within\x01""it." } },
{ 0x7064, { "\x05\x41Ganondorf:\x05\x40\x01""You hear the rumbling,\x01""princess.", "\x05\x41Ganondorf:\x05\x40\x01""It can, princess. It is." } },
{ 0x7067, { "\x05\x41Ganondorf:\x05\x40\x01""The Sage calls through the\x01""dark.", "" } },
{ 0x706D, { "\x05\x41Ganondorf:\x05\x40\x01""You urge the boy to finish me.", "" } },
{ 0x706E, { "\x05\x41Ganondorf:\x05\x40\x01""The Sages seal the door.", "" } },
{ 0x706F, { "\x05\x41Ganondorf:\x05\x40\x01""You thank the boy for sealing\x01""me away.", "" } },
{ 0x7071, { "\x05\x41Ganondorf:\x05\x40\x01""You ask how much I want the\x01""gate.", "" } },
{ 0x7074, { "\x05\x41Ganondorf:\x05\x40\x01""You praise the cleansing of the\x01""temple.", "\x05\x41Ganondorf:\x05\x40\x01""The temple is clean. I find\x01""cleanliness tiresome." } },
{ 0x7075, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the ocarina and\x01""the sword.", "\x05\x41Ganondorf:\x05\x40\x01""While I hold neither, you say.\x01""I need neither. I hold the\x01""Triforce." } },
{ 0x7077, { "\x05\x41Ganondorf:\x05\x40\x01""The last of the Sheikah. You\x01""announce yourself.", "\x05\x41Ganondorf:\x05\x40\x01""The last. Then your people end\x01""with you. Choose your words\x01""carefully." } },
{ 0x7078, { "\x05\x41Ganondorf:\x05\x40\x01""You see me with the sword that\x01""seals evil.", "\x05\x41Ganondorf:\x05\x40\x01""The sword that seals evil.\x01""Strange, that it rests so\x01""easily in my hand." } },
{ 0x7079, { "\x05\x41Ganondorf:\x05\x40\x01""You bid me find the Sages.", "\x05\x41Ganondorf:\x05\x40\x01""I shall find them. One by one,\x01""and each will regret my\x01""finding." } },
{ 0x707A, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the Sage in the\x01""forest.", "" } },
{ 0x707C, { "\x05\x41Ganondorf:\x05\x40\x01""You have things to tell me\x01""alone.", "" } },
{ 0x707D, { "\x05\x41Ganondorf:\x05\x40\x01""The Triforce divided, and only\x01""one part came to me.", "\x05\x41Ganondorf:\x05\x40\x01""Power came to me. It was always\x01""going to. The rest will follow." } },
{ 0x707E, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the strength that\x01""made me evil.", "\x05\x41Ganondorf:\x05\x40\x01""Not evil, Sheikah. Mighty. Only\x01""the weak make one word of the\x01""two." } },
{ 0x707F, { "\x05\x41Ganondorf:\x05\x40\x01""You tell of my search for the\x01""other parts.", "\x05\x41Ganondorf:\x05\x40\x01""I seek them still. They cannot\x01""hide forever." } },
{ 0x7080, { "\x05\x41Ganondorf:\x05\x40\x01""You remember the day I took the\x01""castle.", "\x05\x41Ganondorf:\x05\x40\x01""I remember it well. It was the\x01""happiest of my life." } },
{ 0x7081, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the sword's seal.", "" } },
{ 0x7082, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of the spirit left in\x01""the Sacred Realm.", "" } },
{ 0x7083, { "\x05\x41Ganondorf:\x05\x40\x01""You ask if I will end the age I\x01""began.", "\x05\x41Ganondorf:\x05\x40\x01""End it? I have only begun." } },
{ 0x7084, { "\x05\x41Ganondorf:\x05\x40\x01""You tell how the Sages will\x01""lure me.", "\x05\x41Ganondorf:\x05\x40\x01""Lure me. I come willingly. The\x01""trap is theirs to spring, and\x01""mine to break." } },
{ 0x7088, { "\x05\x41Ganondorf:\x05\x40\x01""You explain the door and the\x01""sword.", "" } },
{ 0x7089, { "\x05\x41Ganondorf:\x05\x40\x01""You complain of dogs in the\x01""streets.", "\x05\x41Ganondorf:\x05\x40\x01""Dogs are drawn to the scent of\x01""what is coming. They are wiser\x01""than your guards." } },
{ 0x708A, { "\x05\x41Ganondorf:\x05\x40\x01""You offer help, and beg mercy.", "" } },
{ 0x708B, { "\x05\x41Ganondorf:\x05\x40\x01""You speak of returning to my\x01""own time.", "\x05\x41Ganondorf:\x05\x40\x01""I have no time but my own. I\x01""make it as I go." } },
{ 0x708C, { "\x05\x41Ganondorf:\x05\x40\x01""You say I shall have to return\x01""here.", "\x05\x41Ganondorf:\x05\x40\x01""I shall return to all things,\x01""in time." } },
{ 0x708D, { "\x05\x41Ganondorf:\x05\x40\x01""You announce yourself, Impa.\x01""Protector of the princess. From\x01""me.", "\x05\x41Ganondorf:\x05\x40\x01""Protect her, then. It will be\x01""the most tiresome task of your\x01""long life." } },
