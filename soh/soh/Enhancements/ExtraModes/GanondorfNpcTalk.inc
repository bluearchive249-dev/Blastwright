{ 0x4018, { "\x05\x41Ganondorf:\x05\x40\x01""Big fellow. Fine.", "\x05\x41Ganondorf:\x05\x40\x01""The old lady in Kakariko? I know her. Smells like your work." } },
{ 0x401A, { "\x05\x41Ganondorf:\x05\x40\x01""She'll turn up.", "" } },
{ 0x401B, { "\x05\x41Ganondorf:\x05\x40\x01""Inside the fish. Ha.", "" } },
{ 0x401C, { "\x05\x41Ganondorf:\x05\x40\x01""Undo what I've done.", "\x05\x41Ganondorf:\x05\x40\x01""I'll find her. Don't shout at me again." } },
{ 0x401E, { "\x05\x41Ganondorf:\x05\x40\x01""Calm down.", "\x05\x41Ganondorf:\x05\x40\x01""It's not as bad as it looks. Probably." } },
{ 0x401F, { "\x05\x41Ganondorf:\x05\x40\x01""I'm not smug.", "\x05\x41Ganondorf:\x05\x40\x01""A Zora Tunic. I'll take it. Thanks." } },
{ 0x4020, { "\x05\x41Ganondorf:\x05\x40\x01""Pretty Zora girl. No.", "\x05\x41Ganondorf:\x05\x40\x01""I haven't hurt anyone today. Yet." } },
{ 0x4021, { "\x05\x41Ganondorf:\x05\x40\x01""Sorrow. Mostly.", "\x05\x41Ganondorf:\x05\x40\x01""The river carries what we put in it." } },
