{ 0x4023, { "\x05\x41Ganondorf:\x05\x40\x01""Of the fish. Sure.", "\x05\x41Ganondorf:\x05\x40\x01""Your secret's safe." } },
{ 0x4024, { "\x05\x41Ganondorf:\x05\x40\x01""I'm here.", "\x05\x41Ganondorf:\x05\x40\x01""Stop shouting. I heard you the first time." } },
