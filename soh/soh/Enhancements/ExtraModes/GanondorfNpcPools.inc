static const char* const sKokiriGreet[] = {
    "\x05\x41Ganondorf:\x05\x40\x01""Look up, forest child. A king\x01""stands in your little woods.",
    "\x05\x41Ganondorf:\x05\x40\x01""Do not hide behind that fairy.\x01""Speak to me.",
